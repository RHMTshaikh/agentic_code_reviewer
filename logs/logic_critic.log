  2439 | class ClassDocstring:
  2440 |     Config = r"""
  2441 |     This is the configuration class to store the configuration of a {model_base_class}. It is used to instantiate a {model_name}
  2442 |     model according to the specified arguments, defining the model architecture. Instantiating a configuration with the
  2443 |     defaults will yield a similar configuration to that of the [{model_checkpoint}](https://huggingface.co/{model_checkpoint})
  2444 | 
  2445 |     Configuration objects inherit from [`PreTrainedConfig`] and can be used to control the model outputs. Read the
  2446 |     documentation from [`PreTrainedConfig`] for more information.
  2447 |     """
  2448 | 
  2449 |     PreTrainedModel = r"""
  2450 |     This model inherits from [`PreTrainedModel`]. Check the superclass documentation for the generic methods the
  2451 |     library implements for all its model (such as downloading or saving, resizing the input embeddings, pruning heads
  2452 |     etc.)
  2453 | 
  2454 |     This model is also a PyTorch [torch.nn.Module](https://pytorch.org/docs/stable/nn.html#torch.nn.Module) subclass.
  2455 |     Use it as a regular PyTorch Module and refer to the PyTorch documentation for all matter related to general usage
  2456 |     and behavior.
  2457 |     """
