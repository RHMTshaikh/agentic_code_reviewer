  2352 |             if padding is True:
  2353 |                 if verbose:
  2354 |                     if max_length is not None and (
  2355 |                         truncation is None or truncation is False or truncation == "do_not_truncate"
  2356 |                     ):
  2357 |                         warnings.warn(
  2358 |                             "`max_length` is ignored when `padding`=`True` and there is no truncation strategy. "
  2359 |                             "To pad to max length, use `padding='max_length'`."
  2360 |                         )
  2361 |                 padding_strategy = PaddingStrategy.LONGEST  # Default to pad to the longest sequence in the batch
  2362 |             elif not isinstance(padding, PaddingStrategy):
  2363 |                 padding_strategy = PaddingStrategy(padding)
  2364 |             elif isinstance(padding, PaddingStrategy):
  2365 |                 padding_strategy = padding
  2366 |         else:
  2367 |             padding_strategy = PaddingStrategy.DO_NOT_PAD
  2368 | 
  2369 |         # Get truncation strategy
  2370 |         if truncation is not False and truncation is not None:
  2371 |             if truncation is True:
  2372 |                 truncation_strategy = (
  2373 |                     TruncationStrategy.LONGEST_FIRST
  2374 |                 )  # Default to truncate the longest sequences in pairs of inputs
  2375 |             elif not isinstance(truncation, TruncationStrategy):
  2376 |                 truncation_strategy = TruncationStrategy(truncation)
  2377 |             elif isinstance(truncation, TruncationStrategy):
  2378 |                 truncation_strategy = truncation
  2379 |         else:
  2380 |             truncation_strategy = TruncationStrategy.DO_NOT_TRUNCATE
  2381 | 
  2382 |         # Set max length if needed
  2383 |         if max_length is None:
  2384 |             if padding_strategy == PaddingStrategy.MAX_LENGTH:
  2385 |                 if self.model_max_length > LARGE_INTEGER:
  2386 |                     padding_strategy = PaddingStrategy.DO_NOT_PAD
  2387 |                 else:
  2388 |                     max_length = self.model_max_length
  2389 | 
  2390 |             if truncation_strategy != TruncationStrategy.DO_NOT_TRUNCATE:
  2391 |                 if self.model_max_length > LARGE_INTEGER:
  2392 |                     truncation_strategy = TruncationStrategy.DO_NOT_TRUNCATE
  2393 |                 else:
  2394 |                     max_length = self.model_max_length
