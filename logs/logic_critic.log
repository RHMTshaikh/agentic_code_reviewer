  2991 |     def apply_chat_template(
  2992 |         self,
  2993 |         conversation: list[dict[str, str]] | list[list[dict[str, str]]],
  2994 |         tools: list[dict | Callable] | None = None,
  2995 |         documents: list[dict[str, str]] | None = None,
  2996 |         chat_template: str | None = None,
  2997 |         add_generation_prompt: bool = False,
  2998 |         continue_final_message: bool | str = False,
