   780 |     def materialize_tensors(self) -> dict[str, list[torch.Tensor]]:
   781 |         """
   782 |         Materialize all the tensors that were saved in `self.collected_tensors`. This function removes them from the
   783 |         internal attribute to avoid keeping them in memory during the different `self.convert` operations, and return
   784 |         a new dictionary (otherwise we use more memory than needed during loading).
   785 | 
   786 |         We basically have 3 cases here:
   787 |         - async loading (default): the tensors are Future instances that we need to wait for
   788 |         - sync loading: the tensors are Callable, we need to call the Callable to actually load them from disk
   789 |         - saving: the tensors are already torch.Tensor instances (the existing model weights)
   790 |         """
   791 |         collected_tensors = {}
   792 |         for key in list(self.collected_tensors.keys()):
   793 |             # Remove from internal attribute
   794 |             tensors = self.collected_tensors.pop(key)
   795 |             # Async loading
   796 |             if isinstance(tensors[0], Future):
   797 |                 tensors = [future.result() for future in tensors if future.result() is not None]
   798 |             # Sync loading
   799 |             elif callable(tensors[0]):
   800 |                 tensors = [func() for func in tensors]
   801 |                 # Some may be None for some distributed setups
   802 |                 tensors = [tensor for tensor in tensors if tensor is not None]
   803 |             # Add them to the new dictionary
   804 |             collected_tensors[key] = tensors
   805 | 
   806 |         return collected_tensors
