  3609 |             # Save the index as well
  3610 |             with open(save_index_file, "w", encoding="utf-8") as f:
  3611 |                 content = json.dumps(index, indent=2, sort_keys=True) + "\n"
  3612 |                 f.write(content)
  3613 |             logger.info(
  3614 |                 f"The model is bigger than the maximum size per checkpoint ({max_shard_size}) and is going to be "
  3615 |                 f"split in {len(state_dict_split.filename_to_tensors)} checkpoint shards. You can find where each parameters has been saved in the "
  3616 |                 f"index located at {save_index_file}."
  3617 |             )
  3618 | 
  3619 |         if push_to_hub:
