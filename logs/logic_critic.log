   234 |     def test_streaming_output_after_soft_reset_does_not_shorten_generation(self):
   235 |         state = RequestState(request_id="r", initial_tokens=[10, 11], max_new_tokens=5, streaming=True)
   236 |         state._status = RequestStatus.DECODING
   237 |         for token_id in [101, 102]:
   238 |             self.assertFalse(state.update_and_check_completion(token_id, None))
   239 | 
   240 |         reset_state = state.create_equivalent_initial_request()
   241 |         reset_state._status = RequestStatus.DECODING
   242 |         reset_state.streaming = True
   243 | 
   244 |         accepted_tokens = []
   245 |         streamed_tokens = []
   246 |         for token_id in [103, 104, 105, 106]:
   247 |             previous_tokens = reset_state.generated_tokens[:]
   248 |             is_finished = reset_state.update_and_check_completion(token_id, None)
   249 |             if reset_state.generated_tokens != previous_tokens:
   250 |                 accepted_tokens.append(token_id)
   251 |             streamed_tokens.append(reset_state.to_generation_output().generated_tokens)
   252 |             if is_finished:
   253 |                 break
   254 | 
   255 |         self.assertEqual(accepted_tokens, [103, 104, 105])
   256 |         self.assertEqual(streamed_tokens, [[101, 102, 103], [101, 102, 103, 104], [101, 102, 103, 104, 105]])
   257 |         self.assertEqual(reset_state.generated_tokens, [103, 104, 105])
   258 |         self.assertEqual(reset_state.initial_tokens, [10, 11, 101, 102])
