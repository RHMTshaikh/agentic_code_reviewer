  2558 |         # Expand inputs depending on the generation mode
  2559 |         input_ids, model_kwargs = self._expand_inputs_for_generation(
  2560 |             input_ids=input_ids,
  2561 |             expand_size=max(generation_config.num_beams, generation_config.num_return_sequences),
  2562 |             is_encoder_decoder=self.config.is_encoder_decoder,
  2563 |             **model_kwargs,
