   204 | def apply_fully_sharded_data_parallel(
   205 |     model: nn.Module, fsdp_mesh: torch.distributed.device_mesh.DeviceMesh
   206 | ) -> nn.Module:
   207 |     """
   208 |     Apply FSDP2 (fully_shard) to a model.
   209 |     """
   210 |     if not is_torch_available():
   211 |         raise ImportError("PyTorch is required for FSDP support")
   212 | 
   213 |     if not is_torch_greater_or_equal("2.6"):
   214 |         raise OSError("FSDP2 requires torch>=2.6")
   215 | 
