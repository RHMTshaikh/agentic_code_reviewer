  2712 |                 encoded_inputs,
  2713 |                 max_length=max_length,
  2714 |                 padding_strategy=padding_strategy,
  2715 |                 pad_to_multiple_of=pad_to_multiple_of,
  2716 |                 padding_side=padding_side,
  2717 |                 return_attention_mask=return_attention_mask,
