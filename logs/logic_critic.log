   319 |         # kw_only=True ensures fields without defaults in subclasses can follow
   320 |         # parent fields that have defaults (Python dataclass ordering rule).
   321 |         # Config fields are always passed as keyword arguments, so this is safe.
   322 |         cls = dataclass(cls, repr=False, kw_only=True)
   323 | 
   324 |         if not cls_has_custom_init:
   325 |             # Wrap all subclasses to accept arbitrary kwargs for BC
   326 |             # only if the subclass has no custom `__init__`. Most
   327 |             # remote code has an init defined, but some model are not
   328 |             # See https://huggingface.co/hmellor/Ilama-3.2-1B/blob/main/configuration_ilama.py
   329 |             cls = wrap_init_to_accept_kwargs(cls)
