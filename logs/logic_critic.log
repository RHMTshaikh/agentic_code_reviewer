   182 |             torch.testing.assert_close(op.shard_tensor(tensor), expected[rank], msg=f"rank {rank}")
   183 | 
   184 |     def test_2D_strided_shard_same_dim(self):
   185 |         tensor = torch.arange(16).reshape(4, 4).float()
   186 |         expected = {
   187 |             0: tensor[[0]],  # row 0
   188 |             1: tensor[[2]],  # row 2
   189 |             2: tensor[[1]],  # row 1
   190 |             3: tensor[[3]],  # row 3
   191 |         }
   192 |         for rank in range(4):
   193 |             mesh = FakeMesh(shape=(2, 2), rank=rank)
   194 |             op = _make_dtensor_shard_op(
   195 |                 mesh,
   196 |                 [_StridedShard(dim=0, split_factor=2), Shard(0)],
   197 |                 param_shape=(4, 4),
