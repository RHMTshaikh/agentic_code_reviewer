  2651 |     def _has_unfinished_sequences(self, this_peer_finished: bool, synced_gpus: bool, device: torch.device) -> bool:
  2652 |         """
  2653 |         Returns whether there are still unfinished sequences in the device. The existence of unfinished sequences is
  2654 |         fed through `this_peer_finished`. ZeRO stage 3-friendly.
  2655 |         """
  2656 |         if synced_gpus:
  2657 |             # Under synced_gpus the `forward` call must continue until all gpus complete their sequence.
  2658 |             # The following logic allows an early break if all peers finished generating their sequence
  2659 |             this_peer_finished_flag = torch.tensor(0.0 if this_peer_finished else 1.0, device=device)
  2660 |             # send 0.0 if we finished, 1.0 otherwise
  2661 |             dist.all_reduce(this_peer_finished_flag, op=dist.ReduceOp.SUM)  # type: ignore
  2662 |             # did all peers finish? the reduced sum will be 0.0 then
  2663 |             if this_peer_finished_flag.item() == 0.0:
  2664 |                 return False
  2665 |         elif this_peer_finished:
  2666 |             return False
  2667 |         return True
  2668 | 
  2669 |     def heal_tokens(
  2670 |         self, input_ids: torch.LongTensor, tokenizer: Optional["PreTrainedTokenizerBase"] = None
  2671 |     ) -> torch.LongTensor:
  2672 |         r"""
  2673 |         Generates sequences of token ids for models with a language modeling head.
  2674 |         Parameters:
  2675 |             input_ids (`torch.LongTensor`): The sequence used as a prompt for the generation.
  2676 |             tokenizer (`PreTrainedTokenizerBase`, *optional*): The tokenizer used to decode the input ids.
  2677 |         Return:
  2678 |             `torch.LongTensor` where each sequence has its tail token replaced with its appropriate extension.
  2679 |         """
  2680 |         if tokenizer is None:
  2681 |             raise ValueError(
  2682 |                 " When generating with token healing, you must pass the model's tokenizer to the `tokenizer` "
  2683 |                 "argument of `generate`."
  2684 |             )
  2685 | 
  2686 |         bos_token_id, pad_token_id = tokenizer.bos_token_id, tokenizer.pad_token_id
  2687 |         vocab_trie = ExtensionsTrie(tokenizer.get_vocab())
  2688 |         generation_config = GenerationConfig(max_new_tokens=1, pad_token_id=pad_token_id)
  2689 | 
  2690 |         # assumption: leading/trailing whitespace is not meaningful, so the prompts are
  2691 |         # stripped before re-tokenizing to desensitize generation to whitespace artefacts
  2692 |         prompts = [p.strip() for p in tokenizer.decode(input_ids, skip_special_tokens=True)]
  2693 |         input_ids = tokenizer(
  2694 |             prompts,
  2695 |             return_tensors="pt",
  2696 |             padding=True,
  2697 |         ).input_ids.to(input_ids.device)
  2698 | 
  2699 |         # replace bos with pad to not condition healing on it
  2700 |         input_ids = torch.where(input_ids == bos_token_id, pad_token_id, input_ids)
  2701 | 
  2702 |         # the latter code assumes the input_ids is not empty, input_id has to be checked if contains elements
  2703 |         if input_ids.numel() == 0:
  2704 |             return input_ids
  2705 | 
  2706 |         tail_ids = input_ids[:, -1].tolist()
  2707 | 
  2708 |         # tail tokens are used for a prefix search, thus, whitespaces are replaced with
  2709 |         # their tokenization (e.g. 'Ġ') to enable search for tokens prefixed with a whitespace
  2710 |         if tokenizer.convert_tokens_to_ids(" ") is not None:
  2711 |             space_tok = tokenizer.convert_ids_to_tokens(tokenizer.convert_tokens_to_ids(" "))[0]
  2712 |             tail_toks = (cast(str, tokenizer.decode(t)).replace(" ", space_tok) for t in tail_ids)
  2713 |         else:
  2714 |             tail_toks = (cast(str, tokenizer.decode(t)) for t in tail_ids)
  2715 | 
  2716 |         for batch_idx, (tail_id, tail_tok) in enumerate(zip(tail_ids, tail_toks)):
  2717 |             batch_ids = input_ids[batch_idx]
  2718 |             if torch.all(batch_ids == pad_token_id).item():
  2719 |                 continue  # skip empty sequences (all pad ids)
  2720 | 
  2721 |             # apply bias for alternatives (extensions) to the tail token
  2722 |             """
  2723 |             seq_bias key has to be tuple with int so have to use
  2724 |             tokenizer function to convert str to int
  2725 | 			"""
  2726 |             seq_bias = {
  2727 |                 (tokenizer.convert_tokens_to_ids(alt_tok),): 10.0 for alt_tok in vocab_trie.extensions(prefix=tail_tok)
  2728 |             }
  2729 | 
  2730 |             if len(seq_bias) == 1:
  2731 |                 continue  # skip if there are no token alternatives to heal with
  2732 | 
  2733 |             # slightly favor original token to limit aggressive healing e.g. 'http' -> 'https'
  2734 |             seq_bias[(tail_id,)] += 1.0
  2735 |             generation_config.update(sequence_bias=seq_bias)
  2736 | 
  2737 |             trimmed_ids = batch_ids[:-1]
  2738 | 
  2739 |             """
  2740 |             the latter code assumes trimmed_ids is not empty
  2741 |             so have to check the its element count
  2742 | 			"""
  2743 |             if trimmed_ids.numel() == 0:
  2744 |                 continue
  2745 | 
  2746 |             # if the prompt is a single (non-pad) token, regenerate from bos
  2747 |             if len(batch_ids[batch_ids != pad_token_id]) == 1:
  2748 |                 trimmed_ids[-1] = bos_token_id
  2749 | 
  2750 |             input_ids[batch_idx] = self.generate(trimmed_ids.unsqueeze(0), generation_config=generation_config)
  2751 | 
  2752 |         return input_ids
  2753 | 
  2754 |     def _sample(
  2755 |         self: "GenerativePreTrainedModel",
  2756 |         input_ids: torch.LongTensor,
  2757 |         logits_processor: LogitsProcessorList,
  2758 |         stopping_criteria: StoppingCriteriaList,
  2759 |         generation_config: GenerationConfig,
  2760 |         synced_gpus: bool = False,
  2761 |         streamer: Optional["BaseStreamer"] = None,
  2762 |         **model_kwargs,
  2763 |     ) -> GenerateNonBeamOutput | torch.LongTensor:
  2764 |         r"""
  2765 |         Generates sequences of token ids for models with a language modeling head using **multinomial sampling** and
  2766 |         can be used for text-decoder, text-to-text, speech-to-text, and vision-to-text models.
  2767 | 
  2768 |         Parameters:
  2769 |             input_ids (`torch.LongTensor` of shape `(batch_size, sequence_length)`):
  2770 |                 The sequence used as a prompt for the generation.
  2771 |             logits_processor (`LogitsProcessorList`):
  2772 |                 An instance of [`LogitsProcessorList`]. List of instances of class derived from [`LogitsProcessor`]
  2773 |                 used to modify the prediction scores of the language modeling head applied at each generation step.
  2774 |             stopping_criteria (`StoppingCriteriaList`):
  2775 |                 An instance of [`StoppingCriteriaList`]. List of instances of class derived from [`StoppingCriteria`]
  2776 |                 used to tell if the generation loop should stop.
  2777 |             generation_config ([`~generation.GenerationConfig`]):
  2778 |                 The generation configuration to be used as parametrization of the decoding method.
  2779 |             synced_gpus (`bool`):
  2780 |                 Whether to continue running the while loop until max_length (needed to avoid deadlocking with
  2781 |                 `FullyShardedDataParallel` and DeepSpeed ZeRO Stage 3).
  2782 |             streamer (`BaseStreamer`, *optional*):
  2783 |                 Streamer object that will be used to stream the generated sequences. Generated tokens are passed
  2784 |                 through `streamer.put(token_ids)` and the streamer is responsible for any further processing.
  2785 |             model_kwargs:
  2786 |                 Additional model specific kwargs will be forwarded to the `forward` function of the model. If model is
  2787 |                 an encoder-decoder model the kwargs should include `encoder_outputs`.
  2788 | 
  2789 |         Return:
  2790 |             [`~generation.GenerateDecoderOnlyOutput`], [`~generation.GenerateEncoderDecoderOutput`] or `torch.LongTensor`:
  2791 |             A `torch.LongTensor` containing the generated tokens (default behaviour) or a
  2792 |             [`~generation.GenerateDecoderOnlyOutput`] if `model.config.is_encoder_decoder=False` and
  2793 |             `return_dict_in_generate=True` or a [`~generation.GenerateEncoderDecoderOutput`] if
  2794 |             `model.config.is_encoder_decoder=True`.
  2795 |         """
  2796 |         # init values
  2797 |         pad_token_id = generation_config._pad_token_tensor
  2798 |         output_attentions = generation_config.output_attentions
  2799 |         output_hidden_states = generation_config.output_hidden_states
  2800 |         output_scores = generation_config.output_scores
  2801 |         output_logits = generation_config.output_logits
  2802 |         return_dict_in_generate = generation_config.return_dict_in_generate
  2803 |         has_eos_stopping_criteria = any(hasattr(criteria, "eos_token_id") for criteria in stopping_criteria)
  2804 |         do_sample = generation_config.do_sample
  2805 | 
  2806 |         # init attention / hidden states / scores tuples
  2807 |         scores = () if (return_dict_in_generate and output_scores) else None
  2808 |         raw_logits = () if (return_dict_in_generate and output_logits) else None
  2809 |         decoder_attentions = () if (return_dict_in_generate and output_attentions) else None
  2810 |         cross_attentions = () if (return_dict_in_generate and output_attentions) else None
  2811 |         decoder_hidden_states = () if (return_dict_in_generate and output_hidden_states) else None
  2812 | 
  2813 |         # if model is an encoder-decoder, retrieve encoder attention weights and hidden states
  2814 |         if return_dict_in_generate and self.config.is_encoder_decoder:
  2815 |             encoder_attentions = model_kwargs["encoder_outputs"].get("attentions") if output_attentions else None
  2816 |             encoder_hidden_states = (
  2817 |                 model_kwargs["encoder_outputs"].get("hidden_states") if output_hidden_states else None
  2818 |             )
  2819 | 
  2820 |         # keep track of which sequences are already finished
  2821 |         batch_size = input_ids.shape[0]
  2822 |         this_peer_finished = False
  2823 |         unfinished_sequences = torch.ones(batch_size, dtype=torch.long, device=input_ids.device)
  2824 | 
  2825 |         # `pad_token_id` is created on `inputs_tensor.device` in `_prepare_special_tokens`. For multimodal models
  2826 |         # (e.g. BLIP-2, LLaVA) sharded across devices via `device_map="auto"`, `inputs_tensor` (e.g. `pixel_values`
  2827 |         # on the vision encoder) and `input_ids` (on the language model) can live on different devices, so we need to
  2828 |         # realign `pad_token_id` with `input_ids` to avoid cross-device ops below.
  2829 |         if pad_token_id is not None:
  2830 |             pad_token_id = pad_token_id.to(input_ids.device)
  2831 | 
  2832 |         model_forward = (
  2833 |             self.get_compiled_call(generation_config.compile_config)
  2834 |             if self._valid_auto_compile_criteria(model_kwargs, generation_config)
  2835 |             else self.__call__
  2836 |         )
  2837 | 
  2838 |         prefill_consumed = False
  2839 |         outputs = self._prefill(
  2840 |             input_ids,
  2841 |             generation_config,
  2842 |             model_kwargs,
  2843 |             is_first_iteration=not generation_config.is_assistant,
  2844 |         )
  2845 | 
  2846 |         while self._has_unfinished_sequences(this_peer_finished, synced_gpus, device=input_ids.device):
  2847 |             if prefill_consumed:
  2848 |                 next_sequence_length = 1 if model_kwargs["use_cache"] else None
  2849 |                 model_inputs = self.prepare_inputs_for_generation(
  2850 |                     input_ids, next_sequence_length=next_sequence_length, **model_kwargs
  2851 |                 )
  2852 |                 with self._optimize_model_for_decode():
  2853 |                     outputs = model_forward(**model_inputs, return_dict=True)
  2854 |             prefill_consumed = True
  2855 |             model_kwargs = self._update_model_kwargs_for_generation(
  2856 |                 outputs,
  2857 |                 model_kwargs,
  2858 |                 is_encoder_decoder=self.config.is_encoder_decoder,
  2859 |             )
  2860 |             if synced_gpus and this_peer_finished:
  2861 |                 continue
  2862 | 
  2863 |             # Copy is needed to avoid keeping a hanging ref to outputs.logits which may be very large for first iteration
  2864 |             # (the clone itself is always small)
  2865 |             next_token_logits = outputs.logits[:, -1, :].to(copy=True, dtype=torch.float32, device=input_ids.device)
  2866 | 
  2867 |             # pre-process distribution
  2868 |             next_token_scores = logits_processor(input_ids, next_token_logits)
  2869 | 
  2870 |             # Store scores, attentions and hidden_states when required
  2871 |             if return_dict_in_generate:
  2872 |                 if output_scores:
  2873 |                     scores += (next_token_scores,)
  2874 |                 if output_logits:
  2875 |                     raw_logits += (next_token_logits,)
  2876 |                 if output_attentions:
  2877 |                     decoder_attentions += (
  2878 |                         (outputs.decoder_attentions,) if self.config.is_encoder_decoder else (outputs.attentions,)
  2879 |                     )
  2880 |                     if self.config.is_encoder_decoder:
  2881 |                         cross_attentions += (outputs.cross_attentions,)
  2882 | 
  2883 |                 if output_hidden_states:
  2884 |                     decoder_hidden_states += (
  2885 |                         (outputs.decoder_hidden_states,)
  2886 |                         if self.config.is_encoder_decoder
  2887 |                         else (outputs.hidden_states,)
  2888 |                     )
  2889 | 
  2890 |             # token selection
  2891 |             if do_sample:
  2892 |                 probs = nn.functional.softmax(next_token_scores, dim=-1)
  2893 |                 # TODO (joao): this OP throws "skipping cudagraphs due to ['incompatible ops']", find solution
  2894 |                 next_tokens = torch.multinomial(probs, num_samples=1).squeeze(1)
  2895 |             else:
  2896 |                 next_tokens = torch.argmax(next_token_scores, dim=-1)
  2897 | 
  2898 |             # finished sentences should have their next token be a padding token
  2899 |             if has_eos_stopping_criteria:
  2900 |                 next_tokens = next_tokens * unfinished_sequences + pad_token_id * (1 - unfinished_sequences)
  2901 | 
  2902 |             # update generated ids, model inputs, and length for next step
  2903 |             input_ids = torch.cat([input_ids, next_tokens[:, None]], dim=-1)
  2904 |             if streamer is not None:
  2905 |                 streamer.put(next_tokens.cpu())
  2906 | 
  2907 |             unfinished_sequences = unfinished_sequences & ~stopping_criteria(input_ids, scores)
  2908 |             this_peer_finished = unfinished_sequences.max() == 0
  2909 | 
  2910 |             # This is needed to properly delete outputs.logits which may be very large for first iteration
  2911 |             # Otherwise a reference to outputs is kept which keeps the logits alive in the next iteration
  2912 |             del outputs
  2913 | 
  2914 |         if streamer is not None:
  2915 |             streamer.end()
  2916 | 
  2917 |         if return_dict_in_generate:
  2918 |             cache = None
  2919 |             if any(cache_key in model_kwargs for cache_key in ALL_CACHE_NAMES):
  2920 |                 cache_key = next(cache_key for cache_key in ALL_CACHE_NAMES if cache_key in model_kwargs)
  2921 |                 cache = model_kwargs[cache_key]
  2922 |             if self.config.is_encoder_decoder:
  2923 |                 return GenerateEncoderDecoderOutput(
  2924 |                     sequences=input_ids,
  2925 |                     scores=scores,
  2926 |                     logits=raw_logits,
  2927 |                     encoder_attentions=encoder_attentions,
  2928 |                     encoder_hidden_states=encoder_hidden_states,
  2929 |                     decoder_attentions=decoder_attentions,
  2930 |                     cross_attentions=cross_attentions,
  2931 |                     decoder_hidden_states=decoder_hidden_states,
  2932 |                     past_key_values=cache,
  2933 |                 )
  2934 |             else:
  2935 |                 return GenerateDecoderOnlyOutput(
  2936 |                     sequences=input_ids,
  2937 |                     scores=scores,
  2938 |                     logits=raw_logits,
  2939 |                     attentions=decoder_attentions,
  2940 |                     hidden_states=decoder_hidden_states,
  2941 |                     past_key_values=cache,
  2942 |                 )
  2943 |         else:
  2944 |             return input_ids
  2945 | 
  2946 |     @staticmethod
  2947 |     def _flatten_beam_dim(tensor: torch.Tensor) -> torch.Tensor:
  2948 |         """[batch_size, num_beams, ...] -> [batch_size * num_beams, ...]"""
  2949 |         shape = list(tensor.shape)
  2950 |         return torch.reshape(tensor, [shape[0] * shape[1]] + shape[2:])
  2951 | 
  2952 |     @staticmethod
  2953 |     def _unflatten_beam_dim(tensor: torch.Tensor, batch_size: int, num_beams: int) -> torch.Tensor:
  2954 |         """[batch_size * num_beams, ...] -> [batch_size, num_beams, ...]"""
  2955 |         shape = list(tensor.shape)
  2956 |         return torch.reshape(tensor, [batch_size, num_beams] + shape[1:])
  2957 | 
  2958 |     @staticmethod
  2959 |     def _gather_beams(tensor: torch.Tensor, beam_indices: torch.Tensor) -> torch.Tensor:
  2960 |         """
  2961 |         Gathers the beam slices indexed by beam_indices into new beam array.
  2962 | 
  2963 |         Args:
  2964 |             tensor (`torch.Tensor`): A tensor containing data to be gathered. The tensor is a 2D or a 3D tensor
  2965 |                 with the two first dimensions depicting the batch and the beam dimensions.
  2966 |             beam_indices (`torch.Tensor` of shape `(batch_size, num_beams_to_select)`): The indices of the beams to
  2967 |                 select .
  2968 | 
  2969 |         Returns:
  2970 |             A tensor with the selected beams
  2971 |         """
  2972 |         # `take_along_dim` requires its indices arg to have the same number of dims as `input`
  2973 |         while len(beam_indices.shape) < len(tensor.shape):
  2974 |             beam_indices = beam_indices.unsqueeze(-1)
  2975 |         gathered_tensor = torch.take_along_dim(input=tensor, indices=beam_indices, dim=1)
  2976 |         return gathered_tensor
  2977 | 
  2978 |     @staticmethod
  2979 |     def _check_early_stop_heuristic(
  2980 |         is_early_stop_heuristic_unsatisfied: torch.Tensor,
  2981 |         running_beam_scores: torch.Tensor,
  2982 |         beam_scores: torch.Tensor,
  2983 |         is_sent_finished: torch.Tensor,
  2984 |         cur_len: int,
  2985 |         max_length: int,
  2986 |         decoder_prompt_len: int,
  2987 |         early_stopping: bool | str,
  2988 |         length_penalty: float,
  2989 |     ):
  2990 |         """
  2991 |         Determine whether early stopping is possible by checking if the best possible score of running beams
  2992 |         could still improve upon the finished ones.
  2993 | 
  2994 |         Mechanism:
  2995 |         - Without a length penalty, beam scores typically decrease as more tokens are generated.
  2996 |         So, if the *best possible* score from any running beam is already worse than the *worst* finished beam,
  2997 |         we can safely stop early.
  2998 |         - With a length penalty, scores may increase with longer sequences. In this case, we use heuristics
  2999 |         to estimate the best possible score — though this estimate may not always be correct — and stop
  3000 |         if no further improvement seems likely.
  3001 | 
  3002 |         We apply different heuristics depending on the value of `early_stopping`:
  3003 |         1. `early_stopping == False`:
  3004 |         -> Use a heuristic that assumes the best score comes from the current length minus the decoder prompt length.
  3005 |         -> See detailed discussion: https://github.com/huggingface/transformers/pull/20901#issuecomment-1369845565
  3006 | 
  3007 |         2. `early_stopping == "never"`:
  3008 |         -> Estimate the best score using either `max_length` or `cur_len`, depending on the sign of `length_penalty`.
  3009 |         -> A positive length penalty favors longer sequences, so we use `max_length` in that case.
  3010 | 
  3011 |         NOTE: the canonical beam search implementation can be replicated with `early_stopping="never"` and
  3012 |         `length_penalty=0.0`, which are NOT the default flags. The default behavior was empirically found to produce
  3013 |         better sequences (prior to 2022), and changing it is BC breaking.
  3014 |         """
  3015 |         if early_stopping == "never" and length_penalty > 0.0:
  3016 |             best_hypothetical_length = max_length - decoder_prompt_len
  3017 |         else:
  3018 |             best_hypothetical_length = cur_len - decoder_prompt_len
  3019 |         best_possible_running_score = running_beam_scores[:, :1] / (best_hypothetical_length**length_penalty)
  3020 |         worst_finished_score = torch.where(is_sent_finished, torch.min(beam_scores, dim=1, keepdim=True)[0], -1.0e9)
  3021 |         return is_early_stop_heuristic_unsatisfied & torch.any(
  3022 |             best_possible_running_score > worst_finished_score, dim=-1, keepdim=True
  3023 |         )
  3024 | 
  3025 |     @staticmethod
  3026 |     def _beam_search_has_unfinished_sequences(
  3027 |         is_early_stop_heuristic_unsatisfied: torch.Tensor,
  3028 |         is_sent_finished: torch.Tensor,
  3029 |         next_token_hits_stopping_criteria: torch.Tensor,
  3030 |         early_stopping: bool | str,
  3031 |     ):
  3032 |         """
  3033 |         Beam Search stopping condition -- halts the generation loop if any of these conditions becomes False
  3034 |         """
  3035 |         # a. Can the open beams improve the top completed scores?
  3036 |         improvement_possible = torch.any(is_early_stop_heuristic_unsatisfied)
  3037 | 
  3038 |         # b. Is there still a beam without fully completed sequences? This is only relevant if early_stopping is
  3039 |         # enabled, where we want to finish as soon as all beams have a completed sequence.
  3040 |         exists_open_beam = ~(torch.all(is_sent_finished) & (early_stopping is True))
  3041 | 
  3042 |         # c. Have we hit a stopping criteria with all running sequences and have no way to continue? e.g. we have
  3043 |         # reached `max_length``
  3044 |         valid_continuations = ~torch.all(next_token_hits_stopping_criteria)
  3045 | 
  3046 |         return improvement_possible & exists_open_beam & valid_continuations
  3047 | 
  3048 |     def _get_top_k_continuations(
  3049 |         self,
  3050 |         accumulated_log_probs: torch.Tensor,
  3051 |         running_sequences: torch.Tensor,
  3052 |         running_beam_indices: torch.Tensor,
  3053 |         cur_len: int,
  3054 |         decoder_prompt_len: int,
  3055 |         do_sample: bool,
  3056 |         beams_to_keep: int,
  3057 |         num_beams: int,
  3058 |         vocab_size: int,
  3059 |         batch_size: int,
  3060 |     ) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
  3061 |         """
  3062 |         Get top-K continuations given the accumulated log probs on the next token.
  3063 | 
  3064 |         A few notes to understand what's going on:
  3065 |         1. Each item in batch has `num_beams` * `vocab_size` candidate continuations. For each item, get the
  3066 |         top K [K = (number of EOS tokens + 1) * `num_beams`] candidates with the highest accumulated
  3067 |         log-probabilities, or sample them without replacement using the accumulated scores
  3068 |         2. We gather the top K (as opposed to `num_beams`, or any number lower than K) here so that we have at
  3069 |         least `num_beams` sequences remaining to continue the live beam search.
  3070 |         3. Note that other stopping criteria might result in impossible to continue beams, i.e. all continuations
  3071 |         selected in this step hit the stopping criteria.
  3072 |         """
  3073 |         # TODO (joao): This function should take an optional beam scorer function, to manipulate the scores after
  3074 |         # token selection. The function should be an argument exposed, so that custom scoring functions can be
  3075 |         # defined.
  3076 | 
  3077 |         # Gather the top K scores from _all_ beams.
  3078 |         if do_sample:
  3079 |             topk_indices = torch.multinomial(
  3080 |                 nn.functional.softmax(accumulated_log_probs, dim=-1), num_samples=beams_to_keep
  3081 |             )
  3082 |             topk_log_probs = torch.gather(input=accumulated_log_probs, dim=1, index=topk_indices)
  3083 |         else:
  3084 |             topk_log_probs, topk_indices = torch.topk(accumulated_log_probs, k=beams_to_keep)
  3085 | 
  3086 |         # Gather K top beams, recover the beam index by floor division and token id by modulo division
  3087 |         topk_current_beam_indices = topk_indices // vocab_size
  3088 |         topk_running_beam_indices = self._gather_beams(running_beam_indices, topk_current_beam_indices)
  3089 |         topk_running_sequences = self._gather_beams(running_sequences, topk_current_beam_indices)
  3090 |         topk_ids = topk_indices % vocab_size
  3091 | 
  3092 |         # Update sequences for the K top-k new sequences.
  3093 |         topk_running_sequences[:, :, cur_len] = topk_ids
  3094 | 
  3095 |         # we want to store the beam indices with batch information -> real beam index = beam index % num beams
  3096 |         batch_offset = torch.arange(batch_size, device=topk_ids.device).view(-1, 1) * num_beams
  3097 |         batch_modified_indices = topk_current_beam_indices + batch_offset
  3098 |         topk_running_beam_indices[:, :, cur_len - decoder_prompt_len] = batch_modified_indices
  3099 | 
  3100 |         return topk_log_probs, topk_running_sequences, topk_running_beam_indices
  3101 | 
  3102 |     def _get_running_beams_for_next_iteration(
  3103 |         self,
  3104 |         topk_log_probs: torch.Tensor,
  3105 |         topk_running_sequences: torch.Tensor,
  3106 |         topk_running_beam_indices: torch.Tensor,
  3107 |         next_token_hits_stopping_criteria: torch.Tensor,
  3108 |         num_beams: int,
  3109 |     ) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
  3110 |         """
  3111 |         Given the top-K continuations, their scores, and whether they hit a stopping criteria, select the
  3112 |         best non-finished beams to continue beam search in the next iteration.
  3113 |         """
  3114 |         # To prevent these just finished sequences from being used in subsequent iterations, set their log probs
  3115 |         # to a very large negative value
  3116 |         topk_running_log_probs = topk_log_probs + next_token_hits_stopping_criteria.to(torch.float32) * -1.0e9
  3117 | 
  3118 |         next_topk_indices = torch.topk(topk_running_log_probs, k=num_beams)[1]
  3119 |         running_sequences = self._gather_beams(topk_running_sequences, next_topk_indices)
  3120 |         running_beam_scores = self._gather_beams(topk_running_log_probs, next_topk_indices)
  3121 |         running_beam_indices = self._gather_beams(topk_running_beam_indices, next_topk_indices)
  3122 |         return running_sequences, running_beam_scores, running_beam_indices
  3123 | 
  3124 |     def _update_finished_beams(
  3125 |         self,
  3126 |         sequences: torch.Tensor,
  3127 |         topk_running_sequences: torch.Tensor,
  3128 |         beam_scores: torch.Tensor,
  3129 |         topk_log_probs: torch.Tensor,
  3130 |         beam_indices: torch.Tensor,
  3131 |         topk_running_beam_indices: torch.Tensor,
  3132 |         is_early_stop_heuristic_unsatisfied: torch.Tensor,
  3133 |         is_sent_finished: torch.Tensor,
  3134 |         next_token_hits_stopping_criteria: torch.Tensor,
  3135 |         top_num_beam_mask: torch.Tensor,
  3136 |         num_beams: int,
  3137 |         cur_len: int,
  3138 |         decoder_prompt_len: int,
  3139 |         length_penalty: float,
  3140 |         early_stopping: bool | str,
  3141 |     ) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor, torch.Tensor]:
  3142 |         """
  3143 |         Updates the finished beams if (and only if) there are new completed sequences that have a higher score than
  3144 |         the current finished sequences.
  3145 |         """
  3146 |         # Only the top `num_beam` sequences can be considered for the final returned sequences. Remember: the
  3147 |         # remaining sequences only exist as a backup to ensure that we have at least `num_beams` sequences to
  3148 |         # continue.
  3149 |         did_top_num_beams_just_finished = next_token_hits_stopping_criteria & top_num_beam_mask[None, :]
  3150 | 
  3151 |         # Further process topk logits for the finished beams
  3152 |         # - add length penalty
  3153 |         topk_log_probs = topk_log_probs / ((cur_len + 1 - decoder_prompt_len) ** length_penalty)
  3154 |         # - make sure no scores can be added anymore if beam is full and early stopping is on
  3155 |         beams_in_batch_are_full = torch.all(is_sent_finished, axis=-1, keepdims=True) & (early_stopping is True)
  3156 |         topk_log_probs += beams_in_batch_are_full.to(torch.float32) * -1.0e9
  3157 |         # - make sure no scores can be added anymore if improvement is not possible
  3158 |         topk_log_probs += (~is_early_stop_heuristic_unsatisfied).to(torch.float32) * -1.0e9
  3159 | 
  3160 |         # - make sure still running sequences cannot be chosen as finalized beam
  3161 |         topk_log_probs += (~did_top_num_beams_just_finished) * -1.0e9
  3162 | 
  3163 |         # Get finalized  `num_beam` sequences for the next generation step -- combine the previous finalized
  3164 |         # data with the new finalized sequences (if any, non-finalized sequences have a very large negative score
  3165 |         # in this step), and keep the best `num_beams` sequences.
  3166 |         merged_sequences = torch.cat((sequences, topk_running_sequences), dim=1)
  3167 |         merged_scores = torch.cat((beam_scores, topk_log_probs), dim=1)
  3168 |         merged_beam_indices = torch.cat((beam_indices, topk_running_beam_indices), dim=1)
  3169 |         merged_is_sent_finished = torch.cat((is_sent_finished, did_top_num_beams_just_finished), dim=1)
  3170 |         topk_merged_indices = torch.topk(merged_scores, k=num_beams)[1]
  3171 |         sequences = self._gather_beams(merged_sequences, topk_merged_indices)
  3172 |         beam_scores = self._gather_beams(merged_scores, topk_merged_indices)
  3173 |         beam_indices = self._gather_beams(merged_beam_indices, topk_merged_indices)
  3174 |         is_sent_finished = self._gather_beams(merged_is_sent_finished, topk_merged_indices)
  3175 |         return sequences, beam_scores, beam_indices, is_sent_finished
  3176 | 
  3177 |     # end of auxiliary functions for beam search
  3178 | 
  3179 |     def _beam_search(
  3180 |         self: "GenerativePreTrainedModel",
  3181 |         input_ids: torch.LongTensor,
  3182 |         logits_processor: LogitsProcessorList,
  3183 |         stopping_criteria: StoppingCriteriaList,
  3184 |         generation_config: GenerationConfig,
  3185 |         synced_gpus: bool = False,
  3186 |         **model_kwargs,
  3187 |     ) -> GenerateBeamOutput | torch.LongTensor:
  3188 |         r"""
  3189 |         Generates sequences of token ids for models with a language modeling head using **beam search decoding** and
  3190 |         can be used for text-decoder, text-to-text, speech-to-text, and vision-to-text models.
  3191 | 
  3192 |         If it's the first time you're diving into Beam Search, we recommend you read the following blog post:
  3193 |         https://huggingface.co/blog/how-to-generate (especially the beam search section).
  3194 | 
  3195 |         You can recompute the sequence scores from the individual scores using the `compute_transition_scores` function
  3196 |         (https://huggingface.co/docs/transformers/main_classes/text_generation#transformers.GenerationMixin.compute_transition_scores)
  3197 | 
  3198 |         Parameters:
  3199 |             input_ids (`torch.LongTensor` of shape `(batch_size*num_beams, sequence_length)`):
  3200 |                 The sequence used as a prompt for the generation.
  3201 |             logits_processor (`LogitsProcessorList`):
  3202 |                 An instance of [`LogitsProcessorList`]. List of instances of class derived from [`LogitsProcessor`]
  3203 |                 used to modify the prediction scores of the language modeling head applied at each generation step.
  3204 |             stopping_criteria (`StoppingCriteriaList`:
  3205 |                 An instance of [`StoppingCriteriaList`]. List of instances of class derived from [`StoppingCriteria`]
  3206 |                 used to tell if the generation loop should stop.
  3207 |             generation_config ([`~generation.GenerationConfig`]):
  3208 |                 The generation configuration to be used as parametrization of the decoding method.
  3209 |             synced_gpus (`bool`):
  3210 |                 Whether to continue running the while loop until max_length (needed to avoid deadlocking with
  3211 |                 `FullyShardedDataParallel` and DeepSpeed ZeRO Stage 3).
  3212 |             model_kwargs:
  3213 |                 Additional model specific kwargs will be forwarded to the `forward` function of the model. If model is
  3214 |                 an encoder-decoder model the kwargs should include `encoder_outputs`.
  3215 | 
  3216 |         Return:
  3217 |             [`generation.GenerateBeamDecoderOnlyOutput`], [`~generation.GenerateBeamEncoderDecoderOutput`] or
  3218 |             `torch.LongTensor`: A `torch.LongTensor` containing the generated tokens (default behaviour) or a
  3219 |             [`~generation.GenerateBeamDecoderOnlyOutput`] if `model.config.is_encoder_decoder=False` and
  3220 |             `return_dict_in_generate=True` or a [`~generation.GenerateBeamEncoderDecoderOutput`] if
  3221 |             `model.config.is_encoder_decoder=True`.
  3222 |         """
  3223 |         # 1. init beam_search values
  3224 |         pad_token_id = generation_config._pad_token_tensor
  3225 |         eos_token_id = generation_config._eos_token_tensor
  3226 |         output_attentions = generation_config.output_attentions
  3227 |         output_hidden_states = generation_config.output_hidden_states
  3228 |         output_scores = generation_config.output_scores
  3229 |         output_logits = generation_config.output_logits
  3230 |         return_dict_in_generate = generation_config.return_dict_in_generate
  3231 |         do_sample = generation_config.do_sample
  3232 |         early_stopping = generation_config.early_stopping
  3233 |         length_penalty = generation_config.length_penalty
  3234 |         max_length = generation_config.max_length
  3235 |         num_beams = generation_config.num_beams
  3236 |         num_return_sequences = generation_config.num_return_sequences
  3237 | 
  3238 |         batch_size_unflattened, cur_len = input_ids.shape[:2]
  3239 |         batch_size = batch_size_unflattened // num_beams
  3240 |         # TODO (joao): standardize special cases
  3241 |         if self.__class__.__name__ == "MoshiDepthDecoder":
  3242 |             vocab_size = self.config.audio_vocab_size
  3243 |         elif self.__class__.__name__ == "ImageGPTForCausalImageModeling":
  3244 |             vocab_size = self.get_output_embeddings().out_features
  3245 |         elif self.__class__.__name__ == "BarkSemanticModel":
  3246 |             vocab_size = self.config.output_vocab_size
  3247 |         else:
  3248 |             vocab_size = self.config.get_text_config().vocab_size
  3249 |         decoder_prompt_len = cur_len
  3250 |         this_peer_finished = False
  3251 | 
  3252 |         # At each beam search step, we want to keep top K [K = (number of EOS tokens + 1) * `num_beams`] candidates
  3253 |         # with the highest log-probabilities, or sample K continuations without replacement. We gather the top K
  3254 |         # (as opposed to `num_beams`, or any number lower than K) so that we have at least `num_beams` sequences
  3255 |         # non-finished to continue the live beam search, in case the top `num_beams` all select an EOS token.
  3256 |         n_eos_tokens = eos_token_id.shape[0] if eos_token_id is not None else 0
  3257 |         beams_to_keep = max(2, 1 + n_eos_tokens) * num_beams
  3258 |         top_num_beam_mask = torch.cat(
  3259 |             (torch.ones((num_beams), dtype=torch.bool), torch.zeros((beams_to_keep - num_beams), dtype=torch.bool)),
  3260 |             dim=0,
  3261 |         ).to(input_ids.device)
  3262 | 
