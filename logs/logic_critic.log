   575 | def process_source_pattern(source_pattern: str, target_pattern: str) -> str:
   576 |     """
   577 |     Process a source pattern for reverse mapping (when sources become targets).
   578 |     This is useful because usually if the original source (so now the target in reverse mode) had a `^` or `$`
   579 |     to restrict to start/end of string, we should do the same in reverse mode. This is why this method in conditioned
   580 |     on the target pattern, we want to do it only for pairs (source, target) when the original source (so the current target
   581 |     in reverse mode) had it.
   582 |     """
   583 |     if target_pattern.startswith("^"):
   584 |         source_pattern = f"^{source_pattern}" if not source_pattern.startswith("^") else source_pattern
   585 |     if target_pattern.endswith("$"):
   586 |         source_pattern = f"{source_pattern}$" if not source_pattern.endswith("$") else source_pattern
   587 | 
   588 |     return source_pattern
