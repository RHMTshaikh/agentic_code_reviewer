    37 | class DtensorShardOperation:
    38 |     """Shard-on-read: slice a full checkpoint tensor down to this rank's local
    39 |     DTensor shard, for any combination of placements on a 1-D or n-D mesh.
    40 | 
    41 |     Placements primer
    42 |     -----------------
    43 |     Each mesh dim carries one placement describing how it slices the tensor:
    44 | 
    45 |     | Placement                | Local data on each rank of the mesh dim         |
    46 |     |--------------------------|-------------------------------------------------|
    47 |     | Replicate                | full tensor (no slicing)                        |
    48 |     | Shard(d)                 | contiguous chunk of dim d (rows r*c .. (r+1)*c) |
    49 |     | _StridedShard(d, sf=N)   | one chunk from each of N groups along dim d,   |
    50 |     |                          | concatenated together (interleaved layout)      |
    51 | 
    52 |     Different scenarios of different placements
    53 |     ------------------------------------------
    54 |     Placement tuples are ordered outermost-first; for a 2-D (fsdp, tp) mesh
    55 |     the tuple is (fsdp_placement, tp_placement).
    56 | 
    57 |     | Scenario                                          | Placements                                  |
    58 |     |---------------------------------------------------|---------------------------------------------|
    59 |     | TP-only, non-fused (e.g. q_proj/k_proj/v_proj)    | [Shard(d)]                                   |
    60 |     | TP-only, fused gate/up                            | [_StridedShard(d, sf=2)]                     |
    61 |     | TP + FSDP, same tensor dim (contiguous TP case)   | [Shard(d), Shard(d)]                         |
    62 |     | TP + FSDP, same tensor dim (fused/interleaved TP) | [_StridedShard(d, sf=tp_size), Shard(d)]     |
    63 |     | TP + FSDP, different dims                         | [Shard(d1), Shard(d2)]                       |
    64 | 
    65 |     Mesh dimensions are listed outermost-first. For a 2-D (fsdp=F, tp=T) mesh,
    66 |     rank index = fsdp_idx * T + tp_idx.
    67 | 
    68 |     Loading (this class)
    69 |     --------------------
    70 |     During `from_pretrained`, each rank reads the full checkpoint tensors,
    71 |     then calls `shard_tensor(source, tensor_idx=...)` to keep only its local
    72 |     DTensor shard. The class encapsulates the placements + mesh so the
    73 |     slicing logic doesn't have to be repeated at every call site.
    74 | 
    75 |     Two checkpoint layouts are supported. Running example: an MoE weight
    76 |     stack of param shape [N_experts, in, out]:
    77 | 
    78 |     | Checkpoint layout                  | tensor_idx | source.shape  | Returns                     |
    79 |     |------------------------------------|------------|---------------|-----------------------------|
    80 |     | One stacked tensor                 | None       | [N, in, out]  | This rank's slice along     |
    81 |     |                                    |            |               | every sharded dim.          |
    82 |     | N per-expert tensors (called once  | 0..N-1     | [in, out]     | Inner-dim slice if this     |
    83 |     | per expert by the caller)          |            |               | rank owns expert `i`,       |
    84 |     |                                    |            |               | else None (caller drops it).|
    85 |     """
    86 | 
    87 |     def __init__(self, param: DTensor):
    88 |         self.device_mesh = param.device_mesh
    89 |         self.placements = tuple(param.placements)
    90 |         self.param_ndim = param.ndim
    91 |         local_shape, offsets = compute_local_shape_and_global_offset(param.shape, self.device_mesh, self.placements)
    92 |         # Axis-0 range owned by this rank (used to filter per-expert pieces)
    93 |         # [_axis0_offset, _axis0_offset + _axis0_local_size)
    94 |         self._axis0_offset = offsets[0]
    95 |         self._axis0_local_size = local_shape[0]
    96 | 
    97 |     def shard_tensor(
    98 |         self, source: torch.Tensor, tensor_idx: int | None = None, device=None, dtype=None
    99 |     ) -> torch.Tensor | None:
   100 |         """Return this rank's local shard of a checkpoint tensor.
   101 | 
   102 |         Two layouts (example param shape [N, in, out]):
   103 | 
   104 |         - tensor_idx is None: one stacked [N, in, out] tensor;
   105 |           slice every sharded dim (including axis 0).
   106 |         - tensor_idx given: one [in, out] tensor per expert;
   107 |           return None if this rank does not own that expert, else slice
   108 |           inner dims only. Surviving pieces are stacked by MergeModulelist
   109 |           into this rank's local [n_local, in, out] shard.
   110 |         """
   111 |         source_shape = list(source.shape) if isinstance(source, torch.Tensor) else source.get_shape()
   112 |         dim_placements = [
   113 |             (mesh_dim, placement) for mesh_dim, placement in enumerate(self.placements) if hasattr(placement, "dim")
   114 |         ]
   115 | 
   116 |         # Dense path
   117 |         if tensor_idx is None:
   118 |             if not dim_placements:
   119 |                 return source[...].to(device=device, dtype=dtype)
   120 | 
   121 |             # Determine for each tensor dimension, which type of sharding operations to apply (_StridedShard or Shard) and which rank to apply it to.
   122 |             # i.e: dim 0 -> [ Strided(rank0, size=2, sf=2), Shard(rank1, size=2) ]
   123 |             # i.e: dim 1 -> [ Shard(rank0, size=2)]
   124 |             planned_ops_by_dim = [[] for _ in source_shape]
   125 |             for mesh_dim, placement in dim_placements:
   126 |                 sub_mesh = self._get_sub_mesh(mesh_dim)
   127 |                 rank, world_size = sub_mesh.get_local_rank(), sub_mesh.size()
   128 |                 dim_idx = self._normalize_param_dim(placement.dim)
   129 |                 planned_ops_by_dim[dim_idx].append((placement, rank, world_size))
   130 | 
   131 |             # Apply the sharding operations to each tensor dimension.
   132 |             intervals_by_dim = [[(0, size)] for size in source_shape]
   133 |             for dim_idx, planned_ops in enumerate(planned_ops_by_dim):
   134 |                 intervals = intervals_by_dim[dim_idx]
   135 |                 for placement, rank, world_size in planned_ops:
   136 |                     if placement.is_shard():
   137 |                         intervals = self._apply_contiguous_shard(intervals, rank, world_size)
   138 |                     else:
   139 |                         intervals = self._apply_strided_shard(intervals, rank, world_size, placement.split_factor)
   140 |                 intervals_by_dim[dim_idx] = intervals
   141 | 
   142 |             has_strided_shard = any(not placement.is_shard() for _, placement in dim_placements)
   143 |             if has_strided_shard:
   144 |                 # Multi-interval dim: read each piece separately, then concatenate.
   145 |                 return self._slice_and_cat(source, intervals_by_dim, device, dtype)
   146 |             else:
   147 |                 slice_parts = []
   148 |                 for intervals in intervals_by_dim:
   149 |                     start, end = intervals[0] if len(intervals) > 0 else (0, 0)
   150 |                     slice_parts.append(slice(start, end))
   151 | 
   152 |                 return source[tuple(slice_parts)].to(device=device, dtype=dtype)
   153 | 
   154 |         # MoE path
   155 |         # tensor_idx identifies the axis-0 piece in param space (not in source.shape).
   156 |         normalized_dim_placements = [
   157 |             (mesh_dim, placement, self._normalize_param_dim(placement.dim)) for mesh_dim, placement in dim_placements
   158 |         ]
   159 | 
   160 |         # if this rank owns expert `tensor_idx` along axis 0, we need to slice the inner dimensions, else we drop it
   161 |         has_axis0_shard = any(param_dim == 0 for _, _, param_dim in normalized_dim_placements)
   162 |         owns_tensor_idx = self._axis0_offset <= tensor_idx < self._axis0_offset + self._axis0_local_size
   163 |         if has_axis0_shard and not owns_tensor_idx:
   164 |             return None
   165 | 
   166 |         # `param_dim` indexes the full parameter layout [N, in, out] (expert axis first).
   167 |         # In per-expert loading, leading axis is absent ([in, out]).
   168 |         # Therefore we need to shift the dimensions by 1 to the left so that sharding operations can be applied to the inner dimensions.
   169 |         #   param [N, in, out]  ↔  source [in, out]
   170 |         #   Shard(param dim 1)  →  slice source dim 0
   171 |         #   Shard(param dim 2)  →  slice source dim 1
   172 |         planned_ops_by_source_dim = [[] for _ in source_shape]
   173 |         for mesh_dim, _, param_dim in normalized_dim_placements:
   174 |             if param_dim > 0:
   175 |                 source_dim = param_dim - 1
   176 |                 sub_mesh = self._get_sub_mesh(mesh_dim)
   177 |                 rank, world_size = sub_mesh.get_local_rank(), sub_mesh.size()
   178 |                 planned_ops_by_source_dim[source_dim].append((rank, world_size))
   179 | 
   180 |         intervals_by_source_dim = [[(0, size)] for size in source_shape]
   181 |         for source_dim, planned_ops in enumerate(planned_ops_by_source_dim):
   182 |             intervals = intervals_by_source_dim[source_dim]
   183 |             for rank, world_size in planned_ops:
   184 |                 intervals = self._apply_contiguous_shard(intervals, rank, world_size)
   185 |             intervals_by_source_dim[source_dim] = intervals
   186 | 
   187 |         slice_parts = []
   188 |         for intervals in intervals_by_source_dim:
   189 |             start, end = intervals[0] if intervals else (0, 0)
   190 |             slice_parts.append(slice(start, end))
   191 | 
   192 |         return source[tuple(slice_parts)].to(device=device, dtype=dtype)
   193 | 
   194 |     def _apply_strided_shard(
   195 |         self, intervals: list[tuple[int, int]], rank: int, world_size: int, split_factor: int
   196 |     ) -> list[tuple[int, int]]:
   197 |         local_intervals = []
   198 | 
   199 |         for interval_start, interval_end in intervals:
   200 |             # For each interval, we break it into split_factor consecutive groups.
   201 |             group_width = math.ceil((interval_end - interval_start) / split_factor)
   202 | 
   203 |             for group_idx in range(split_factor):
   204 |                 # Compute this group's boundaries in source coordinates.
   205 |                 group_start = interval_start + group_idx * group_width
   206 |                 group_end = min(group_start + group_width, interval_end)
   207 |                 group_len = group_end - group_start
   208 | 
   209 |                 if group_len > 0:
   210 |                     # Inside each group, we do a normal contiguous shard across world_size ranks.
   211 |                     local_shard_size, local_shard_offset = Shard.local_shard_size_and_offset(
   212 |                         group_len, world_size, rank
   213 |                     )
   214 |                     if local_shard_size > 0:
   215 |                         # Convert group-local offset back to global source coordinates.
   216 |                         shard_start = group_start + local_shard_offset
   217 |                         local_intervals.append((shard_start, shard_start + local_shard_size))
   218 | 
   219 |         return local_intervals
   220 | 
   221 |     def _apply_contiguous_shard(
   222 |         self, intervals: list[tuple[int, int]], rank: int, world_size: int
   223 |     ) -> list[tuple[int, int]]:
   224 |         # We apply contiguous sharding to a list of intervals. Two cases:
   225 |         # 1. The intervals is a single interval -> we return the local interval for this rank.
   226 |         # 2. The intervals are disjoint (i.e: 2D TP + FSDP, same tensor dim (fused/interleaved TP = [StridedShard(d, sf=tp_size), Shard(d)])
   227 |         # -> find overlapping local intervals across the disjoint intervals.
   228 | 
   229 |         # Compute rank's local length and start offset when the total length is partitioned across world_size ranks.
   230 |         flat_total_len = sum(end - start for start, end in intervals)
   231 |         local_flat_len, local_flat_start = Shard.local_shard_size_and_offset(flat_total_len, world_size, rank)
   232 |         local_flat_end = local_flat_start + local_flat_len
   233 | 
   234 |         if local_flat_len == 0:
   235 |             return []
   236 | 
   237 |         # Single-interval case.
   238 |         if len(intervals) == 1:
   239 |             source_start, _ = intervals[0]
   240 |             return [(source_start + local_flat_start, source_start + local_flat_end)]
   241 | 
   242 |         # Disjoint intervals case.
   243 |         # 1) Build flat mapping from source intervals.
   244 |         # Example: intervals=[(0,3), (10,15)] -> flat segments: (0,3,0) and (3,8,10)
   245 |         # meaning flat [0,3) maps to source [0,3), and flat [3,8) maps to source [10,15).
   246 |         flat_segments = []  # (interval_flat_start, interval_flat_end, source_start)
   247 |         idx = 0
   248 |         for source_start, source_end in intervals:
   249 |             interval_len = source_end - source_start
   250 |             if interval_len > 0:
   251 |                 flat_segments.append((idx, idx + interval_len, source_start))
   252 |                 idx += interval_len
   253 | 
   254 |         # 2) Intersect this rank's flat span with each flat segment, then map overlap
   255 |         # back to source coordinates.
   256 |         # Example: local flat span [2,6) with segments above gives:
   257 |         #   overlap with [0,3) => [2,3) -> source (2,3)
   258 |         #   overlap with [3,8) => [3,6) -> source (10,13)
   259 |         # result: local_intervals = [(2,3), (10,13)]
   260 |         local_intervals = []
   261 |         for interval_flat_start, interval_flat_end, source_start in flat_segments:
   262 |             overlap_flat_start = max(interval_flat_start, local_flat_start)
   263 |             overlap_flat_end = min(interval_flat_end, local_flat_end)
   264 |             if overlap_flat_start < overlap_flat_end:
   265 |                 source_overlap_start = source_start + (overlap_flat_start - interval_flat_start)
   266 |                 source_overlap_end = source_start + (overlap_flat_end - interval_flat_start)
   267 |                 local_intervals.append((source_overlap_start, source_overlap_end))
   268 | 
   269 |         return local_intervals
   270 | 
   271 |     def _slice_and_cat(
   272 |         self,
   273 |         source: torch.Tensor,
   274 |         intervals: list[list[tuple[int, int]]],
   275 |         device: torch.device | str | int | None,
   276 |         dtype: torch.dtype | None,
   277 |     ) -> torch.Tensor:
   278 |         multi_interval_dims = [dim_idx for dim_idx, dim_intervals in enumerate(intervals) if len(dim_intervals) > 1]
   279 |         if len(multi_interval_dims) > 1:
   280 |             # NOTE(3outeille): not sure yet which scenario will have StridedShard
   281 |             # placements on both row and column. Thus, delay implementing this for now.
   282 |             raise ValueError("Current shard-on-read only supports disjoint ranges on a single checkpoint dimension.")
   283 |         concat_dim = multi_interval_dims[0] if multi_interval_dims else None
   284 | 
   285 |         base_slices = []
   286 |         for dim_idx, dim_intervals in enumerate(intervals):
   287 |             if dim_idx == concat_dim:
   288 |                 # Disconnected intervals on this dim — placeholder; filled per interval below.
   289 |                 base_slices.append(slice(None))
   290 |             else:
   291 |                 # Single contiguous slice on this dim.
   292 |                 start, end = dim_intervals[0]
   293 |                 base_slices.append(slice(start, end))
   294 | 
   295 |         # Fast path: every dim is one contiguous interval, read in a single slice.
   296 |         if concat_dim is None:
   297 |             return source[tuple(base_slices)].to(device=device, dtype=dtype)
   298 | 
   299 |         # Multi-interval dim: keep base slices fixed and vary concat_dim only.
   300 |         base_slices_tuple = tuple(base_slices)
   301 |         interval_tensors = []
   302 |         for interval_start, interval_end in intervals[concat_dim]:
   303 |             interval_slices = (
   304 |                 *base_slices_tuple[:concat_dim],
   305 |                 slice(interval_start, interval_end),
   306 |                 *base_slices_tuple[concat_dim + 1 :],
   307 |             )
   308 |             interval_tensors.append(source[interval_slices])
   309 | 
   310 |         return torch.cat(interval_tensors, dim=concat_dim).to(device=device, dtype=dtype)
   311 | 
   312 |     def _get_sub_mesh(self, mesh_dim: int):
   313 |         if self.device_mesh.ndim == 1:
   314 |             return self.device_mesh
   315 |         return self.device_mesh[self.device_mesh.mesh_dim_names[mesh_dim]]
   316 | 
   317 |     def _normalize_param_dim(self, dim: int) -> int:
   318 |         # if dim is negative, it should be normalized to the last axis
   319 |         return dim if dim >= 0 else self.param_ndim + dim
