  1216 |         generation_params = {}
  1217 |         default_config = self.__class__().to_dict() if not self.has_no_defaults_at_init else {}
  1218 |         for key in GenerationConfig._get_default_generation_params().keys():
  1219 |             if key == "use_cache":
  1220 |                 continue  # common key for most models
  1221 |             if hasattr(self, key) and getattr(self, key) is not None and key not in default_config:
  1222 |                 generation_params[key] = getattr(self, key)
  1223 | 
  1224 |         return generation_params
