   497 |     def get_read_indices(self, request_id: str, past_length: int, query_length: int) -> list[int]:
   498 |         """Returns the physical indices of where to read request_id's cache in the cache tensor.
   499 |         For a group of sliding window attention layers, we read from the cache tensor before writing on it, because the
   500 |         new cache can overwrite the old one. To form the cache + new key / values states, we read the at most
   501 |         sliding_window - 1 cache page and then manually add the new key / values states after. Hence the sentinel
   502 |         indices which indicate where to store the new key or values indices."""
   503 |         # Retrieve the block table for the request and raise an error if it doesn't exist
