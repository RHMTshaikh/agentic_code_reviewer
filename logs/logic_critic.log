   190 |     def test_model_outputs_equivalence(self):
   191 |         config, inputs_dict = self.model_tester.prepare_config_and_inputs_for_common()
   192 | 
   193 |         def check_equivalence(model, tuple_inputs, dict_inputs, additional_kwargs={}):
   194 |             with torch.no_grad():
   195 |                 tuple_output = model(**tuple_inputs, return_dict=False, **additional_kwargs)
   196 |                 dict_output = model(**dict_inputs, return_dict=True, **additional_kwargs).to_tuple()
   197 | 
   198 |                 def recursive_check(tuple_object, dict_object):
   199 |                     if isinstance(tuple_object, xLSTMCache):
   200 |                         recursive_check(tuple_object.rnn_state, dict_object.rnn_state)
   201 |                     elif isinstance(tuple_object, (list, tuple)):
   202 |                         for tuple_iterable_value, dict_iterable_value in zip(tuple_object, dict_object):
   203 |                             recursive_check(tuple_iterable_value, dict_iterable_value)
   204 |                     elif isinstance(tuple_object, dict):
   205 |                         for tuple_iterable_value, dict_iterable_value in zip(
   206 |                             tuple_object.values(), dict_object.values()
   207 |                         ):
   208 |                             recursive_check(tuple_iterable_value, dict_iterable_value)
   209 |                     elif tuple_object is None:
   210 |                         return
   211 |                     else:
   212 |                         self.assertTrue(
   213 |                             torch.allclose(tuple_object, dict_object, atol=1e-5),
   214 |                             msg=(
   215 |                                 "Tuple and dict output are not equal. Difference:"
   216 |                                 f" {torch.max(torch.abs(tuple_object - dict_object))}. Tuple has `nan`:"
   217 |                                 f" {torch.isnan(tuple_object).any()} and `inf`: {torch.isinf(tuple_object)}. Dict has"
   218 |                                 f" `nan`: {torch.isnan(dict_object).any()} and `inf`: {torch.isinf(dict_object)}."
   219 |                             ),
   220 |                         )
   221 | 
   222 |                 recursive_check(tuple_output, dict_output)
   223 | 
   224 |         for model_class in self.all_model_classes:
   225 |             model = model_class(config)
   226 |             model.to(torch_device)
   227 |             model.eval()
   228 | 
   229 |             tuple_inputs = self._prepare_for_class(inputs_dict, model_class)
   230 |             dict_inputs = self._prepare_for_class(inputs_dict, model_class)
   231 |             check_equivalence(model, tuple_inputs, dict_inputs)
   232 | 
   233 |             tuple_inputs = self._prepare_for_class(inputs_dict, model_class, return_labels=True)
   234 |             dict_inputs = self._prepare_for_class(inputs_dict, model_class, return_labels=True)
