  3468 | def _get_base_kwargs_class_from_name(cls_name: str) -> str | None:
  3469 |     """Map kwargs class name to base using naming conventions. Returns base class name or None."""
  3470 |     if cls_name in _BASIC_KWARGS_NAMES:
  3471 |         return cls_name
  3472 |     if "ImageProcessorKwargs" in cls_name or cls_name.endswith("ImagesKwargs"):
  3473 |         return "ImagesKwargs"
  3474 |     if "ProcessorKwargs" in cls_name:
  3475 |         return "ProcessingKwargs"
  3476 |     if "VideoProcessorKwargs" in cls_name or cls_name.endswith("VideosKwargs"):
  3477 |         return "VideosKwargs"
  3478 |     if "AudioProcessorKwargs" in cls_name or cls_name.endswith("AudioKwargs"):
  3479 |         return "AudioKwargs"
  3480 |     if "TextKwargs" in cls_name:
  3481 |         return "TextKwargs"
  3482 |     return None
