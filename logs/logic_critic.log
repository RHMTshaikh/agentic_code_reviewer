  4838 |         missing_patterns = self._keys_to_ignore_on_load_missing or set()
  4839 |         unexpected_patterns = (self._keys_to_ignore_on_load_unexpected or set()) | additional_unexpected_patterns
  4840 |         ignore_missing_regex, ignore_unexpected_regex = None, None
  4841 |         if len(missing_patterns) > 0:
  4842 |             ignore_missing_regex = re.compile("|".join(rf"({pattern})" for pattern in missing_patterns))
  4843 |         if len(unexpected_patterns) > 0:
  4844 |             ignore_unexpected_regex = re.compile("|".join(rf"({pattern})" for pattern in unexpected_patterns))
  4845 | 
  4846 |         # Clean-up missing keys
  4847 |         if ignore_missing_regex is not None:
  4848 |             loading_info.missing_keys = {
  4849 |                 key for key in loading_info.missing_keys if ignore_missing_regex.search(key) is None
  4850 |             }
  4851 | 
  4852 |         # Clean-up unexpected keys
  4853 |         if ignore_unexpected_regex is not None:
  4854 |             loading_info.unexpected_keys = {
  4855 |                 key for key in loading_info.unexpected_keys if ignore_unexpected_regex.search(key) is None
  4856 |             }
