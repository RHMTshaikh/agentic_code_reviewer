   455 |                 self.write_index_storage[i, : len(group_write_indices)] = to_index_tensor(group_write_indices)
   456 |                 self.true_write_sizes[i] = len(group_write_indices)
   457 |             if read_index is not None:
   458 |                 for i, group_read_indices in enumerate(read_index):
   459 |                     self.read_index_storage[i, : len(group_read_indices)] = to_index_tensor(group_read_indices)
   460 |                     self.true_read_sizes[i] = len(group_read_indices)
