  4510 |     @staticmethod
  4511 |     def _finalize_model_loading(
  4512 |         model, load_config: LoadStateDictConfig, loading_info: LoadStateDictInfo
  4513 |     ) -> LoadStateDictInfo:
  4514 |         """Perform all post processing operations after having loaded some checkpoints into a model, such as moving
  4515 |         missing keys from meta device to their expected device, reinitializing missing weights according to proper
  4516 |         distributions, tying the weights and logging the loading report."""
  4517 |         try:
  4518 |             # Marks tied weights as `_is_hf_initialized` to avoid initializing them (it's very important for efficiency)
  4519 |             model.mark_tied_weights_as_initialized(loading_info)
  4520 | 
  4521 |             # Move missing (and potentially mismatched) keys and non-persistent buffers back to their expected device from
  4522 |             # meta device (because they were not moved when loading the weights as they were not in the loaded state dict)
  4523 |             model._move_missing_keys_from_meta_to_device(
  4524 |                 loading_info.missing_and_mismatched(),
  4525 |                 load_config.device_map,
  4526 |                 load_config.device_mesh,
  4527 |                 load_config.hf_quantizer,
  4528 |             )
  4529 | 
  4530 |             # Correctly initialize the missing (and potentially mismatched) keys (all parameters without the `_is_hf_initialized` flag)
  4531 |             model._initialize_missing_keys(load_config.is_quantized)
  4532 | 
  4533 |             # Tie the weights
  4534 |             model.tie_weights(missing_keys=loading_info.missing_keys, recompute_mapping=False)
  4535 | 
  4536 |             # Adjust missing and unexpected keys
  4537 |             model._adjust_missing_and_unexpected_keys(loading_info)
  4538 |         finally:
  4539 |             log_state_dict_report(
  4540 |                 model=model,
  4541 |                 pretrained_model_name_or_path=load_config.pretrained_model_name_or_path,
  4542 |                 ignore_mismatched_sizes=load_config.ignore_mismatched_sizes,
  4543 |                 loading_info=loading_info,
  4544 |                 logger=logger,
  4545 |             )
  4546 | 
  4547 |         return loading_info
  4548 | 
  4549 |     def retrieve_modules_from_names(self, names, add_prefix=False, remove_prefix=False):
  4550 |         module_keys = {".".join(key.split(".")[:-1]) for key in names}
  4551 | 
  4552 |         # torch.nn.ParameterList is a special case where two parameter keywords
  4553 |         # are appended to the module name, *e.g.* bert.special_embeddings.0
  4554 |         module_keys = module_keys.union(
  4555 |             {".".join(key.split(".")[:-2]) for key in names if len(key) > 0 and key[-1].isdigit()}
  4556 |         )
  4557 | 
  4558 |         retrieved_modules = []
  4559 |         # retrieve all modules that has at least one missing weight name
  4560 |         for name, module in self.named_modules():
  4561 |             if remove_prefix:
  4562 |                 _prefix = f"{self.base_model_prefix}."
  4563 |                 name = name.removeprefix(_prefix)
  4564 |             elif add_prefix:
  4565 |                 name = ".".join([self.base_model_prefix, name]) if len(name) > 0 else self.base_model_prefix
  4566 | 
  4567 |             if name in module_keys:
  4568 |                 retrieved_modules.append(module)
  4569 | 
  4570 |         return retrieved_modules
  4571 | 
  4572 |     @classmethod
  4573 |     def register_for_auto_class(cls, auto_class="AutoModel"):
  4574 |         """
  4575 |         Register this class with a given auto class. This should only be used for custom models as the ones in the
  4576 |         library are already mapped with an auto class.
  4577 | 
  4578 | 
  4579 | 
  4580 |         Args:
  4581 |             auto_class (`str` or `type`, *optional*, defaults to `"AutoModel"`):
  4582 |                 The auto class to register this new model with.
  4583 |         """
  4584 |         if not isinstance(auto_class, str):
  4585 |             auto_class = auto_class.__name__
  4586 | 
  4587 |         import transformers.models.auto as auto_module
  4588 | 
  4589 |         if not hasattr(auto_module, auto_class):
  4590 |             raise ValueError(f"{auto_class} is not a valid auto class.")
  4591 | 
  4592 |         cls._auto_class = auto_class
  4593 | 
  4594 |     def warn_if_padding_and_no_attention_mask(self, input_ids, attention_mask):
  4595 |         """
  4596 |         Shows a one-time warning if the input_ids appear to contain padding and no attention mask was given.
  4597 |         """
  4598 | 
  4599 |         # Skip the check during tracing.
  4600 |         if is_tracing(input_ids):
  4601 |             return
  4602 | 
  4603 |         if (attention_mask is not None) or (self.config.pad_token_id is None):
  4604 |             return
  4605 | 
  4606 |         # Check only the first and last input IDs to reduce overhead.
  4607 |         if self.config.pad_token_id in input_ids[:, [-1, 0]]:
  4608 |             warn_string = (
  4609 |                 "We strongly recommend passing in an `attention_mask` since your input_ids may be padded. See "
  4610 |                 "https://huggingface.co/docs/transformers/troubleshooting"
  4611 |                 "#incorrect-output-when-padding-tokens-arent-masked."
  4612 |             )
  4613 | 
  4614 |             # If the pad token is equal to either BOS, EOS, or SEP, we do not know whether the user should use an
  4615 |             # attention_mask or not. In this case, we should still show a warning because this is a rare case.
  4616 |             # NOTE: `sep_token_id` is not used in all models and it can be absent in the config
  4617 |             sep_token_id = getattr(self.config, "sep_token_id", None)
  4618 |             if (
  4619 |                 (self.config.bos_token_id is not None and self.config.bos_token_id == self.config.pad_token_id)
  4620 |                 or (self.config.eos_token_id is not None and self.config.eos_token_id == self.config.pad_token_id)
  4621 |                 or (sep_token_id is not None and sep_token_id == self.config.pad_token_id)
  4622 |             ):
  4623 |                 warn_string += (
  4624 |                     f"\nYou may ignore this warning if your `pad_token_id` ({self.config.pad_token_id}) is identical "
  4625 |                     f"to the `bos_token_id` ({self.config.bos_token_id}), `eos_token_id` ({self.config.eos_token_id}), "
  4626 |                     f"or the `sep_token_id` ({sep_token_id}), and your input is not padded."
  4627 |                 )
  4628 | 
  4629 |             logger.warning_once(warn_string)
  4630 | 
  4631 |     @property
  4632 |     def supports_tp_plan(self):
  4633 |         """
  4634 |         Returns whether the model has a tensor parallelism plan.
  4635 |         """
  4636 |         # Check if model has a TP plan
  4637 |         if self._tp_plan:
  4638 |             return True
  4639 |         # Check if base model has a TP plan
  4640 |         if self.base_model._tp_plan:
  4641 |             return True
  4642 |         # Check if config has TP plan
  4643 |         if self.config.base_model_tp_plan:
  4644 |             return True
  4645 |         return False
  4646 | 
