   347 |     def free_blocks(self, request_id: str) -> None:
   348 |         """Free all allocated cache blocks for a given request across all layer groups. Actual deallocation is done
   349 |         by the cache managers."""
   350 |         for cm in self.group_cache_managers:
   351 |             cm.free_blocks(request_id, self._block_manager)
   352 | 
   353 |     def get_num_free_blocks(self) -> int:
   354 |         """Get the current number of unallocated blocks available for new requests."""
