   480 |             self.block_table[request_id] = []
   481 |         # Early return if we are already at the max number of blocks per request
   482 |         already_allocated = len(self.block_table[request_id])
   483 |         if already_allocated == self._max_blocks_per_request:
   484 |             return 0
   485 |         # Compute actual number of blocks to allocate
   486 |         after_allocation = min(already_allocated + n_blocks, self._max_blocks_per_request)
   487 |         actual_n_blocks = after_allocation - already_allocated
   488 |         # Classic allocation
   489 |         allocated_blocks = block_manager.get_free_blocks(
