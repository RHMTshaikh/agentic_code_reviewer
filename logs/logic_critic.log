   449 |     def validate_architecture(self):
   450 |         """Part of `@strict`-powered validation. Validates the architecture of the config."""
   451 |         if (
   452 |             hasattr(self, "head_dim")
   453 |             and hasattr(self, "num_heads")
   454 |             and hasattr(self, "embed_dim")
   455 |             and self.head_dim * self.num_heads != self.embed_dim
   456 |         ):
   457 |             raise ValueError(
   458 |                 f"The embed_dim ({self.embed_dim}) is not a multiple of the number of attention "
   459 |                 f"heads ({self.num_heads})."
   460 |             )
   461 | 
   462 |     def validate_token_ids(self):
   463 |         """Part of `@strict`-powered validation. Validates the contents of the special tokens."""
   464 |         text_config = self.get_text_config(decoder=True)
   465 |         vocab_size = getattr(text_config, "vocab_size", None)
   466 |         if vocab_size is not None:
   467 |             # Check for all special tokens, e..g. pad_token_id, image_token_id, audio_token_id
   468 |             for name in text_config:
   469 |                 value = getattr(text_config, name)
   470 |                 if name.endswith("_token_id") and isinstance(value, int) and not 0 <= value < vocab_size:
   471 |                     # Can't be an exception until we can load configs that fail validation: several configs on the Hub
   472 |                     # store invalid special tokens, e.g. `pad_token_id=-1`
   473 |                     logger.warning_once(
   474 |                         f"Model config: {name} must be `None` or an integer within the vocabulary (between 0 "
   475 |                         f"and {vocab_size - 1}), got {value}. This may result in unexpected behavior."
   476 |                     )
   477 | 
   478 |     def validate_layer_type(self):
   479 |         """Check that `layer_types` is correctly defined."""
   480 |         for layer_types in ["layer_types", "mlp_layer_types"]:
   481 |             layers = getattr(self, layer_types, None)
   482 |             if not (layers is not None and hasattr(self, "num_hidden_layers")):
   483 |                 return
   484 |             elif not all(layer_type in ALLOWED_LAYER_TYPES for layer_type in layers):
   485 |                 raise ValueError(f"The `{layer_types}` entries must be in {ALLOWED_LAYER_TYPES} but got {layers}")
   486 |             elif self.num_hidden_layers is not None and self.num_hidden_layers != len(layers):
   487 |                 raise ValueError(
   488 |                     f"`num_hidden_layers` ({self.num_hidden_layers}) must be equal to the number of `{layer_types}` "
   489 |                     f"({len(layers)})"
   490 |                 )
