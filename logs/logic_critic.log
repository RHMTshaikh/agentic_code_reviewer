  31 | def map_overlaps(forward_map):
  32 |     """
  33 |     Corrected check for overlapping folds.
  34 |     Checks if X reverses horizontally or Y reverses vertically.
  35 |     """
  36 |     # 1. Horizontal Check: Does X (index 0) reverse across columns?
  37 |     # We only care about forward_map[..., 0] here
  38 |     diff_h_x = np.diff(forward_map[:, :, 0], axis=1)
  39 |     has_pos_h = np.any(diff_h_x > 1e-6, axis=1)
  40 |     has_neg_h = np.any(diff_h_x < -1e-6, axis=1)
  41 |     row_overlaps_x = has_pos_h & has_neg_h
  42 | 
  43 |     # 2. Vertical Check: Does Y (index 1) reverse across rows?
  44 |     # We only care about forward_map[..., 1] here
  45 |     diff_v_y = np.diff(forward_map[:, :, 1], axis=0)
  46 |     has_pos_v = np.any(diff_v_y > 1e-6, axis=0)
  47 |     has_neg_v = np.any(diff_v_y < -1e-6, axis=0)
  48 |     col_overlaps_y = has_pos_v & has_neg_v
  49 | 
  50 |     # Only return True if the PRIMARY direction reverses
  51 |     return np.any(row_overlaps_x) or np.any(col_overlaps_y)


