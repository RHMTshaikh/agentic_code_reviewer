   194 |     def _apply_strided_shard(
   195 |         self, intervals: list[tuple[int, int]], rank: int, world_size: int, split_factor: int
   196 |     ) -> list[tuple[int, int]]:
   197 |         local_intervals = []
   198 | 
   199 |         for interval_start, interval_end in intervals:
   200 |             # For each interval, we break it into split_factor consecutive groups.
   201 |             group_width = math.ceil((interval_end - interval_start) / split_factor)
   202 | 
   203 |             for group_idx in range(split_factor):
   204 |                 # Compute this group's boundaries in source coordinates.
   205 |                 group_start = interval_start + group_idx * group_width
   206 |                 group_end = min(group_start + group_width, interval_end)
   207 |                 group_len = group_end - group_start
   208 | 
   209 |                 if group_len > 0:
   210 |                     # Inside each group, we do a normal contiguous shard across world_size ranks.
   211 |                     local_shard_size, local_shard_offset = Shard.local_shard_size_and_offset(
   212 |                         group_len, world_size, rank
   213 |                     )
   214 |                     if local_shard_size > 0:
   215 |                         # Convert group-local offset back to global source coordinates.
   216 |                         shard_start = group_start + local_shard_offset
   217 |                         local_intervals.append((shard_start, shard_start + local_shard_size))
   218 | 
   219 |         return local_intervals
   220 | 

