   377 |     @_attn_implementation.setter
   378 |     def _attn_implementation(self, value: str | dict | None):
   379 |         """We set it recursively on the sub-configs as well"""
   380 |         # Set if for current config
   381 |         current_attn = getattr(self, "_attn_implementation", None)
   382 |         attn_implementation = value if not isinstance(value, dict) else value.get("", current_attn)
   383 |         self._attn_implementation_internal = attn_implementation
   384 | 
   385 |         # Set it recursively on the subconfigs
   386 |         for subconfig_key in self.sub_configs:
   387 |             subconfig = getattr(self, subconfig_key, None)
   388 |             if subconfig is not None:
   389 |                 current_subconfig_attn = getattr(subconfig, "_attn_implementation", None)
   390 |                 sub_implementation = (
   391 |                     value if not isinstance(value, dict) else value.get(subconfig_key, current_subconfig_attn)
   392 |                 )
   393 |                 subconfig._attn_implementation = sub_implementation
   394 | 
   395 |     @property
