  2430 |         Symmetric setter. Mirrors the lookup logic used in `get_decoder`.
  2431 |         """
  2432 | 
  2433 |         possible_module_names = ["language_model", "text_model", "decoder"]
  2434 |         for name in possible_module_names:
  2435 |             if hasattr(self, name):
  2436 |                 setattr(self, name, decoder)
  2437 |                 return
  2438 | 
  2439 |         if self.base_model is not self:
  2440 |             if hasattr(self.base_model, "set_decoder"):
  2441 |                 self.base_model.set_decoder(decoder)
