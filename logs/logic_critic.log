   541 | def process_target_pattern(pattern: str) -> tuple[str, str | None]:
   542 |     """
   543 |     Process a target pattern for reverse mapping (when targets become sources).
   544 | 
   545 |     This handles several edge cases in checkpoint conversion mappings:
   546 |     - Removes `^` prefix and `$` suffix (start/end of string anchors)
   547 |     - Removes negative lookahead/lookbehind assertions
   548 |     - Detects capturing groups and replaces them with `\\1` backreference
   549 | 
   550 |     Args:
   551 |         pattern: The target pattern to process for reverse mapping.
   552 | 
   553 |     Returns:
   554 |         A tuple of (processed_pattern, captured_group) where captured_group is
   555 |         the original capturing group found (e.g., "(encoder|decoder)") or None.
   556 |     """
   557 |     # Some mapping contains `^` to notify start of string when matching -> remove it during reverse mapping
   558 |     pattern = pattern.removeprefix("^")
   559 |     # Some mapping contains `$` to notify end of string when matching -> remove it during reverse mapping
   560 |     pattern = pattern.removesuffix("$")
   561 |     # Remove negative lookahead/behind if any. This is ugly but needed for reverse mapping of
   562 |     # Qwen2.5, Sam3, Ernie4.5 VL MoE! It needs to be non greedy in case there are several
   563 |     pattern = re.sub(r"\(\?.+?\)?\)", "", pattern)
   564 |     # Remove the backslash for literal dots
   565 |     pattern = pattern.replace(r"\.", ".")
   566 |     # Allow capturing groups in patterns, i.e. to add/remove a prefix to all keys (e.g. timm_wrapper, sam3)
   567 |     capturing_group_match = re.search(r"\(.+?\)", pattern)
   568 |     captured_group = None
   569 |     if capturing_group_match:
   570 |         captured_group = capturing_group_match.group(0)
   571 |         pattern = pattern.replace(captured_group, r"\1", 1)
   572 |     return pattern, captured_group
   573 | 

