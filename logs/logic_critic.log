   361 |         self.post_attention_layernorm = MiniCPM3RMSNorm(config.hidden_size, eps=config.rms_norm_eps)
   362 |         # MiniCPM3 multiplies each residual branch by `scale_depth / sqrt(num_hidden_layers)`
   363 |         # (Llama adds the branch directly). Precompute the constant once instead of per forward.
   364 |         self.residual_scale = config.scale_depth / math.sqrt(config.num_hidden_layers)
   365 | 
   366 |     def forward(
   367 |         self,
   368 |         hidden_states: torch.Tensor,
   369 |         attention_mask: torch.Tensor | None = None,
   370 |         position_ids: torch.LongTensor | None = None,
   371 |         past_key_values: Cache | None = None,
   372 |         use_cache: bool | None = False,
   373 |         position_embeddings: tuple[torch.Tensor, torch.Tensor] | None = None,
   374 |         **kwargs: Unpack[TransformersKwargs],
   375 |     ) -> torch.Tensor:
   376 |         residual = hidden_states
   377 |         hidden_states = self.input_layernorm(hidden_states)
   378 |         hidden_states, _ = self.self_attn(
   379 |             hidden_states=hidden_states,
   380 |             attention_mask=attention_mask,
   381 |             position_ids=position_ids,
   382 |             past_key_values=past_key_values,
   383 |             use_cache=use_cache,
   384 |             position_embeddings=position_embeddings,
   385 |             **kwargs,
   386 |         )
   387 |         hidden_states = residual + hidden_states * self.residual_scale
   388 | 
   389 |         residual = hidden_states
   390 |         hidden_states = self.post_attention_layernorm(hidden_states)
   391 |         hidden_states = self.mlp(hidden_states)
   392 |         hidden_states = residual + hidden_states * self.residual_scale
   393 |         return hidden_states
