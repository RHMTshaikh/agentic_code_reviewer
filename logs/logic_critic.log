  2886 |             clean_up_tokenization_spaces = kwargs.pop("clean_up_tokenization_spaces", False)
  2887 |             return [
  2888 |                 self._decode(
  2889 |                     token_ids=seq,
  2890 |                     skip_special_tokens=skip_special_tokens,
  2891 |                     clean_up_tokenization_spaces=clean_up_tokenization_spaces,
  2892 |                     **kwargs,
  2893 |                 )
  2894 |                 for seq in token_ids
  2895 |             ]
  2896 | 
  2897 |         return self._decode(
  2898 |             token_ids=token_ids,
  2899 |             skip_special_tokens=skip_special_tokens,
  2900 |             **kwargs,
  2901 |         )
