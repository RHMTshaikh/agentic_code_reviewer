  2640 |             self,
  2641 |             input_ids,
  2642 |             logits_processor=prepared_logits_processor,
  2643 |             stopping_criteria=prepared_stopping_criteria,
  2644 |             generation_config=generation_config,
  2645 |             **generation_mode_kwargs,
  2646 |             **model_kwargs,
  2647 |         )
