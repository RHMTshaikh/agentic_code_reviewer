   157 |         # if this rank owns expert `tensor_idx` along axis 0, we need to slice the inner dimensions, else we drop it
   158 |         has_axis0_shard = any(param_dim == 0 for _, _, param_dim in normalized_dim_placements)
   159 |         owns_tensor_idx = self._axis0_offset <= tensor_idx < self._axis0_offset + self._axis0_local_size
