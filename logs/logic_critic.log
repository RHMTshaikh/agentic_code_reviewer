 179 | def overlay_image_on_background(image: np.ndarray, background_image: np.ndarray):
 180 |     assert image.shape[2] == 4, "Image must have an alpha channel"
 181 |     
 182 |     background_image: np.ndarray = add_alpha_channel(background_image)
 183 |     
 184 |     # Resize background image to match the size of the input image
 185 |     background_image: np.ndarray = outer_fit(background_image, image.shape[0], image.shape[1])
 186 |     background_image: np.ndarray = crop_to_size_at_center(background_image, image.shape[0], image.shape[1])
 187 |     
 188 |     # Create a mask where the image is not transparent
 189 |     alpha_channel: np.ndarray = image[:, :, 3] / 255.0
 190 |     alpha_mask: np.ndarray = alpha_channel[:, :, np.newaxis]
 191 |     
 192 |     # Blend the image with the background using the alpha mask
 193 |     blended_image: np.ndarray = (image[:, :, :3] * alpha_mask + background_image[:, :, :3] * (1 - alpha_mask)).astype(image.dtype)
 194 |     
 195 |     # Combine blended RGB with full alpha channel
 196 |     final_image: np.ndarray = np.dstack((blended_image, np.full(image.shape[:2], 255, dtype=image.dtype)))
 197 |     
 198 |     return final_image


