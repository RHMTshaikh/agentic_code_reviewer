   303 |                 *base_slices_tuple[concat_dim + 1 :],
   304 |             )
   305 |             interval_tensors.append(source[interval_slices])
   306 | 
   307 |         return torch.cat(interval_tensors, dim=concat_dim).to(device=device, dtype=dtype)
