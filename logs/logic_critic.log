   649 |         current_token = torch.argmax(result[:, -1, :], dim=-1).item()
   650 |         response_tokens.append(current_token)
   651 | 
   652 |         while len(response_tokens) < max_generation_length:
   653 |             result = exported_program.module().forward(
   654 |                 input_ids=torch.tensor([[current_token]], dtype=torch.long, device=device),
   655 |                 cache_position=torch.tensor([len(response_tokens)], dtype=torch.long, device=device),
   656 |             )
   657 |             current_token = torch.argmax(result[:, -1, :], dim=-1).item()
   658 |             response_tokens.append(current_token)
