  2915 | def _get_model_info(func, parent_class):
  2916 |     """
  2917 |     Extract model information from a function or its parent class.
  2918 | 
  2919 |     Args:
  2920 |         func (`function`): The function to extract information from
  2921 |         parent_class (`class`): Optional parent class of the function
  2922 |     """
  2923 |     # import here to avoid circular import
  2924 |     from transformers.models import auto as auto_module
  2925 | 
  2926 |     # Get model name from either parent class or function
  2927 |     if parent_class is not None:
  2928 |         model_name_lowercase = get_model_name(parent_class)
  2929 |     else:
  2930 |         model_name_lowercase = get_model_name(func)
  2931 | 
  2932 |     # Normalize model name if needed
  2933 |     if model_name_lowercase and model_name_lowercase not in getattr(
  2934 |         getattr(auto_module, PLACEHOLDER_TO_AUTO_MODULE["config_class"][0]),
  2935 |         PLACEHOLDER_TO_AUTO_MODULE["config_class"][1],
  2936 |     ):
  2937 |         model_name_lowercase = model_name_lowercase.replace("_", "-")
  2938 | 
  2939 |     # Get class name from function's qualified name
  2940 |     class_name = func.__qualname__.split(".")[0]
  2941 | 
  2942 |     # Get config class for the model
  2943 |     if model_name_lowercase is None:
  2944 |         config_class = None
  2945 |     else:
  2946 |         try:
  2947 |             config_class = getattr(
  2948 |                 getattr(auto_module, PLACEHOLDER_TO_AUTO_MODULE["config_class"][0]),
  2949 |                 PLACEHOLDER_TO_AUTO_MODULE["config_class"][1],
  2950 |             )[model_name_lowercase]
  2951 |         except KeyError:
  2952 |             if model_name_lowercase in HARDCODED_CONFIG_FOR_MODELS:
  2953 |                 config_class = HARDCODED_CONFIG_FOR_MODELS[model_name_lowercase]
  2954 |             else:
  2955 |                 config_class = "ModelConfig"
  2956 |                 print(
  2957 |                     f"[ERROR] Config not found for {model_name_lowercase}. You can manually add it to HARDCODED_CONFIG_FOR_MODELS in utils/auto_docstring.py"
  2958 |                 )
  2959 |     return model_name_lowercase, class_name, config_class
