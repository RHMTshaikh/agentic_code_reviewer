   321 |     def test_model_outputs_equivalence(self):
   322 |         config, inputs_dict = self.model_tester.prepare_config_and_inputs_for_common()
   323 | 
   324 |         def check_equivalence(model, tuple_inputs, dict_inputs, additional_kwargs={}):
   325 |             with torch.no_grad():
   326 |                 tuple_output = model(**tuple_inputs, return_dict=False, **additional_kwargs)
   327 |                 dict_output = model(**dict_inputs, return_dict=True, **additional_kwargs).to_tuple()
   328 | 
   329 |                 def recursive_check(tuple_object, dict_object):
   330 |                     if isinstance(tuple_object, DynamicCache):  # MODIFIED PART START
   331 |                         for idx in range(len(tuple_object)):
   332 |                             recursive_check(tuple_object.layers[idx].conv_states, dict_object.layers[idx].conv_states)
   333 |                             recursive_check(
   334 |                                 tuple_object.layers[idx].recurrent_states, dict_object.layers[idx].recurrent_states
   335 |                             )
   336 |                     elif isinstance(tuple_object, (list, tuple)):  # MODIFIED PART END
   337 |                         for tuple_iterable_value, dict_iterable_value in zip(tuple_object, dict_object):
   338 |                             recursive_check(tuple_iterable_value, dict_iterable_value)
   339 |                     elif isinstance(tuple_object, dict):
   340 |                         for tuple_iterable_value, dict_iterable_value in zip(
   341 |                             tuple_object.values(), dict_object.values()
   342 |                         ):
   343 |                             recursive_check(tuple_iterable_value, dict_iterable_value)
   344 |                     elif tuple_object is None:
   345 |                         return
   346 |                     else:
   347 |                         self.assertTrue(
   348 |                             torch.allclose(tuple_object, dict_object, atol=1e-5),
   349 |                             msg=(
   350 |                                 "Tuple and dict output are not equal. Difference:"
   351 |                                 f" {torch.max(torch.abs(tuple_object - dict_object))}. Tuple has `nan`:"
   352 |                                 f" {torch.isnan(tuple_object).any()} and `inf`: {torch.isinf(tuple_object)}. Dict has"
   353 |                                 f" `nan`: {torch.isnan(dict_object).any()} and `inf`: {torch.isinf(dict_object)}."
   354 |                             ),
   355 |                         )
   356 | 
   357 |                 recursive_check(tuple_output, dict_output)
   358 | 
   359 |         for model_class in self.all_model_classes:
   360 |             model = model_class(config)
   361 |             model.to(torch_device)
   362 |             model.eval()
   363 | 
   364 |             tuple_inputs = self._prepare_for_class(inputs_dict, model_class)
   365 |             dict_inputs = self._prepare_for_class(inputs_dict, model_class)
   366 |             check_equivalence(model, tuple_inputs, dict_inputs)
   367 | 
   368 |             tuple_inputs = self._prepare_for_class(inputs_dict, model_class, return_labels=True)
   369 |             dict_inputs = self._prepare_for_class(inputs_dict, model_class, return_labels=True)
   370 |             check_equivalence(model, tuple_inputs, dict_inputs)
   371 | 
   372 |             tuple_inputs = self._prepare_for_class(inputs_dict, model_class)
   373 |             dict_inputs = self._prepare_for_class(inputs_dict, model_class)
   374 |             check_equivalence(model, tuple_inputs, dict_inputs, {"output_hidden_states": True})
   375 | 
   376 |             tuple_inputs = self._prepare_for_class(inputs_dict, model_class, return_labels=True)
   377 |             dict_inputs = self._prepare_for_class(inputs_dict, model_class, return_labels=True)
