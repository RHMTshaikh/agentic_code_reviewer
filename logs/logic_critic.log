   953 |     def to_diff_dict(self) -> dict[str, Any]:
   954 |         """
   955 |         Removes all attributes from the configuration that correspond to the default config attributes for
   956 |         better readability, while always retaining the `config` attribute from the class. Serializes to a
   957 |         Python dictionary.
   958 | 
   959 |         Returns:
   960 |             dict[str, Any]: Dictionary of all the attributes that make up this configuration instance.
   961 |         """
   962 |         config_dict = self.to_dict()
   963 | 
   964 |         # Get the default config dict (from a fresh PreTrainedConfig instance)
   965 |         default_config_dict = PreTrainedConfig().to_dict()
   966 | 
   967 |         # get class specific config dict
   968 |         class_config_dict = self.__class__().to_dict() if not self.has_no_defaults_at_init else {}
   969 | 
   970 |         serializable_config_dict = {}
   971 | 
   972 |         # Only serialize values that differ from the default config,
   973 |         # except always keep the 'config' attribute.
   974 |         for key, value in config_dict.items():
   975 |             if (
   976 |                 isinstance(getattr(self, key, None), PreTrainedConfig)
   977 |                 and key in class_config_dict
   978 |                 and isinstance(class_config_dict[key], dict)
   979 |             ):
   980 |                 # For nested configs we need to clean the diff recursively
   981 |                 diff = recursive_diff_dict(value, default_config_dict, config_obj=getattr(self, key, None))
   982 |                 if "model_type" in value:
   983 |                     # Needs to be set even if it's not in the diff
   984 |                     diff["model_type"] = value["model_type"]
   985 | 
   986 |                 serializable_config_dict[key] = diff
   987 |             elif (
   988 |                 key not in default_config_dict
   989 |                 or key == "transformers_version"
   990 |                 or key == "vocab_file"
   991 |                 or value != default_config_dict[key]
   992 |                 or (key in default_config_dict and value != class_config_dict.get(key, value))
   993 |             ):
   994 |                 serializable_config_dict[key] = value
   995 | 
   996 |         self._remove_keys_not_serialized(serializable_config_dict)
   997 | 
   998 |         # Key removed only in diff dict
   999 |         if "_name_or_path" in serializable_config_dict:
  1000 |             del serializable_config_dict["_name_or_path"]
  1001 | 
  1002 |         if hasattr(self, "quantization_config"):
  1003 |             serializable_config_dict["quantization_config"] = (
  1004 |                 self.quantization_config.to_dict()
  1005 |                 if not isinstance(self.quantization_config, dict) and self.quantization_config is not None
  1006 |                 else self.quantization_config
  1007 |             )
  1008 |         self.dict_dtype_to_str(serializable_config_dict)
  1009 | 
  1010 |         return serializable_config_dict
