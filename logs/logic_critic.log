    37 | class DtensorShardOperation:
    38 |     """Shard-on-read: slice a full checkpoint tensor down to this rank's local
    39 |     DTensor shard, for any combination of placements on a 1-D or n-D mesh.
    40 | 
    41 |     Placements primer
    42 |     -----------------
    43 |     Each mesh dim carries one placement describing how it slices the tensor:
    44 | 
    45 |     | Placement                | Local data on each rank of the mesh dim         |
    46 |     |--------------------------|-------------------------------------------------|
    47 |     | Replicate                | full tensor (no slicing)                        |
    48 |     | Shard(d)                 | contiguous chunk of dim d (rows r*c .. (r+1)*c) |
    49 |     | _StridedShard(d, sf=N)   | one chunk from each of N groups along dim d,   |
    50 |     |                          | concatenated together (interleaved layout)      |
    51 | 
    52 |     Different scenarios of different placements
    53 |     ------------------------------------------
    54 |     Placement tuples are ordered outermost-first; for a 2-D (fsdp, tp) mesh
    55 |     the tuple is (fsdp_placement, tp_placement).
    56 | 
    57 |     | Scenario                                          | Placements                            |
    58 |     |---------------------------------------------------|---------------------------------------|
    59 |     | TP-only, non-fused (e.g. q_proj/k_proj/v_proj)    | [Shard(d)]                            |
    60 |     | TP-only, fused gate/up                            | [_StridedShard(d, sf=2)]              |
    61 |     | TP + FSDP, same tensor dim                        | [_StridedShard(d, sf=tp_size), Shard(d)] |
    62 |     | TP + FSDP, different dims                         | [Shard(d1), Shard(d2)]                |
    63 | 
    64 |     Mesh dimensions are listed outermost-first. For a 2-D (fsdp=F, tp=T) mesh,
    65 |     rank index = fsdp_idx * T + tp_idx.
    66 | 
    67 |     Loading (this class)
    68 |     --------------------
    69 |     During `from_pretrained`, each rank reads the full checkpoint tensors,
    70 |     then calls `shard_tensor(source, tensor_idx=...)` to keep only its local
    71 |     DTensor shard. The class encapsulates the placements + mesh so the
    72 |     slicing logic doesn't have to be repeated at every call site.
    73 | 
    74 |     Two checkpoint layouts are supported. Running example: an MoE weight
    75 |     stack of param shape [N_experts, in, out]:
    76 | 
    77 |     | Checkpoint layout                  | tensor_idx | source.shape  | Returns                     |
    78 |     |------------------------------------|------------|---------------|-----------------------------|
    79 |     | One stacked tensor                 | None       | [N, in, out]  | This rank's slice along     |
    80 |     |                                    |            |               | every sharded dim.          |
    81 |     | N per-expert tensors (called once  | 0..N-1     | [in, out]     | Inner-dim slice if this     |
    82 |     | per expert by the caller)          |            |               | rank owns expert `i`,       |
    83 |     |                                    |            |               | else None (caller drops it).|
    84 |     """
    85 | 
    86 |     def __init__(self, param: DTensor):
    87 |         self.device_mesh = param.device_mesh
    88 |         self.placements = tuple(param.placements)
    89 |         self.param_ndim = param.ndim
    90 |         local_shape, offsets = compute_local_shape_and_global_offset(param.shape, self.device_mesh, self.placements)
    91 |         # Where this rank's slice starts along axis 0, and how many indices
    92 |         # it covers. Example: param of shape [8, in, out] with Shard(0) on
    93 |         # 2 ranks gives:
    94 |         #   rank 0 → _axis0_offset=0, _axis0_local_size=4  (owns experts 0..3)
    95 |         #   rank 1 → _axis0_offset=4, _axis0_local_size=4  (owns experts 4..7)
    96 |         # When the checkpoint stores one tensor per expert, shard_tensor
    97 |         # checks whether tensor_idx falls in this rank's range to decide
    98 |         # whether to keep the piece or drop it.
    99 |         self._axis0_offset = offsets[0]
   100 |         self._axis0_local_size = local_shape[0]
   101 | 
   102 |     def shard_tensor(
   103 |         self, source: torch.Tensor, tensor_idx: int | None = None, device=None, dtype=None
   104 |     ) -> torch.Tensor | None:
   105 |         """Slice source down to this rank's shard.
   106 | 
   107 |         The checkpoint can store the parameter in two layouts. Take a stack
   108 |         of N MoE experts of shape [in, out] as a running example — the
   109 |         param shape is [N, in, out]:
   110 | 
   111 |         - Single tensor (tensor_idx is None): the checkpoint holds one
   112 |           [N, in, out] tensor, so source.shape == param.shape. Every
   113 |           sharded dim is sliced here, including axis 0.
   114 | 
   115 |         - One tensor per piece (tensor_idx given): the checkpoint holds N
   116 |           separate [in, out] tensors, one per expert. shard_tensor is
   117 |           called once per expert; on each call source is the [in, out]
   118 |           tensor for expert number tensor_idx (so 0 <= tensor_idx < N).
   119 |           Note: source has one fewer dim than the param: the axis-0
   120 |           index lives in tensor_idx, not in source.shape.
   121 |           If this rank does not own tensor_idx along axis 0, return None
   122 |           and the piece is discarded. Otherwise slice only the inner
   123 |           dims; the caller (MergeModulelist / Concatenate) collects the
   124 |           kept pieces and stacks them back along axis 0 to rebuild the
   125 |           full [N, in, out] param.
   126 |         """
   127 |         source_shape = list(source.shape) if isinstance(source, torch.Tensor) else source.get_shape()
   128 |         placements = [(md, p) for md, p in enumerate(self.placements) if hasattr(p, "dim")]
   129 | 
   130 |         # Dense path
   131 |         if tensor_idx is None:
   132 |             if not placements:
   133 |                 return source[...].to(device=device, dtype=dtype)
   134 |             has_strided = any(not p.is_shard() for _, p in placements)
   135 |             intervals = [[(0, size)] for size in source_shape]
   136 |             for mesh_dim, placement in placements:  # [i.e: (0, Shard(0)), (1, Shard(-1))]
   137 |                 sub_mesh = self._get_sub_mesh(mesh_dim)
   138 |                 rank, world_size = sub_mesh.get_local_rank(), sub_mesh.size()
   139 |                 source_dim = self._norm_dim(placement.dim)
   140 |                 if not placement.is_shard():
   141 |                     intervals[source_dim] = self._strided_intervals(
   142 |                         intervals[source_dim], rank, world_size, placement.split_factor
   143 |                     )
   144 |                 else:
   145 |                     intervals[source_dim] = self._contiguous_intervals(intervals[source_dim], rank, world_size)
   146 |             # Only _StridedShard can produce multi-interval dims that need cat.
   147 |             if has_strided:
   148 |                 return self._slice_and_cat(source, intervals, device, dtype)
   149 |             slices = tuple(slice(*(pieces[0] if pieces else (0, 0))) for pieces in intervals)
   150 |             return source[slices].to(device=device, dtype=dtype)
   151 | 
   152 |         # MoE path: drop the piece if this rank does not own tensor_idx
   153 |         # along axis 0. Once shard_tensor has been called for all N pieces,
   154 |         # the caller (MergeModulelist) stacks the kept slices along axis 0 to
   155 |         # form this rank's local shard of the param.
   156 |         shards_leading_axis = any(self._norm_dim(p.dim) == 0 for _, p in placements)
   157 |         owns_index = self._axis0_offset <= tensor_idx < self._axis0_offset + self._axis0_local_size
   158 |         if shards_leading_axis and not owns_index:
   159 |             return None
   160 | 
   161 |         # Inner dims use only _contiguous_intervals (one piece per dim), so a
   162 |         # single slice suffices
   163 |         inner_placements = [(md, p) for md, p in placements if self._norm_dim(p.dim) != 0]
   164 |         if not inner_placements:
   165 |             return source[...].to(device=device, dtype=dtype)
   166 |         slice_per_dim: list[tuple[int, int]] = [(0, size) for size in source_shape]
   167 |         # placement.dim is indexed in param space (e.g. axis 2 of [N, in, out]).
   168 |         # source is in source space (e.g. axis 1 of [in, out]), so we translate
   169 |         # from one to the other by stripping the leading axis.
   170 |         for mesh_dim, placement in inner_placements:
   171 |             sub_mesh = self._get_sub_mesh(mesh_dim)
   172 |             rank, world_size = sub_mesh.get_local_rank(), sub_mesh.size()
   173 |             param_dim = self._norm_dim(placement.dim)
   174 |             source_dim = param_dim - 1
   175 |             pieces = self._contiguous_intervals([slice_per_dim[source_dim]], rank, world_size)
   176 |             slice_per_dim[source_dim] = pieces[0] if pieces else (0, 0)
   177 |         return source[tuple(slice(s, e) for s, e in slice_per_dim)].to(device=device, dtype=dtype)
   178 | 
   179 |     def _strided_intervals(
   180 |         self, intervals: list[tuple[int, int]], rank: int, world_size: int, split_factor: int
   181 |     ) -> list[tuple[int, int]]:
   182 |         narrowed = []
   183 |         for start, end in intervals:
   184 |             group_size = math.ceil((end - start) / split_factor)
   185 |             for group_idx in range(split_factor):
   186 |                 group_start = start + group_idx * group_size
   187 |                 group_end = min(group_start + group_size, end)
   188 |                 if group_end <= group_start:
   189 |                     continue
   190 |                 size, offset = Shard.local_shard_size_and_offset(group_end - group_start, world_size, rank)
   191 |                 if size > 0:
   192 |                     narrowed.append((group_start + offset, group_start + offset + size))
   193 |         return narrowed
   194 | 
   195 |     def _contiguous_intervals(
   196 |         self, intervals: list[tuple[int, int]], rank: int, world_size: int
   197 |     ) -> list[tuple[int, int]]:
   198 |         total = sum(end - start for start, end in intervals)
   199 |         my_size, my_offset = Shard.local_shard_size_and_offset(total, world_size, rank)
   200 |         if my_size == 0:
   201 |             return []
   202 | 
   203 |         out: list[tuple[int, int]] = []
   204 |         flat_pos = 0
   205 |         slice_end = my_offset + my_size
   206 |         for start, end in intervals:
   207 |             length = end - start
   208 |             interval_end_flat = flat_pos + length
   209 |             if interval_end_flat <= my_offset:  # entirely before my slice
   210 |                 flat_pos = interval_end_flat
   211 |                 continue
   212 |             if flat_pos >= slice_end:  # entirely after my slice
   213 |                 break
   214 |             sub_start = max(0, my_offset - flat_pos)
   215 |             sub_end = min(length, slice_end - flat_pos)
   216 |             out.append((start + sub_start, start + sub_end))
   217 |             flat_pos = interval_end_flat
   218 |         return out
   219 | 
   220 |     def _slice_and_cat(self, source, intervals, device, dtype):
   221 |         multi_interval_dim: int | None = None
   222 |         slices: list[slice] = []
   223 |         for source_dim, pieces in enumerate(intervals):
   224 |             if len(pieces) == 1:
   225 |                 start, end = pieces[0]
   226 |                 slices.append(slice(start, end))
   227 |                 continue
   228 |             if multi_interval_dim is not None:
   229 |                 raise ValueError("Shard-on-read only supports disjoint ranges on a single checkpoint dimension.")
   230 |             multi_interval_dim = source_dim
   231 |             slices.append(slice(None))  # placeholder, filled per-piece below
   232 | 
   233 |         # Fast path: every dim is one contiguous interval, read in a single slice.
   234 |         if multi_interval_dim is None:
   235 |             return source[tuple(slices)].to(device=device, dtype=dtype)
   236 | 
   237 |         # Multi-interval dim: read each piece separately, then concatenate.
   238 |         pieces_read = []
   239 |         for start, end in intervals[multi_interval_dim]:
   240 |             piece_slices = list(slices)
   241 |             piece_slices[multi_interval_dim] = slice(start, end)
   242 |             pieces_read.append(source[tuple(piece_slices)])
   243 |         return torch.cat(pieces_read, dim=multi_interval_dim).to(device=device, dtype=dtype)
   244 | 
   245 |     def _get_sub_mesh(self, mesh_dim: int):
   246 |         if self.device_mesh.ndim == 1:
   247 |             return self.device_mesh
   248 |         return self.device_mesh[self.device_mesh.mesh_dim_names[mesh_dim]]
   249 | 
   250 |     def _norm_dim(self, dim: int) -> int:
   251 |         # if dim is negative, it should be normalized to the last axis
   252 |         return dim if dim >= 0 else self.param_ndim + dim
   253 | 

