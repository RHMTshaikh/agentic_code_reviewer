   251 |         q_len = self.write_index_storage.size(-1) if full_reset else self.num_q_tokens
   252 |         kv_len = self.read_index_storage.size(-1) if full_reset else self.max_kv_read
   253 |         b_size = self.max_requests_per_batch + 1 if full_reset else min(self.num_q_tokens, self.max_requests_per_batch)
   254 | 
   255 |         # Reset the attributes part of the bulk input tensor in one kernel
   256 |         self._bulk_input_tensor[: self.static_inputs, : q_len + 1].zero_()
   257 |         if full_reset:
   258 |             self._bulk_input_tensor[self.static_inputs :] = self.logits_processors_defaults
   259 |         self.max_seqlen_q = 0
   260 | 
   261 |         # Reset the logits indices and output ids
   262 |         self.logits_indices[:b_size].zero_()
   263 |         self.output_ids[:, :b_size].zero_()
   264 | 
   265 |         # Reset the attributes that are either tensors or dict of tensors
   266 |         for layer_type in self.cumulative_seqlens_k:
   267 |             self.max_seqlen_k[layer_type] = 0
   268 |             self.total_seqlen_k[layer_type] = 0
