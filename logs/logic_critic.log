   279 |             raise ValueError("Current shard-on-read only supports disjoint ranges on a single checkpoint dimension.")
   280 |         concat_dim = multi_interval_dims[0] if multi_interval_dims else None
   281 | 
   282 |         base_slices = []
   283 |         for dim_idx, dim_intervals in enumerate(intervals):
   284 |             if dim_idx == concat_dim:
   285 |                 # Disconnected intervals on this dim — placeholder; filled per interval below.
   286 |                 base_slices.append(slice(None))
   287 |             else:
   288 |                 # Single contiguous slice on this dim.
   289 |                 start, end = dim_intervals[0]
   290 |                 base_slices.append(slice(start, end))
   291 | 
   292 |         # Fast path: every dim is one contiguous interval, read in a single slice.
   293 |         if concat_dim is None:
   294 |             return source[tuple(base_slices)].to(device=device, dtype=dtype)
   295 | 
   296 |         # Multi-interval dim: keep base slices fixed and vary concat_dim only.
   297 |         base_slices_tuple = tuple(base_slices)
   298 |         interval_tensors = []
   299 |         for interval_start, interval_end in intervals[concat_dim]:
   300 |             interval_slices = (
   301 |                 *base_slices_tuple[:concat_dim],
   302 |                 slice(interval_start, interval_end),
   303 |                 *base_slices_tuple[concat_dim + 1 :],
   304 |             )
   305 |             interval_tensors.append(source[interval_slices])
   306 | 
   307 |         return torch.cat(interval_tensors, dim=concat_dim).to(device=device, dtype=dtype)
