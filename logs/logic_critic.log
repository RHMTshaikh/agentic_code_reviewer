  56 | def generate_non_intersecting_lines_by_random_point(height, width, n) -> list[Line_3D]:
  57 |     lines = []
  58 |     attempts = 0
  59 |     max_attempts = n * 10  # Prevent infinite loops
  60 |     rect = Rect_2D(0, 0, width - 1, height - 1)
  61 |     
  62 |     while True:
  63 | 
  64 |         while len(lines) < n and attempts < max_attempts:
  65 |             point_on_plane = get_random_point_in_plane(height, width)
  66 |             vector_on_plane = random_2d_unit_vector()
  67 |             line = line_by_point_and_direction(point1=(*point_on_plane, 0), direction=(*vector_on_plane, 0))
  68 |             # line.set_boundary_points(rect) # dont use it because it will shift values to float, we want to keep them as int for mask indexing
  69 | 
  70 |             intersects = False
  71 |             for existing_line in lines:
  72 |                 if rect.lines_intersects_in_rect(line, existing_line):
  73 |                     intersects = True
  74 |                     break
  75 |                 
  76 |             if not intersects:
  77 |                 lines.append(line)
  78 | 
  79 |             attempts += 1
  80 |             
  81 |         if len(lines) < n:
  82 |             lines = []
  83 |             attempts = 0
  84 |         else:
  85 |             break
  86 | 
  87 |     return lines



