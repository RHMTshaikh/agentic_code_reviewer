   479 |             # Prefix sharing is only supported when there is only one full attention layer group, so group_id=0.
   480 |             current_hash = self._block_manager.compute_hash(current_hash, tokens, group_id=0)
   481 |             block_id = self._block_manager._hash_to_id.get(current_hash)
   482 |             if block_id is not None:
   483 |                 allocated_blocks.append(block_id)
   484 |                 self._block_manager.increase_ref_count(block_id)
   485 |             else:
   486 |                 break
   487 |         # If we found a matching prefix, we reference the blocks in the request
   488 |         if allocated_blocks:
   489 |             logger.debug(f"Found prefix match for request {request_id} with {len(allocated_blocks)} blocks")
   490 |             cm = self.group_cache_managers[0]
   491 |             cm.block_table[request_id] = allocated_blocks
