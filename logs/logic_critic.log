  2288 |     def enable_input_require_grads(self):
  2289 |         """
  2290 |         Enables the gradients for the input embeddings. This is useful for fine-tuning adapter weights while keeping
  2291 |         the model weights fixed.
  2292 |         """
  2293 | 
  2294 |         def make_inputs_require_grads(module, input, output):
  2295 |             output.requires_grad_(True)
  2296 | 
  2297 |         hooks = []
  2298 |         seen_modules = set()
  2299 |         found_embeddings = False
  2300 | 
  2301 |         for module in self.modules():
  2302 |             if not (isinstance(module, PreTrainedModel) and hasattr(module, "get_input_embeddings")):
  2303 |                 continue
  2304 | 
  2305 |             try:
  2306 |                 input_embeddings = module.get_input_embeddings()
  2307 |             except NotImplementedError:
  2308 |                 continue
  2309 | 
  2310 |             if input_embeddings is None or not hasattr(input_embeddings, "register_forward_hook"):
  2311 |                 continue
  2312 | 
  2313 |             embedding_id = id(input_embeddings)
  2314 |             if embedding_id in seen_modules:
  2315 |                 continue
  2316 | 
  2317 |             seen_modules.add(embedding_id)
  2318 |             hooks.append(input_embeddings.register_forward_hook(make_inputs_require_grads))
  2319 |             found_embeddings = True
  2320 | 
  2321 |         self._require_grads_hooks = hooks
  2322 |         if hooks:
  2323 |             # for BC
  2324 |             self._require_grads_hook = hooks[0]
  2325 |         if not found_embeddings:
  2326 |             logger.warning_once(
  2327 |                 f"{self.__class__.__name__} does not expose input embeddings. Gradients cannot flow back to the token "
  2328 |                 "embeddings when using adapters or gradient checkpointing. Override `get_input_embeddings` to fully "
  2329 |                 "support those features, or set `_input_embed_layer` to the attribute name that holds the embeddings."
  2330 |             )
  2331 | 
  2332 |     def disable_input_require_grads(self):
