  4706 |     def _default_compile_config(self) -> CompileConfig:
  4707 |         """Build the default `CompileConfig` for `get_compiled_call`.
  4708 | 
  4709 |         Inductor + `reduce-overhead` (the `CompileConfig` defaults) target CUDA.
  4710 |         torch_tpu registers its own TorchDynamo backend named `"tpu"`; route
  4711 |         `device.type == "tpu"` through it with static shapes to match the
  4712 |         common StaticCache + fixed-prefill usage."""
  4713 |         if self.device.type == "tpu":
  4714 |             return CompileConfig(backend="tpu", dynamic=False, mode="default")
  4715 |         return CompileConfig()
  4716 | 
  4717 |     def get_compiled_call(self, compile_config: CompileConfig | None) -> Callable:
  4718 |         """Return a `torch.compile`'d version of `self.__call__`. This is useful to dynamically choose between
  4719 |         non-compiled/compiled `forward` during inference, especially to switch between prefill (where we don't
  4720 |         want to use compiled version to avoid recomputing the graph with new shapes) and iterative decoding
  4721 |         (where we want the speed-ups of compiled version with static shapes)."""
  4722 |         # Only reset it if not present or different from previous config
  4723 |         if "llama4" in self.config.model_type:  # TODO try to enable for FULL COMPILE HYBRID CACHE SUPPORT
  4724 |             return self.__call__
  4725 |         compile_config = compile_config or self._default_compile_config()
  4726 |         default_config = getattr(self.generation_config, "compile_config", None) or self._default_compile_config()
  4727 |         if (
  4728 |             not hasattr(self, "_compiled_call")
  4729 |             or getattr(self, "_last_compile_config", default_config) != compile_config
  4730 |         ):
  4731 |             self._last_compile_config = compile_config
  4732 |             self._compiled_call = torch.compile(self.__call__, **compile_config.to_dict())
  4733 |         return self._compiled_call
  4734 | 
  4735 |     @classmethod
  4736 |     def is_backend_compatible(cls):
  4737 |         return cls._supports_attention_backend
  4738 | 
  4739 |     def _move_missing_keys_from_meta_to_device(
  4740 |         self,
  4741 |         missing_keys: list[str],
  4742 |         device_map: dict | None,
  4743 |         device_mesh: "DeviceMeshLike | None",
  4744 |         hf_quantizer: HfQuantizer | None,
  4745 |     ) -> None:
  4746 |         """Move the missing keys (keys that are part of the model parameters, but were NOT found in the loaded state dicts)
  4747 |         back from meta device to their device according to the `device_map` if any, else cpu. Takes care of sharding those
  4748 |         missing parameters if `device_mesh` is provided, i.e. we are using TP.
  4749 |         All non-persistent buffers are also moved back to the correct device (they are not part of the state_dict, but are
  4750 |         not missing either).
  4751 |         """
  4752 |         is_quantized = hf_quantizer is not None
  4753 |         # This is the only case where we do not initialize the model on meta device, so we don't have to do anything here
  4754 |         if is_deepspeed_zero3_enabled() and not is_quantized:
  4755 |             return
  4756 | 
  4757 |         # In this case we need to move everything back
  4758 |         if is_fsdp_enabled() and not is_local_dist_rank_0() and not is_quantized:
  4759 |             for key, param in self.named_parameters():
  4760 |                 value = torch.zeros_like(param, device="cpu")
  4761 |                 _load_parameter_into_model(self, key, value)
  4762 |             for key, buffer in self.named_buffers():
  4763 |                 value = torch.zeros_like(buffer, device="cpu")
  4764 |                 _load_parameter_into_model(self, key, value)
  4765 |             return
  4766 | 
  4767 |         # The tied weight keys are in the "missing" usually, but they should not be moved (they will be tied anyway)
  4768 |         # This is especially important because if they are moved, they will lose the `_is_hf_initialized` flag, and they
  4769 |         # will be re-initialized for nothing (which can be quite long)
  4770 |         for key in missing_keys - self.all_tied_weights_keys.keys():
  4771 |             param = self.get_parameter_or_buffer(key)
  4772 |             param_device = get_device(device_map, key, valid_torch_device=True)
  4773 |             value = torch.empty_like(param, device=param_device)
  4774 |             # For TP, we may need to shard the param
  4775 |             if device_mesh is not None:
  4776 |                 shard_and_distribute_module(
  4777 |                     self, value, param, key, None, False, device_mesh.get_local_rank(), device_mesh
  4778 |                 )
  4779 |             # Otherwise, just move it to device
  4780 |             else:
  4781 |                 _load_parameter_into_model(self, key, value)
  4782 |         # We need to move back non-persistent buffers as well, as they are not part of loaded weights anyway
  4783 |         for key, buffer in self.named_non_persistent_buffers():
  4784 |             buffer_device = get_device(device_map, key, valid_torch_device=True)
  4785 |             value = torch.empty_like(buffer, device=buffer_device)
  4786 |             _load_parameter_into_model(self, key, value)
  4787 | 
  4788 |     def _initialize_missing_keys(self, is_quantized: bool) -> None:
  4789 |         """
  4790 |         Initialize the missing keys (keys that are part of the model parameters, but were NOT found in the loaded state dicts), according to
  4791 |         `_initialize_weights`. Indeed, since the corresponding weights are missing from the state dict, they will not be replaced and need to
  4792 |         be initialized correctly (i.e. weight initialization distribution).
  4793 | 
  4794 |         Also marks non-missing params/buffers with `_is_hf_initialized` and propagates this flag to modules,
  4795 |         so that `_initialize_weights` can skip fully-initialized modules entirely.
  4796 |         """
  4797 |         if is_fsdp_enabled() and not is_local_dist_rank_0():
  4798 |             # Handle FSDP edge case when using cpu ram efficient loading to ensure it is marked as initialized
  4799 |             # since it will get its weights broadcasted from rank0
  4800 |             # We actually need to do that only because we want to re-initialize non-persistent buffers with correct values.
  4801 |             # Everything else in the state_dict will be gathered from rank0, so we don't need re-initialization.
  4802 |             # We could simply early return after buffer inits if we had a way to init only the non-persistent buffers
  4803 |             for key in self.state_dict():
  4804 |                 try:
  4805 |                     param_or_buffer = self.get_parameter_or_buffer(key)
  4806 |                     param_or_buffer._is_hf_initialized = True
  4807 |                 except AttributeError:
  4808 |                     pass  # may happen when handling pre-quantized weights
  4809 |             self._is_hf_initialized = True
  4810 | 
  4811 |         # This will only initialize submodules that are not marked as initialized by the line above.
  4812 |         if is_deepspeed_zero3_enabled() and not is_quantized:
  4813 |             import deepspeed
  4814 | 
  4815 |             # keep_vars=True as we need the original tensors, so that the "_is_hf_initialized" is present on them
  4816 |             not_initialized_parameters = list(
  4817 |                 {v for v in self.state_dict(keep_vars=True).values() if not getattr(v, "_is_hf_initialized", False)}
  4818 |             )
  4819 |             with deepspeed.zero.GatheredParameters(not_initialized_parameters, modifier_rank=0):
  4820 |                 self.initialize_weights()
  4821 |         else:
  4822 |             self.initialize_weights()
  4823 | 
  4824 |     def _adjust_missing_and_unexpected_keys(self, loading_info: LoadStateDictInfo) -> None:
  4825 |         """Adjust the `missing_keys` and `unexpected_keys` based on current model's exception rules, to avoid
  4826 |         raising unneeded warnings/errors. This is performed in-place.
  4827 |         """
  4828 |         # Old checkpoints may have keys for rotary_emb.inv_freq for each layer, however we moved this buffer to the main model
  4829 |         # (so the buffer name has changed). Remove them in such a case. This is another exception that was not added to
  4830 |         # `_keys_to_ignore_on_load_unexpected` as it touches many models -> we add it manually to the existing patterns
  4831 |         has_inv_freq_buffers = any(buffer.endswith("rotary_emb.inv_freq") for buffer, _ in self.named_buffers())
  4832 |         additional_unexpected_patterns = {r"rotary_emb\.inv_freq"} if has_inv_freq_buffers else set()
  4833 |         # Same idea for `position_ids`: used to be a persistent buffer, now `persistent=False` in most models.
  4834 |         has_position_ids_buffers = any(buffer.endswith("position_ids") for buffer, _ in self.named_buffers())
  4835 |         if has_position_ids_buffers:
  4836 |             additional_unexpected_patterns.add(r"(^|\.)position_ids$")
  4837 | 
  4838 |         missing_patterns = self._keys_to_ignore_on_load_missing or set()
  4839 |         unexpected_patterns = (self._keys_to_ignore_on_load_unexpected or set()) | additional_unexpected_patterns
  4840 |         ignore_missing_regex, ignore_unexpected_regex = None, None
  4841 |         if len(missing_patterns) > 0:
  4842 |             ignore_missing_regex = re.compile("|".join(rf"({pattern})" for pattern in missing_patterns))
  4843 |         if len(unexpected_patterns) > 0:
  4844 |             ignore_unexpected_regex = re.compile("|".join(rf"({pattern})" for pattern in unexpected_patterns))
  4845 | 
  4846 |         # Clean-up missing keys
  4847 |         if ignore_missing_regex is not None:
  4848 |             loading_info.missing_keys = {
  4849 |                 key for key in loading_info.missing_keys if ignore_missing_regex.search(key) is None
  4850 |             }
  4851 | 
  4852 |         # Clean-up unexpected keys
  4853 |         if ignore_unexpected_regex is not None:
  4854 |             loading_info.unexpected_keys = {
  4855 |                 key for key in loading_info.unexpected_keys if ignore_unexpected_regex.search(key) is None
  4856 |             }
  4857 | 
  4858 |     def mark_tied_weights_as_initialized(self, loading_info):
  4859 |         """Adds the `_is_hf_initialized` flag on parameters that will be tied, in order to avoid initializing them
  4860 |         later as they will be tied (overwritten) anyway.
  4861 |         This is very important as most embeddings are tied, and they are huge params (vocabularies are often 256k), so
  4862 |         running inits on them is very costly."""
  4863 |         for tied_param in getattr(self, "all_tied_weights_keys", {}).keys():
  4864 |             param = self.get_parameter(tied_param)
  4865 |             setattr(param, "_is_hf_initialized", True)
  4866 | 
  4867 |         # Some remote code models define module tying (not parameter tying) in their __init__. When modules themselves are shared,
  4868 |         # weights inside both modules appear in the `state_dict` but only one will appear in the safetensors checkpoints
  4869 |         # as they are inherently tied because the 2 modules are the same object. In this case, once we load a parameter
  4870 |         # inside one of the 2 modules, the other will also automatically be loaded and will have the `_is_hf_initialized`
  4871 |         # flag (because we call `setattr` with the loaded param on the module, which is the same object), but its counterpart
  4872 |         # will still appear as a missing key as we never get it out of the set (because it appears in the state_dict as well).
  4873 |         # So we remove it now - otherwise it's considered missing and will be wrongly reinitialized
  4874 |         # Note: this is never an issue in main Transformers, as we never do module-tying, only parameter-tying, and we know
  4875 |         # which params are supposed to be tied to which other params
  4876 |         if self.is_remote_code():
  4877 |             # Remove those that are already initialized, but appear as missing due to module tying (only if they are not known
  4878 |             # tied weights, i.e. we did not explicitly mark them as initialized just above)
  4879 |             loading_info.missing_keys = {
  4880 |                 key
  4881 |                 for key in loading_info.missing_keys
  4882 |                 if key in self.all_tied_weights_keys
  4883 |                 or not getattr(self.get_parameter_or_buffer(key), "_is_hf_initialized", False)
  4884 |             }
  4885 | 
  4886 |     def get_parameter_or_buffer(self, target: str):
  4887 |         """
  4888 |         Return the parameter or buffer given by `target` if it exists, otherwise throw an error. This combines
  4889 |         `get_parameter()` and `get_buffer()` in a single handy function. If the target is an `_extra_state` attribute,
  4890 |         it will return the extra state provided by the module. Note that it only work if `target` is a leaf of the model.
  4891 |         """
  4892 |         try:
  4893 |             return self.get_parameter(target)
  4894 |         except AttributeError:
  4895 |             pass
  4896 |         try:
  4897 |             return self.get_buffer(target)
  4898 |         except AttributeError:
  4899 |             pass
  4900 |         module, param_name = get_module_from_name(self, target)
  4901 |         if (
  4902 |             param_name == "_extra_state"
  4903 |             and getattr(module.__class__, "get_extra_state", torch.nn.Module.get_extra_state)
  4904 |             is not torch.nn.Module.get_extra_state
  4905 |         ):
  4906 |             return module.get_extra_state()
  4907 | 
  4908 |         raise AttributeError(f"`{target}` is neither a parameter, buffer, nor extra state.")
  4909 | 
  4910 |     def named_non_persistent_buffers(
  4911 |         self, recurse: bool = True, remove_duplicate: bool = True
  4912 |     ) -> Iterator[tuple[str, torch.Tensor]]:
  4913 |         """Similar to `named_buffers`, but only yield non-persistent ones. It is handy as it's not perfectly straightforward
  4914 |         to know if they are persistent or not"""
  4915 |         for name, tensor in self.named_buffers(recurse=recurse, remove_duplicate=remove_duplicate):
  4916 |             # We have to grab the parent here, as the attribute `_non_persistent_buffers_set` is on the immediate
