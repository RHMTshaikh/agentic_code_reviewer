  4706 |     def _default_compile_config(self) -> CompileConfig:
  4707 |         """Build the default `CompileConfig` for `get_compiled_call`.
  4708 | 
  4709 |         Inductor + `reduce-overhead` (the `CompileConfig` defaults) target CUDA.
  4710 |         torch_tpu registers its own TorchDynamo backend named `"tpu"`; route
  4711 |         `device.type == "tpu"` through it with static shapes to match the
  4712 |         common StaticCache + fixed-prefill usage."""
  4713 |         if self.device.type == "tpu":
  4714 |             return CompileConfig(backend="tpu", dynamic=False, mode="default")
  4715 |         return CompileConfig()
