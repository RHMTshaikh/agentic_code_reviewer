  3746 | def _add_return_tensors_to_docstring(func, parent_class, docstring, indent_level):
  3747 |     """
  3748 |     Add return_tensors parameter documentation for processor __call__ methods if not already present.
  3749 | 
  3750 |     Args:
  3751 |         func (`function`): Function being processed
  3752 |         parent_class (`class`): Parent class of the function
  3753 |         docstring (`str`): Current docstring being built
  3754 |         indent_level (`int`): Indentation level
  3755 | 
  3756 |     Returns:
  3757 |         str: Updated docstring with return_tensors if applicable
  3758 |     """
  3759 |     # Check if this is a processor __call__ method or an image processor preprocess method
  3760 |     is_processor_call = False
  3761 |     is_image_processor_preprocess = False
  3762 |     if func.__name__ == "__call__":
  3763 |         # Check if this is a processor by inspecting class hierarchy
  3764 |         is_processor_call = _is_processor_class(func, parent_class)
  3765 | 
  3766 |     if func.__name__ == "preprocess":
  3767 |         is_image_processor_preprocess = _is_image_processor_class(func, parent_class)
  3768 | 
  3769 |     # If it's a processor __call__ method or an image processor preprocess method and return_tensors is not already documented
  3770 |     if (is_processor_call or is_image_processor_preprocess) and "return_tensors" not in docstring:
  3771 |         # Get the return_tensors documentation from ImageProcessorArgs
  3772 |         source_args_dict = (
  3773 |             get_args_doc_from_source(ProcessorArgs)
  3774 |             if is_processor_call
  3775 |             else get_args_doc_from_source(ImageProcessorArgs)
  3776 |         )
  3777 |         return_tensors_info = source_args_dict["return_tensors"]
  3778 |         param_type = return_tensors_info.get("type", "`str` or [`~utils.TensorType`]")
  3779 |         description = return_tensors_info["description"]
  3780 | 
  3781 |         # Format the parameter type
  3782 |         param_type = param_type if "`" in param_type else f"`{param_type}`"
  3783 | 
  3784 |         # Format the parameter docstring
  3785 |         param_docstring = f"return_tensors ({param_type}, *optional*):{description}"
  3786 |         docstring += set_min_indent(param_docstring, indent_level + 8)
  3787 | 
  3788 |     return docstring
  3789 | 
