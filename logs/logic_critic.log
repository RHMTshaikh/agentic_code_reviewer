   403 |         current_moe = getattr(self, "_experts_implementation", None)
   404 |         experts_implementation = value if not isinstance(value, dict) else value.get("", current_moe)
   405 |         self._experts_implementation_internal = experts_implementation
   406 | 
   407 |         # Set it recursively on the subconfigs
   408 |         for subconfig_key in self.sub_configs:
   409 |             subconfig = getattr(self, subconfig_key, None)
   410 |             if subconfig is not None:
   411 |                 current_subconfig_moe = getattr(subconfig, "_experts_implementation", None)
   412 |                 sub_implementation = (
   413 |                     value if not isinstance(value, dict) else value.get(subconfig_key, current_subconfig_moe)
   414 |                 )
   415 |                 subconfig._experts_implementation = sub_implementation
   416 | 
