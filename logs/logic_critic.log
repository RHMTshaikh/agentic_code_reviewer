  4276 |             dtype, checkpoint_files, config, sharded_metadata, state_dict, weights_only, hf_quantizer
  4277 |         )
  4278 | 
  4279 |         if gguf_file:
  4280 |             from .modeling_gguf_pytorch_utils import load_gguf_checkpoint
  4281 | 
  4282 |             # we need a dummy model to get the state_dict - for this reason, we keep the state_dict as if it was
  4283 |             # passed directly as a kwarg from now on
  4284 |             with torch.device("meta"):
  4285 |                 dummy_model = cls(config)
