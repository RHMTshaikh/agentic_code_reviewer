    92 | def strtobool(val) -> int:
    93 |     """Convert a string representation of truth to true (1) or false (0).
    94 | 
    95 |     True values are 'y', 'yes', 't', 'true', 'on', and '1'; false values are 'n', 'no', 'f', 'false', 'off', and '0'.
