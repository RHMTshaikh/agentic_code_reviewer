  1167 | def rename_source_key(
  1168 |     source_key: str,
  1169 |     weight_renamings: list[WeightRenaming],
  1170 |     weight_converters: list[WeightConverter],
  1171 |     base_model_prefix: str | None = None,
  1172 |     meta_state_dict: dict | None = None,
  1173 | ) -> tuple[str, str | None]:
  1174 |     """
  1175 |     Rename a checkpoint key by first applying all `WeightRenaming`s, then at most one `WeightConverter`.
  1176 | 
  1177 |     A renaming and a converter may act on the same key in that order: the renaming normalises the
  1178 |     key into the namespace the converter expects. The reverse holds on the save path (converter
  1179 |     first, then renaming). There is no need for a converter-then-rename order because converters
  1180 |     act only on specific leaf patterns; no subsequent renamings should ever target their output.
  1181 | 
  1182 |     Args:
  1183 |         source_key (`str`):
  1184 |             The original checkpoint key to rename.
  1185 |         weight_renamings (`list[WeightRenaming]`):
  1186 |             Applied in order; every matching renaming fires (they may chain).
  1187 |         weight_converters (`list[WeightConverter]`):
  1188 |             Applied after all renamings; at most one may match. Subsequent converters are skipped.
  1189 |         base_model_prefix (`str`, *optional*):
  1190 |             Base-model prefix to add or strip when both `base_model_prefix` and `meta_state_dict` are given.
  1191 |         meta_state_dict (`dict`, *optional*):
  1192 |             Meta state dict used to decide whether `base_model_prefix` should be added or stripped.
  1193 | 
  1194 |     Returns:
  1195 |         `tuple[str, str | None]`: The renamed key and the matched converter's source pattern
  1196 |         (or `None` if no converter matched).
  1197 |     """
  1198 |     renamed_key = source_key
  1199 |     # 1. apply all renamings in turns (if multiple match, it's the responsibility of the mappings to make sure they
  1200 |     # are coherent)
  1201 |     for renaming in weight_renamings:
  1202 |         renamed_key, _ = renaming.rename_source_key(renamed_key)
  1203 | 
  1204 |     # 2. apply renaming through weight conversions on the key if we have any WeightConverter (here we stop after
  1205 |     # the first match, as we assume only 1 converter can match any source key)
  1206 |     source_pattern = None
  1207 |     for converter in weight_converters:
  1208 |         renamed_key, source_pattern = converter.rename_source_key(renamed_key)
  1209 |         if source_pattern is not None:
  1210 |             break
  1211 | 
  1212 |     # 3. check if we need to add or remove base_model_prefix if necessary (only during loading, not saving)
  1213 |     if base_model_prefix is not None and meta_state_dict is not None:
  1214 |         if (
  1215 |             renamed_key.startswith(base_model_prefix)
  1216 |             and meta_state_dict.get(re.sub(f"^{base_model_prefix}.", "", renamed_key, count=1)) is not None
  1217 |         ):
  1218 |             renamed_key = re.sub(f"^{base_model_prefix}.", "", renamed_key, count=1)
  1219 |         elif meta_state_dict.get(f"{base_model_prefix}.{renamed_key}") is not None:
  1220 |             renamed_key = f"{base_model_prefix}.{renamed_key}"
  1221 | 
  1222 |     return renamed_key, source_pattern
