   256 |         self,
   257 |         inputs: torch.Tensor | None = None,
   258 |         generation_config: GenerationConfig | None = None,
   259 |         logits_processor: LogitsProcessorList | None = None,
   260 |         stopping_criteria: StoppingCriteriaList | None = None,
   261 |         prefix_allowed_tokens_fn: Callable[[int, torch.Tensor], list[int]] | None = None,
   262 |         synced_gpus: bool | None = None,
   263 |         assistant_model: Optional["PreTrainedModel"] = None,
   264 |         streamer: Optional["BaseStreamer"] = None,
