    48 |                     if not order:
    49 |                         raise ValueError(f"Order {order_id} not found.")
    50 | 
    51 |                     if order.status not in (OrderStatus.OPEN, OrderStatus.PARTIALLY_FILLED):
    52 |                         raise OrderValidationError(f"Order {order_id} is not in an executable state.")
    53 | 
    54 |                     # 1. Retrieve current market reality
    55 |                     quote = await self.pricing_engine.get_validated_quote(order.symbol)
    56 | 
    57 |                     # 2. Matchmaking Logic
    58 |                     fill_price: Decimal | None = None
    59 |                     if order.type == "MARKET":
    60 |                         fill_price = quote.ask if order.side == "BUY" else quote.bid
    61 |                     elif order.type == "LIMIT":
    62 |                         if order.side == "BUY" and quote.ask <= order.limit_price:
    63 |                             fill_price = quote.ask
    64 |                         elif order.side == "SELL" and quote.bid >= order.limit_price:
    65 |                             fill_price = quote.bid
    66 | 
    67 |                     if not fill_price:
    68 |                         return None  # Cannot be filled at current market conditions
    69 | 
    70 |                     # 3. Execution Simulation
    71 |                     remaining_qty = order.requested_quantity - order.filled_quantity
    72 |                     executed_qty = remaining_qty 
