  3407 |         """
  3408 |         if token is not None:
  3409 |             kwargs["token"] = token
  3410 | 
  3411 |         _hf_peft_config_loaded = getattr(self, "_hf_peft_config_loaded", False)
  3412 | 
  3413 |         hf_quantizer = getattr(self, "hf_quantizer", None)
  3414 |         quantization_serializable = (
