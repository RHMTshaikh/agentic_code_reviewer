    77 |                         execution_price=fill_price,
    78 |                         quantity=executed_qty,
    79 |                         broker_reference_id=broker_ref
    80 |                     )
    81 |                     self.session.add(execution)
    82 | 
    83 |                     # 4. State Update
    84 |                     order.filled_quantity += executed_qty
    85 |                     if order.filled_quantity >= order.requested_quantity:
