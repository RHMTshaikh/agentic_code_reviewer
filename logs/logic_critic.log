  2572 |         # 6. Prepare `max_length` depending on other stopping criteria.
  2573 |         input_ids_length = input_ids.shape[1]
  2574 |         generation_config = self._prepare_generated_length(
  2575 |             generation_config=generation_config,
  2576 |             has_default_max_length=has_default_max_length,
  2577 |             has_default_min_length=has_default_min_length,
  2578 |             model_input_name=model_input_name,
  2579 |             inputs_tensor=inputs_tensor,
  2580 |             input_ids_length=input_ids_length,
  2581 |         )
  2582 | 
  2583 |         # If the model supports `logits_to_keep` in forward(), set it to 1 to avoid computing the whole
