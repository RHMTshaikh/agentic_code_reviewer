  1319 |     def get_special_tokens_mask(
  1320 |         self, token_ids_0: list[int], token_ids_1: list[int] | None = None, already_has_special_tokens: bool = False
  1321 |     ) -> list[int]:
  1322 |         """
  1323 |         Retrieve sequence ids from a token list that has no special tokens added.
  1324 | 
  1325 |         For fast tokenizers, data collators call this with `already_has_special_tokens=True` to build a mask over an
  1326 |         already-formatted sequence. In that case, we compute the mask by checking membership in `all_special_ids`.
