  3349 |     def save_pretrained(
  3350 |         self,
  3351 |         save_directory: str | os.PathLike,
  3352 |         is_main_process: bool = True,
  3353 |         state_dict: dict | None = None,
  3354 |         push_to_hub: bool = False,
  3355 |         max_shard_size: int | str = "50GB",
  3356 |         variant: str | None = None,
  3357 |         token: str | bool | None = None,
  3358 |         save_peft_format: bool = True,
  3359 |         save_original_format: bool = True,
  3360 |         **kwargs,
  3361 |     ):
  3362 |         """
  3363 |         Save a model and its configuration file to a directory, so that it can be re-loaded using the
  3364 |         [`~PreTrainedModel.from_pretrained`] class method.
  3365 | 
  3366 |         Arguments:
  3367 |             save_directory (`str` or `os.PathLike`):
  3368 |                 Directory to which to save. Will be created if it doesn't exist.
  3369 |             is_main_process (`bool`, *optional*, defaults to `True`):
  3370 |                 Whether the process calling this is the main process or not. Useful when in distributed training like
  3371 |                 TPUs and need to call this function on all processes. In this case, set `is_main_process=True` only on
  3372 |                 the main process to avoid race conditions.
  3373 |             state_dict (nested dictionary of `torch.Tensor`):
  3374 |                 The state dictionary of the model to save. Will default to `self.state_dict()`, but can be used to only
  3375 |                 save parts of the model or if special precautions need to be taken when recovering the state dictionary
  3376 |                 of a model (like when using model parallelism).
  3377 |             push_to_hub (`bool`, *optional*, defaults to `False`):
  3378 |                 Whether or not to push your model to the Hugging Face model hub after saving it. You can specify the
  3379 |                 repository you want to push to with `repo_id` (will default to the name of `save_directory` in your
  3380 |                 namespace).
  3381 |             max_shard_size (`int` or `str`, *optional*, defaults to `"50GB"`):
  3382 |                 The maximum size for a checkpoint before being sharded. Checkpoints shard will then be each of size
  3383 |                 lower than this size. If expressed as a string, needs to be digits followed by a unit (like `"5MB"`).
  3384 | 
  3385 |                 <Tip warning={true}>
  3386 | 
  3387 |                 If a single weight of the model is bigger than `max_shard_size`, it will be in its own checkpoint shard
  3388 |                 which will be bigger than `max_shard_size`.
  3389 | 
  3390 |                 </Tip>
  3391 | 
  3392 |             variant (`str`, *optional*):
  3393 |                 If specified, weights are saved in the format model.<variant>.safetensors.
  3394 |             token (`str` or `bool`, *optional*):
  3395 |                 The token to use as HTTP bearer authorization for remote files. If `True`, or not specified, will use
  3396 |                 the token generated when running `hf auth login` (stored in `~/.huggingface`).
  3397 |             save_peft_format (`bool`, *optional*, defaults to `True`):
  3398 |                 For backward compatibility with PEFT library, in case adapter weights are attached to the model, all
  3399 |                 keys of the state dict of adapters needs to be prepended with `base_model.model`. Advanced users can
  3400 |                 disable this behaviours by setting `save_peft_format` to `False`.
  3401 |             save_original_format (`bool`, *optional*, defaults to `True`):
  3402 |                 For backward compatibility with the previous versions of `transformers` you can save the checkpoint with
  3403 |                 its reverse mapping. The reverse mapping needs to exists even if the model was loaded from a None legacy
  3404 |                 checkpoint.
  3405 |             kwargs (`dict[str, Any]`, *optional*):
  3406 |                 Additional key word arguments passed along to the [`~utils.PushToHubMixin.push_to_hub`] method.
  3407 |         """
  3408 |         if token is not None:
  3409 |             kwargs["token"] = token
  3410 | 
  3411 |         _hf_peft_config_loaded = getattr(self, "_hf_peft_config_loaded", False)
  3412 | 
  3413 |         hf_quantizer = getattr(self, "hf_quantizer", None)
  3414 |         quantization_serializable = (
  3415 |             hf_quantizer is not None and isinstance(hf_quantizer, HfQuantizer) and hf_quantizer.is_serializable()
  3416 |         )
  3417 | 
  3418 |         if hf_quantizer is not None and not _hf_peft_config_loaded and not quantization_serializable:
  3419 |             raise ValueError(
  3420 |                 f"The model is quantized with {hf_quantizer.quantization_config.quant_method} and is not serializable - check out the warnings from"
  3421 |                 " the logger on the traceback to understand the reason why the quantized model is not serializable."
  3422 |             )
  3423 | 
  3424 |         # we need to check against tp_size, not tp_plan, as tp_plan is substituted to the class one
