   270 |         # ********** mostly taken from main generate function up to calling the different methods (see NOTE) **********
   271 |         # 1. Handle `generation_config` and kwargs that might update it, and validate the `.generate()` call
   272 |         generation_mode_kwargs = self._extract_generation_mode_kwargs(
