   271 |         """
   272 |         if images is None and text is None:
   273 |             raise ValueError("You have to specify at least one of `images` or `text`.")
   274 | 
   275 |         output_kwargs = self._merge_kwargs(
   276 |             Florence2ProcessorKwargs,
   277 |             tokenizer_init_kwargs=self.tokenizer.init_kwargs,
   278 |             **kwargs,
   279 |         )
   280 | 
   281 |         image_inputs = {}
   282 |         if images is not None:
   283 |             image_inputs = self.image_processor(images, **output_kwargs["images_kwargs"])
   284 | 
   285 |         if text is None:
   286 |             logger.warning_once("You are using Florence-2 without a text prefix.")
   287 |             text = [""] * (1 if not isinstance(images, list) else len(images))
