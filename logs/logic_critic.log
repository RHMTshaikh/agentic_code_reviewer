  2154 |     # Convenience setters for grouped configuration
  2155 |     def set_training(
  2156 |         self,
  2157 |         learning_rate: float = 5e-5,
  2158 |         batch_size: int = 8,
  2159 |         weight_decay: float = 0,
  2160 |         num_epochs: float = 3,
  2161 |         max_steps: int = -1,
  2162 |         gradient_accumulation_steps: int = 1,
  2163 |         seed: int = 42,
  2164 |         gradient_checkpointing: bool = False,
  2165 |     ):
  2166 |         """
  2167 |         A method that regroups all basic arguments linked to the training.
  2168 | 
  2169 |         <Tip>
  2170 | 
  2171 |         Calling this method will automatically set `self.do_train` to `True`.
  2172 | 
  2173 |         </Tip>
  2174 | 
  2175 |         Args:
  2176 |             learning_rate (`float`, *optional*, defaults to 5e-5):
  2177 |                 The initial learning rate for the optimizer.
  2178 |             batch_size (`int` *optional*, defaults to 8):
  2179 |                 The batch size per device (GPU/TPU core/CPU...) used for training.
  2180 |             weight_decay (`float`, *optional*, defaults to 0):
  2181 |                 The weight decay to apply (if not zero) to all layers except all bias and LayerNorm weights in the
  2182 |                 optimizer.
  2183 |             num_train_epochs(`float`, *optional*, defaults to 3.0):
  2184 |                 Total number of training epochs to perform (if not an integer, will perform the decimal part percents
  2185 |                 of the last epoch before stopping training).
  2186 |             max_steps (`int`, *optional*, defaults to -1):
  2187 |                 If set to a positive number, the total number of training steps to perform. Overrides `num_train_epochs`.
  2188 |                 For a finite dataset, training is reiterated through the dataset (if all data is exhausted) until
  2189 |                 `max_steps` is reached.
  2190 |             gradient_accumulation_steps (`int`, *optional*, defaults to 1):
  2191 |                 Number of updates steps to accumulate the gradients for, before performing a backward/update pass.
  2192 | 
  2193 |                 <Tip warning={true}>
  2194 | 
  2195 |                 When using gradient accumulation, one step is counted as one step with backward pass. Therefore,
  2196 |                 logging, evaluation, save will be conducted every `gradient_accumulation_steps * xxx_step` training
  2197 |                 examples.
