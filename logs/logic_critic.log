  3485 | def _get_base_kwargs_class(cls):
  3486 |     """
  3487 |     Get the root/base TypedDict class by walking the inheritance chain.
  3488 |     For model-specific kwargs like ComplexProcessingKwargs(ProcessingKwargs), returns ProcessingKwargs.
  3489 |     For model-specific kwargs like DummyImageProcessorKwargs(ImagesKwargs), returns ImagesKwargs.
  3490 | 
  3491 |     Compatibility: On Python < 3.12, non-generic TypedDict subclasses do not have __orig_bases__ set
  3492 |     (cpython#103699). We fall back to naming heuristics (e.g. *ImageProcessorKwargs -> ImagesKwargs).
  3493 |     """
  3494 |     current = cls
  3495 |     while True:
  3496 |         bases = typing_extensions.get_original_bases(current)
  3497 |         parent = None
  3498 |         for base in bases:
  3499 |             if isinstance(base, type) and base not in (dict, object):
  3500 |                 if getattr(base, "__name__", "") == "TypedDict" and getattr(base, "__module__", "") == "typing":
  3501 |                     continue
  3502 |                 parent = base
  3503 |                 break
  3504 |         if parent is None:
  3505 |             # Python < 3.12 fallback: use naming heuristics
  3506 |             base_name = _get_base_kwargs_class_from_name(current.__name__)
  3507 |             if base_name is not None:
  3508 |                 global _BASIC_KWARGS_CLASSES
  3509 |                 if _BASIC_KWARGS_CLASSES is None:
  3510 |                     from transformers.processing_utils import (
  3511 |                         AudioKwargs,
  3512 |                         ImagesKwargs,
  3513 |                         ProcessingKwargs,
  3514 |                         TextKwargs,
  3515 |                         VideosKwargs,
  3516 |                     )
  3517 | 
  3518 |                     _BASIC_KWARGS_CLASSES = {
  3519 |                         "ImagesKwargs": ImagesKwargs,
  3520 |                         "ProcessingKwargs": ProcessingKwargs,
  3521 |                         "TextKwargs": TextKwargs,
  3522 |                         "VideosKwargs": VideosKwargs,
  3523 |                         "AudioKwargs": AudioKwargs,
  3524 |                     }
  3525 |                 parent = _BASIC_KWARGS_CLASSES[base_name]
  3526 |         if parent is None or parent == current:
  3527 |             return current
  3528 |         current = parent
