 114 | def generate_scaled_deformes_backward_map(shape, num_folds=1, angle_range=(30, 60)):
 115 |     """
 116 |     Generate a backward map for a given shape by applying random folds.
 117 |     Parameters:
 118 |         shape (tuple): Shape of the image as (height, width).
 119 |         num_folds (int): Number of folds to apply.
 120 |         angle_range (tuple): Range of angles (in degrees) for each fold as (min_angle, max_angle).
 121 |     Returns:
 122 |         np.ndarray: Backward map of shape (H', W', 2) where backward_map[dst_y, dst_x] = [src_x, src_y]
 123 |     """
 124 |     h, w = shape
 125 |     forward_map = create_forward_map(h, w)
 126 |     # lines = generate_non_intersecting_lines_by_random_peremeter_point(h, w, num_folds)
 127 |     lines = generate_non_intersecting_lines_by_random_point(*forward_map.shape[:2], num_folds)
 128 |     masks = []
 129 |     for line in lines:
 130 |         masks.append(get_affected_points_mask(forward_map.shape, line))
 131 | 
 132 |     for i in range(num_folds):
 133 |         line = lines[i]
 134 |         angle = np.radians(np.random.uniform(*angle_range)) * np.random.choice([-1, 1])
 135 |         mask = masks[i]
 136 |         
 137 |         while True:
 138 |             test_map = apply_fold(forward_map, line, angle, mask)
 139 |             if not map_overlaps(test_map):
 140 |                 forward_map = test_map
 141 |                 break
 142 |             angle = np.radians(np.random.uniform(*angle_range))* random.choice([-1, 1])
 143 |         
 144 |         # Apply fold to all subsequent lines to keep them consistent
 145 |         for j in range(i + 1, num_folds):
 146 |             next_line = lines[j]
 147 |             x, y, z = next_line.point1 # ponit1 is always integer, so we can safely cast to int
 148 |             if mask[int(y), int(x)]:
 149 |                 next_line.rotate(line, angle)
 150 |     
 151 |     backward_map = convert_forward_to_backward_using_interp1d(forward_map)
 152 |     
 153 |     return forward_map, backward_map


