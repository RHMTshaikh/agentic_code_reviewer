  88 | def convert_forward_to_backward_using_interp1d(forward_map: np.ndarray) -> np.ndarray:
  89 |     """
  90 |     forward_map: A numpy array of shape (H, W, 2) ot shape (H, W, 3) where 
  91 |                  map[y, x] = [dest_x, dest_y, ...]
  92 |     This function assumes that the forward_map is mostly smooth and can be approximated by 1D interpolation along rows and then columns.
  93 |     
  94 |     returns: A backward map of shape (H', W', 2) where backward_map[dst_y, dst_x] = [src_x, src_y]
  95 |     """
  96 |     
  97 |     forward_map_copy = forward_map.copy()
  98 |     
  99 |     for i in range(2):
 100 |         forward_map_copy[:,:,i] -= forward_map_copy[:,:,i].min()
 101 |     
 102 |     x_max = forward_map_copy[:, :, 0].max()
 103 |     y_max = forward_map_copy[:, :, 1].max()
 104 | 
 105 |     forward_map_height = forward_map_copy.shape[0]
 106 |     forward_map_width = forward_map_copy.shape[1]
 107 | 
 108 |     backward_map_height = int(np.ceil(y_max  + 1))
 109 |     backward_map_width = int(np.ceil(x_max  + 1))
 110 |     
 111 |     backward_map_horizontally_expanded = np.zeros((forward_map_height, backward_map_width, 2), dtype=np.float32)
 112 |     backward_map = np.zeros((backward_map_height, backward_map_width, 2), dtype=np.float32)
 113 |     for row in range(forward_map_height):
 114 |         f = interp1d(
 115 |             forward_map_copy[row, :, 0], 
 116 |             np.arange(forward_map_width),
 117 |             kind='linear', 
 118 |             fill_value="extrapolate",
 119 |         )
 120 |         backward_map_horizontally_expanded[row, :, 0] = f(np.arange(backward_map_width))
 121 | 
 122 |         g = interp1d(
 123 |             forward_map_copy[row, :, 0], 
 124 |             forward_map_copy[row, :, 1], 
 125 |             kind='linear', 
 126 |             fill_value="extrapolate"
 127 |         )
 128 |         backward_map_horizontally_expanded[row, :, 1] = g(np.arange(backward_map_width))
 129 |     
 130 |     for col in range(backward_map_width):
 131 |         f = interp1d(
 132 |             backward_map_horizontally_expanded[:, col, 1],
 133 |             np.arange(forward_map_height),
 134 |             kind='linear', 
 135 |             fill_value="extrapolate",
 136 |         )
 137 |         backward_map[:, col, 1] = f(np.arange(backward_map_height))
 138 | 
 139 |         g = interp1d(
 140 |             backward_map_horizontally_expanded[:, col, 1],
 141 |             backward_map_horizontally_expanded[:, col, 0],
 142 |             kind='linear', 
 143 |             fill_value="extrapolate"
 144 |         )
 145 |         backward_map[:, col, 0] = g(np.arange(backward_map_height))
 146 |     
 147 |     return backward_map

