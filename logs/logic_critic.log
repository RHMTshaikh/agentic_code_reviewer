   265 |         """
   266 |         super().__init__(config)
   267 |         self.config = config
   268 | 
   269 |         # Output channels for the projection layers
   270 |         channels = [16, 24, 24, 32, 32, 32, 64, 64, 64, 64, 96, 96, 96, 160, 160, 160, 320]
   271 |         channels = [apply_depth_multiplier(config, x) for x in channels]
   272 | 
   273 |         # Strides for the depthwise layers
