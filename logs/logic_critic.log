   698 |         sampler = self._prepare_sampler(generation_config)
   699 |         logits_processor = self._prepare_logits_processor(generation_config, logits_processor)
   700 |         stopping_criteria = self._prepare_ar_stopping_criteria(generation_config, stopping_criteria)
   701 |         diffusion_stopping_criteria = self._prepare_diffusion_stopping_criteria(generation_config)
   702 |         if streamer is not None:
   703 |             streamer.put(input_ids.cpu())
   704 | 
   705 |         # 0.f performance tuning
   706 |         is_compiling = (
   707 |             past_key_values is not None and past_key_values.is_compileable and not generation_config.disable_compile
   708 |         )
   709 |         if is_compiling:
   710 |             encoder_forward_after_prefill, decoder_forward, sampler, diffusion_stopping_criteria = (
   711 |                 self._compile_functions(sampler, diffusion_stopping_criteria)
   712 |             )
   713 |         else:
   714 |             decoder_forward = self.forward
   715 |             encoder_forward_after_prefill = self.model.encoder
   716 | 
   717 |         # 1. Autoregressive canvas generation loop
   718 |         # NOTE: please keep the docstring in sync with this section's comments.
   719 |         is_prefill = True
   720 |         for _ in range(max_new_canvases):
   721 |             # 1.a. Encode all previous tokens using the encoder, to get the KV cache.
   722 |             unprocessed_input_ids, encoder_mask_mapping = self._prepare_encoder_inputs(
   723 |                 input_ids=input_ids,
   724 |                 attention_mask=attention_mask,
   725 |                 encoder_position_ids=encoder_position_ids,
   726 |                 past_key_values=past_key_values,
   727 |                 is_prefill=is_prefill,
   728 |                 canvas_length=canvas_length,
   729 |                 batch_size=batch_size,
   730 |                 **model_kwargs,
   731 |             )
   732 | 
   733 |             encoder_forward = self.model.encoder if is_prefill else encoder_forward_after_prefill
   734 |             encoder_outputs = encoder_forward(
   735 |                 input_ids=unprocessed_input_ids,
   736 |                 attention_mask=encoder_mask_mapping,
   737 |                 past_key_values=past_key_values,
   738 |                 position_ids=encoder_position_ids,
   739 |                 **model_kwargs,
   740 |             )
   741 |             past_key_values = encoder_outputs.past_key_values
   742 |             is_prefill = False
   743 | 
   744 |             # 1.b. Prepare data for the new denoising loop
   745 |             current_canvas, self_conditioning_logits, mask_mapping, finished_denoising = self._prepare_denoiser_inputs(
   746 |                 decoder_attention_mask=decoder_attention_mask,
   747 |                 past_key_values=past_key_values,
   748 |                 sampler=sampler,
   749 |                 diffusion_stopping_criteria=diffusion_stopping_criteria,
   750 |                 batch_size=batch_size,
   751 |                 device=device,
   752 |                 model_kwargs=model_kwargs,  # passed as a dict, because some contents will be popped
   753 |             )
   754 |             argmax_canvas = current_canvas
   755 | 
   756 |             # 1.c For each denoising (diffusion) step:
   757 |             # NOTE: we iterate in reverse order, as denoising is the reverse diffusion process (N..1).
   758 |             for cur_step in reversed(range(1, generation_config.max_denoising_steps + 1)):
   759 |                 # Unfinished batch items get their decoder forward pass counter incremented
   760 |                 # Finished batch items wouldn't have this decoder pass if we were running with bsz == 1
   761 |                 decoder_forward_passes += ~(finished_denoising | finished_sequences)
   762 | 
   763 |                 current_canvas, argmax_canvas, self_conditioning_logits, finished_denoising = self._denoising_step(
   764 |                     decoder_forward=decoder_forward,
   765 |                     current_canvas=current_canvas,
   766 |                     argmax_canvas=argmax_canvas,
   767 |                     input_ids=input_ids,
   768 |                     decoder_position_ids=decoder_position_ids,
   769 |                     self_conditioning_logits=self_conditioning_logits,
   770 |                     mask_mapping=mask_mapping,
   771 |                     past_key_values=past_key_values,
   772 |                     finished_denoising=finished_denoising,
   773 |                     cur_step=cur_step,
   774 |                     sampler=sampler,
   775 |                     logits_processor=logits_processor,
   776 |                     diffusion_stopping_criteria=diffusion_stopping_criteria,
   777 |                     **model_kwargs,
   778 |                 )
   779 | 
   780 |                 # If we have a draft-compatible streamer, put out the latest draft. We consider `argmax_canvas`
   781 |                 # to be the draft, as it is often the closest to the final output.
   782 |                 if streamer is not None and hasattr(streamer, "put_draft"):
   783 |                     streamer_kwargs = {"value": argmax_canvas.cpu()}
   784 |                     if getattr(streamer, "_takes_logits", False):
   785 |                         streamer_kwargs = {"logits": self_conditioning_logits.cpu()}
   786 |                     streamer.put_draft(**streamer_kwargs)
   787 | 
   788 |                 # Early exit if no more denoising steps are needed
   789 |                 if torch.all(finished_denoising):
   790 |                     break
   791 | 
   792 |             # 1.d. Append the new denoised canvas to the sequence of generated tokens.
   793 |             input_ids = torch.cat([input_ids, argmax_canvas], dim=-1)
   794 | 
   795 |             # 1.e. Check if any autoregressive stopping criteria are met, and break the outer loop if all sequences
   796 |             # have met them. Replaces generated tokens in finished sequences by pad.
   797 |             input_ids, finished_sequences = self._finalize_canvas(
   798 |                 input_ids=input_ids,
   799 |                 finished_sequences=finished_sequences,
   800 |                 generation_config=generation_config,
   801 |                 stopping_criteria=stopping_criteria,
   802 |                 canvas_length=canvas_length,
   803 |                 eos_tensor=eos_tensor,
   804 |             )
   805 | 
   806 |             if streamer is not None:
   807 |                 streamer.put(input_ids[:, -canvas_length:].cpu())
   808 | 
   809 |             if torch.all(finished_sequences):
   810 |                 break
   811 | 
   812 |             # 1.f. Prepare tensors for the next block
   813 |             cur_len, decoder_attention_mask, attention_mask, encoder_position_ids, decoder_position_ids = (
   814 |                 self._prepare_kwargs_for_next_canvas(
   815 |                     attention_mask=attention_mask,
   816 |                     decoder_attention_mask=decoder_attention_mask,
   817 |                     decoder_position_ids=decoder_position_ids,
   818 |                     canvas_length=canvas_length,
   819 |                     cur_len=cur_len,
   820 |                 )
   821 |             )
   822 | 
   823 |         # 2. Finalize and return
   824 |         if streamer is not None:
   825 |             streamer.end()
   826 |         if not return_dict_in_generate:
   827 |             return input_ids
   828 | 
   829 |         tokens_per_forward = self._compute_tokens_per_forward(
   830 |             input_ids, decoder_forward_passes, initial_input_ids_len, generation_config.pad_token_id
   831 |         )
   832 |         return DiffusionGemmaGenerationOutput(
   833 |             sequences=input_ids, tokens_per_forward=tokens_per_forward, past_key_values=past_key_values
   834 |         )
   835 | 
   836 |     @staticmethod
   837 |     def _compute_tokens_per_forward(
   838 |         input_ids: torch.Tensor,
   839 |         decoder_forward_passes: torch.Tensor,
   840 |         initial_input_ids_len: int,
   841 |         pad_token_id: int | None,
   842 |     ) -> torch.Tensor:
   843 |         """
   844 |         Computes and returns the tokens per forward of the diffusion step.
   845 | 
   846 |         It is defined as # generated tokens / # denoising steps, where:
   847 |         - # generated tokens EXCLUDES all pad tokens (i.e. tokens after EOS)
   848 |         - # denoising steps EXCLUDES the batched denoising steps after which a given row has hit the stopping criteria
   849 |         """
   850 |         new_tokens = input_ids[:, initial_input_ids_len:]
   851 |         if pad_token_id is not None:
   852 |             num_valid_tokens = (new_tokens != pad_token_id).sum(dim=-1)
   853 |         else:
   854 |             num_valid_tokens = new_tokens.shape[1]
   855 |         tokens_per_forward = num_valid_tokens / decoder_forward_passes
   856 |         return tokens_per_forward
   857 | 
   858 |     def _prepare_generation_config(
   859 |         self, generation_config: DiffusionGemmaGenerationConfig, **kwargs: Any
   860 |     ) -> DiffusionGemmaGenerationConfig:
   861 |         """
   862 |         Prepares the base generation config, then applies any generation configuration options from kwargs.
   863 |         """
   864 |         # TODO(joao, raushan): refactor `GenerationMixin` and this to reuse logic without requiring inheritance.
   865 | 
   866 |         # priority for baseline parameterization: ad hoc kwargs passed to `generate` > provided `generation_config` >
   867 |         # `self.generation_config` > global defaults
   868 |         generation_config = generation_config or self.generation_config or DiffusionGemmaGenerationConfig()
   869 |         # copy: don't modify the original generation config when applying global defaults or kwargs
   870 |         generation_config = copy.deepcopy(generation_config)
   871 |         # apply global defaults to unset parameters
   872 |         global_defaults = generation_config._get_default_generation_params()
   873 |         generation_config.update(**self.generation_config.to_dict(), defaults_only=True, allow_custom_entries=True)
   874 |         generation_config.update(**global_defaults, defaults_only=True)
   875 |         # kwargs rejected from updating the generation config are model_kwargs
   876 |         model_kwargs = generation_config.update(**kwargs)
   877 |         generation_config.validate()
   878 |         return generation_config, model_kwargs
   879 | 
   880 |     def _prepare_generated_length(
   881 |         self,
   882 |         generation_config: DiffusionGemmaGenerationConfig,
   883 |         cur_len: int,
   884 |     ):
   885 |         """Prepared max length in generation configs to avoid clashes between similar attributes"""
   886 |         # TODO(joao, raushan): refactor `GenerationMixin` and this to reuse logic without requiring inheritance.
   887 | 
   888 |         if generation_config.max_length and generation_config.max_new_tokens == 256:
   889 |             max_length = generation_config.max_length
   890 |             max_new_tokens = max_length - cur_len
   891 |         else:
   892 |             max_new_tokens = generation_config.max_new_tokens
   893 |             max_length = max_new_tokens + cur_len
   894 |         return max_length, max_new_tokens
   895 | 
   896 |     def _prepare_cache_for_generation(
   897 |         self, generation_config: DiffusionGemmaGenerationConfig, batch_size: int, max_length: int
   898 |     ) -> Cache:
   899 |         """
   900 |         Prepares and returns the cache for generation, given the parameterization in `generation_config`.
   901 | 
   902 |         (NOTE: Originally copied from `GenerationMixin._prepare_cache_for_generation` on 2026-03-27, and stripped down
   903 |         for DiffusionGemma.)
   904 |         """
   905 |         # TODO(joao, raushan): refactor `GenerationMixin` and this to reuse logic without requiring inheritance.
   906 | 
   907 |         # Static Caches
   908 |         if generation_config.cache_implementation in ALL_STATIC_CACHE_IMPLEMENTATIONS:
   909 |             if generation_config.cache_implementation in DEPRECATED_STATIC_CACHE_IMPLEMENTATIONS:
   910 |                 logger.warning_once(
   911 |                     f"Using `cache_implementation='{generation_config.cache_implementation}' is deprecated "
   912 |                     f"and will be removed in v5.13. Please only use one of {STATIC_CACHE_IMPLEMENTATIONS}, "
   913 |                     "and the layer structure will be inferred automatically."
   914 |                 )
   915 |             past_key_values = self._prepare_static_cache(
   916 |                 cache_implementation=generation_config.cache_implementation,
   917 |                 batch_size=batch_size,
   918 |                 max_length=max_length,
   919 |             )
   920 |         elif generation_config.cache_implementation == "quantized":
   921 |             cache_config = generation_config.cache_config if generation_config.cache_config is not None else {}
   922 |             cache_config.setdefault("config", self.config.get_text_config(decoder=True))
   923 |             backend = cache_config.pop("backend", "quanto")
   924 |             past_key_values = QuantizedCache(backend=backend, **cache_config)
   925 | 
   926 |         # Dynamic Caches
   927 |         else:
   928 |             dynamic_cache_kwargs = {}
   929 |             if generation_config.cache_implementation != "dynamic_full":
   930 |                 dynamic_cache_kwargs["config"] = self.config.get_text_config(decoder=True)
   931 |             if generation_config.cache_implementation == "offloaded":
   932 |                 dynamic_cache_kwargs["offloading"] = True
   933 |             past_key_values = DynamicCache(**dynamic_cache_kwargs)
   934 | 
   935 |         return past_key_values
   936 | 
   937 |     def _prepare_encoder_inputs(
   938 |         self,
   939 |         input_ids: torch.Tensor,
   940 |         attention_mask: torch.Tensor,
   941 |         encoder_position_ids: torch.Tensor,
   942 |         past_key_values: Cache,
   943 |         is_prefill: bool,
   944 |         canvas_length: int,
   945 |         batch_size: int,
   946 |         **model_kwargs,
   947 |     ) -> tuple[torch.Tensor, dict]:
   948 |         """Prepares the inputs for the encoder"""
   949 |         unprocessed_input_ids = input_ids if is_prefill else input_ids[:, -canvas_length:]
   950 |         # Clone with `memory_format=torch.contiguous_format` to prevent stride-related graph breaks
   951 |         unprocessed_input_ids = unprocessed_input_ids.clone(memory_format=torch.contiguous_format)
   952 | 
   953 |         # 2D -> 4D attention mask mapping. Calling it in advance prevents graph breaks
   954 |         dummy_input_embeds = torch.empty(
   955 |             (batch_size, unprocessed_input_ids.shape[1], 0), dtype=self.dtype, device=input_ids.device
   956 |         )
   957 |         encoder_mask_mapping = self.model.encoder.create_masks_for_generate(
   958 |             config=self.config,
   959 |             # we only need batch size, seq_length, dtype and device here - so we pass a 0-sized tensor with only the metadata
   960 |             inputs_embeds=dummy_input_embeds,
   961 |             attention_mask=attention_mask,
   962 |             past_key_values=past_key_values,
   963 |             position_ids=encoder_position_ids,
   964 |             mm_token_type_ids=model_kwargs.get("mm_token_type_ids"),
   965 |         )
   966 |         return unprocessed_input_ids, encoder_mask_mapping
   967 | 
   968 |     def _prepare_denoiser_inputs(
   969 |         self,
   970 |         decoder_attention_mask: torch.Tensor,
   971 |         past_key_values: Cache,
   972 |         sampler: EntropyBoundSampler,
   973 |         diffusion_stopping_criteria: DiffusionGemmaAdaptiveStopping | None,
   974 |         batch_size: int,
   975 |         device: torch.device,
   976 |         model_kwargs: dict,
   977 |     ) -> tuple:
   978 |         """Prepares the inputs for the denoising loop"""
   979 |         # These `model_kwargs` keys, when set, are consumed in the first encoder call
   980 |         for key in ("pixel_values", "image_position_ids", "mm_token_type_ids"):
   981 |             if key in model_kwargs:
   982 |                 del model_kwargs[key]
   983 | 
   984 |         # Randomly initialize a canvas of `canvas_length` tokens and prepare the 4D decoder attention mask
   985 |         # (The exception is if a user provides their own starting canvas, which gets consumed in the first
   986 |         # decoder call)
   987 |         current_canvas = model_kwargs.pop(
   988 |             "decoder_input_ids", sampler.initialize_canvas(batch_size=batch_size, device=device)
   989 |         )
   990 |         # (The same applies to the self-conditioning logits)
   991 |         self_conditioning_logits = model_kwargs.pop("self_conditioning_logits", None)
   992 | 
   993 |         mask_mapping = self.model.decoder.create_diffusion_decoder_attention_mask(
   994 |             config=self.config,
   995 |             inputs_embeds=current_canvas.unsqueeze(-1),  # we only need a dummy tensor with the same shape[:2] here
   996 |             past_key_values=past_key_values,
   997 |             decoder_attention_mask=decoder_attention_mask,
   998 |         )
   999 |         finished_denoising = torch.zeros(batch_size, dtype=torch.bool, device=device)
  1000 |         if diffusion_stopping_criteria is not None:
  1001 |             diffusion_stopping_criteria.reset()
  1002 | 
  1003 |         return current_canvas, self_conditioning_logits, mask_mapping, finished_denoising
  1004 | 
  1005 |     def _denoising_step(
  1006 |         self,
  1007 |         decoder_forward: Callable,
  1008 |         current_canvas: torch.Tensor,
  1009 |         argmax_canvas: torch.Tensor,
  1010 |         input_ids: torch.LongTensor,
  1011 |         decoder_position_ids: torch.LongTensor,
  1012 |         self_conditioning_logits: torch.Tensor,
  1013 |         mask_mapping: dict[str, torch.Tensor],
  1014 |         past_key_values: Cache,
  1015 |         finished_denoising: torch.Tensor,
  1016 |         cur_step: int,
  1017 |         sampler: EntropyBoundSampler,
  1018 |         logits_processor: LogitsProcessorList,
  1019 |         diffusion_stopping_criteria: DiffusionGemmaAdaptiveStopping | None,
  1020 |         **model_kwargs,
  1021 |     ):
  1022 |         """
  1023 |         Runs one denoising step. Please refer to the docstring in `generate` for more details.
  1024 |         """
  1025 |         # if we're compiling inner functions, `cur_step` as a plain `int` will trigger recompilations
  1026 |         cur_step = torch.tensor(cur_step, device=current_canvas.device, dtype=torch.int32)
  1027 |         torch.compiler.cudagraph_mark_step_begin()  # needed for the compiled EB sampler
  1028 | 
  1029 |         # 1.c.i Run the decoder, taking the current canvas, the encoder KV cache, and the self-conditioning
  1030 |         # logits (if available) as inputs.
  1031 |         decoder_outputs = decoder_forward(
  1032 |             decoder_input_ids=current_canvas,
  1033 |             self_conditioning_logits=self_conditioning_logits,
  1034 |             decoder_attention_mask=mask_mapping,
  1035 |             past_key_values=past_key_values,
  1036 |             decoder_position_ids=decoder_position_ids,
  1037 |             **model_kwargs,
  1038 |         )
  1039 |         raw_logits = decoder_outputs.logits
  1040 | 
  1041 |         # 1.c.ii Select new canvas tokens from the output logits.
  1042 |         processed_logits = logits_processor(input_ids, raw_logits, cur_step=cur_step)
  1043 |         probs = torch.softmax(processed_logits, dim=-1, dtype=torch.float32)
  1044 |         # `torch.multinomial` only works on 2D tensors, so we flatten/unflatten
  1045 |         vocab_size = self.config.text_config.vocab_size
  1046 |         batch_size, canvas_length = current_canvas.shape
  1047 |         denoiser_canvas = torch.multinomial(probs.view(-1, vocab_size), num_samples=1)
  1048 |         denoiser_canvas = denoiser_canvas.squeeze(-1).view(batch_size, canvas_length)
  1049 |         new_argmax_canvas = torch.argmax(processed_logits, dim=-1)
  1050 | 
  1051 |         # 1.c.iii Apply the sampler acceptance and renoising logic.
  1052 |         accepted_canvas = sampler.accept_canvas(current_canvas, denoiser_canvas, processed_logits, cur_step)
  1053 |         accepted_canvas = accepted_canvas.clone()  # clone needed for compiled sampler
  1054 |         new_current_canvas = sampler.renoise_canvas(accepted_canvas, cur_step)
  1055 |         new_current_canvas = new_current_canvas.clone()  # clone needed for compiled sampler
  1056 | 
  1057 |         # 1.c.iv Update the diffusion stopping criteria.
  1058 |         if diffusion_stopping_criteria is not None:
  1059 |             # If we have any batch item that has finished before, we don't want to update its results!
  1060 |             if finished_denoising.any():
  1061 |                 new_argmax_canvas = torch.where(finished_denoising[:, None], argmax_canvas, new_argmax_canvas)
  1062 |                 new_current_canvas = torch.where(finished_denoising[:, None], current_canvas, new_current_canvas)
  1063 |                 processed_logits = torch.where(
  1064 |                     finished_denoising[:, None, None], self_conditioning_logits, processed_logits
  1065 |                 )
  1066 | 
  1067 |             finished_denoising |= diffusion_stopping_criteria(new_argmax_canvas, processed_logits)
  1068 | 
  1069 |         # 1.c.v Use the output logits as self-conditioning logits for the next step.
  1070 |         embeddings_dtype = self.model.decoder.embed_tokens.weight.dtype
  1071 |         self_conditioning_logits = processed_logits.to(embeddings_dtype)
  1072 | 
  1073 |         return (
  1074 |             new_current_canvas,
  1075 |             new_argmax_canvas,
  1076 |             self_conditioning_logits,
  1077 |             finished_denoising,
  1078 |         )
  1079 | 
  1080 |     @staticmethod
  1081 |     def _finalize_canvas(
  1082 |         input_ids: torch.Tensor,
  1083 |         finished_sequences: torch.Tensor,
  1084 |         generation_config: DiffusionGemmaGenerationConfig,
  1085 |         stopping_criteria: StableAndConfidentStoppingCriteria,
  1086 |         canvas_length: int,
  1087 |         eos_tensor: torch.Tensor,
  1088 |     ) -> tuple[torch.Tensor, torch.Tensor]:
  1089 |         """Finalizes a newly generated canvas"""
  1090 |         finished_this_canvas = stopping_criteria(
  1091 |             input_ids,
  1092 |             None,
  1093 |             # `new_token_length` is used in the EosTokenCriteria to look for eos tokens in the whole canvas
  1094 |             new_token_length=canvas_length,
  1095 |         )
  1096 |         previously_finished_sequences = finished_sequences
  1097 |         finished_sequences = previously_finished_sequences | finished_this_canvas
  1098 |         pad_mask = None
  1099 |         if generation_config.pad_token_id is not None and torch.any(finished_sequences):
  1100 |             # finished sequences from previous canvases: all generated tokens get replaced by pad
  1101 |             input_ids[previously_finished_sequences, -canvas_length:] = generation_config.pad_token_id
  1102 |             # finished sequences from this canvas: all tokens after eos get replaced by pad
  1103 |             if generation_config.eos_token_id is not None and torch.any(finished_this_canvas):
  1104 |                 new_tokens = input_ids[:, -canvas_length:]
  1105 |                 is_eos = torch.isin(new_tokens, eos_tensor)
  1106 |                 eos_cumsum = is_eos.cumsum(dim=-1)
  1107 |                 pad_mask = (eos_cumsum > 0) & ~((eos_cumsum == 1) & is_eos)
  1108 |                 new_tokens[pad_mask] = generation_config.pad_token_id  # replaces `input_ids`
  1109 |         return input_ids, finished_sequences
  1110 | 
  1111 |     @staticmethod
  1112 |     def _prepare_kwargs_for_next_canvas(
  1113 |         attention_mask: torch.Tensor,
  1114 |         decoder_attention_mask: torch.Tensor,
  1115 |         decoder_position_ids: torch.Tensor,
  1116 |         canvas_length: int,
  1117 |         cur_len: int,
  1118 |     ) -> tuple:
  1119 |         """Prepares model inputs for the next canvas"""
  1120 |         cur_len += canvas_length
  1121 |         decoder_attention_mask = torch.nn.functional.pad(decoder_attention_mask, (0, canvas_length), value=True)
  1122 |         attention_mask = torch.nn.functional.pad(attention_mask, (0, canvas_length), value=True)
  1123 |         encoder_position_ids = decoder_position_ids
  1124 |         decoder_position_ids = torch.arange(
  1125 |             cur_len, cur_len + canvas_length, dtype=torch.int32, device=decoder_position_ids.device
  1126 |         ).unsqueeze(0)
  1127 |         return cur_len, decoder_attention_mask, attention_mask, encoder_position_ids, decoder_position_ids
  1128 | 
  1129 |     def _prepare_static_cache(self, cache_implementation: str, batch_size: int, max_length: int) -> Cache:
  1130 |         """
  1131 |         Sets a cache for `generate`, **that will persist across calls**. A new cache will only be initialized if a
  1132 |         new `generate` call requires a larger cache or uses a different batch size.
  1133 | 
  1134 |         Returns the resulting cache object.
  1135 | 
  1136 |         (NOTE: Originally copied from `GenerationMixin._prepare_static_cache` on 2026-03-27, and stripped down
  1137 |         for DiffusionGemma.)
  1138 |         """
  1139 |         # TODO(joao, raushan): refactor `GenerationMixin` and this to reuse logic without requiring inheritance.
  1140 |         offload_cache = "offloaded" in cache_implementation
  1141 | 
  1142 |         cache_to_check: StaticCache | None = None
  1143 |         if hasattr(self, "_cache") and isinstance(self._cache, StaticCache):
  1144 |             cache_to_check = self._cache
  1145 | 
  1146 |         need_new_cache = (
  1147 |             cache_to_check is None
  1148 |             or cache_to_check.offloading != offload_cache
  1149 |             or cache_to_check.max_batch_size != batch_size
  1150 |             or cache_to_check.max_cache_len < max_length
  1151 |         )
  1152 | 
  1153 |         if need_new_cache:
  1154 |             cache_kwargs = {
  1155 |                 "config": self.config.get_text_config(decoder=True),
  1156 |                 "max_cache_len": max_length,
  1157 |                 "offloading": offload_cache,
  1158 |             }
