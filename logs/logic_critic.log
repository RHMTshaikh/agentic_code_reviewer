   319 |     def prepare_batch_tensors(
   320 |         self,
   321 |         requests_in_batch: list[FutureRequestState],
   322 |         logits_processors: ContinuousBatchingLogitsProcessorList,
   323 |         use_decode_fast_path: bool,
   324 |         num_q_tokens: int,
   325 |         max_kv_read: int,
   326 |         use_padding: bool,
   327 |     ) -> None:
   328 |         """Prepare tensors and metadata for the next model forward pass, using the given requests as data. This method:
   329 | 
   330 |         1. Resets the static tensors from the previous batch
   331 |         2. Iterates through requests to accumulate input_ids, position_ids, and sequence lengths
   332 |         3. Extends read/write indices for cache management
   333 |         4. Builds attention masks if needed (for eager/SDPA implementations)
   334 |         5. Converts accumulated lists to tensors and copies them to static storage
   335 | 
   336 |         This method also modifies the `position_offset` attribute of each request to track progress and adds a
   337 |         temporary token at the end of the requests for which there will a new token.
   338 |         """
   339 |         # Keep track of this requests in the batch, which will be useful to update the batch later
   340 |         if not requests_in_batch:
   341 |             raise ValueError("No requests in batch")
   342 | 
   343 |         # Determine if the block table is used before we start to prepare the batch, to avoid useless preparation
   344 |         self.use_block_table = use_decode_fast_path and self.block_table.numel() > 0
   345 |         # Memoize the length of Q and KV
   346 |         self.num_q_tokens = num_q_tokens
   347 |         self.max_kv_read = 0 if self.use_block_table else max_kv_read  # No need to track KV read for decode-fast-path
   348 |         self.num_request_in_batch = len(requests_in_batch)
   349 |         # Reset the static storage that is going to be used for the next batch
   350 |         self._reset_static_tensors()
   351 | 
   352 |         # Reset accumulators
   353 |         self.true_read_sizes = [0 for _ in range(self.cache.num_groups)]
   354 |         self.true_write_sizes = [0 for _ in range(self.cache.num_groups)]
   355 |         self.requests_in_batch = []
   356 |         self.req_id_to_new_token_position = {}
   357 | 
   358 |         # Prepare accumulators. For batches with no past cache to read, we leave read_index empty: the cache.update
   359 |         # will detect the 0-size indices and skip the read.
   360 |         input_ids = []
   361 |         position_ids = []
   362 |         cumulative_seqlens_q = [0]
   363 |         logits_indices = []
   364 |         cumulative_seqlens_k = {layer_type: [0] for layer_type in self.cumulative_seqlens_k.keys()}
   365 |         write_index = [[] for _ in range(self.cache.num_groups)]
   366 |         read_index = None if self.max_kv_read == 0 else [[] for _ in range(self.cache.num_groups)]
   367 | 
   368 |         # Go through all the requests in the batch
   369 |         for i, future_state in enumerate(requests_in_batch):
   370 |             # First we retrieve the lengths related to the request
   371 |             state = future_state.state
   372 |             past_length = state.position_offset
   373 |             query_length = future_state.query_length
   374 |             seqlens_k = self.cache.get_seqlens_k(past_length, query_length)
   375 | 
   376 |             # Update the internal state of the request
   377 |             state.position_offset += query_length
   378 | 
   379 |             # Then we accumulate for the object used in the kwargs
   380 |             input_ids.extend(state.tokens_to_process)
   381 |             position_ids.extend(range(past_length, past_length + query_length))
   382 |             cumulative_seqlens_q.append(cumulative_seqlens_q[-1] + query_length)
   383 |             self.max_seqlen_q = max(self.max_seqlen_q, query_length)
   384 | 
   385 |             # Accumulate the key sequence lengths for the current request
   386 |             for layer_type, layer_type_seqlen_k in seqlens_k.items():
   387 |                 cumulative_seqlens_k[layer_type].append(cumulative_seqlens_k[layer_type][-1] + layer_type_seqlen_k)
   388 |                 self.max_seqlen_k[layer_type] = max(self.max_seqlen_k[layer_type], layer_type_seqlen_k)
   389 | 
   390 |             # We extend the read and write indices for the cache, or fill the block table for decode-only batches
   391 |             if self.use_block_table:
   392 |                 self.cache.fill_block_table(state.request_id, past_length, query_length, self.block_table[:, i])
   393 |             else:
   394 |                 self.cache.extend_read_and_write_indices(
   395 |                     state.request_id, past_length, query_length, read_index, write_index
   396 |                 )
   397 | 
   398 |             # If the request has no remaining prefill tokens, it means the next token prediction is relevant
   399 |             if future_state.has_new_token:
   400 |                 logits_indices.append(cumulative_seqlens_q[-1] - 1)
   401 |                 state.tokens_to_process = [TMP_TOKEN_ID]
   402 |                 self.req_id_to_new_token_position[state.request_id] = logits_indices[-1]
   403 | 
   404 |             self.requests_in_batch.append(future_state)
