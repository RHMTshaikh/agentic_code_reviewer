  1281 |                 value = [self.convert_ids_to_tokens(v) for v in value]
  1282 |             if not isinstance(value, (list, tuple)) and value is not None:
  1283 |                 raise ValueError(f"extra_special_tokens must be a list or tuple, got {type(value)}")
