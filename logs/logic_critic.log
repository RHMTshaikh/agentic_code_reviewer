   3 | def _build_rotation_matrix(vector, angle):
   4 |     """
   5 |     Generates a 3x3 rotation matrix from an axis and an angle.
   6 |     
   7 |     Args:
   8 |         axis (np.ndarray): 3-element vector representing the rotation axis.
   9 |         angle (float): Rotation angle in radians.
  10 | 
  11 |     Returns:
  12 |         np.ndarray: The 3x3 rotation matrix.
  13 |     """
  14 |     cos_theta = np.cos(angle)
  15 |     sin_theta = np.sin(angle)
  16 |     
  17 |     I = np.identity(3)
  18 |     K = np.array([
  19 |         [0, -vector[2], vector[1]],
  20 |         [vector[2], 0, -vector[0]],
  21 |         [-vector[1], vector[0], 0]
  22 |     ])
  23 |     K2 = np.outer(vector, vector) - I
  24 |     R = I + sin_theta * K + (1 - cos_theta) * K2
  25 |     return R

