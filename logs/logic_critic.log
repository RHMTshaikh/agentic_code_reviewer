  2948 |                 getattr(auto_module, PLACEHOLDER_TO_AUTO_MODULE["config_class"][0]),
  2949 |                 PLACEHOLDER_TO_AUTO_MODULE["config_class"][1],
  2950 |             )[model_name_lowercase]
  2951 |         except KeyError:
  2952 |             if model_name_lowercase in HARDCODED_CONFIG_FOR_MODELS:
