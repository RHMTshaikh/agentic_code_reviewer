   137 |                 # requests are not: they hold no cache and can simply keep waiting.
   138 |                 if state.request_id in self.active_requests:
   139 |                     physical_blocks = self.cache.blocks_needed(blocks_needed, state.allocated_blocks)
   140 |                     self.starved_requests.append((state, physical_blocks))
