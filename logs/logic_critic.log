   338 |             attention_context_right=1,
   339 |             use_clipped_linears=False,
   340 |         )
   341 | 
   342 |         module = Gemma4AudioRelPositionalEncoding(config)
   343 |         hidden_states = torch.zeros(1, 3, config.hidden_size)
   344 | 
   345 |         pos = module(hidden_states)
   346 | 
   347 |         context_size = config.attention_chunk_size + config.attention_context_left - 1 + config.attention_context_right
   348 |         expected_len = context_size // 2 + 1
   349 | 
   350 |         self.assertEqual(pos.shape, (1, expected_len, config.hidden_size))
   351 | 
   352 |         position_ids = torch.arange(context_size // 2, -1, -1, device=hidden_states.device)[..., None]
   353 |         scaled_time = position_ids * module.inv_timescales.to(device=hidden_states.device)
   354 |         expected = torch.cat([torch.sin(scaled_time), torch.cos(scaled_time)], dim=-1).to(hidden_states.dtype)
