  3586 | 
  3587 |                 # If the param was offloaded, we need to load it back from disk to resave it. It's a strange pattern,
  3588 |                 # but it would otherwise not be contained in the saved shard if we were to simply move the file
  3589 |                 # or something
  3590 |                 if is_offloaded and tensor.device.type == "meta":
  3591 |                     tensor = load_offloaded_parameter(model_to_save, tensor_name)
  3592 | 
  3593 |                 # only do contiguous after it's permuted correctly in case of TP
  3594 |                 shard_state_dict[tensor_name] = tensor.contiguous()
  3595 | 
  3596 |             # TODO: it would be very nice to do the writing concurrently, but safetensors never releases the GIL,
  3597 |             # so it's not possible for now....
