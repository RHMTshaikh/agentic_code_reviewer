   835 |             # add LayerDrop (see https://huggingface.co/papers/1909.11556 for description)
   836 |             dropout_probability = torch.rand([])
   837 |             skip_the_layer = self.training and dropout_probability < self.layerdrop
   838 |             if not skip_the_layer or synced_gpus:
