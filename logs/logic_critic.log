  1226 |     def get_text_config(self, decoder=None, encoder=None) -> "PreTrainedConfig":
  1227 |         """
  1228 |         Returns the text config related to the text input (encoder) or text output (decoder) of the model. The
  1229 |         `decoder` and `encoder` input arguments can be used to specify which end of the model we are interested in,
  1230 |         which is useful on models that have both text input and output modalities.
  1231 | 
  1232 |         There are three possible outcomes of using this method:
  1233 |         1. On most models, it returns the original config instance itself.
  1234 |         2. On newer (2024+) composite models, it returns the text section of the config, which is nested under a set
  1235 |             of valid names.
  1236 |         3. On older (2023-) composite models, it discards decoder-only parameters when `encoder=True` and vice-versa.
  1237 | 
  1238 |         Args:
  1239 |             decoder (`Optional[bool]`, *optional*):
  1240 |                 If set to `True`, then only search for decoder config names.
  1241 |             encoder (`Optional[bool]`, *optional*):
  1242 |                 If set to `True`, then only search for encoder config names.
  1243 |         """
  1244 |         return_both = decoder == encoder  # both unset or both set -> search all possible names
  1245 | 
  1246 |         decoder_possible_text_config_names = ("decoder", "generator", "text_config")
  1247 |         encoder_possible_text_config_names = ("text_encoder",)
  1248 |         if return_both:
  1249 |             possible_text_config_names = encoder_possible_text_config_names + decoder_possible_text_config_names
  1250 |         elif decoder:
  1251 |             possible_text_config_names = decoder_possible_text_config_names
  1252 |         else:
  1253 |             possible_text_config_names = encoder_possible_text_config_names
  1254 | 
  1255 |         valid_text_config_names = []
  1256 |         for text_config_name in possible_text_config_names:
  1257 |             if hasattr(self, text_config_name):
  1258 |                 text_config = getattr(self, text_config_name, None)
  1259 |                 if text_config is not None:
  1260 |                     valid_text_config_names += [text_config_name]
  1261 | 
  1262 |         if len(valid_text_config_names) > 1:
  1263 |             raise ValueError(
  1264 |                 f"Multiple valid text configs were found in the model config: {valid_text_config_names}. In this "
  1265 |                 "case, using `get_text_config()` would be ambiguous. Please specify the desired text config directly, "
  1266 |                 "e.g. `text_config = config.sub_config_name`"
  1267 |             )
  1268 |         elif len(valid_text_config_names) == 1:
  1269 |             config_to_return = getattr(self, valid_text_config_names[0])
  1270 |         else:
  1271 |             config_to_return = self
  1272 | 
  1273 |         # handle legacy models with flat config structure, when we only want one of the configs
  1274 |         if not return_both and len(valid_text_config_names) == 0 and config_to_return.is_encoder_decoder:
  1275 |             config_to_return = copy.deepcopy(config_to_return)
  1276 |             prefix_to_keep = "decoder" if decoder else "encoder"
  1277 |             for key in config_to_return.to_dict():
  1278 |                 # NOTE: We can't discard keys because:
  1279 |                 # 1) we can't truly delete a cls attribte on a dataclass; 2) we can't set the value to `None` due to
  1280 |                 # strict validation. So we just keep it as is, since there are only a couple old models falling in this condition
