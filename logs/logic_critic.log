  3176 | 
  3177 |         # Check if the covariance is positive definite.
  3178 |         epsilon = 1e-9
  3179 |         is_covariance_psd = constraints.positive_definite.check(epsilon * covariance).all()
  3180 |         if is_covariance_psd:
  3181 |             # If covariances is positive definite, a distribution can be created. and we can sample new weights from it.
  3182 |             distribution = torch.distributions.multivariate_normal.MultivariateNormal(
  3183 |                 mean_embeddings, covariance_matrix=epsilon * covariance
  3184 |             )
  3185 |             new_embeddings.weight.data[-1 * added_num_tokens :, :] = distribution.sample(
  3186 |                 sample_shape=(added_num_tokens,)
  3187 |             ).to(old_embeddings.weight.dtype)
  3188 |         else:
  3189 |             # Otherwise, just initialize with the mean. because distribution will not be created.
  3190 |             new_embeddings.weight.data[-1 * added_num_tokens :, :] = (
  3191 |                 mean_embeddings[None, :].repeat(added_num_tokens, 1).to(old_embeddings.weight.dtype)
  3192 |             )
  3193 | 
  3194 |     def _init_added_lm_head_weights_with_mean(
  3195 |         self,
  3196 |         old_lm_head,
  3197 |         new_lm_head,
  3198 |         old_lm_head_dim,
  3199 |         old_num_tokens,
  3200 |         added_num_tokens,
  3201 |         transposed: bool = False,
  3202 |     ):
  3203 |         if transposed:
  3204 |             # Transpose to the desired shape for the function.
  3205 |             new_lm_head.weight.data = new_lm_head.weight.data.T
  3206 |             old_lm_head.weight.data = old_lm_head.weight.data.T
  3207 | 
  3208 |         # The same initialization logic as Embeddings.
  3209 |         self._init_added_embeddings_weights_with_mean(old_lm_head, new_lm_head, old_num_tokens, added_num_tokens)
  3210 | 
  3211 |         if transposed:
  3212 |             # Transpose again to the correct shape.
  3213 |             new_lm_head.weight.data = new_lm_head.weight.data.T
  3214 |             old_lm_head.weight.data = old_lm_head.weight.data.T
  3215 | 
  3216 |     def _init_added_lm_head_bias_with_mean(self, old_lm_head, new_lm_head, added_num_tokens):
  3217 |         bias_mean = torch.mean(old_lm_head.bias.data, axis=0, dtype=torch.float32)
  3218 |         bias_std = torch.std(old_lm_head.bias.data, axis=0).to(torch.float32)
  3219 |         new_lm_head.bias.data[-1 * added_num_tokens :].normal_(mean=bias_mean, std=1e-9 * bias_std)
  3220 | 
  3221 |     def _copy_lm_head_original_to_resized(
  3222 |         self, new_lm_head, old_lm_head, num_tokens_to_copy, transposed, has_new_lm_head_bias
  3223 |     ):
  3224 |         # Copy old lm head weights to new lm head
  3225 |         if not transposed:
  3226 |             new_lm_head.weight.data[:num_tokens_to_copy, :] = old_lm_head.weight.data[:num_tokens_to_copy, :]
  3227 |         else:
  3228 |             new_lm_head.weight.data[:, :num_tokens_to_copy] = old_lm_head.weight.data[:, :num_tokens_to_copy]
  3229 | 
  3230 |         # Copy bias weights to new lm head
  3231 |         if has_new_lm_head_bias:
  3232 |             new_lm_head.bias.data[:num_tokens_to_copy] = old_lm_head.bias.data[:num_tokens_to_copy]
