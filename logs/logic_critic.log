  3075 | def process_type_annotation(type_input, param_name: str | None = None) -> tuple[str, bool]:
  3076 |     """
  3077 |     Unified function to process and format a parameter's type annotation.
  3078 | 
  3079 |     This function intelligently handles both type objects (from inspect.Parameter.annotation)
  3080 |     and string representations of types. It will:
  3081 |     - Use type introspection when given a type object (preserves generic arguments)
  3082 |     - Parse string representations when that's all that's available
  3083 |     - Always return a formatted type string and optional flag
  3084 | 
  3085 |     Handles various type representations including:
  3086 |     - Type objects with generics (e.g., list[str], Optional[int])
  3087 |     - Union types (both Union[X, Y] and X | Y syntax)
  3088 |     - Modern union syntax with | (e.g., "bool | None")
  3089 |     - Complex typing constructs (Union, Optional, Annotated, etc.)
  3090 |     - Generic types with brackets
  3091 |     - Class type strings
  3092 |     - Simple types and module paths
  3093 | 
  3094 |     Args:
  3095 |         type_input: Either a type annotation object or a string representation of a type
  3096 |         param_name (`str | None`): The parameter name (used for legacy module path handling)
  3097 | 
  3098 |     Returns:
  3099 |         tuple[str, bool]: (formatted_type_string, is_optional)
  3100 |     """
  3101 |     optional = False
  3102 | 
  3103 |     # Path 1: Type object (best approach - preserves generic type information)
  3104 |     if not isinstance(type_input, str):
  3105 |         # Handle None type
  3106 |         if type_input is None or type_input is type(None):
  3107 |             return "None", True
  3108 | 
  3109 |         # Handle Union types and modern UnionType (X | Y)
  3110 |         if get_origin(type_input) is Union or get_origin(type_input) is UnionType:
  3111 |             subtypes = get_args(type_input)
  3112 |             out_str = []
  3113 |             for subtype in subtypes:
  3114 |                 if subtype is type(None):
  3115 |                     optional = True
  3116 |                     continue
  3117 |                 formatted_type = _format_type_annotation_recursive(subtype)
  3118 |                 out_str.append(formatted_type)
  3119 | 
  3120 |             if not out_str:
  3121 |                 return "", optional
  3122 |             elif len(out_str) == 1:
  3123 |                 return out_str[0], optional
  3124 |             else:
  3125 |                 return f"Union[{', '.join(out_str)}]", optional
  3126 | 
  3127 |         # Single type (not a Union)
  3128 |         formatted_type = _format_type_annotation_recursive(type_input)
  3129 |         return formatted_type, optional
  3130 | 
  3131 |     # Path 2: String representation (fallback when we only have strings)
  3132 |     param_type = type_input
  3133 | 
  3134 |     # Handle Union types with | syntax
  3135 |     if " | " in param_type:
  3136 |         # Modern union syntax (e.g., "bool | None")
  3137 |         parts = [p.strip() for p in param_type.split(" | ")]
  3138 |         if "None" in parts:
  3139 |             optional = True
  3140 |             parts = [p for p in parts if p != "None"]
  3141 |         param_type = " | ".join(parts) if parts else ""
  3142 |         # Clean up module prefixes including typing
  3143 |         param_type = "".join(param_type.split("typing.")).replace("transformers.", "~").replace("builtins.", "")
  3144 | 
  3145 |     elif "typing" in param_type or "Union[" in param_type or "Optional[" in param_type or "[" in param_type:
  3146 |         # Complex typing construct or generic type - clean up typing module references
  3147 |         param_type = "".join(param_type.split("typing.")).replace("transformers.", "~")
  3148 | 
  3149 |     elif "<class '" in param_type:
  3150 |         # This is a class type like "<class 'module.ClassName'>" - should NOT append param_name
  3151 |         param_type = (
  3152 |             param_type.replace("transformers.", "~").replace("builtins.", "").replace("<class '", "").replace("'>", "")
  3153 |         )
  3154 | 
  3155 |     else:
  3156 |         # Simple type or module path - only append param_name if it looks like a module path
  3157 |         # This is legacy behavior for backwards compatibility
  3158 |         if param_name and "." in param_type and not param_type.split(".")[-1][0].isupper():
  3159 |             # Looks like a module path ending with an attribute
  3160 |             param_type = f"{param_type.replace('transformers.', '~').replace('builtins', '')}.{param_name}"
  3161 |         else:
  3162 |             # Simple type name, don't append param_name
  3163 |             param_type = param_type.replace("transformers.", "~").replace("builtins.", "")
  3164 | 
  3165 |     # Clean up ForwardRef
  3166 |     if "ForwardRef" in param_type:
  3167 |         param_type = _re_forward_ref.sub(r"\1", param_type)
  3168 | 
  3169 |     # Handle Optional wrapper
  3170 |     if "Optional" in param_type:
  3171 |         param_type = _re_optional.sub(r"\1", param_type)
  3172 |         optional = True
  3173 | 
  3174 |     return param_type, optional
  3175 | 
  3176 | 
  3177 | def _process_parameter_type(param):
  3178 |     """
  3179 |     Process and format a parameter's type annotation from an inspect.Parameter object.
  3180 | 
  3181 |     Args:
  3182 |         param (`inspect.Parameter`): The parameter from the function signature
  3183 | 
  3184 |     Returns:
  3185 |         tuple[str, bool]: (formatted_type_string, is_optional)
  3186 |     """
  3187 |     if param.annotation == inspect.Parameter.empty:
  3188 |         return "", False
  3189 | 
  3190 |     # Use the unified function to process the type annotation
  3191 |     formatted_type, optional = process_type_annotation(param.annotation)
  3192 | 
  3193 |     # Check if parameter has a default value (makes it optional)
