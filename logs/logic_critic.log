  2835 | def format_args_docstring(docstring: str, model_name: str) -> str:
  2836 |     """
  2837 |     Replaces placeholders such as {image_processor_class} in the docstring with the actual values,
  2838 |     deducted from the model name and the auto modules.
  2839 |     """
  2840 |     # first check if there are any placeholders in the docstring, if not return it as is
  2841 |     placeholders = set(_re_placeholders.findall(docstring))
  2842 |     if not placeholders:
  2843 |         return docstring
  2844 | 
  2845 |     # get the placeholders dictionary for the given model name
  2846 |     placeholders_dict = get_placeholders_dict(placeholders, model_name)
  2847 |     # replace the placeholders in the docstring with the values from the placeholders_dict
  2848 |     for placeholder, value in placeholders_dict.items():
  2849 |         if isinstance(value, dict) and placeholder == "image_processor_class":
  2850 |             value = value.get("torchvision", value.get("pil", None))
  2851 |         if placeholder is not None:
  2852 |             docstring = docstring.replace(f"{{{placeholder}}}", value)
  2853 |     return docstring
