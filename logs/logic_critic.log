  2608 |                 "You are calling .generate() with the `input_ids` being on a device type different"
  2609 |                 f" than your model's device. `input_ids` is on {input_ids.device.type}, whereas the model"
  2610 |                 f" is on {self.device.type}. You may experience unexpected behaviors or slower generation."
  2611 |                 " Please make sure that you have put `input_ids` to the"
  2612 |                 f" correct device by calling for example input_ids = input_ids.to('{self.device.type}') before"
  2613 |                 " running `.generate()`.",
  2614 |                 UserWarning,
  2615 |             )
  2616 | 
  2617 |         # 8. Prepare logits processors and stopping criteria
  2618 |         prepared_logits_processor = self._get_logits_processor(
  2619 |             generation_config=generation_config,
  2620 |             input_ids_seq_length=input_ids_length,
  2621 |             encoder_input_ids=inputs_tensor,
  2622 |             prefix_allowed_tokens_fn=prefix_allowed_tokens_fn,
  2623 |             logits_processor=logits_processor,
  2624 |             device=inputs_tensor.device,
  2625 |             model_kwargs=model_kwargs,
  2626 |             negative_prompt_ids=negative_prompt_ids,
  2627 |             negative_prompt_attention_mask=negative_prompt_attention_mask,
  2628 |         )
  2629 |         prepared_stopping_criteria = self._get_stopping_criteria(
  2630 |             generation_config=generation_config,
  2631 |             stopping_criteria=stopping_criteria,
  2632 |             tokenizer=generation_mode_kwargs.get("tokenizer"),
  2633 |         )
  2634 | 
  2635 |         # Set model_kwargs `use_cache` so we can use it later in forward runs
