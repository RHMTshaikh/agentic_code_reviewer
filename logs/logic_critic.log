   217 |     # Class attributes that we don't want to save or have in `self.__dict__`
   218 |     # They are not supposed to be set/changed by users. Each field is set when
   219 |     # creating a model class
   220 |     base_config_key: ClassVar[str] = ""
   221 |     sub_configs: ClassVar[dict[str, type["PreTrainedConfig"]]] = {}
   222 |     has_no_defaults_at_init: ClassVar[bool] = False
   223 |     keys_to_ignore_at_inference: ClassVar[list[str]] = []
   224 |     attribute_map: ClassVar[dict[str, str]] = {}
   225 |     base_model_tp_plan: ClassVar[dict[str, Any] | None] = None
   226 |     base_model_fsdp_plan: ClassVar[dict[Any, str] | None] = None
   227 |     base_model_pp_plan: ClassVar[dict[str, Sequence[list[str]]] | None] = None
   228 |     base_model_ep_plan: ClassVar[dict[str, Sequence[list[str]]] | None] = None
   229 |     _auto_class: ClassVar[str | None] = None
   230 | 
   231 |     # Attributes set internally when saving and used to infer model
   232 |     # class for `Auto` mapping
   233 |     model_type: ClassVar[str] = ""
   234 |     transformers_version: str | None = None
   235 |     architectures: list[str] | None = None
   236 | 
   237 |     # Common attributes for all models
   238 |     output_hidden_states: bool | None = False
   239 |     return_dict: bool | None = True
   240 |     dtype: Union[str, "torch.dtype"] | None = None
   241 |     chunk_size_feed_forward: int = 0
   242 |     is_encoder_decoder: bool = False
   243 | 
   244 |     # Fine-tuning task arguments
   245 |     id2label: dict[int, str] | dict[str, str] | None = None
   246 |     label2id: dict[str, int] | dict[str, str] | None = None
   247 |     problem_type: Literal["regression", "single_label_classification", "multi_label_classification"] | None = None
   248 | 
   249 |     def __post_init__(self, **kwargs):
   250 |         # BC for the `torch_dtype` argument instead of the simpler `dtype`
   251 |         # Do not warn, as it would otherwise always be triggered since most configs on the hub have `torch_dtype`
   252 |         if (torch_dtype := kwargs.pop("torch_dtype", None)) is not None:
   253 |             # If both are provided, keep `dtype`
   254 |             self.dtype = self.dtype if self.dtype is not None else torch_dtype
   255 |         if self.dtype is not None and isinstance(self.dtype, str) and is_torch_available():
   256 |             # we will start using self.dtype in v5, but to be consistent with
   257 |             # from_pretrained's dtype arg convert it to an actual torch.dtype object
   258 |             import torch
   259 | 
   260 |             self.dtype = getattr(torch, self.dtype)
   261 | 
   262 |         # Keep the default value of `num_labels=2` in case users have saved a classfier with 2 labels
   263 |         # Our configs prev wouldn't save `id2label` for 2 labels because it is the default. In all other
   264 |         # cases we expect the config dict to have an `id2label` field if it's a clf model, or not otherwise
   265 |         if self.id2label is None:
   266 |             self.num_labels = kwargs.get("num_labels", 2)
   267 |         else:
   268 |             if kwargs.get("num_labels") is not None and len(self.id2label) != kwargs.get("num_labels"):
   269 |                 logger.warning(
   270 |                     f"You passed `num_labels={kwargs.get('num_labels')}` which is incompatible to "
   271 |                     f"the `id2label` map of length `{len(self.id2label)}`."
   272 |                 )
   273 |             # Keys are always strings in JSON so convert ids to int
   274 |             self.id2label = {int(key): value for key, value in self.id2label.items()}
   275 | 
   276 |         if self.problem_type == "single_label_classification" and self.num_labels == 1:
   277 |             raise ValueError(
   278 |                 '`problem_type="single_label_classification"` requires `num_labels > 1`. For binary '
   279 |                 'classification use `num_labels=2`, or use `problem_type="regression"` for a '
   280 |                 "single-output regression head."
   281 |             )
   282 | 
   283 |         # BC for rotary embeddings. We will pop out legacy keys from kwargs and rename to new format
   284 |         if hasattr(self, "rope_parameters"):
   285 |             kwargs = self.convert_rope_params_to_dict(**kwargs)
   286 |         elif kwargs.get("rope_scaling") and kwargs.get("rope_theta"):
   287 |             logger.warning(
   288 |                 f"{self.__class__.__name__} got `key=rope_scaling` in kwargs but hasn't set it as attribute. "
   289 |                 "For RoPE standardization you need to set `self.rope_parameters` in model's config. "
   290 |             )
   291 |             kwargs = self.convert_rope_params_to_dict(**kwargs)
   292 | 
   293 |         # Parameters for sequence generation saved in the config are popped instead of loading them.
   294 |         for parameter_name in GenerationConfig._get_default_generation_params().keys():
   295 |             kwargs.pop(parameter_name, None)
   296 | 
   297 |         # Name or path to the pretrained checkpoint
   298 |         self._name_or_path = str(kwargs.pop("name_or_path", ""))
   299 |         self._commit_hash = kwargs.pop("_commit_hash", None)
   300 | 
   301 |         # Attention/Experts implementation to use, if relevant (it sets it recursively on sub-configs)
   302 |         self._output_attentions: bool | None = kwargs.pop("output_attentions", False)
   303 |         self._attn_implementation: str | None = kwargs.pop("attn_implementation", None)
   304 |         self._experts_implementation: str | None = kwargs.pop("experts_implementation", None)
   305 | 
   306 |         # Additional attributes without default values
   307 |         for key, value in kwargs.items():
   308 |             # Check this to avoid deserializing problematic fields from hub configs - they should use the public field
   309 |             if key not in ("_attn_implementation_internal", "_experts_implementation_internal"):
   310 |                 try:
   311 |                     setattr(self, key, value)
   312 |                 except AttributeError as err:
   313 |                     logger.error(f"Can't set {key} with value {value} for {self}")
   314 |                     raise err
   315 | 
   316 |     def __init_subclass__(cls, *args, **kwargs):
   317 |         super().__init_subclass__(*args, **kwargs)
   318 |         cls_has_custom_init = "__init__" in cls.__dict__
   319 |         # kw_only=True ensures fields without defaults in subclasses can follow
   320 |         # parent fields that have defaults (Python dataclass ordering rule).
   321 |         # Config fields are always passed as keyword arguments, so this is safe.
   322 |         cls = dataclass(cls, repr=False, kw_only=True)
   323 | 
   324 |         if not cls_has_custom_init:
   325 |             # Wrap all subclasses to accept arbitrary kwargs for BC
   326 |             # only if the subclass has no custom `__init__`. Most
   327 |             # remote code has an init defined, but some model are not
   328 |             # See https://huggingface.co/hmellor/Ilama-3.2-1B/blob/main/configuration_ilama.py
   329 |             cls = wrap_init_to_accept_kwargs(cls)
