   232 | class MiniCPM3Attention(nn.Module):
   233 |     """
   234 |     Multi-head Latent Attention (MLA), structurally identical to `DeepseekV2Attention`.
   235 |     The only difference is the rotary convention: MiniCPM3 keeps the original cos/sin RoPE
   236 |     (`apply_rotary_pos_emb`) instead of DeepSeek-V2's complex rotary, so we inherit the
   237 |     module construction and override only `forward`.
   238 |     """
   239 | 
   240 |     def __init__(self, config: MiniCPM3Config, layer_idx: int | None = None):
