  3271 |     docstring = ""
  3272 |     # Check if this is a processor by inspecting class hierarchy
  3273 |     is_processor = _is_processor_class(func, parent_class)
  3274 | 
  3275 |     # Use appropriate args source based on whether it's a processor or not
  3276 |     if source_args_dict is None:
  3277 |         if is_processor:
  3278 |             source_args_dict = get_args_doc_from_source([ModelArgs, ImageProcessorArgs, ProcessorArgs])
  3279 |         else:
  3280 |             source_args_dict = get_args_doc_from_source([ModelArgs, ImageProcessorArgs])
  3281 | 
  3282 |     missing_args = {}
  3283 | 
  3284 |     for param_name, param in sig.parameters.items():
  3285 |         # Skip parameters that should be ignored
  3286 |         if (
  3287 |             param_name in ARGS_TO_IGNORE
  3288 |             or param_name.startswith("_")  # Private/internal params (e.g. ClassVar-backed fields in configs)
  3289 |             or param.kind == inspect.Parameter.VAR_POSITIONAL
  3290 |             or param.kind == inspect.Parameter.VAR_KEYWORD
  3291 |         ):
  3292 |             continue
  3293 |         # When a filter is active (e.g. config classes: only own annotations), skip inherited params
  3294 |         if allowed_params is not None and param_name not in allowed_params:
  3295 |             continue
  3296 | 
  3297 |         # When a filter is active (e.g. config classes: only own annotations), skip inherited params
  3298 |         if allowed_params is not None and param_name not in allowed_params:
  3299 |             continue
  3300 | 
  3301 |         param_name = ARGS_TO_RENAME.get(param_name, param_name)
  3302 | 
  3303 |         # Process parameter type and optional status
