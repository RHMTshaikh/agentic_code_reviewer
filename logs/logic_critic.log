  1460 |     def __post_init__(self):
  1461 |         # ── 1. Defaults & Normalization ──
  1462 |         if self.output_dir is None:
  1463 |             self.output_dir = "trainer_output"
  1464 |             logger.info(
  1465 |                 "No output directory specified, defaulting to 'trainer_output'. "
  1466 |                 "To change this behavior, specify --output_dir when creating TrainingArguments."
  1467 |             )
  1468 | 
  1469 |         # Parse JSON string dict args from CLI (e.g., '{"key": "value"}').
  1470 |         # Only parses strings starting with '{'; other strings are treated as file paths.
  1471 |         for valid_field in self._VALID_DICT_FIELDS:
  1472 |             passed_value = getattr(self, valid_field)
  1473 |             if isinstance(passed_value, str) and passed_value.startswith("{"):
  1474 |                 loaded_dict = json.loads(passed_value)
  1475 |                 loaded_dict = _convert_str_dict(loaded_dict)
  1476 |                 setattr(self, valid_field, loaded_dict)
  1477 | 
  1478 |         # Expand ~ in paths so os.makedirs works correctly (#10628)
  1479 |         if self.output_dir is not None:
  1480 |             self.output_dir = os.path.expanduser(self.output_dir)
  1481 | 
  1482 |         if self.disable_tqdm is None:
  1483 |             self.disable_tqdm = logger.getEffectiveLevel() > logging.WARN
  1484 | 
  1485 |         if self.warmup_ratio is not None:
  1486 |             logger.warning("warmup_ratio is deprecated and will be removed in v5.2. Use `warmup_steps` instead.")
  1487 |             self.warmup_steps = self.warmup_ratio
  1488 | 
  1489 |         if self.logging_dir is not None:
  1490 |             logger.warning(
  1491 |                 "`logging_dir` is deprecated and will be removed in v5.2. Please set `TENSORBOARD_LOGGING_DIR` instead."
  1492 |             )
  1493 | 
  1494 |         if isinstance(self.include_num_input_tokens_seen, bool):
  1495 |             self.include_num_input_tokens_seen = "all" if self.include_num_input_tokens_seen else "no"
  1496 | 
  1497 |         # ── 2. Enum / Type Conversions ──
  1498 |         self.eval_strategy = IntervalStrategy(self.eval_strategy)
  1499 |         self.logging_strategy = IntervalStrategy(self.logging_strategy)
  1500 |         self.save_strategy = SaveStrategy(self.save_strategy)
  1501 |         self.hub_strategy = HubStrategy(self.hub_strategy)
  1502 |         self.lr_scheduler_type = SchedulerType(self.lr_scheduler_type)
  1503 |         self.optim = OptimizerNames(self.optim)
  1504 | 
  1505 |         if isinstance(self.debug, str):
  1506 |             self.debug = [DebugOption(s) for s in self.debug.split()]
  1507 |         elif self.debug is None:
  1508 |             self.debug = []
  1509 | 
  1510 |         # ── 3. Auto-derived Values ──
  1511 |         if self.do_eval is False and self.eval_strategy != IntervalStrategy.NO:
  1512 |             self.do_eval = True
  1513 | 
  1514 |         # Fall back to logging_steps if eval_steps is unset
  1515 |         if self.eval_strategy == IntervalStrategy.STEPS and (self.eval_steps is None or self.eval_steps == 0):
  1516 |             if self.logging_steps > 0:
  1517 |                 logger.info(f"using `logging_steps` to initialize `eval_steps` to {self.logging_steps}")
  1518 |                 self.eval_steps = self.logging_steps
  1519 |             else:
  1520 |                 raise ValueError(
  1521 |                     f"evaluation strategy {self.eval_strategy} requires either non-zero --eval_steps or"
  1522 |                     " --logging_steps"
  1523 |                 )
  1524 | 
  1525 |         if (
  1526 |             self.load_best_model_at_end
  1527 |             or self.lr_scheduler_type == SchedulerType.REDUCE_ON_PLATEAU
  1528 |             or self.lr_scheduler_type == SchedulerType.GREEDY
  1529 |         ) and self.metric_for_best_model is None:
  1530 |             self.metric_for_best_model = "loss"
  1531 |         if self.greater_is_better is None and self.metric_for_best_model is not None:
  1532 |             self.greater_is_better = not self.metric_for_best_model.endswith("loss")
  1533 | 
  1534 |         if self.report_to == "all" or self.report_to == ["all"]:
  1535 |             from .integrations import get_available_reporting_integrations
  1536 | 
  1537 |             self.report_to = get_available_reporting_integrations()
  1538 |         elif self.report_to == "none" or self.report_to == ["none"]:
  1539 |             self.report_to = []
  1540 |         elif not isinstance(self.report_to, list):
  1541 |             self.report_to = [self.report_to]
  1542 | 
  1543 |         # Auto-enable Kubeflow integration when running inside a Kubeflow TrainJob
  1544 |         from .integrations import is_kubeflow_available
  1545 | 
  1546 |         if is_kubeflow_available() and "kubeflow" not in self.report_to:
  1547 |             self.report_to = list(self.report_to) + ["kubeflow"]
  1548 | 
  1549 |         # ── 4. Validation ──
  1550 |         self._validate_args()
  1551 | 
  1552 |         # ── 5. Mixed Precision ──
  1553 |         # Read from env first; DeepSpeed may override this later
  1554 |         self.mixed_precision = os.environ.get("ACCELERATE_MIXED_PRECISION", "no")
  1555 |         if self.fp16:
  1556 |             self.mixed_precision = "fp16"
  1557 |         elif self.bf16:
  1558 |             self.mixed_precision = "bf16"
  1559 | 
  1560 |         # ── 6. Torch Compile ──
  1561 |         if (self.torch_compile_mode is not None or self.torch_compile_backend is not None) and not self.torch_compile:
  1562 |             self.torch_compile = True
  1563 |         if self.torch_compile and self.torch_compile_backend is None:
  1564 |             if not self.use_cpu and is_torch_hpu_available():
  1565 |                 self.torch_compile_backend = "hpu_backend"
  1566 |             else:
  1567 |                 self.torch_compile_backend = "inductor"
  1568 | 
  1569 |         if self.torch_compile:
  1570 |             # TODO: remove env var fallback once minimum accelerate >= 1.2.0
  1571 |             if not is_accelerate_available("1.2.0"):
  1572 |                 os.environ["ACCELERATE_DYNAMO_BACKEND"] = self.torch_compile_backend
  1573 |                 if self.torch_compile_mode is not None:
  1574 |                     os.environ["ACCELERATE_DYNAMO_MODE"] = self.torch_compile_mode
  1575 | 
  1576 |         # ── 7. Accelerator Config (must come before self.device) ──
  1577 |         if is_accelerate_available():
  1578 |             if not isinstance(self.accelerator_config, AcceleratorConfig):
  1579 |                 if self.accelerator_config is None:
  1580 |                     self.accelerator_config = AcceleratorConfig()
  1581 |                 elif isinstance(self.accelerator_config, dict):
  1582 |                     self.accelerator_config = AcceleratorConfig(**self.accelerator_config)
  1583 |                 # Reject uninstantiated class (e.g. AcceleratorConfig instead of AcceleratorConfig())
  1584 |                 elif isinstance(self.accelerator_config, type):
  1585 |                     raise NotImplementedError(
  1586 |                         "Tried passing in a callable to `accelerator_config`, but this is not supported. "
  1587 |                         "Please pass in a fully constructed `AcceleratorConfig` object instead."
  1588 |                     )
  1589 |                 else:
  1590 |                     self.accelerator_config = AcceleratorConfig.from_json_file(self.accelerator_config)
  1591 |             if self.accelerator_config.split_batches:
  1592 |                 logger.info(
  1593 |                     "Using `split_batches=True` in `accelerator_config` will override the `per_device_train_batch_size` "
  1594 |                     "Batches will be split across all processes equally when using `split_batches=True`."
  1595 |                 )
  1596 | 
  1597 |         # ── 8. Device Init ──
  1598 |         if is_torch_available():
  1599 |             self.device
  1600 | 
  1601 |         # ── 9. TF32 ──
  1602 |         if is_torch_available() and self.torch_compile:
  1603 |             if is_torch_tf32_available():
