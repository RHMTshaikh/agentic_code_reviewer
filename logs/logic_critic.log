   907 |     def create_mm_token_type_ids(self, input_ids: list) -> list[list[int]]:
   908 |         """
   909 |         Build per-token modality type IDs for a batch of token_id sequences.
   910 | 
   911 |         Each position is assigned an integer indicating which modality it belongs to:
   912 |         ``0`` for regular text, ``1`` for image tokens, ``2`` for video tokens, and
   913 |         ``3`` for audio tokens. Membership is determined by comparing against
   914 |         ``self.image_token_ids``, ``self.video_token_ids``, and ``self.audio_token_ids``.
   915 | 
   916 |         Args:
   917 |             input_ids (`list[list[int]]`):
   918 |                 Batch of token ID sequences. May be unpadded (variable length), so
   919 |                 a plain Python list of lists is expected rather than a tensor or
   920 |                 uniformly-shaped array.
   921 | 
   922 |         Returns:
   923 |             `list[list[int]]`: A list of the same structure as ``input_ids``, where each
   924 |             integer is the modality type ID for the corresponding token.
   925 |         """
   926 |         mm_token_type_ids = []
   927 |         for tokenizer_input in input_ids:
   928 |             # Convert tensor rows to a list so `np.array` avoids NumPy 2.0's `__array__` copy-keyword deprecation.
   929 |             if not isinstance(tokenizer_input, list):
   930 |                 tokenizer_input = tokenizer_input.tolist()
   931 |             tokenizer_input = np.array(tokenizer_input)
   932 |             mm_token_types = np.zeros_like(tokenizer_input)
   933 |             mm_token_types[np.isin(tokenizer_input, self.image_token_ids)] = 1
   934 |             mm_token_types[np.isin(tokenizer_input, self.video_token_ids)] = 2
   935 |             mm_token_types[np.isin(tokenizer_input, self.audio_token_ids)] = 3
   936 |             mm_token_type_ids.append(mm_token_types.tolist())
   937 |         return mm_token_type_ids
