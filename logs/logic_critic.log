  2716 | def get_model_name(obj):
  2717 |     """
  2718 |     Get the model name from the file path of the object.
  2719 |     """
  2720 | 
  2721 |     path = inspect.getsourcefile(obj)
  2722 |     if path is None:
  2723 |         return None
  2724 |     if path.split(os.path.sep)[-3] != "models":
  2725 |         return None
  2726 |     file_name = path.split(os.path.sep)[-1]
  2727 |     model_name_lowercase_from_folder = path.split(os.path.sep)[-2]
  2728 |     model_name_lowercase_from_file = None
  2729 |     for file_type in AUTODOC_FILES:
  2730 |         start = file_type.split("*")[0]
  2731 |         end = file_type.split("*")[-1] if "*" in file_type else ""
  2732 |         if file_name.startswith(start) and file_name.endswith(end):
  2733 |             model_name_lowercase_from_file = file_name[len(start) : -len(end)]
  2734 |             break
  2735 |     if model_name_lowercase_from_file and model_name_lowercase_from_folder != model_name_lowercase_from_file:
  2736 |         from transformers.models.auto.configuration_auto import SPECIAL_MODEL_TYPE_TO_MODULE_NAME
  2737 | 
  2738 |         if (
  2739 |             model_name_lowercase_from_file in SPECIAL_MODEL_TYPE_TO_MODULE_NAME
  2740 |             or model_name_lowercase_from_file.replace("_", "-") in SPECIAL_MODEL_TYPE_TO_MODULE_NAME
  2741 |         ):
  2742 |             return model_name_lowercase_from_file
  2743 |         return model_name_lowercase_from_folder
  2744 |     return model_name_lowercase_from_folder
