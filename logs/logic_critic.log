  1744 |         return cls._from_pretrained(
  1745 |             resolved_vocab_files,
  1746 |             pretrained_model_name_or_path,
  1747 |             init_configuration,
  1748 |             *init_inputs,
  1749 |             token=token,
  1750 |             cache_dir=cache_dir,
  1751 |             local_files_only=local_files_only,
  1752 |             _commit_hash=commit_hash,
  1753 |             _is_local=is_local,
  1754 |             trust_remote_code=trust_remote_code,
  1755 |             **kwargs,
  1756 |         )
