  3200 | def _get_parameter_info(param_name, documented_params, source_args_dict, param_type, optional):
  3201 |     """
  3202 |     Get parameter documentation details from the appropriate source.
  3203 |     Tensor shape, optional status and description are taken from the custom docstring in priority if available.
  3204 |     Type is taken from the function signature first, then from the custom docstring if missing from the signature
  3205 | 
  3206 |     Args:
  3207 |         param_name (`str`): Name of the parameter
  3208 |         documented_params (`dict`): Dictionary of documented parameters (manually specified in the docstring)
  3209 |         source_args_dict (`dict`): Default source args dictionary to use if not in documented_params
  3210 |         param_type (`str`): Current parameter type (may be updated)
  3211 |         optional (`bool`): Whether the parameter is optional (may be updated)
  3212 |     """
  3213 |     description = None
  3214 |     shape = None
  3215 |     shape_string = ""
  3216 |     is_documented = True
  3217 |     additional_info = None
  3218 |     optional_string = r", *optional*" if optional else ""
  3219 | 
  3220 |     if param_name in documented_params:
  3221 |         # Parameter is documented in the function's docstring
  3222 |         if (
  3223 |             param_type == ""
  3224 |             and documented_params[param_name].get("type", None) is not None
  3225 |             or documented_params[param_name]["additional_info"]
  3226 |         ):
  3227 |             param_type = documented_params[param_name]["type"]
  3228 |         optional = documented_params[param_name]["optional"]
  3229 |         shape = documented_params[param_name].get("shape", None)
  3230 |         shape_string = shape if shape else ""
  3231 |         additional_info = documented_params[param_name]["additional_info"] or ""
  3232 |         description = f"{documented_params[param_name]['description']}\n"
  3233 |     elif param_name in source_args_dict:
  3234 |         # Parameter is documented in ModelArgs or ImageProcessorArgs
  3235 |         param_type = source_args_dict[param_name].get("type", param_type)
  3236 |         shape = source_args_dict[param_name].get("shape", None)
  3237 |         shape_string = " " + shape if shape else ""
  3238 |         description = source_args_dict[param_name]["description"]
  3239 |         additional_info = source_args_dict[param_name].get("additional_info", None)
  3240 |         if additional_info:
  3241 |             additional_info = shape_string + optional_string + ", " + additional_info
  3242 |     else:
  3243 |         # Parameter is not documented
  3244 |         is_documented = False
  3245 | 
  3246 |     return param_type, optional_string, shape_string, additional_info, description, is_documented
