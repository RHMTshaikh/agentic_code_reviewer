   112 | def _resolve_tied_embed_lm_head_plan(
   113 |     fsdp_plan: dict[str, str],
   114 |     model: nn.Module,
   115 | ) -> dict[str, str]:
   116 |     """
   117 |     Rewrite the plan so tied embed/lm_head weights are wrapped once.
   118 |     Example:
   119 |         {"model.embed_tokens": "free_full_weight",
   120 |         "model.layers.*": "free_full_weight",
   121 |         "model.norm": "keep_full_weight",
   122 |         "lm_head": "keep_full_weight"}
   123 |     ->
   124 |         {"model.layers.*": "free_full_weight",
   125 |         "model.norm": "keep_full_weight",
   126 |         "model.embed_tokens": "keep_full_weight"}
   127 |     """
   128 |     tied_keys = getattr(model, "all_tied_weights_keys", None) or {}
   129 |     if not tied_keys:
   130 |         return fsdp_plan
   131 | 
   132 |     input_embed, output_head = _get_input_output_embeddings(model)
   133 |     name_by_module = {module: name for name, module in model.named_modules()}
   134 |     embed_module = name_by_module.get(input_embed)
   135 |     head_module = name_by_module.get(output_head)
   136 | 
   137 |     if embed_module is None or head_module is None:
   138 |         return fsdp_plan
   139 | 
   140 |     adapted_plan = fsdp_plan.copy()
   141 |     adapted_plan.pop(embed_module, None)
   142 | 
   143 |     if fsdp_plan.get(head_module) == "keep_full_weight":
   144 |         adapted_plan.pop(head_module, None)
   145 |         adapted_plan[embed_module] = "keep_full_weight"
   146 | 
   147 |     return adapted_plan
   148 | 

