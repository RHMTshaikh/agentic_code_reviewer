   555 |     def free_all_requests(self) -> None:
   556 |         """Free all blocks allocated to requests across all cache managers. This preserves prefix hashes in the block
   557 |         manager (blocks become initialized rather than uninitialized if they were complete), allowing prefix sharing
   558 |         to work across generation sessions."""
   559 |         all_request_ids = set()
   560 |         for cm in self.group_cache_managers:
   561 |             all_request_ids.update(cm.block_table.keys())
   562 |         for request_id in all_request_ids:
   563 |             self.free_blocks(request_id)
