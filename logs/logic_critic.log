  2096 |     def _valid_auto_compile_criteria(
  2097 |         self: "GenerativePreTrainedModel", model_kwargs: dict[str, Any], generation_config: GenerationConfig
  2098 |     ) -> bool:
  2099 |         """
  2100 |         Determines whether to trigger auto-compilation of the model's forward pass at generation time.
  2101 |         """
  2102 |         # Override: honor `disable_compile` flag
  2103 |         if generation_config.disable_compile:
  2104 |             return False
  2105 | 
  2106 |         cache = model_kwargs.get("past_key_values", model_kwargs.get("cache_params"))
  2107 | 
  2108 |         # Base logic
  2109 |         valid_hardware = self.device.type in ["cuda", "xpu", "neuron", "tpu"] or bool(
  2110 |             generation_config.compile_config is not None and generation_config.compile_config._compile_all_devices
  2111 |         )
  2112 |         # Note: for some models that only use linear attention (e.g. Mamba), even a DynamicCache is compileable since all
  2113 |         # layers are, but we don't want to ALWAYS compile when calling `generate`, so we check the type
  2114 |         using_compilable_cache = cache is not None and cache.is_compileable and type(cache) is not DynamicCache
  2115 |         can_compile = valid_hardware and using_compilable_cache
  2116 | 
  2117 |         # Exception 1: Some quantization methods do not support compilation
  2118 |         if getattr(self, "hf_quantizer", None) is not None:
  2119 |             can_compile &= self.hf_quantizer.is_compileable
  2120 | 
  2121 |         if hasattr(self, "hf_device_map"):
  2122 |             all_model_devices = set(self.hf_device_map.values())
  2123 |             # Exception 2: Don't compile if the model is using CPU offload (as of April 2025, this results in a crash)
  2124 |             has_cpu_offload = "cpu" in all_model_devices and len(all_model_devices) > 1
  2125 |             can_compile &= not has_cpu_offload
  2126 | 
  2127 |             # Exception 3: Disk offload is not supported for compilation
  2128 |             has_disk_offload = "disk" in all_model_devices
  2129 |             can_compile &= not has_disk_offload
  2130 | 
  2131 |         # If the user has manually specified compilation options, but compilation is not possible, let's warn
  2132 |         # them
  2133 |         if generation_config.compile_config is not None and not can_compile:
  2134 |             logger.warning_once(
  2135 |                 "You have set `compile_config`, but we are unable to meet the criteria for compilation. Compilation "
  2136 |                 "will be skipped."
  2137 |             )
  2138 | 
  2139 |         if can_compile:
  2140 |             # Finally: if we can compile, disable tokenizers parallelism
  2141 |             os.environ["TOKENIZERS_PARALLELISM"] = "0"
  2142 | 
  2143 |             # If we use FA and a static cache, we cannot compile with fullgraph
  2144 |             if is_flash_attention_requested(self.config):
  2145 |                 # only raise warning if the user passed an explicit compile-config
  2146 |                 if generation_config.compile_config is not None and generation_config.compile_config.fullgraph:
  2147 |                     logger.warning_once(
  2148 |                         "When using Flash Attention and a static cache, you cannot use the option `CompileConfig(fullgraph=True)` as "
  2149 |                         "FA introduces graph breaks. We overrode the option with `fullgraph=False`."
  2150 |                     )
  2151 |                     generation_config.compile_config.fullgraph = False
  2152 | 
  2153 |         return can_compile
  2154 | 
  2155 |     @contextmanager
  2156 |     def _optimize_model_for_decode(self: "GenerativePreTrainedModel"):
  2157 |         original_experts_implementation = self.config._experts_implementation
  2158 |         # On non-CPU devices, 'batched_mm' can trade off a bit of memory (by duplicating selected experts weights)
  2159 |         # for much better speed during decoding, especially for smaller inputs. On CPU, grouped_mm is usually better.
  2160 |         if original_experts_implementation == "grouped_mm" and self.device.type != "cpu":
  2161 |             logger.info_once(
  2162 |                 "We will be switching to 'batched_mm' for the decoding stage as it is much more performant than 'grouped_mm' on smaller inputs. "
  2163 |                 "If you experience any issues with this, please open an issue on the Hugging Face Transformers GitHub repository.",
  2164 |             )
  2165 |             self.set_experts_implementation("batched_mm")
  2166 | 
  2167 |         try:
  2168 |             yield
  2169 |         finally:
  2170 |             if original_experts_implementation == "grouped_mm" and self.device.type != "cpu":
  2171 |                 self.set_experts_implementation(original_experts_implementation)
  2172 | 
  2173 |     def _get_deprecated_gen_repo(
  2174 |         self,
  2175 |         generation_mode: GenerationMode,
  2176 |         trust_remote_code: bool,
  2177 |         custom_generate: str | None = None,
  2178 |     ) -> str | None:
  2179 |         """
  2180 |         Returns the Hub repo for a deprecated generation mode, if any.
  2181 |         """
  2182 |         if custom_generate is not None or "/" not in (repo := GENERATION_MODES_MAPPING[generation_mode]):
  2183 |             return None
  2184 | 
  2185 |         logger.warning_once(
  2186 |             f"{generation_mode.name.replace('_', ' ').title()} was moved to a `custom_generate` repo: https://hf.co/{repo}. "
  2187 |             f"To prevent loss of backward compatibility, add `custom_generate='{repo}'` "
  2188 |             "to your `generate` call before v4.62.0."
  2189 |         )
  2190 |         if not trust_remote_code:
  2191 |             raise ValueError(
  2192 |                 f"{generation_mode.name.replace('_', ' ').title()} requires `trust_remote_code=True` in your `generate` call, "
  2193 |                 f"since it loads https://hf.co/{repo}."
  2194 |             )
  2195 |         return repo
  2196 | 
  2197 |     def _extract_generation_mode_kwargs(
  2198 |         self,
  2199 |         custom_generate,
  2200 |         kwargs,
  2201 |         synced_gpus,
  2202 |         assistant_model,
  2203 |         streamer,
  2204 |     ) -> dict[str, Any]:
  2205 |         """
  2206 |         Extracts and returns the generation mode related keyword arguments from the provided kwargs.
  2207 |         """
  2208 |         generation_mode_kwargs = {
  2209 |             "tokenizer": kwargs.pop("tokenizer", None),
  2210 |             "assistant_tokenizer": kwargs.pop("assistant_tokenizer", None),
  2211 |             "assistant_model": assistant_model,
  2212 |             "streamer": streamer,
  2213 |         }
  2214 |         world_size = dist.get_world_size() if dist.is_available() and dist.is_initialized() else 1  # type: ignore
  2215 |         generation_mode_kwargs["synced_gpus"] = (
  2216 |             (is_deepspeed_zero3_enabled() or is_fsdp_managed_module(self)) and world_size > 1
  2217 |             if synced_gpus is None
  2218 |             else synced_gpus
  2219 |         )
  2220 |         generation_mode_kwargs = {k: v for k, v in generation_mode_kwargs.items() if v is not None}
  2221 |         # Custom_generate callables can have their own set of arguments
  2222 |         # To extract them, we compare the signature with the standard _sample method
  2223 |         if isinstance(custom_generate, Callable):
  2224 |             usual_mode_kwargs = inspect.signature(GenerationMixin._sample).parameters.keys()
  2225 |             custom_generate_kwargs = inspect.signature(custom_generate).parameters.keys()
  2226 |             new_custom_keys = custom_generate_kwargs - usual_mode_kwargs
  2227 |             generation_mode_kwargs = {k: kwargs.pop(k) for k in new_custom_keys if k in kwargs}
  2228 |         return generation_mode_kwargs
  2229 | 
  2230 |     @torch.no_grad()
  2231 |     def generate(
  2232 |         self: "GenerativePreTrainedModel",
