   116 |             # Determine for each tensor dimension, which type of sharding operations to apply (_StridedShard or Shard) and which rank to apply it to.
   117 |             # i.e: dim 0 -> [ Strided(rank0, size=2, sf=2), Shard(rank1, size=2) ]
   118 |             # i.e: dim 1 -> [ Shard(rank0, size=2)]
   119 |             planned_ops_by_dim = [[] for _ in source_shape]
   120 |             for mesh_dim, placement in dim_placements:
   121 |                 sub_mesh = self._get_sub_mesh(mesh_dim)
   122 |                 rank, world_size = sub_mesh.get_local_rank(), sub_mesh.size()
   123 |                 dim_idx = self._normalize_param_dim(placement.dim)
   124 |                 planned_ops_by_dim[dim_idx].append((placement, rank, world_size))
   125 | 
   126 |             # prepare the slices to fetch on disk for each tensor dimension.
   127 |             intervals_by_dim = [[(0, size)] for size in source_shape]
   128 |             for dim_idx, planned_ops in enumerate(planned_ops_by_dim):
   129 |                 intervals = intervals_by_dim[dim_idx]
   130 |                 for placement, rank, world_size in planned_ops:
   131 |                     if placement.is_shard():
   132 |                         intervals = self._compute_contiguous_slice(intervals, rank, world_size)
   133 |                     else:
   134 |                         intervals = self._compute_strided_slice(intervals, rank, world_size, placement.split_factor)
   135 |                 intervals_by_dim[dim_idx] = intervals
   136 | 
   137 |             has_strided_shard = any(not placement.is_shard() for _, placement in dim_placements)
   138 |             # finally fetch from the disk only the slices
   139 |             # finally fetch from the disk only the slices
   140 |             if has_strided_shard:
   141 |                 # Multi-interval dim: read each piece separately, then concatenate.
   142 |                 return self._slice_and_cat(source, intervals_by_dim, device, dtype)
   143 |             else:
   144 |                 slice_parts = []
   145 |                 for intervals in intervals_by_dim:
   146 |                     start, end = intervals[0] if len(intervals) > 0 else (0, 0)
   147 |                     slice_parts.append(slice(start, end))
   148 | 
   149 |                 return source[tuple(slice_parts)].to(device=device, dtype=dtype)
   150 | 
   151 |         # MoE path
   152 |         # tensor_idx identifies the axis-0 piece in param space (not in source.shape).
   153 |         normalized_dim_placements = [
   154 |             (mesh_dim, placement, self._normalize_param_dim(placement.dim)) for mesh_dim, placement in dim_placements
   155 |         ]
   156 | 
   157 |         # if this rank owns expert `tensor_idx` along axis 0, we need to slice the inner dimensions, else we drop it
   158 |         has_axis0_shard = any(param_dim == 0 for _, _, param_dim in normalized_dim_placements)
   159 |         owns_tensor_idx = self._axis0_offset <= tensor_idx < self._axis0_offset + self._axis0_local_size
   160 |         if has_axis0_shard and not owns_tensor_idx:
