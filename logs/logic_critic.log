  2903 |     def batch_decode(
  2904 |         self,
  2905 |         sequences: list[int] | list[list[int]] | np.ndarray | torch.Tensor,
  2906 |         skip_special_tokens: bool = False,
  2907 |         clean_up_tokenization_spaces: bool | None = None,
  2908 |         **kwargs,
  2909 |     ) -> list[str]:
  2910 |         """
  2911 |         Convert a list of lists of token ids into a list of strings by calling decode.
  2912 | 
  2913 |         This method is provided for backwards compatibility. The `decode` method now handles batched input natively,
  2914 |         so you can use `decode` directly instead of `batch_decode`.
  2915 | 
  2916 |         Args:
  2917 |             sequences (`Union[list[int], list[list[int]], np.ndarray, torch.Tensor]`):
  2918 |                 List of tokenized input ids. Can be obtained using the `__call__` method.
  2919 |             skip_special_tokens (`bool`, *optional*, defaults to `False`):
  2920 |                 Whether or not to remove special tokens in the decoding.
  2921 |             clean_up_tokenization_spaces (`bool`, *optional*):
  2922 |                 Whether or not to clean up the tokenization spaces. If `None`, will default to
  2923 |                 `self.clean_up_tokenization_spaces`.
  2924 |             kwargs (additional keyword arguments, *optional*):
  2925 |                 Will be passed to the underlying model specific decode method.
  2926 | 
  2927 |         Returns:
  2928 |             `list[str]`: The list of decoded sentences.
  2929 |         """
  2930 |         # Forward to decode() which now handles batched input natively
  2931 |         result = self.decode(
  2932 |             token_ids=sequences,
  2933 |             skip_special_tokens=skip_special_tokens,
  2934 |             clean_up_tokenization_spaces=clean_up_tokenization_spaces,
  2935 |             **kwargs,
  2936 |         )
  2937 |         # Ensure we always return a list for backwards compatibility
  2938 |         if isinstance(result, str):
  2939 |             return [result]
