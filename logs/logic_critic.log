  4717 |     def get_compiled_call(self, compile_config: CompileConfig | None) -> Callable:
  4718 |         """Return a `torch.compile`'d version of `self.__call__`. This is useful to dynamically choose between
  4719 |         non-compiled/compiled `forward` during inference, especially to switch between prefill (where we don't
  4720 |         want to use compiled version to avoid recomputing the graph with new shapes) and iterative decoding
  4721 |         (where we want the speed-ups of compiled version with static shapes)."""
  4722 |         # Only reset it if not present or different from previous config
  4723 |         if "llama4" in self.config.model_type:  # TODO try to enable for FULL COMPILE HYBRID CACHE SUPPORT
  4724 |             return self.__call__
  4725 |         compile_config = compile_config or self._default_compile_config()
  4726 |         default_config = getattr(self.generation_config, "compile_config", None) or self._default_compile_config()
  4727 |         if (
  4728 |             not hasattr(self, "_compiled_call")
  4729 |             or getattr(self, "_last_compile_config", default_config) != compile_config
  4730 |         ):
  4731 |             self._last_compile_config = compile_config
  4732 |             self._compiled_call = torch.compile(self.__call__, **compile_config.to_dict())
  4733 |         return self._compiled_call
