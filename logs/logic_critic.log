    34 |     async def attempt_execution(self, order_id: uuid.UUID) -> TradeExecution | None:
    35 |         """
    36 |         Attempts to fill an open order, utilizing automatic retries for optimistic lock failures.
    37 |         """
    38 |         max_retries = 3
    39 |         
    40 |         for attempt in range(max_retries):
    41 |             try:
    42 |                 # Wrap the entire execution attempt in a savepoint
    43 |                 async with self.session.begin_nested():
    44 |                     stmt = select(Order).where(Order.id == order_id)
    45 |                     result = await self.session.execute(stmt)
    46 |                     order = result.scalar_one_or_none()
    47 | 
    48 |                     if not order:
    49 |                         raise ValueError(f"Order {order_id} not found.")
    50 | 
    51 |                     if order.status not in (OrderStatus.OPEN, OrderStatus.PARTIALLY_FILLED):
    52 |                         raise OrderValidationError(f"Order {order_id} is not in an executable state.")
    53 | 
    54 |                     # 1. Retrieve current market reality
    55 |                     quote = await self.pricing_engine.get_validated_quote(order.symbol)
    56 | 
    57 |                     # 2. Matchmaking Logic
    58 |                     fill_price: Decimal | None = None
    59 |                     if order.type == "MARKET":
    60 |                         fill_price = quote.ask if order.side == "BUY" else quote.bid
    61 |                     elif order.type == "LIMIT":
    62 |                         if order.side == "BUY" and quote.ask <= order.limit_price:
    63 |                             fill_price = quote.ask
    64 |                         elif order.side == "SELL" and quote.bid >= order.limit_price:
    65 |                             fill_price = quote.bid
    66 | 
    67 |                     if not fill_price:
    68 |                         return None  # Cannot be filled at current market conditions
    69 | 
    70 |                     # 3. Execution Simulation
    71 |                     remaining_qty = order.requested_quantity - order.filled_quantity
    72 |                     executed_qty = remaining_qty 
    73 |                     broker_ref = f"EXEC-{uuid.uuid4().hex[:8].upper()}"
    74 | 
    75 |                     execution = TradeExecution(
    76 |                         order_id=order.id,
    77 |                         execution_price=fill_price,
    78 |                         quantity=executed_qty,
    79 |                         broker_reference_id=broker_ref
    80 |                     )
    81 |                     self.session.add(execution)
    82 | 
    83 |                     # 4. State Update
    84 |                     order.filled_quantity += executed_qty
    85 |                     if order.filled_quantity >= order.requested_quantity:
    86 |                         order.status = OrderStatus.FILLED
    87 |                     else:
