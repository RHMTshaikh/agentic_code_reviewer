   673 |         """Tests that generate can run beyond the sliding window length"""
   674 |         config, model_inputs = self.model_tester.prepare_config_and_inputs_for_common()
   675 |         # Canvas length has to be much smaller than sliding window to correctly check the mask
   676 |         # and input-length has to be smaller than sliding length! We will check three cases:
   677 |         # 1) input/mask is smaller than window
   678 |         # 2) input length approaching full cache length
   679 |         # 3) input length goes beyond window length
   680 |         # Input length is 25 in model tester, so we will set sliding window to 48 tokens
   681 |         # After generating `max_new_tokens=32`, the final length will go beyond sliding window
   682 |         config.text_config.sliding_window = 48
   683 |         model = DiffusionGemmaForBlockDiffusion(config=config).to(torch_device).eval()
   684 |         model.generation_config.eos_token_id = None  # force generation up to `max_new_tokens`
   685 | 
   686 |         generation_outputs = model.generate(
   687 |             **model_inputs,
   688 |             max_new_tokens=32,
   689 |             max_denoising_steps=2,
   690 |             disable_compile=True,
   691 |             cache_implementation=cache_implementation,
   692 |         )
   693 |         self.assertTrue(generation_outputs.sequences.shape[1] > config.text_config.sliding_window)
