   217 |     if not fsdp_plan:
   218 |         raise ValueError(
   219 |             f"{type(model).__name__} does not have a FSDP2 plan declared. Set "
   220 |             "`base_model_fsdp_plan` on the config and `_fsdp_plan` on the head class."
   221 |         )
   222 | 
   223 |     distributed_config = getattr(model.config, "distributed_config", None)
   224 |     fsdp_policy_kwargs = _get_fsdp_policy_kwargs(distributed_config)
   225 |     tie_word_embeddings = getattr(model.config, "tie_word_embeddings", False)
   226 | 
   227 |     adapted_fsdp_plan = _resolve_tied_embed_lm_head_plan(fsdp_plan, model)
   228 |     reshard_targets, no_reshard_targets = expand_fsdp_plan(model, adapted_fsdp_plan)
   229 | 
   230 |     for module_name, module in reshard_targets:
   231 |         fully_shard(module, mesh=fsdp_mesh, reshard_after_forward=True, **fsdp_policy_kwargs)
   232 |         logger.debug(f"Applied fully_shard to {module_name} (reshard=True)")
   233 | 
   234 |     # Optimization: when the keep buffer is exactly the (final_norm, lm_head/embed)
   235 |     # tail pair, bundle them into one fully_shard so that we dont need to do all-gather during backward pass.
