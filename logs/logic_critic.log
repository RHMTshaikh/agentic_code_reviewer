   137 |     def __call__(
   138 |         self,
   139 |         images: ImageInput | None = None,
   140 |         text: TextInput | PreTokenizedInput | list[TextInput] | list[PreTokenizedInput] | None = None,
   141 |         videos: VideoInput | None = None,
   142 |         **kwargs: Unpack[InternVLProcessorKwargs],
   143 |     ) -> BatchFeature:
   144 |         r"""
   145 |         Returns:
   146 |             [`BatchFeature`]: A [`BatchFeature`] with the following fields:
   147 | 
   148 |             - **input_ids** -- List of token ids to be fed to a model. Returned when `text` is not `None`.
   149 |             - **attention_mask** -- List of indices specifying which tokens should be attended to by the model (when
   150 |               `return_attention_mask=True` or if *"attention_mask"* is in `self.model_input_names` and if `text` is not
   151 |               `None`).
   152 |             - **pixel_values** -- Pixel values to be fed to a model. Returned when `images` is not `None`.
   153 |         """
   154 |         if text is None:
   155 |             raise ValueError("You have to specify text.")
   156 | 
   157 |         output_kwargs = self._merge_kwargs(
   158 |             InternVLProcessorKwargs,
   159 |             tokenizer_init_kwargs=self.tokenizer.init_kwargs,
   160 |             **kwargs,
   161 |         )
   162 | 
   163 |         if not isinstance(text, (list, tuple)):
   164 |             text = [text]
   165 | 
   166 |         # Process images and videos separately, as videos don't support crop_to_patches
   167 |         image_num_patches = []
   168 |         image_pixel_values = None
   169 |         image_num_patches_indices = np.array([0])
   170 |         if images is not None:
   171 |             images = self.image_processor.fetch_images(images)
   172 |             images = make_flat_list_of_images(images)
   173 |             image_inputs = self.image_processor(images=images, **output_kwargs["images_kwargs"])
   174 |             image_num_patches = image_inputs.pop("num_patches")
   175 |             image_pixel_values = image_inputs.pop("pixel_values")
   176 |             image_num_patches_indices = np.cumsum(image_num_patches)
   177 | 
   178 |         video_num_patches = []  # per frame
   179 |         video_pixel_values = None
   180 |         video_patch_indices = np.array([0])
   181 |         video_num_patches_indices = np.array([0])
   182 |         if videos is not None:
   183 |             video_kwargs = output_kwargs["videos_kwargs"]
   184 |             video_inputs = self.video_processor(videos=videos, **video_kwargs)
   185 |             video_pixel_values = video_inputs.pop("pixel_values_videos")
   186 | 
   187 |             batch_size, num_frames, *_ = video_pixel_values.shape
   188 |             num_frames_per_video = np.full(batch_size, num_frames)
   189 |             num_frames = sum(num_frames_per_video)  # total
   190 |             video_patch_indices = np.empty(batch_size + 1, int)
   191 |             video_patch_indices[0] = 0
   192 |             video_patch_indices[1:] = np.cumsum(num_frames_per_video)
   193 |             video_num_patches = [1] * num_frames
   194 |             video_num_patches_indices = np.empty(num_frames + 1, int)
   195 |             video_num_patches_indices[0] = 0
   196 |             video_num_patches_indices[1:] = np.cumsum(video_num_patches)
   197 |             video_pixel_values = video_pixel_values.flatten(0, 1)
   198 | 
   199 |         image_videos_inputs = {}
   200 |         if images is not None or videos is not None:
   201 |             text, image_video_patches, image_index, video_index = self._insert_media_placeholders(
   202 |                 text,
   203 |                 image_pixel_values,
   204 |                 video_pixel_values,
   205 |                 image_num_patches,
   206 |                 video_num_patches,
   207 |                 image_num_patches_indices,
   208 |                 video_num_patches_indices,
   209 |                 video_patch_indices,
   210 |             )
   211 |             if images is not None and image_index != len(images):
   212 |                 raise ValueError("Number of image placeholders in the prompt does not match the number of images.")
   213 |             if videos is not None and video_index != len(num_frames_per_video):
   214 |                 raise ValueError("Number of video placeholders in the prompt does not match the number of videos.")
   215 | 
   216 |             # Concatenate the interleaved image and video patches (function agnostic to the patches type (list, numpy array, torch tensor))
   217 |             image_videos_inputs = {"pixel_values": concatenate_list(image_video_patches)}
   218 | 
   219 |         return_tensors = output_kwargs["text_kwargs"].pop("return_tensors", None)
   220 |         return_mm_token_type_ids = output_kwargs["text_kwargs"].pop("return_mm_token_type_ids", None)
   221 |         text_inputs = self.tokenizer(text, **output_kwargs["text_kwargs"])
   222 |         self._check_special_mm_tokens(text, text_inputs, modalities=["image"])
   223 | 
   224 |         if return_mm_token_type_ids:
   225 |             text_inputs["mm_token_type_ids"] = self.create_mm_token_type_ids(text_inputs["input_ids"])
   226 |         return BatchFeature(data={**text_inputs, **image_videos_inputs}, tensor_type=return_tensors)
