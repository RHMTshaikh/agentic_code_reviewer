   321 |         mesh = FakeMesh(shape=(2,), rank=0)
   322 |         op = _make_dtensor_shard_op(mesh, [Shard(0)], param_shape=(8,), local_shape=(4,))
   323 |         expected = {
   324 |             # Single interval, even split -> rank 0 -> first 4 elems, rank 1 -> last 4 elems
   325 |             (((0, 8),), 0, 2): [(0, 4)],
   326 |             (((0, 8),), 1, 2): [(4, 8)],
   327 |             # Uneven: size 5 / 2 ranks -> rank 0 -> first 3 elems, rank 1 -> last 2 elems
   328 |             (((0, 5),), 0, 2): [(0, 3)],
   329 |             (((0, 5),), 1, 2): [(3, 5)],
   330 |             # Empty: size 3 / 4 ranks -> rank 3 -> nothing
