  3311 |         param_type, optional_string, shape_string, additional_info, description, is_documented = _get_parameter_info(
  3312 |             param_name, documented_params, source_args_dict, param_type, optional
  3313 |         )
  3314 | 
  3315 |         if is_documented:
  3316 |             if param_name == "config":
  3317 |                 if param_type == "":
  3318 |                     param_type = f"[`{class_name}`]"
  3319 |                 else:
  3320 |                     param_type = f"[`{param_type.split('.')[-1]}`]"
  3321 |             # elif param_type == "" and False:  # TODO: Enforce typing for all parameters
  3322 |             #     print(f"[ERROR] {param_name} for {func.__qualname__} in file {func.__code__.co_filename} has no type")
  3323 |             param_type = param_type if "`" in param_type else f"`{param_type}`"
  3324 |             # Format the parameter docstring
  3325 |             if additional_info:
  3326 |                 param_docstring = f"{param_name} ({param_type}{additional_info}):{description}"
  3327 |             else:
  3328 |                 param_docstring = (
  3329 |                     f"{param_name} ({param_type}{shape_string}{optional_string}{param_default}):{description}"
  3330 |                 )
  3331 |             docstring += set_min_indent(
  3332 |                 param_docstring,
  3333 |                 indent_level + 8,
  3334 |             )
  3335 |         else:
  3336 |             missing_args[param_name] = {
  3337 |                 "type": param_type if param_type else "<fill_type>",
  3338 |                 "optional": optional,
  3339 |                 "shape": shape_string,
  3340 |                 "description": description if description else "\n    <fill_description>",
  3341 |                 "default": param_default,
