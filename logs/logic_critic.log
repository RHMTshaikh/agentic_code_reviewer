  3592 |             if kwargs_documentation is not None:
  3593 |                 documented_kwargs = parse_docstring(kwargs_documentation)[0]
  3594 |             # Process each kwarg parameter
  3595 |             for param_name, param_type_annotation in kwarg_param.annotation.__args__[0].__annotations__.items():
