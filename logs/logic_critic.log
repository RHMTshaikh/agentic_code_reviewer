   179 | 
   180 |         # For backward compatibility check keyword args
   181 |         # Instead of simply assigning `[text|vision]_config_dict` to `[text|vision]_config`, we use the values in
   182 |         # `[text|vision]_config_dict` to update the values in `[text|vision]_config`. The values should be same in most
   183 |         # cases, but we don't want to break anything regarding `_config_dict` that existed before commit `8827e1b2`.
   184 |         text_config_dict = kwargs.pop("text_config_dict", None)
   185 |         vision_config_dict = kwargs.pop("vision_config_dict", None)
