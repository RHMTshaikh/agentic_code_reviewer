  2840 |     def _resize_token_embeddings(self, new_num_tokens, pad_to_multiple_of=None, mean_resizing=True):
  2841 |         old_embeddings = self.get_input_embeddings()
  2842 |         new_embeddings = self._get_resized_embeddings(
  2843 |             old_embeddings, new_num_tokens, pad_to_multiple_of, mean_resizing
  2844 |         )
  2845 |         if hasattr(old_embeddings, "_hf_hook"):
  2846 |             hook = old_embeddings._hf_hook
  2847 |             add_hook_to_module(new_embeddings, hook)
  2848 |         old_embeddings_requires_grad = old_embeddings.weight.requires_grad
  2849 |         new_embeddings.requires_grad_(old_embeddings_requires_grad)
  2850 |         self.set_input_embeddings(new_embeddings)
  2851 |         is_quantized = hasattr(self, "hf_quantizer") and self.hf_quantizer is not None
  2852 | 
  2853 |         # Update new_num_tokens with the actual size of new_embeddings
  2854 |         if pad_to_multiple_of is not None:
  2855 |             if is_deepspeed_zero3_enabled() and not is_quantized:
  2856 |                 import deepspeed
  2857 | 
  2858 |                 with deepspeed.zero.GatheredParameters(new_embeddings.weight, modifier_rank=None):
  2859 |                     new_num_tokens = new_embeddings.weight.shape[0]
  2860 |             else:
  2861 |                 new_num_tokens = new_embeddings.weight.shape[0]
  2862 | 
  2863 |         # if word embeddings are not tied, make sure that lm head is resized as well
  2864 |         if self.get_output_embeddings() is not None:
  2865 |             old_lm_head = self.get_output_embeddings()
  2866 |             if isinstance(old_lm_head, torch.nn.Embedding):
  2867 |                 new_lm_head = self._get_resized_embeddings(old_lm_head, new_num_tokens, mean_resizing=mean_resizing)
  2868 |             else:
  2869 |                 new_lm_head = self._get_resized_lm_head(old_lm_head, new_num_tokens, mean_resizing=mean_resizing)
  2870 |             if hasattr(old_lm_head, "_hf_hook"):
  2871 |                 hook = old_lm_head._hf_hook
  2872 |                 add_hook_to_module(new_lm_head, hook)
  2873 |             old_lm_head_requires_grad = old_lm_head.weight.requires_grad
  2874 |             new_lm_head.requires_grad_(old_lm_head_requires_grad)
  2875 |             self.set_output_embeddings(new_lm_head)
  2876 | 
  2877 |         return self.get_input_embeddings()
