  4428 |         if load_config.device_map is not None and "disk" in load_config.device_map.values():
  4429 |             disk_offload_index = accelerate_disk_offload(
  4430 |                 model,
  4431 |                 load_config.disk_offload_folder,
  4432 |                 checkpoint_files,
  4433 |                 load_config.device_map,
  4434 |                 load_config.sharded_metadata,
  4435 |                 load_config.dtype,
  4436 |                 load_config.weight_mapping,
  4437 |             )
  4438 | 
  4439 |         # Warmup cuda to load the weights much faster on devices
  4440 |         if load_config.device_map is not None and not is_hqq_or_quark:
  4441 |             expanded_device_map = expand_device_map(load_config.device_map, expected_keys)
  4442 |             caching_allocator_warmup(model, expanded_device_map, load_config.hf_quantizer)
  4443 | 
  4444 |         error_msgs = []
  4445 | 
  4446 |         if is_deepspeed_zero3_enabled() and not is_quantized:
  4447 |             if state_dict is None:
  4448 |                 merged_state_dict = {}
  4449 |                 for ckpt_file in checkpoint_files:
  4450 |                     merged_state_dict.update(
  4451 |                         load_state_dict(
  4452 |                             ckpt_file,
  4453 |                             map_location="cpu",
  4454 |                             weights_only=load_config.weights_only,
  4455 |                             disable_mmap=load_config.disable_mmap,
  4456 |                         )
  4457 |                     )
  4458 |                 state_dict = merged_state_dict
  4459 |             error_msgs, missing_keys = _load_state_dict_into_zero3_model(model, state_dict, load_config)
  4460 |             # This is not true but for now we assume only best-case scenario with deepspeed, i.e. perfectly matching checkpoints
  4461 |             loading_info = LoadStateDictInfo(
  4462 |                 missing_keys=missing_keys,
  4463 |                 error_msgs=error_msgs,
  4464 |                 unexpected_keys=set(),
  4465 |                 mismatched_keys=set(),
  4466 |                 conversion_errors={},
  4467 |             )
  4468 |         else:
  4469 |             all_pointer = set()
  4470 |             if state_dict is not None:
  4471 |                 merged_state_dict = state_dict
  4472 |             elif checkpoint_files is not None and checkpoint_files[0].endswith(".safetensors") and state_dict is None:
  4473 |                 merged_state_dict = {}
  4474 |                 for file in checkpoint_files:
  4475 |                     if load_config.disable_mmap or _is_on_hf_mount(file):
  4476 |                         with open(file, "rb") as _fh:
  4477 |                             merged_state_dict.update(_safe_load_bytes(_fh.read()))
  4478 |                         continue
  4479 |                     is_mps = load_config.device_map is not None and any(
  4480 |                         (d.type if isinstance(d, torch.device) else d) == "mps"
  4481 |                         for d in load_config.device_map.values()
  4482 |                     )
  4483 |                     backend, device = ("pread", "mps") if is_mps else ("mmap", "cpu")
  4484 |                     file_pointer = safe_open(file, framework="pt", device=device, backend=backend)
  4485 |                     all_pointer.add(file_pointer)
  4486 |                     for k in file_pointer.keys():
  4487 |                         merged_state_dict[k] = file_pointer.get_slice(k)  # don't materialize yet
  4488 |             # Checkpoints are .bin
  4489 |             elif checkpoint_files is not None:
  4490 |                 merged_state_dict = {}
  4491 |                 for ckpt_file in checkpoint_files:
  4492 |                     merged_state_dict.update(load_state_dict(ckpt_file, disable_mmap=load_config.disable_mmap))
  4493 |             else:
  4494 |                 raise ValueError("Neither a state dict nor checkpoint files were found.")
  4495 | 
  4496 |             loading_info, disk_offload_index = convert_and_load_state_dict_in_model(
  4497 |                 model=model,
  4498 |                 state_dict=merged_state_dict,
  4499 |                 load_config=load_config,
  4500 |                 tp_plan=model.tp_plan,
  4501 |                 disk_offload_index=disk_offload_index,
  4502 |             )
  4503 | 
  4504 |             # finally close all opened file pointers
  4505 |             for k in all_pointer:
  4506 |                 k.__exit__(None, None, None)
  4507 | 
  4508 |         return loading_info, disk_offload_index
