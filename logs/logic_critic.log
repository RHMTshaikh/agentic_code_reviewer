  3857 | def _prepare_return_docstring(output_type, config_class, add_intro=True):
  3858 |     """
  3859 |     Prepare the return docstring from a ModelOutput class.
  3860 | 
  3861 |     This is a robust replacement for the old _prepare_output_docstrings from doc.py,
  3862 |     using the same parsing and formatting methods as the rest of auto_docstring.
  3863 | 
  3864 |     Args:
  3865 |         output_type: The ModelOutput class to generate documentation for
  3866 |         config_class (`str`): Config class for the model
  3867 |         add_intro (`bool`): Whether to add the introduction text
  3868 | 
  3869 |     Returns:
  3870 |         str: Formatted return docstring
  3871 |     """
  3872 |     output_docstring = output_type.__doc__
  3873 | 
  3874 |     # If the class has no docstring, try to use the parent class's docstring
  3875 |     if output_docstring is None and hasattr(output_type, "__mro__"):
  3876 |         for base in output_type.__mro__[1:]:  # Skip the class itself
  3877 |             if base.__doc__ is not None:
  3878 |                 output_docstring = base.__doc__
  3879 |                 break
  3880 | 
  3881 |     if output_docstring is None:
  3882 |         if add_intro:
  3883 |             raise ValueError(
  3884 |                 f"No docstring found for `{output_type.__name__}` or its parent classes. "
  3885 |                 "Make sure the ModelOutput class or one of its parents has a docstring."
  3886 |             )
  3887 |         return ""
  3888 | 
  3889 |     # Parse the output class docstring to extract parameters
  3890 |     documented_params, _ = parse_docstring(output_docstring)
  3891 | 
  3892 |     if not documented_params and add_intro:
  3893 |         raise ValueError(
  3894 |             f"No `Args` or `Parameters` section is found in the docstring of `{output_type.__name__}`. "
  3895 |             "Make sure it has a docstring and contains either `Args` or `Parameters`."
  3896 |         )
  3897 | 
  3898 |     # Build the return section
  3899 |     full_output_type, _ = process_type_annotation(output_type)
  3900 |     if add_intro:
  3901 |         # Import here to avoid circular import
  3902 |         from .doc import PT_RETURN_INTRODUCTION
  3903 | 
  3904 |         intro = PT_RETURN_INTRODUCTION.format(full_output_type=full_output_type, config_class=config_class)
  3905 |     else:
  3906 |         intro = f"Returns:\n    `{full_output_type}`"
  3907 |         if documented_params:
  3908 |             intro += ":\n"
  3909 |         else:
  3910 |             intro += "\n"
  3911 | 
  3912 |     # Build the parameters section
  3913 |     params_text = ""
  3914 |     if documented_params:
  3915 |         for param_name, param_info in documented_params.items():
  3916 |             param_type = param_info.get("type", "")
  3917 |             param_description = param_info.get("description", "").strip()
  3918 |             additional_info = param_info.get("additional_info", "")
  3919 | 
  3920 |             # Handle types with unbalanced backticks due to nested parentheses
  3921 |             # The parse_docstring function splits types like `tuple(torch.FloatTensor)` incorrectly
  3922 |             # so we need to reconstruct the complete type by grabbing the closing part from additional_info
  3923 |             if param_type.startswith("`") and not param_type.endswith("`"):
  3924 |                 # Find the closing backtick in additional_info
  3925 |                 closing_backtick_idx = additional_info.find("`")
  3926 |                 if closing_backtick_idx != -1:
  3927 |                     # Grab everything up to and including the closing backtick
  3928 |                     param_type += additional_info[: closing_backtick_idx + 1]
  3929 |                     # Remove that part from additional_info
  3930 |                     additional_info = additional_info[closing_backtick_idx + 1 :]
  3931 | 
  3932 |             # Strip backticks from type to add them back consistently
  3933 |             param_type = param_type.strip("`")
  3934 | 
  3935 |             # Use process_type_annotation to ensure consistent type formatting
  3936 |             # This applies the same formatting rules as the rest of auto_docstring
  3937 |             if param_type:
  3938 |                 param_type, _ = process_type_annotation(param_type)
  3939 | 
  3940 |             # Build the parameter line
  3941 |             if additional_info:
  3942 |                 # additional_info contains shape and optional status
  3943 |                 param_line = f"- **{param_name}** (`{param_type}`{additional_info}) -- {param_description}"
  3944 |             else:
  3945 |                 param_line = f"- **{param_name}** (`{param_type}`) -- {param_description}"
  3946 | 
  3947 |             # Handle multi-line descriptions:
  3948 |             # Split the description to handle continuations with proper indentation
  3949 |             lines = param_line.split("\n")
  3950 |             formatted_lines = []
  3951 |             for i, line in enumerate(lines):
  3952 |                 if i == 0:
  3953 |                     # First line gets no extra indent (just the bullet point)
  3954 |                     formatted_lines.append(line)
  3955 |                 else:
  3956 |                     # Continuation lines: strip existing indentation and add 2 spaces (relative to the bullet)
  3957 |                     formatted_lines.append("  " + line.lstrip())
  3958 | 
  3959 |             param_text = "\n".join(formatted_lines)
  3960 | 
  3961 |             # Indent everything to 4 spaces and append with newline
  3962 |             param_text_indented = set_min_indent(param_text, 4)
  3963 |             params_text += param_text_indented + "\n"
  3964 | 
  3965 |     result = intro + params_text
  3966 | 
  3967 |     return result
  3968 | 
