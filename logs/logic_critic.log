   361 |     @output_attentions.setter
   362 |     def output_attentions(self, value: bool):
   363 |         # If we set `output_attentions` explicitly before the attn implementation, dispatch eager
   364 |         if value and self._attn_implementation is None:
   365 |             self._attn_implementation = "eager"
   366 |         if value and self._attn_implementation != "eager":
   367 |             raise ValueError(
   368 |                 "The `output_attentions` attribute is not supported when using the `attn_implementation` set to "
   369 |                 f"{self._attn_implementation}. Please set it to 'eager' instead."
