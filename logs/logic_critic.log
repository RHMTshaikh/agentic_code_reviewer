    51 | class MiniCPM3Config(LlamaConfig):
    52 |     r"""
    53 |     kv_lora_rank (`int`, *optional*, defaults to 256):
    54 |         Rank of the low-rank KV projection in multi-head latent attention.
    55 |     q_lora_rank (`int`, *optional*, defaults to 768):
    56 |         Rank of the low-rank query projection in multi-head latent attention. If `None`, the query projection
    57 |         is a single dense projection rather than a low-rank one.
    58 |     qk_nope_head_dim (`int`, *optional*, defaults to 64):
    59 |         Dimension of the non-RoPE part of each query/key head.
    60 |     qk_rope_head_dim (`int`, *optional*, defaults to 32):
    61 |         Dimension of the RoPE part of each query/key head.
    62 |     v_head_dim (`int`, *optional*):
    63 |         Dimension of each value head. If `None`, defaults to `hidden_size // num_attention_heads`.
    64 |     scale_emb (`int` or `float`, *optional*, defaults to 12):
    65 |         Multiplier applied to input embeddings.
    66 |     scale_depth (`int` or `float`, *optional*, defaults to 1.4):
    67 |         Multiplier for residual connections; the effective scaling is `scale_depth / sqrt(num_hidden_layers)`.
    68 |         If `None`, defaults to `sqrt(num_hidden_layers)` (no-op scaling).
    69 |     dim_model_base (`int`, *optional*, defaults to 256):
    70 |         Base model dimension used to scale logits before the language model head. If `None`,
    71 |         defaults to `hidden_size` (no-op scaling).
    72 | 
    73 |     Example:
    74 | 
    75 |     ```python
    76 |     >>> from transformers import MiniCPM3Model, MiniCPM3Config
    77 |     >>> # Initializing a MiniCPM3 style configuration
    78 |     >>> configuration = MiniCPM3Config()
    79 |     >>> # Initializing a model from the configuration
    80 |     >>> model = MiniCPM3Model(configuration)
    81 |     >>> # Accessing the model configuration
    82 |     >>> configuration = model.config
    83 |     ```
    84 |     """
    85 | 
    86 |     base_model_tp_plan = {
    87 |         "layers.*.self_attn.q_proj": "colwise",
    88 |         "layers.*.self_attn.q_b_proj": "colwise",
    89 |         "layers.*.self_attn.kv_a_proj_with_mqa": "mla_kv_a_proj",
    90 |         "layers.*.self_attn.kv_b_proj": "colwise",
    91 |         "layers.*.self_attn.o_proj": "rowwise",
    92 |         "layers.*.mlp.gate_proj": "colwise",
    93 |         "layers.*.mlp.up_proj": "colwise",
    94 |         "layers.*.mlp.down_proj": "rowwise",
    95 |     }
    96 | 
    97 |     model_type = "minicpm3"
    98 | 
    99 |     # Only fields whose defaults differ from `LlamaConfig` are redeclared here; the rest are inherited.
   100 |     # Defaults match the `openbmb/MiniCPM3-4B` checkpoint.
   101 |     vocab_size: int = 73448
   102 |     hidden_size: int = 2560
   103 |     intermediate_size: int = 6400
   104 |     num_hidden_layers: int = 62
   105 |     num_attention_heads: int = 40
   106 |     num_key_value_heads: int | None = 40
   107 |     max_position_embeddings: int = 32768
   108 |     initializer_range: float = 0.1
   109 |     rms_norm_eps: float = 1e-5
   110 |     tie_word_embeddings: bool = True
   111 |     kv_lora_rank: int = 256
   112 |     q_lora_rank: int | None = 768
   113 |     qk_nope_head_dim: int = 64
   114 |     qk_rope_head_dim: int = 32
   115 |     v_head_dim: int | None = None
   116 |     scale_emb: int | float = 12
   117 |     scale_depth: int | float | None = 1.4
   118 |     dim_model_base: int | None = 256
   119 | 
   120 |     def __post_init__(self, **kwargs):
   121 |         # In MLA the per-head dim used by RoPE is the rotary part, not `hidden_size / num_attention_heads`.
   122 |         self.head_dim = self.qk_rope_head_dim
   123 |         # When explicitly set to `None`, these collapse to no-op scalings (e.g. for a randomly
   124 |         # initialised tiny model); the class defaults otherwise match `openbmb/MiniCPM3-4B`.
   125 |         if self.v_head_dim is None:
   126 |             self.v_head_dim = self.hidden_size // self.num_attention_heads
   127 |         if self.scale_depth is None:
   128 |             self.scale_depth = math.sqrt(self.num_hidden_layers)
   129 |         if self.dim_model_base is None:
   130 |             self.dim_model_base = self.hidden_size
   131 |         super().__post_init__(**kwargs)
   132 | 
   133 |     @property
   134 |     def logits_scaling(self) -> float:
   135 |         # Hidden states are divided by this factor before the LM head (`1` when `dim_model_base == hidden_size`).
   136 |         return self.hidden_size / self.dim_model_base
