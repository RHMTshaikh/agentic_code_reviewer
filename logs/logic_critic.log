   703 | def process_source_pattern(source_pattern: str, target_pattern: str) -> str:
   704 |     """
   705 |     Process a source pattern for reverse mapping (when sources become targets).
   706 |     This is useful because usually if the original source (so now the target in reverse mode) had a `^` or `$`
   707 |     to restrict to start/end of string, we should do the same in reverse mode. This is why this method in conditioned
   708 |     on the target pattern, we want to do it only for pairs (source, target) when the original source (so the current target
   709 |     in reverse mode) had it.
   710 |     """
   711 |     if target_pattern.startswith("^"):
   712 |         source_pattern = f"^{source_pattern}" if not source_pattern.startswith("^") else source_pattern
   713 |     if target_pattern.endswith("$"):
   714 |         source_pattern = f"{source_pattern}$" if not source_pattern.endswith("$") else source_pattern
   715 | 
   716 |     return source_pattern
   717 | 

