   561 |     def test_per_layer_inputs_are_correctly_forwarded(self):
   562 |         from transformers.models.gemma4.modeling_gemma4 import Gemma4TextModel
   563 | 
   564 |         config, _ = self.model_tester.prepare_config_and_inputs_for_common()
   565 | 
   566 |         model = Gemma4ForConditionalGeneration(config).to(torch_device)
   567 |         model.eval()
   568 | 
   569 |         input_ids = torch.randint(20, 50, (1, 10), device=torch_device)
   570 |         inputs_embeds = model.get_input_embeddings()(input_ids)
   571 |         per_layer_inputs = model.model.language_model.get_per_layer_inputs(input_ids, None)
   572 | 
   573 |         @contextmanager
   574 |         def count_get_per_layer_inputs_calls():
   575 |             original = Gemma4TextModel.get_per_layer_inputs
   576 |             counter = {"call_count": 0}
   577 | 
   578 |             def count_calls(*args, **kwargs):
   579 |                 nonlocal counter
   580 |                 counter["call_count"] += 1
   581 |                 return original(*args, **kwargs)
   582 | 
   583 |             Gemma4TextModel.get_per_layer_inputs = count_calls
   584 |             try:
   585 |                 yield counter
   586 |             finally:
   587 |                 Gemma4TextModel.get_per_layer_inputs = original
   588 | 
   589 |         # We should never call `get_per_layer_input_embeddings` if we provide both inputs_embeds and per_layer_inputs
   590 |         with count_get_per_layer_inputs_calls() as counter:
   591 |             _ = model(inputs_embeds=inputs_embeds, per_layer_inputs=per_layer_inputs)
   592 |             self.assertEqual(counter["call_count"], 0)
   593 | 
   594 |         # We should call it once if we provide only input_ids
   595 |         with count_get_per_layer_inputs_calls() as counter:
   596 |             _ = model(input_ids)
   597 |             self.assertEqual(counter["call_count"], 1)
   598 | 
   599 |         # We should call it once as well if we provide only inputs_embeds
   600 |         with count_get_per_layer_inputs_calls() as counter:
   601 |             _ = model(inputs_embeds=inputs_embeds)
   602 |             self.assertEqual(counter["call_count"], 1)
