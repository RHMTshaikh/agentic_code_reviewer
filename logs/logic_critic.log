    82 |     inv_freq: torch.Tensor  # fix linting for `register_buffer`
    83 | 
    84 |     def __init__(self, config: MiniCPM3Config, device=None):
    85 |         super().__init__()
    86 |         self.max_seq_len_cached = config.max_position_embeddings
    87 |         self.original_max_seq_len = config.max_position_embeddings
    88 | 
    89 |         self.config = config
    90 | 
    91 |         self.rope_type = self.config.rope_parameters["rope_type"]
    92 |         rope_init_fn: Callable = self.compute_default_rope_parameters
    93 |         if self.rope_type != "default":
    94 |             rope_init_fn = ROPE_INIT_FUNCTIONS[self.rope_type]
    95 |         inv_freq, self.attention_scaling = rope_init_fn(self.config, device)
