   737 |         else:
   738 |             past_length = 0
   739 |             if (cache := model_kwargs.get("past_key_values")) is not None:
   740 |                 past_length = cache.get_seq_length()
   741 | 
   742 |             position_ids = torch.arange(seq_length + past_length, dtype=torch.long, device=inputs_tensor.device)
   743 |             position_ids = position_ids.unsqueeze(0)
   744 |         return position_ids
   745 | 
   746 |     def _prepare_attention_mask_for_generation(
   747 |         self,
   748 |         inputs_tensor: torch.Tensor,
   749 |         generation_config: GenerationConfig,
   750 |         model_kwargs: dict[str, Any],
   751 |     ) -> torch.LongTensor:
   752 |         pad_token_id = generation_config._pad_token_tensor
   753 |         eos_token_id = generation_config._eos_token_tensor
   754 | 
   755 |         # `input_ids` may be present in the model kwargs, instead of being the main input (e.g. multimodal model)
   756 |         if "input_ids" in model_kwargs and model_kwargs["input_ids"].shape[1] > 0:
   757 |             inputs_tensor = model_kwargs["input_ids"]
   758 | 
   759 |         # No information for attention mask inference -> return default attention mask
   760 |         default_attention_mask = torch.ones(inputs_tensor.shape[:2], dtype=torch.long, device=inputs_tensor.device)
   761 |         if pad_token_id is None:
   762 |             return default_attention_mask
   763 | 
   764 |         is_input_ids = len(inputs_tensor.shape) == 2 and inputs_tensor.dtype in [torch.int, torch.long]
   765 |         if not is_input_ids:
   766 |             return default_attention_mask
   767 | 
   768 |         is_pad_token_in_inputs = (pad_token_id is not None) and (torch.isin(inputs_tensor, pad_token_id).any())
   769 |         is_pad_token_not_equal_to_eos_token_id = (eos_token_id is None) or ~(
   770 |             torch.isin(eos_token_id, pad_token_id).any()
   771 |         )
   772 |         can_infer_attention_mask = is_pad_token_in_inputs * is_pad_token_not_equal_to_eos_token_id
   773 |         attention_mask_from_padding = inputs_tensor.ne(pad_token_id).long()
   774 | 
   775 |         attention_mask = (
   776 |             attention_mask_from_padding * can_infer_attention_mask + default_attention_mask * ~can_infer_attention_mask
   777 |         )
   778 |         return attention_mask
   779 | 
   780 |     def _prepare_encoder_decoder_kwargs_for_generation(
   781 |         self: "GenerativePreTrainedModel",
   782 |         inputs_tensor: torch.Tensor,
   783 |         model_kwargs,
   784 |         model_input_name: str | None,
   785 |         generation_config: GenerationConfig,
   786 |     ) -> dict[str, Any]:
   787 |         # 1. get encoder
   788 |         encoder = self.get_encoder()
   789 |         # Compatibility with Accelerate big model inference: we need the encoder to outputs stuff on the same device
   790 |         # as the inputs.
   791 |         if hasattr(self, "hf_device_map"):
   792 |             if hasattr(encoder, "_hf_hook"):
   793 |                 encoder._hf_hook.io_same_device = True
   794 |             else:
   795 |                 add_hook_to_module(encoder, AlignDevicesHook(io_same_device=True))
   796 | 
   797 |         # 2. Prepare encoder args and encoder kwargs from model kwargs and generation config.
   798 |         irrelevant_prefix = ["decoder_", "cross_attn", "use_cache", "past_key_values", "cache_params"]
   799 |         encoder_kwargs = {
   800 |             argument: value
   801 |             for argument, value in model_kwargs.items()
   802 |             if not any(argument.startswith(p) for p in irrelevant_prefix)
   803 |         }
   804 |         encoder_signature = set(inspect.signature(encoder.forward).parameters)
   805 |         encoder_accepts_wildcard = "kwargs" in encoder_signature or "model_kwargs" in encoder_signature
   806 |         if not encoder_accepts_wildcard:
   807 |             encoder_kwargs = {
   808 |                 argument: value for argument, value in encoder_kwargs.items() if argument in encoder_signature
   809 |             }
   810 |         encoder_kwargs["output_attentions"] = generation_config.output_attentions
   811 |         encoder_kwargs["output_hidden_states"] = generation_config.output_hidden_states
   812 | 
   813 |         # 3. make sure that encoder returns `ModelOutput`
   814 |         model_input_name = model_input_name if model_input_name is not None else self.main_input_name
   815 |         encoder_kwargs["return_dict"] = True
   816 |         encoder_kwargs[model_input_name] = inputs_tensor
   817 |         model_kwargs["encoder_outputs"]: ModelOutput = encoder(**encoder_kwargs)
   818 | 
   819 |         return model_kwargs
   820 | 
   821 |     def _prepare_decoder_input_ids_for_generation(
   822 |         self: "GenerativePreTrainedModel",
   823 |         batch_size: int,
   824 |         model_input_name: str,
   825 |         model_kwargs: dict[str, torch.Tensor],
   826 |         decoder_start_token_id: torch.Tensor,
   827 |         device: torch.device | None = None,
   828 |     ) -> tuple[torch.LongTensor, dict[str, torch.Tensor]]:
   829 |         """Prepares `decoder_input_ids` for generation with encoder-decoder models"""
   830 |         # 1. Check whether the user has defined `decoder_input_ids` manually. To facilitate in terms of input naming,
   831 |         # we also allow the user to pass it under `input_ids`, if the encoder does not use it as the main input.
   832 |         if model_kwargs is not None and "decoder_input_ids" in model_kwargs:
   833 |             decoder_input_ids = model_kwargs.pop("decoder_input_ids")
   834 |         elif "input_ids" in model_kwargs and model_input_name != "input_ids":
   835 |             decoder_input_ids = model_kwargs.pop("input_ids")
   836 |         else:
   837 |             decoder_input_ids = None
   838 | 
   839 |         # 2. `decoder_start_token_id` must have shape (batch_size, 1)
   840 |         if device is None:
   841 |             device = self.device
   842 |         if decoder_start_token_id.ndim == 1:
   843 |             if decoder_start_token_id.shape[0] != batch_size:
   844 |                 raise ValueError(
   845 |                     f"`decoder_start_token_id` expected to have length {batch_size} but got {decoder_start_token_id.shape[0]}"
   846 |                 )
   847 |             decoder_start_token_id = decoder_start_token_id.view(-1, 1)
   848 |         else:
   849 |             decoder_start_token_id = (
   850 |                 torch.ones((batch_size, 1), dtype=torch.long, device=device) * decoder_start_token_id
   851 |             )
   852 | 
   853 |         # 3. Encoder-decoder models expect the `decoder_input_ids` to start with a special token. Let's ensure that.
   854 |         # no user input -> use decoder_start_token_id as decoder_input_ids
   855 |         if decoder_input_ids is None:
   856 |             decoder_input_ids = decoder_start_token_id
   857 |         # exception: Donut checkpoints have task-specific decoder starts and don't expect a BOS token. Note that the
   858 |         # original checkpoints can't be detected through `self.__class__.__name__.lower()`, needing custom logic.
   859 |         # See: https://github.com/huggingface/transformers/pull/31470
   860 |         elif "donut" in self.__class__.__name__.lower() or (
   861 |             self.config.model_type == "vision-encoder-decoder" and "donut" in self.config.encoder.model_type.lower()
   862 |         ):
   863 |             pass
   864 |         elif self.config.model_type == "whisper":
   865 |             pass
   866 |         # user input but doesn't start with decoder_start_token_id -> prepend decoder_start_token_id (and adjust
   867 |         # decoder_attention_mask if provided)
   868 |         elif (decoder_input_ids[:, 0] != decoder_start_token_id[:, 0]).all().item():
   869 |             decoder_input_ids = torch.cat([decoder_start_token_id, decoder_input_ids], dim=-1)
   870 |             if "decoder_attention_mask" in model_kwargs:
   871 |                 decoder_attention_mask = model_kwargs["decoder_attention_mask"]
   872 |                 decoder_attention_mask = torch.cat(
   873 |                     (torch.ones_like(decoder_attention_mask)[:, :1], decoder_attention_mask),
   874 |                     dim=-1,
   875 |                 )
   876 |                 model_kwargs["decoder_attention_mask"] = decoder_attention_mask
   877 | 
   878 |         return decoder_input_ids, model_kwargs
   879 | 
   880 |     @staticmethod
   881 |     def _expand_inputs_for_generation(
   882 |         expand_size: int = 1,
   883 |         is_encoder_decoder: bool = False,
   884 |         input_ids: torch.LongTensor | None = None,
   885 |         **model_kwargs,
   886 |     ) -> tuple[torch.LongTensor, dict[str, Any]]:
   887 |         """Expands tensors from [batch_size, ...] to [batch_size * expand_size, ...]"""
   888 |         # Do not call torch.repeat_interleave if expand_size is 1 because it clones
   889 |         # the input tensor and thus requires more memory although no change is applied
   890 |         if expand_size == 1:
   891 |             return input_ids, model_kwargs
   892 | 
   893 |         def _expand_dict_for_generation(dict_to_expand):
   894 |             for key in dict_to_expand:
   895 |                 if dict_to_expand[key] is not None and isinstance(dict_to_expand[key], torch.Tensor):
   896 |                     dict_to_expand[key] = dict_to_expand[key].repeat_interleave(expand_size, dim=0)
   897 |             return dict_to_expand
   898 | 
   899 |         if input_ids is not None:
   900 |             input_ids = input_ids.repeat_interleave(expand_size, dim=0)
   901 | 
   902 |         model_kwargs = _expand_dict_for_generation(model_kwargs)
   903 | 
   904 |         if is_encoder_decoder:
   905 |             if model_kwargs.get("encoder_outputs") is None:
   906 |                 raise ValueError("If `is_encoder_decoder` is True, make sure that `encoder_outputs` is defined.")
   907 |             model_kwargs["encoder_outputs"] = _expand_dict_for_generation(model_kwargs["encoder_outputs"])
   908 | 
   909 |         return input_ids, model_kwargs
   910 | 
   911 |     def _update_model_kwargs_for_generation(
   912 |         self,
   913 |         outputs: ModelOutput,
   914 |         model_kwargs: dict[str, Any],
   915 |         is_encoder_decoder: bool = False,
   916 |         num_new_tokens: int = 1,
   917 |     ) -> dict[str, Any]:
   918 |         """
   919 |         Update the model kwargs to account for the `num_new_tokens` new tokens that were just generated.
   920 |         That is, update the `attention_mask`, `position_ids`, and `token_type_ids` to account for the
   921 |         new tokens of the total sequence.
   922 |         Note that this function never slices inputs, this is performed in `prepare_inputs_for_generation`.
   923 |         """
   924 |         # update past_key_values keeping its naming used in model code
   925 |         for possible_cache_name in ALL_CACHE_NAMES:
   926 |             if possible_cache_name in outputs:
   927 |                 # TODO (joao): remove output/input mismatch when these old models (xlnet, reformer) are deprecated
   928 |                 if possible_cache_name in ("past_buckets_states", "mems"):
   929 |                     cache_name = "past_key_values"
   930 |                 else:
   931 |                     cache_name = possible_cache_name
   932 |                 model_kwargs[cache_name] = getattr(outputs, possible_cache_name)
   933 |                 break
   934 | 
   935 |         # update token_type_ids with last value
   936 |         if (token_type_ids := model_kwargs.get("token_type_ids")) is not None:
   937 |             model_kwargs["token_type_ids"] = torch.cat([token_type_ids, token_type_ids[:, -num_new_tokens:]], dim=-1)
   938 | 
   939 |         # update mm_token_type_ids with zeros (only-text)
   940 |         if (mm_token_type_ids := model_kwargs.get("mm_token_type_ids")) is not None:
   941 |             model_kwargs["mm_token_type_ids"] = torch.cat(
   942 |                 [mm_token_type_ids, mm_token_type_ids.new_zeros((mm_token_type_ids.shape[0], num_new_tokens))], dim=-1
   943 |             )
   944 | 
   945 |         # Position ids (2D or 3D sometimes)
   946 |         position_ids_key = "position_ids" if not is_encoder_decoder else "decoder_position_ids"
   947 |         if (position_ids := model_kwargs.get(position_ids_key)) is not None:
   948 |             # We want to expand to the same number of dims which is not always the same
   949 |             required_dim = [1] * (position_ids.dim() - 1) + [-1]
   950 |             next_position_ids = (
   951 |                 torch.arange(num_new_tokens, dtype=position_ids.dtype, device=position_ids.device).view(*required_dim)
   952 |                 + position_ids[..., -1:]
   953 |                 + 1
   954 |             )
   955 |             next_position_ids = torch.cat([position_ids, next_position_ids], dim=-1)
   956 |             model_kwargs[position_ids_key] = next_position_ids
   957 | 
   958 |         # 2D attention mask (always 2D here)
   959 |         attention_mask_key = "attention_mask" if not is_encoder_decoder else "decoder_attention_mask"
   960 |         if (attention_mask := model_kwargs.get(attention_mask_key)) is not None:
   961 |             model_kwargs[attention_mask_key] = torch.cat(
   962 |                 [attention_mask, attention_mask.new_ones((attention_mask.shape[0], num_new_tokens))], dim=-1
   963 |             )
   964 | 
   965 |         return model_kwargs
   966 | 
   967 |     def _get_candidate_generator(
   968 |         self: "GenerativePreTrainedModel",
   969 |         generation_config: GenerationConfig,
   970 |         input_ids: torch.LongTensor,
   971 |         inputs_tensor: torch.Tensor,
   972 |         logits_processor: LogitsProcessorList,
   973 |         model_kwargs: dict[str, Any],
   974 |         assistant_model: Optional["PreTrainedModel"] = None,
   975 |         target_tokenizer: Optional["PreTrainedTokenizerBase"] = None,
   976 |         assistant_tokenizer: Optional["PreTrainedTokenizerBase"] = None,
   977 |     ) -> CandidateGenerator:
   978 |         """
   979 |         Returns the candidate generator to be used in `assisted_generation`
   980 |         """
   981 |         different_tokenizers = all(v is not None for v in (assistant_model, target_tokenizer, assistant_tokenizer))
   982 | 
   983 |         if generation_config.assistant_early_exit is not None:
   984 |             candidate_generator = EarlyExitCandidateGenerator(
   985 |                 input_ids=input_ids,
   986 |                 assistant_model=self,
   987 |                 generation_config=generation_config,
   988 |                 model_kwargs=model_kwargs,
   989 |                 inputs_tensor=inputs_tensor,
   990 |                 logits_processor=logits_processor,
   991 |             )
   992 |         elif generation_config.prompt_lookup_num_tokens is not None:
   993 |             candidate_generator = PromptLookupCandidateGenerator(
   994 |                 eos_token_id=generation_config._eos_token_tensor,
   995 |                 num_output_tokens=generation_config.prompt_lookup_num_tokens,
   996 |                 max_matching_ngram_size=generation_config.max_matching_ngram_size or 2,
   997 |                 max_length=generation_config.max_length,
   998 |                 logits_processor=logits_processor,
   999 |                 vocab_size=self.config.get_text_config().vocab_size,
  1000 |             )
  1001 |         # SinglePositionMultiTokenCandidateGenerator requires a target model that can provide, and an assistant model that
  1002 |         # can work from a shared_kv_states dictionary. Currently, the only models that can provide this are Gemma 3n and
  1003 |         # Gemma 4, and the only model that can work from it is a Gemma 4 Assistant
  1004 |         elif assistant_model is not None and assistant_model.__class__.__name__.startswith(
  1005 |             ("Gemma4Assistant", "Gemma4UnifiedAssistant")
  1006 |         ):
  1007 |             if not self.__class__.__name__.startswith(("Gemma4", "Gemma3n")):
  1008 |                 raise ValueError(
  1009 |                     f"Expected class name to start with Gemma4 or Gemma3n. Got {self.__class__.__name__}."
  1010 |                     " Gemma4Assistant models require a target model that provides a shared_kv_states dictionary."
  1011 |                     " Currently, only Gemma4 and Gemma3n provide a shared_kv_states dictionary."
  1012 |                 )
  1013 | 
  1014 |             candidate_generator = SinglePositionMultiTokenCandidateGenerator(
  1015 |                 input_ids=input_ids,
  1016 |                 assistant_model=assistant_model,
  1017 |                 target_model_input_embeddings=self.get_input_embeddings(),
  1018 |                 generation_config=generation_config,
  1019 |                 model_kwargs=model_kwargs,
  1020 |                 inputs_tensor=inputs_tensor,
  1021 |                 logits_processor=logits_processor,
  1022 |             )
  1023 |         elif different_tokenizers:
  1024 |             assistant_model = cast("PreTrainedModel", assistant_model)
  1025 |             target_tokenizer = cast("PreTrainedTokenizerBase", target_tokenizer)
  1026 |             assistant_tokenizer = cast("PreTrainedTokenizerBase", assistant_tokenizer)
  1027 |             if generation_config.do_sample is True:
  1028 |                 atm_translator = AssistantVocabTranslatorCache.get_translator(
  1029 |                     target_tokenizer,
  1030 |                     assistant_tokenizer,
  1031 |                     self.config.get_text_config().vocab_size,
  1032 |                     assistant_model=assistant_model,
  1033 |                     assistant_prune_lm_head=True,  # prune LM head of assistant model
  1034 |                 )
  1035 |                 # Since we prune the LM head, we cannot use the repetition penalty on the assistant model due to mismatches between token ids and logits index
  1036 |                 assistant_model.generation_config.repetition_penalty = None
  1037 |                 candidate_generator = UniversalSpeculativeDecodingGenerator(
  1038 |                     input_ids=input_ids,
  1039 |                     assistant_model=assistant_model,
  1040 |                     generation_config=generation_config,
  1041 |                     model_kwargs=model_kwargs,
  1042 |                     inputs_tensor=inputs_tensor,
  1043 |                     logits_processor=logits_processor,
  1044 |                     target_tokenizer=target_tokenizer,
  1045 |                     assistant_tokenizer=assistant_tokenizer,
  1046 |                     atm_translator=atm_translator,
  1047 |                 )
  1048 |             elif generation_config.do_sample is False:
  1049 |                 candidate_generator = AssistedCandidateGeneratorDifferentTokenizers(
  1050 |                     input_ids=input_ids,
  1051 |                     assistant_model=assistant_model,
  1052 |                     generation_config=generation_config,
  1053 |                     model_kwargs=model_kwargs,
  1054 |                     inputs_tensor=inputs_tensor,
  1055 |                     logits_processor=logits_processor,
  1056 |                     target_tokenizer=target_tokenizer,
  1057 |                     assistant_tokenizer=assistant_tokenizer,
  1058 |                 )
  1059 |             else:
  1060 |                 raise ValueError(
  1061 |                     f"Invalid value for `do_sample`: expected a boolean, got {type(generation_config.do_sample).__name__}"
  1062 |                 )
  1063 |         else:
  1064 |             candidate_generator = AssistedCandidateGenerator(
  1065 |                 input_ids=input_ids,
  1066 |                 assistant_model=assistant_model,
  1067 |                 generation_config=generation_config,
  1068 |                 model_kwargs=model_kwargs,
  1069 |                 inputs_tensor=inputs_tensor,
  1070 |                 logits_processor=logits_processor,
  1071 |             )
  1072 |         return candidate_generator
  1073 | 
  1074 |     def _get_logits_processor(
  1075 |         self: "GenerativePreTrainedModel",
  1076 |         generation_config: GenerationConfig,
  1077 |         input_ids_seq_length: int | None = None,
  1078 |         encoder_input_ids: torch.LongTensor | None = None,
  1079 |         prefix_allowed_tokens_fn: Callable[[int, torch.Tensor], list[int]] | None = None,
  1080 |         logits_processor: LogitsProcessorList | None = None,
  1081 |         device: str | None = None,
  1082 |         model_kwargs: dict[str, Any] | None = None,
  1083 |         negative_prompt_ids: torch.Tensor | None = None,
  1084 |         negative_prompt_attention_mask: torch.Tensor | None = None,
  1085 |     ) -> LogitsProcessorList:
  1086 |         """
  1087 |         This class returns a [`LogitsProcessorList`] list object that contains all relevant [`LogitsProcessor`]
  1088 |         instances used to modify the scores of the language model head.
  1089 |         """
  1090 |         # instantiate processors list
  1091 |         processors = LogitsProcessorList()
  1092 |         if logits_processor is None:
  1093 |             logits_processor = []
  1094 | 
  1095 |         if generation_config.guidance_scale is not None and generation_config.guidance_scale != 1:
  1096 |             processors.append(
  1097 |                 UnbatchedClassifierFreeGuidanceLogitsProcessor(
  1098 |                     generation_config.guidance_scale,
  1099 |                     self,
  1100 |                     unconditional_ids=negative_prompt_ids,
  1101 |                     unconditional_attention_mask=negative_prompt_attention_mask,
  1102 |                     use_cache=generation_config.use_cache,
  1103 |                 )
  1104 |             )
  1105 |         if generation_config.sequence_bias is not None:
  1106 |             processors.append(SequenceBiasLogitsProcessor(sequence_bias=generation_config.sequence_bias))
  1107 | 
  1108 |         if (
  1109 |             generation_config.encoder_repetition_penalty is not None
  1110 |             and generation_config.encoder_repetition_penalty != 1.0
  1111 |         ):
  1112 |             if encoder_input_ids is not None and len(encoder_input_ids.shape) == 2:
  1113 |                 processors.append(
  1114 |                     EncoderRepetitionPenaltyLogitsProcessor(
  1115 |                         penalty=generation_config.encoder_repetition_penalty,
  1116 |                         encoder_input_ids=encoder_input_ids,
  1117 |                     )
  1118 |                 )
  1119 |             else:
  1120 |                 warnings.warn(
  1121 |                     "Passing `encoder_repetition_penalty` requires some form of `input_ids` to be passed to "
  1122 |                     "`generate`, ignoring the argument.",
  1123 |                     UserWarning,
  1124 |                 )
  1125 |         if generation_config.repetition_penalty is not None and generation_config.repetition_penalty != 1.0:
  1126 |             processors.append(RepetitionPenaltyLogitsProcessor(penalty=generation_config.repetition_penalty))
  1127 |             if not self.config.is_encoder_decoder and (input_ids_seq_length is None or input_ids_seq_length == 0):
  1128 |                 warnings.warn(
  1129 |                     "Passing `repetition_penalty` with `inputs_embeds` and without `input_ids` to `generate` will "
  1130 |                     "apply the penalty only to newly generated tokens, not to the prompt.",
  1131 |                     UserWarning,
  1132 |                 )
  1133 |         if generation_config.no_repeat_ngram_size is not None and generation_config.no_repeat_ngram_size > 0:
  1134 |             processors.append(NoRepeatNGramLogitsProcessor(generation_config.no_repeat_ngram_size))
  1135 |             if not self.config.is_encoder_decoder and (input_ids_seq_length is None or input_ids_seq_length == 0):
  1136 |                 warnings.warn(
  1137 |                     "Passing `no_repeat_ngram_size` with `inputs_embeds` and without `input_ids` to `generate` will "
  1138 |                     "apply n-gram constraints only to newly generated tokens, not to the prompt.",
  1139 |                     UserWarning,
  1140 |                 )
  1141 |         if (
  1142 |             generation_config.encoder_no_repeat_ngram_size is not None
  1143 |             and generation_config.encoder_no_repeat_ngram_size > 0
  1144 |         ):
  1145 |             if encoder_input_ids is not None and len(encoder_input_ids.shape) == 2:
  1146 |                 processors.append(
  1147 |                     EncoderNoRepeatNGramLogitsProcessor(
  1148 |                         generation_config.encoder_no_repeat_ngram_size,
  1149 |                         encoder_input_ids,
  1150 |                     )
  1151 |                 )
  1152 |             else:
  1153 |                 warnings.warn(
  1154 |                     "Passing `encoder_no_repeat_ngram_size` requires some form of `input_ids` to be passed to "
  1155 |                     "`generate`, ignoring the argument.",
  1156 |                     UserWarning,
  1157 |                 )
  1158 |         if generation_config.bad_words_ids is not None:
  1159 |             processors.append(
  1160 |                 NoBadWordsLogitsProcessor(
  1161 |                     generation_config.bad_words_ids,
  1162 |                     generation_config._eos_token_tensor,
  1163 |                 )
  1164 |             )
  1165 |         if (
  1166 |             generation_config.min_length is not None
  1167 |             and getattr(generation_config, "_eos_token_tensor", None) is not None
  1168 |             and generation_config.min_length > 0
  1169 |         ):
  1170 |             processors.append(
  1171 |                 MinLengthLogitsProcessor(
  1172 |                     generation_config.min_length,
  1173 |                     generation_config._eos_token_tensor,
  1174 |                     device=device,
  1175 |                 )
  1176 |             )
  1177 |         if (
  1178 |             generation_config.min_new_tokens is not None
  1179 |             and getattr(generation_config, "_eos_token_tensor", None) is not None
  1180 |             and generation_config.min_new_tokens > 0
  1181 |         ):
  1182 |             processors.append(
  1183 |                 MinNewTokensLengthLogitsProcessor(
  1184 |                     input_ids_seq_length,
  1185 |                     generation_config.min_new_tokens,
  1186 |                     generation_config._eos_token_tensor,
  1187 |                     device=device,
  1188 |                 )
  1189 |             )
  1190 |         if prefix_allowed_tokens_fn is not None:
  1191 |             processors.append(
  1192 |                 PrefixConstrainedLogitsProcessor(
  1193 |                     prefix_allowed_tokens_fn,
  1194 |                     generation_config.num_beams,
  1195 |                 )
  1196 |             )
  1197 |         if generation_config.forced_bos_token_id is not None:
  1198 |             processors.append(
  1199 |                 ForcedBOSTokenLogitsProcessor(
  1200 |                     generation_config.forced_bos_token_id,
  1201 |                 )
  1202 |             )
  1203 |         if generation_config.forced_eos_token_id is not None:
  1204 |             processors.append(
  1205 |                 ForcedEOSTokenLogitsProcessor(
  1206 |                     generation_config.max_length,
  1207 |                     generation_config.forced_eos_token_id,
  1208 |                     device=device,
  1209 |                 )
  1210 |             )
  1211 |         if generation_config.remove_invalid_values is True:
  1212 |             processors.append(InfNanRemoveLogitsProcessor())
  1213 |         if generation_config.exponential_decay_length_penalty is not None:
  1214 |             processors.append(
  1215 |                 ExponentialDecayLengthPenalty(
  1216 |                     generation_config.exponential_decay_length_penalty,
  1217 |                     generation_config._eos_token_tensor,
  1218 |                     input_ids_seq_length,
  1219 |                 )
  1220 |             )
  1221 |         if generation_config.suppress_tokens is not None:
  1222 |             processors.append(
  1223 |                 SuppressTokensLogitsProcessor(
  1224 |                     generation_config.suppress_tokens,
  1225 |                     device=device,
  1226 |                 )
  1227 |             )
  1228 |         if generation_config.begin_suppress_tokens is not None:
  1229 |             begin_index = input_ids_seq_length
  1230 |             begin_index = (
  1231 |                 begin_index
  1232 |                 if (input_ids_seq_length > 1 or generation_config.forced_bos_token_id is None)
  1233 |                 else begin_index + 1
  1234 |             )
  1235 |             processors.append(
  1236 |                 SuppressTokensAtBeginLogitsProcessor(
  1237 |                     generation_config.begin_suppress_tokens,
  1238 |                     begin_index,
  1239 |                     device=device,
  1240 |                 )
  1241 |             )
  1242 | 
  1243 |         # TODO (joao): find a strategy to specify the order of the processors
  1244 |         processors = self._merge_criteria_processor_list(processors, logits_processor)
  1245 | 
  1246 |         # Processors previously known as `LogitsWarpers`, only applied with sampling strategies
  1247 |         if generation_config.do_sample:
  1248 |             # In beam methods, we need to keep at least one non-eos token to explore continuations that might have a
  1249 |             # better score (i.e. keep len(list(generation_config._eos_token_tensor)) + 1)
  1250 |             if generation_config.num_beams is not None and generation_config.num_beams > 1:
  1251 |                 if isinstance(generation_config._eos_token_tensor, list):
  1252 |                     min_tokens_to_keep = len(generation_config._eos_token_tensor) + 1
  1253 |                 elif isinstance(generation_config._eos_token_tensor, torch.Tensor):
  1254 |                     min_tokens_to_keep = generation_config._eos_token_tensor.shape[0] + 1
  1255 |                 else:
  1256 |                     min_tokens_to_keep = 2
  1257 |             else:
  1258 |                 min_tokens_to_keep = 1
  1259 | 
  1260 |             # the following idea is largely copied from this PR: https://github.com/huggingface/transformers/pull/5420/files
  1261 |             # all samplers can be found in `generation_utils_samplers.py`
  1262 |             if generation_config.temperature is not None and generation_config.temperature != 1.0:
  1263 |                 processors.append(TemperatureLogitsWarper(generation_config.temperature))
  1264 |             if generation_config.top_h is not None:
  1265 |                 processors.append(TopHLogitsWarper(top_h=generation_config.top_h))
  1266 |             if generation_config.top_k is not None and generation_config.top_k != 0:
  1267 |                 processors.append(
  1268 |                     TopKLogitsWarper(top_k=generation_config.top_k, min_tokens_to_keep=min_tokens_to_keep)
  1269 |                 )
  1270 |             if generation_config.top_p is not None and generation_config.top_p < 1.0:
  1271 |                 processors.append(
  1272 |                     TopPLogitsWarper(top_p=generation_config.top_p, min_tokens_to_keep=min_tokens_to_keep)
  1273 |                 )
  1274 |             if generation_config.min_p is not None:
  1275 |                 # Applied after temperature scaling (see https://github.com/ggerganov/llama.cpp/pull/3841#issuecomment-2073826084)
  1276 |                 processors.append(
  1277 |                     MinPLogitsWarper(min_p=generation_config.min_p, min_tokens_to_keep=min_tokens_to_keep)
  1278 |                 )
  1279 |             if generation_config.typical_p is not None and generation_config.typical_p < 1.0:
  1280 |                 processors.append(
  1281 |                     TypicalLogitsWarper(mass=generation_config.typical_p, min_tokens_to_keep=min_tokens_to_keep)
  1282 |                 )
  1283 |             if generation_config.epsilon_cutoff is not None and 0.0 < generation_config.epsilon_cutoff < 1.0:
  1284 |                 processors.append(
  1285 |                     EpsilonLogitsWarper(
  1286 |                         epsilon=generation_config.epsilon_cutoff, min_tokens_to_keep=min_tokens_to_keep
  1287 |                     )
  1288 |                 )
  1289 |             if generation_config.eta_cutoff is not None and 0.0 < generation_config.eta_cutoff < 1.0:
  1290 |                 processors.append(
  1291 |                     EtaLogitsWarper(
  1292 |                         epsilon=generation_config.eta_cutoff, min_tokens_to_keep=min_tokens_to_keep, device=device
  1293 |                     )
  1294 |                 )
  1295 | 
  1296 |         # Watermarking should be after all logits processing is finished (see #34630)
  1297 |         if generation_config.watermarking_config is not None:
  1298 |             processors.append(
  1299 |                 generation_config.watermarking_config.construct_processor(
  1300 |                     self.config.get_text_config().vocab_size, device
  1301 |                 )
  1302 |             )
  1303 | 
  1304 |         # `LogitNormalization` should always be the last logit processor, when present
  1305 |         if generation_config.renormalize_logits is True:
  1306 |             processors.append(LogitNormalization())
  1307 |         return processors
  1308 | 
  1309 |     def _get_stopping_criteria(
  1310 |         self: "GenerativePreTrainedModel",
  1311 |         generation_config: GenerationConfig,
  1312 |         stopping_criteria: StoppingCriteriaList | None,
  1313 |         tokenizer: Optional["PreTrainedTokenizerBase"] = None,
  1314 |     ) -> StoppingCriteriaList:
  1315 |         criteria = StoppingCriteriaList()
  1316 |         if generation_config.max_length is not None:
  1317 |             max_position_embeddings = getattr(self.config, "max_position_embeddings", None)
  1318 |             criteria.append(
  1319 |                 MaxLengthCriteria(
  1320 |                     max_length=generation_config.max_length,
  1321 |                     max_position_embeddings=max_position_embeddings,
  1322 |                 )
  1323 |             )
  1324 |         if generation_config.max_time is not None:
  1325 |             criteria.append(MaxTimeCriteria(max_time=generation_config.max_time))
  1326 |         if generation_config.stop_strings is not None:
  1327 |             if tokenizer is None:
  1328 |                 raise ValueError(
  1329 |                     "There are one or more stop strings, either in the arguments to `generate` or in the "
  1330 |                     "model's generation config, but we could not locate a tokenizer. When generating with "
  1331 |                     "stop strings, you must pass the model's tokenizer to the `tokenizer` argument of `generate`."
  1332 |                 )
  1333 |             criteria.append(StopStringCriteria(stop_strings=generation_config.stop_strings, tokenizer=tokenizer))
  1334 |         if generation_config._eos_token_tensor is not None:
  1335 |             criteria.append(EosTokenCriteria(eos_token_id=generation_config._eos_token_tensor))
  1336 |         if (
  1337 |             generation_config.is_assistant
  1338 |             and generation_config.assistant_confidence_threshold is not None
  1339 |             and generation_config.assistant_confidence_threshold > 0
  1340 |         ):
  1341 |             criteria.append(
  1342 |                 ConfidenceCriteria(assistant_confidence_threshold=generation_config.assistant_confidence_threshold)
  1343 |             )
  1344 |         criteria = self._merge_criteria_processor_list(criteria, stopping_criteria)
  1345 |         return criteria
  1346 | 
  1347 |     def _merge_criteria_processor_list(
  1348 |         self,
  1349 |         default_list: LogitsProcessorList | StoppingCriteriaList,
  1350 |         custom_list: LogitsProcessorList | StoppingCriteriaList,
  1351 |     ) -> LogitsProcessorList | StoppingCriteriaList:
  1352 |         """
  1353 |         Merge user-defined processors/criteria with the ones instantiated inside `generate`. In case the same
  1354 |         processor/criteria is present on both lists, use the user-defined one.
  1355 | 
  1356 |         (Note: up to v4.49.0, this function threw an exception is the same logit processor was found twice.)
  1357 |         """
  1358 |         if len(custom_list) == 0:
  1359 |             return default_list
  1360 | 
  1361 |         final_list = type(default_list)()
  1362 |         for default in default_list:
  1363 |             using_custom = False
  1364 |             for custom in custom_list:
  1365 |                 if type(custom) is type(default):
  1366 |                     object_type = "stopping criteria" if isinstance(custom, StoppingCriteria) else "logits processor"
  1367 |                     logger.warning_once(
  1368 |                         f"A custom {object_type} of type {type(custom)} has been passed to `.generate()`, but it "
  1369 |                         f"was also created in `.generate()`, given its parameterization. The custom {type(custom)} "
  1370 |                         f"will take precedence. Please check the docstring of {type(custom)} to see related "
  1371 |                         "`.generate()` flags."
  1372 |                     )
  1373 |                     final_list.append(custom)
  1374 |                     using_custom = True
  1375 |                     break
  1376 |             if not using_custom:
  1377 |                 final_list.append(default)
  1378 | 
  1379 |         for custom in custom_list:
  1380 |             if custom not in final_list:
  1381 |                 final_list.append(custom)
  1382 |         return final_list
  1383 | 
  1384 |     def compute_transition_scores(
  1385 |         self: "GenerativePreTrainedModel",
  1386 |         sequences: torch.Tensor,
  1387 |         scores: tuple[torch.Tensor],
  1388 |         beam_indices: torch.Tensor | None = None,
  1389 |         normalize_logits: bool = False,
  1390 |     ) -> torch.Tensor:
  1391 |         """
  1392 |         Computes the transition scores of sequences given the generation scores (and beam indices, if beam search was
  1393 |         used). This is a convenient method to quickly obtain the scores of the selected tokens at generation time.
  1394 | 
  1395 |         Parameters:
  1396 |             sequences (`torch.LongTensor`):
  1397 |                 The generated sequences. The second dimension (sequence_length) is either equal to `max_length` or
  1398 |                 shorter if all batches finished early due to the `eos_token_id`.
  1399 |             scores (`tuple(torch.FloatTensor)`):
  1400 |                 Transition scores for each vocabulary token at each generation step. Beam transition scores consisting
  1401 |                 of log probabilities of tokens conditioned on log softmax of previously generated tokens in this beam.
  1402 |                 Tuple of `torch.FloatTensor` with up to `max_new_tokens` elements (one element for each generated token),
  1403 |                 with each tensor of shape `(batch_size*num_beams, config.vocab_size)`.
  1404 |             beam_indices (`torch.LongTensor`, *optional*):
  1405 |                 Beam indices of generated token id at each generation step. `torch.LongTensor` of shape
  1406 |                 `(batch_size*num_return_sequences, sequence_length)`. Only required if a `num_beams>1` at
  1407 |                 generate-time.
  1408 |             normalize_logits (`bool`, *optional*, defaults to `False`):
  1409 |                 Whether to normalize the logits (which, for legacy reasons, may be unnormalized).
  1410 | 
  1411 |         Return:
  1412 |             `torch.Tensor`: A `torch.Tensor` of shape `(batch_size*num_return_sequences, sequence_length)` containing
  1413 |                 the transition scores (logits)
  1414 | 
  1415 |         Examples:
  1416 | 
  1417 |         ```python
  1418 |         >>> from transformers import GPT2Tokenizer, AutoModelForCausalLM
  1419 |         >>> import numpy as np
  1420 | 
  1421 |         >>> tokenizer = GPT2Tokenizer.from_pretrained("gpt2")
  1422 |         >>> model = AutoModelForCausalLM.from_pretrained("openai-community/gpt2")
  1423 |         >>> tokenizer.pad_token_id = tokenizer.eos_token_id
  1424 |         >>> inputs = tokenizer(["Today is"], return_tensors="pt")
  1425 | 
  1426 |         >>> # Example 1: Print the scores for each token generated with Greedy Search
  1427 |         >>> outputs = model.generate(**inputs, max_new_tokens=5, return_dict_in_generate=True, output_scores=True)
  1428 |         >>> transition_scores = model.compute_transition_scores(
  1429 |         ...     outputs.sequences, outputs.scores, normalize_logits=True
  1430 |         ... )
  1431 |         >>> # input_length is the length of the input prompt for decoder-only models, like the GPT family, and 1 for
  1432 |         >>> # encoder-decoder models, like BART or T5.
  1433 |         >>> input_length = 1 if model.config.is_encoder_decoder else inputs.input_ids.shape[1]
  1434 |         >>> generated_tokens = outputs.sequences[:, input_length:]
  1435 |         >>> for tok, score in zip(generated_tokens[0], transition_scores[0]):
  1436 |         ...     # | token | token string | log probability | probability
  1437 |         ...     print(f"| {tok:5d} | {tokenizer.decode(tok):8s} | {score.numpy():.3f} | {np.exp(score.numpy()):.2%}")
  1438 |         |   262 |  the     | -1.414 | 24.33%
  1439 |         |  1110 |  day     | -2.609 | 7.36%
  1440 |         |   618 |  when    | -2.010 | 13.40%
  1441 |         |   356 |  we      | -1.859 | 15.58%
  1442 |         |   460 |  can     | -2.508 | 8.14%
  1443 | 
  1444 |         >>> # Example 2: Reconstruct the sequence scores from Beam Search
  1445 |         >>> outputs = model.generate(
  1446 |         ...     **inputs,
  1447 |         ...     max_new_tokens=5,
  1448 |         ...     num_beams=4,
  1449 |         ...     num_return_sequences=4,
  1450 |         ...     return_dict_in_generate=True,
  1451 |         ...     output_scores=True,
  1452 |         ... )
  1453 |         >>> transition_scores = model.compute_transition_scores(
  1454 |         ...     outputs.sequences, outputs.scores, outputs.beam_indices, normalize_logits=False
  1455 |         ... )
  1456 |         >>> # If you sum the generated tokens' scores and apply the length penalty, you'll get the sequence scores.
  1457 |         >>> # Tip 1: recomputing the scores is only guaranteed to match with `normalize_logits=False`. Depending on the
  1458 |         >>> # use case, you might want to recompute it with `normalize_logits=True`.
  1459 |         >>> # Tip 2: the output length does NOT include the input length
  1460 |         >>> output_length = np.sum(transition_scores.numpy() < 0, axis=1)
  1461 |         >>> length_penalty = model.generation_config.length_penalty
  1462 |         >>> reconstructed_scores = transition_scores.sum(axis=1) / (output_length**length_penalty)
  1463 |         >>> print(np.allclose(outputs.sequences_scores, reconstructed_scores))
  1464 |         True
  1465 |         ```"""
  1466 |         # 1. In absence of `beam_indices`, we can assume that we come from e.g. greedy search, which is equivalent
  1467 |         # to a beam search approach were the first (and only) beam is always selected
  1468 |         if beam_indices is None:
  1469 |             beam_indices = torch.arange(scores[0].shape[0]).view(-1, 1).to(sequences.device)
  1470 |             beam_indices = beam_indices.expand(-1, len(scores))
  1471 | 
  1472 |         # 2. reshape scores as [batch_size*vocab_size, # generation steps] with # generation steps being
  1473 |         # seq_len - input_length
  1474 |         stacked_scores: torch.Tensor = torch.stack(scores).reshape(len(scores), -1).transpose(0, 1)
  1475 | 
  1476 |         # 3. Optionally normalize the logits (across the vocab dimension)
  1477 |         if normalize_logits:
  1478 |             stacked_scores = stacked_scores.reshape(
  1479 |                 -1, self.config.get_text_config().vocab_size, stacked_scores.shape[-1]
  1480 |             )
  1481 |             stacked_scores = torch.nn.functional.log_softmax(stacked_scores, dim=1)
  1482 |             stacked_scores = stacked_scores.reshape(-1, stacked_scores.shape[-1])
  1483 | 
  1484 |         # 4. cut beam_indices to longest beam length
  1485 |         beam_indices_mask = beam_indices < 0
  1486 |         max_beam_length = (1 - beam_indices_mask.long()).sum(-1).max()
  1487 |         beam_indices = beam_indices.clone()[:, :max_beam_length]
  1488 |         beam_indices_mask = beam_indices_mask[:, :max_beam_length]
  1489 | 
  1490 |         # 5. Set indices of beams that finished early to 0; such indices will be masked correctly afterwards
  1491 |         beam_indices[beam_indices_mask] = 0
  1492 | 
  1493 |         # 6. multiply beam_indices with vocab size to gather correctly from scores
  1494 |         beam_sequence_indices = beam_indices * self.config.get_text_config().vocab_size
  1495 | 
  1496 |         # 7. Define which indices contributed to scores
  1497 |         cut_idx = sequences.shape[-1] - max_beam_length
  1498 |         indices = sequences[:, cut_idx:] + beam_sequence_indices
  1499 | 
  1500 |         # 8. Compute scores
  1501 |         transition_scores = stacked_scores.gather(0, indices)
  1502 | 
  1503 |         # 9. Mask out transition_scores of beams that stopped early
  1504 |         transition_scores[beam_indices_mask] = 0
  1505 | 
  1506 |         return transition_scores
  1507 | 
  1508 |     def _validate_generation_mode(
  1509 |         self: "GenerativePreTrainedModel", generation_mode, generation_config, generation_mode_kwargs
  1510 |     ):
  1511 |         supported_modes = getattr(self, "_supported_generation_modes", None)
  1512 |         if supported_modes is not None and generation_mode not in supported_modes:
  1513 |             raise ValueError(
  1514 |                 f"{self.__class__.__name__} only supports {supported_modes}, but got "
  1515 |                 f"generation mode '{generation_mode}'."
  1516 |             )
  1517 | 
  1518 |         if generation_mode == GenerationMode.BEAM_SEARCH and "streamer" in generation_mode_kwargs:
  1519 |             raise ValueError(
  1520 |                 "`streamer` cannot be used with beam search (yet!). Make sure that `num_beams` is set to 1."
  1521 |             )
  1522 | 
  1523 |         if generation_mode == GenerationMode.ASSISTED_GENERATION:
  1524 |             if generation_config.num_return_sequences > 1:
  1525 |                 raise ValueError(
  1526 |                     "num_return_sequences has to be 1 when doing assisted generate, "
  1527 |                     f"but is {generation_config.num_return_sequences}."
  1528 |                 )
  1529 |             if self._is_stateful:
  1530 |                 # In assisted generation we need the ability to confirm whether the model would pick certain tokens,
  1531 |                 # which is not possible with stateful models (they can't reset to a previous subset of generated text)
  1532 |                 raise ValueError(
  1533 |                     f"assisted generation is not supported with stateful models, such as {self.__class__.__name__}"
  1534 |                 )
  1535 | 
  1536 |         if (assistant_model := generation_mode_kwargs.get("assistant_model")) is not None:
  1537 |             if self.config.is_encoder_decoder and not assistant_model.config.is_encoder_decoder:
  1538 |                 attributes_to_check = ["encoder_attention_heads", "encoder_ffn_dim", "encoder_layers"]
  1539 |                 attributes_to_check = [attr for attr in dir(assistant_model.config) if attr in attributes_to_check]
  1540 |                 are_equal = all(
  1541 |                     getattr(self.config, attr) == getattr(assistant_model.config, attr) for attr in attributes_to_check
  1542 |                 )
  1543 |                 if not are_equal:
  1544 |                     raise ValueError(
  1545 |                         "The main model and the assistant don't have compatible encoder-dependent input shapes. "
  1546 |                         "Ensure you load the assistant with the correct encoder-decoder class, e.g. `AutoModelForSpeechSeq2Seq` for Whisper."
  1547 |                     )
  1548 | 
  1549 |             doc_reference = (
  1550 |                 "(see https://huggingface.co/docs/transformers/en/generation_strategies#universal-assisted-decoding)"
  1551 |             )
  1552 |             if self.config.get_text_config().vocab_size == assistant_model.config.get_text_config().vocab_size:
  1553 |                 if "assistant_tokenizer" in generation_mode_kwargs:
  1554 |                     raise ValueError(
  1555 |                         f"`assistant_tokenizer` is not required when the main and assistant models use the same tokenizer. Please omit `assistant_tokenizer` from `generate()` {doc_reference}."
  1556 |                     )
  1557 |             else:
  1558 |                 if "tokenizer" not in generation_mode_kwargs or "assistant_tokenizer" not in generation_mode_kwargs:
  1559 |                     raise ValueError(
  1560 |                         f"The main and assistant models have different tokenizers. Please provide `tokenizer` and `assistant_tokenizer` to `generate()` {doc_reference}."
  1561 |                     )
  1562 | 
  1563 |     def _validate_model_kwargs(self: "GenerativePreTrainedModel", model_kwargs: dict[str, Any]):
  1564 |         """Validates model kwargs for generation. Generate argument typos will also be caught here."""
  1565 |         # Excludes arguments that are handled before calling any model function
  1566 |         if self.config.is_encoder_decoder:
  1567 |             for key in ["decoder_input_ids"]:
  1568 |                 model_kwargs.pop(key, None)
  1569 | 
  1570 |         unused_model_args = []
  1571 |         model_args = set(inspect.signature(self.prepare_inputs_for_generation).parameters)
  1572 |         # `kwargs`/`model_kwargs` is often used to handle optional forward pass inputs like `attention_mask`. If
  1573 |         # `prepare_inputs_for_generation` doesn't accept them, then a stricter check can be made ;)
  1574 |         if "kwargs" in model_args or "model_kwargs" in model_args:
  1575 |             model_args |= set(inspect.signature(self.forward).parameters)
  1576 | 
  1577 |         # Encoder-Decoder models may also need Encoder arguments from `model_kwargs`
  1578 |         if self.config.is_encoder_decoder:
  1579 |             base_model = getattr(self, self.base_model_prefix, None)
  1580 | 
  1581 |             # allow encoder kwargs
  1582 |             encoder = getattr(self, "encoder", None)
  1583 |             # `MusicgenForConditionalGeneration` has `text_encoder` and `audio_encoder`.
  1584 |             # Also, it has `base_model_prefix = "encoder_decoder"` but there is no `self.encoder_decoder`
  1585 |             # TODO: A better way to handle this.
  1586 |             if encoder is None and base_model is not None:
  1587 |                 encoder = getattr(base_model, "encoder", None)
  1588 | 
  1589 |             if encoder is not None:
  1590 |                 encoder_model_args = set(inspect.signature(encoder.forward).parameters)
  1591 |                 model_args |= encoder_model_args
  1592 | 
  1593 |             # allow decoder kwargs
  1594 |             decoder = getattr(self, "decoder", None)
  1595 |             if decoder is None and base_model is not None:
  1596 |                 decoder = getattr(base_model, "decoder", None)
  1597 | 
  1598 |             if decoder is not None:
  1599 |                 decoder_model_args = set(inspect.signature(decoder.forward).parameters)
  1600 |                 model_args |= {f"decoder_{x}" for x in decoder_model_args}
  1601 | 
  1602 |         # TransformersKwargs are model-agnostic attention and generation arguments such as 'output_attentions'
  1603 |         for key, value in model_kwargs.items():
  1604 |             if (
  1605 |                 value is not None
  1606 |                 and key not in model_args
  1607 |                 and key not in TransformersKwargs.__optional_keys__
  1608 |                 and key != "debug_io"
  1609 |             ):
  1610 |                 unused_model_args.append(key)
  1611 | 
  1612 |         if unused_model_args:
  1613 |             raise ValueError(
  1614 |                 f"The following `model_kwargs` are not used by the model: {unused_model_args} (note: typos in the"
  1615 |                 " generate arguments will also show up in this list)"
  1616 |             )
  1617 | 
  1618 |     def _validate_generated_length(
  1619 |         self: "GenerativePreTrainedModel", generation_config, input_ids_length, has_default_max_length
  1620 |     ):
  1621 |         """Performs validation related to the resulting generated length"""
  1622 |         # 1. Max length warnings related to poor parameterization
  1623 |         if has_default_max_length and generation_config.max_new_tokens is None:
  1624 |             # 20 is the default max_length of the generation config
  1625 |             warnings.warn(
  1626 |                 f"Using the model-agnostic default `max_length` (={generation_config.max_length}) to control the "
  1627 |                 "generation length. We recommend setting `max_new_tokens` to control the maximum length of the "
  1628 |                 "generation.",
  1629 |                 UserWarning,
  1630 |             )
  1631 |         if input_ids_length >= generation_config.max_length:
  1632 |             input_ids_string = "decoder_input_ids" if self.config.is_encoder_decoder else "input_ids"
  1633 |             raise ValueError(
  1634 |                 f"Input length of {input_ids_string} is {input_ids_length}, but `max_length` is set to"
  1635 |                 f" {generation_config.max_length}. This can lead to unexpected behavior. You should consider"
  1636 |                 " increasing `max_length` or, better yet, setting `max_new_tokens`."
  1637 |             )
  1638 | 
  1639 |         # 2. Min length warnings due to unfeasible parameter combinations
  1640 |         min_length_error_suffix = (
  1641 |             " Generation will stop at the defined maximum length. You should decrease the minimum length and/or "
  1642 |             "increase the maximum length."
  1643 |         )
  1644 |         if has_default_max_length:
  1645 |             min_length_error_suffix += (
  1646 |                 f" Note that `max_length` is set to {generation_config.max_length}, its default value."
  1647 |             )
  1648 |         if generation_config.min_length is not None and generation_config.min_length > generation_config.max_length:
  1649 |             warnings.warn(
  1650 |                 f"Unfeasible length constraints: `min_length` ({generation_config.min_length}) is larger than"
  1651 |                 f" the maximum possible length ({generation_config.max_length})." + min_length_error_suffix,
  1652 |                 UserWarning,
  1653 |             )
  1654 |         if generation_config.min_new_tokens is not None:
  1655 |             min_length = generation_config.min_new_tokens + input_ids_length
  1656 |             if min_length > generation_config.max_length:
  1657 |                 warnings.warn(
  1658 |                     f"Unfeasible length constraints: `min_new_tokens` ({generation_config.min_new_tokens}), when "
  1659 |                     f"added to the prompt length ({input_ids_length}), is larger than"
  1660 |                     f" the maximum possible length ({generation_config.max_length})." + min_length_error_suffix,
  1661 |                     UserWarning,
  1662 |                 )
  1663 | 
  1664 |     def _prepare_generated_length(
  1665 |         self: "GenerativePreTrainedModel",
  1666 |         generation_config,
  1667 |         has_default_max_length,
  1668 |         has_default_min_length,
  1669 |         model_input_name,
  1670 |         input_ids_length,
  1671 |         inputs_tensor,
  1672 |     ):
  1673 |         """Prepared max and min length in generation configs to avoid clashes between similar attributes"""
  1674 | 
  1675 |         if generation_config.max_new_tokens is not None:
  1676 |             if not has_default_max_length and generation_config.max_length is not None:
  1677 |                 logger.warning(
  1678 |                     f"Both `max_new_tokens` (={generation_config.max_new_tokens}) and `max_length`(="
  1679 |                     f"{generation_config.max_length}) seem to have been set. `max_new_tokens` will take precedence. "
  1680 |                     "Please refer to the documentation for more information. "
  1681 |                     "(https://huggingface.co/docs/transformers/main/en/main_classes/text_generation)"
  1682 |                 )
  1683 |             generation_config.max_length = generation_config.max_new_tokens + input_ids_length
  1684 | 
  1685 |         # If both `inputs_embeds` and `input_ids` are passed, we correct length with `inputs_tensor.shape`
  1686 |         # We need to get max_length = inputs_embeds_len + max_new_tokens
  1687 |         elif (
  1688 |             model_input_name == "inputs_embeds"
  1689 |             and input_ids_length != inputs_tensor.shape[1]
  1690 |             and not self.config.is_encoder_decoder
  1691 |             and not has_default_max_length
  1692 |         ):
  1693 |             generation_config.max_length -= inputs_tensor.shape[1]
  1694 |         elif has_default_max_length:  # by default let's always generate 20 new tokens
  1695 |             generation_config.max_length = generation_config.max_length + input_ids_length
  1696 |             max_position_embeddings = getattr(self.config, "max_position_embeddings", None)
  1697 |             if max_position_embeddings is not None:
  1698 |                 generation_config.max_length = min(generation_config.max_length, max_position_embeddings)
  1699 | 
  1700 |         # same for min length
  1701 |         if generation_config.min_new_tokens is not None:
  1702 |             if not has_default_min_length:
  1703 |                 logger.warning(
  1704 |                     f"Both `min_new_tokens` (={generation_config.min_new_tokens}) and `min_length`(="
  1705 |                     f"{generation_config.min_length}) seem to have been set. `min_new_tokens` will take precedence. "
  1706 |                     "Please refer to the documentation for more information. "
  1707 |                     "(https://huggingface.co/docs/transformers/main/en/main_classes/text_generation)"
  1708 |                 )
  1709 |             generation_config.min_length = generation_config.min_new_tokens + input_ids_length
  1710 | 
  1711 |         elif (
  1712 |             model_input_name == "inputs_embeds"
  1713 |             and input_ids_length != inputs_tensor.shape[1]
  1714 |             and not self.config.is_encoder_decoder
  1715 |         ):
  1716 |             generation_config.min_length = max(generation_config.min_length - inputs_tensor.shape[1], 0)
  1717 | 
  1718 |         return generation_config
  1719 | 
  1720 |     def _prepare_generation_config(
  1721 |         self: "GenerativePreTrainedModel",
  1722 |         generation_config: GenerationConfig | None,
  1723 |         **kwargs: Any,
  1724 |     ) -> tuple[GenerationConfig, dict]:
  1725 |         """
  1726 |         Prepares the base generation config, then applies any generation configuration options from kwargs. This
  1727 |         function handles retrocompatibility with respect to configuration files.
  1728 |         """
  1729 |         # parameterization priority:
  1730 |         # user-defined kwargs or `generation_config` > `self.generation_config` > global default values
  1731 |         # TODO (joao): per-model generation config classes.
  1732 | 
  1733 |         generation_config_provided = generation_config is not None
  1734 |         if generation_config is None:
  1735 |             # Users may modify `model.config` to control generation. This is a legacy behavior and is not supported anymore
  1736 |             if len(self.config._get_generation_parameters()) > 0:
  1737 |                 raise ValueError(
  1738 |                     "You have modified the pretrained model configuration to control generation "
  1739 |                     f"We detected the following values set - {self.config._get_generation_parameters()}. "
  1740 |                     "This strategy to control generation is not supported anymore. Please use and modify `model.generation_config` "
  1741 |                     "(see https://huggingface.co/docs/transformers/generation_strategies#default-text-generation-configuration )",
  1742 |                 )
  1743 |             generation_config = GenerationConfig()
  1744 | 
  1745 |         # `torch.export.export` usually raises an exception if it is called
  1746 |         # with ``strict=True``. deepcopy can only be processed if ``strict=False``.
  1747 |         generation_config = copy.deepcopy(generation_config)
  1748 | 
  1749 |         # First set values from the loaded `self.generation_config`, then set default values (BC)
  1750 |         #
  1751 |         # Only update values that are `None`, i.e. these values were not explicitly set by users to `generate()`,
  1752 |         # or values that are not present in the current config, i.e. custom entries that were set via `**kwargs`.
  1753 |         # Thus we use the specific kwargs `defaults_only=True` (`None` values only) and `allow_custom_entries=True`
  1754 |         # (custom entries are carried over).
  1755 |         global_defaults = self.generation_config._get_default_generation_params()
  1756 |         generation_config.update(**self.generation_config.to_dict(), defaults_only=True, allow_custom_entries=True)
  1757 |         generation_config.update(**global_defaults, defaults_only=True)
  1758 | 
  1759 |         # Finally, if there are any kwargs, update config with it -> highest priority at the end
  1760 |         model_kwargs = generation_config.update(**kwargs)
  1761 | 
  1762 |         # Related to #40039: prior to this PR, models with sliding window attention were forced to have
  1763 |         # `cache_implementation="hybrid"` (the static sliding window cache). For these models, we now want to use
  1764 |         # the dynamic sliding window cache by default, so we UNSET `cache_implementation` if it is a default value.
  1765 |         # (if we're inside this branch, then it is because we're using default values from the Hub)
  1766 |         if generation_config.cache_implementation == "hybrid":
  1767 |             generation_config.cache_implementation = None
  1768 | 
  1769 |         # It doesn't make sense to allow kwargs and `generation_config`, that should be mutually exclusive
  1770 |         if generation_config_provided and set(kwargs.keys()) - set(model_kwargs.keys()):
  1771 |             generation_kwargs = set(kwargs.keys()) - set(model_kwargs.keys())
  1772 |             logger.warning_once(
  1773 |                 f"Passing `generation_config` together with generation-related "
  1774 |                 f"arguments=({generation_kwargs}) is deprecated and will be removed in future versions. "
  1775 |                 "Please pass either a `generation_config` object OR all generation "
  1776 |                 "parameters explicitly, but not both.",
  1777 |             )
  1778 | 
  1779 |         # Finally keep output_xxx args in `model_kwargs` so it can be passed to `forward`
  1780 |         output_attentions = generation_config.output_attentions
  1781 |         output_hidden_states = generation_config.output_hidden_states
  1782 |         model_kwargs.update({"output_attentions": output_attentions} if output_attentions else {})
  1783 |         model_kwargs.update({"output_hidden_states": output_hidden_states} if output_hidden_states else {})
  1784 | 
  1785 |         return generation_config, model_kwargs
  1786 | 
  1787 |     def _get_static_cache_init_shape(self: "GenerativePreTrainedModel") -> tuple[int, int] | None:
  1788 |         """
  1789 |         Returns the per-rank `(num_heads, head_dim)` to eagerly initialize a `StaticCache`, with the head count sharded
  1790 |         for tensor parallelism. Returns `None` when the cache cannot be early initialized.
  1791 |         """
  1792 |         if hasattr(self, "hf_device_map") and len(set(self.hf_device_map.values())) > 1:
  1793 |             # The model layers are on different devices
  1794 |             return None
  1795 |         text_config = self.config.get_text_config(decoder=True)
  1796 |         tp_size = getattr(self, "_tp_size", None) or 1
  1797 |         num_key_value_heads = getattr(text_config, "num_key_value_heads", None) or text_config.num_attention_heads
  1798 |         if num_key_value_heads % tp_size != 0:
  1799 |             # The model cannot be evenly sharded by head
  1800 |             return None
  1801 |         if getattr(text_config, "qk_head_dim", None) is not None:
  1802 |             # MLA models have distinct key (`qk_head_dim`) and value (`v_head_dim`) sizes.
  1803 |             return None
  1804 |         head_dim = getattr(text_config, "head_dim", None) or text_config.hidden_size // text_config.num_attention_heads
  1805 |         return num_key_value_heads // tp_size, head_dim
  1806 | 
  1807 |     def _prepare_static_cache(
  1808 |         self: "GenerativePreTrainedModel",
  1809 |         cache_implementation: str,
  1810 |         batch_size: int,
  1811 |         max_cache_len: int,
  1812 |         prefill_chunk_size: int | None,
  1813 |         model_kwargs,
  1814 |     ) -> Cache:
  1815 |         """
  1816 |         Sets a cache for `generate`, that will persist across calls. A new cache will only be initialized a
  1817 |         new `generate` call requires a larger cache or uses a different batch size.
  1818 | 
  1819 |         Returns the resulting cache object.
  1820 |         """
  1821 |         offload_cache = "offloaded" in cache_implementation
  1822 | 
  1823 |         cache_to_check: StaticCache | None = None
  1824 |         if hasattr(self, "_cache"):
  1825 |             if isinstance(self._cache, EncoderDecoderCache):
  1826 |                 cache_to_check = self._cache.self_attention_cache
  1827 |             elif isinstance(self._cache, StaticCache):
  1828 |                 cache_to_check = self._cache
  1829 | 
  1830 |         need_new_cache = (
  1831 |             cache_to_check is None
  1832 |             or cache_to_check.offloading != offload_cache
  1833 |             or cache_to_check.max_batch_size != batch_size
  1834 |             or cache_to_check.max_cache_len < max_cache_len
  1835 |         )
  1836 | 
  1837 |         encoder_decoder_cache = getattr(self, "_cache", None)
  1838 |         if isinstance(encoder_decoder_cache, EncoderDecoderCache):
  1839 |             need_new_cache = (
  1840 |                 need_new_cache
  1841 |                 or encoder_decoder_cache.cross_attention_cache.max_cache_len
  1842 |                 != model_kwargs["encoder_outputs"][0].shape[1]
  1843 |             )
  1844 | 
  1845 |         if need_new_cache:
  1846 |             self_attention_cache_kwargs = {
  1847 |                 "config": self.config.get_text_config(decoder=True),
  1848 |                 "max_cache_len": max_cache_len,
  1849 |                 "offloading": offload_cache,
  1850 |             }
  1851 |             self._cache = StaticCache(**self_attention_cache_kwargs)
  1852 |             if self.config.is_encoder_decoder:
  1853 |                 cross_attention_cache_kwargs = {
  1854 |                     "config": self.config.get_text_config(decoder=True),
  1855 |                     "max_cache_len": model_kwargs["encoder_outputs"][0].shape[1],
  1856 |                     "offloading": offload_cache,
  1857 |                 }
  1858 |                 self._cache = EncoderDecoderCache(self._cache, StaticCache(**cross_attention_cache_kwargs))
  1859 |             elif prefill_chunk_size is not None:
  1860 |                 # Chunked prefill compiles the prefill, so eagerly init the fresh cache to avoid a recompile next call
  1861 |                 # (#46421). Skipped (-> lazy init) when it can't be initialized on a single device.
  1862 |                 init_shape = self._get_static_cache_init_shape()
  1863 |                 if init_shape is not None:
  1864 |                     num_heads, head_dim = init_shape
  1865 |                     self._cache.early_initialization(
  1866 |                         batch_size=batch_size,
  1867 |                         num_heads=num_heads,
  1868 |                         head_dim=head_dim,
  1869 |                         dtype=self.dtype,
  1870 |                         device=self.device,
  1871 |                     )
  1872 |         else:
  1873 |             self._cache.reset()
  1874 |         return self._cache
  1875 | 
  1876 |     @classmethod
  1877 |     def _supports_default_dynamic_cache(cls: type["GenerativePreTrainedModel"]) -> bool:
  1878 |         """
  1879 |         Return `True` if current model can use a `DynamicCache` instance when initializing the `past_key_values`.
  1880 |         """
  1881 |         # NOTE: remove xlnet/reformer when the models are deprecated, non-standard model architecture/cache name
  1882 |         unsupported_model_names = (
  1883 |             "reformer",
  1884 |             "minimax",
  1885 |             "xlnet",
  1886 |             "olmohybrid",  # olmo_hybrid cannot use linear attention cache for now as it uses split k,q,v conv states
  1887 |             "rwkv",
  1888 |             "xlstm",
  1889 |         )
  1890 |         # The "minimax" exclusion targets the original linear-attention MiniMax (custom cache); the later
  1891 |         # MiniMax M2 / M3 are standard attention models that use the regular Dynamic/Static caches.
  1892 |         name = cls.__name__.lower()
  1893 |         return (
  1894 |             "minimaxm2" in name
  1895 |             or "minimaxm3" in name
  1896 |             or all(unsupported_name not in name for unsupported_name in unsupported_model_names)
  1897 |         )
  1898 | 
  1899 |     def _prepare_cache_for_generation(
  1900 |         self: "GenerativePreTrainedModel",
  1901 |         generation_config: GenerationConfig,
  1902 |         model_kwargs: dict,
  1903 |         generation_mode: GenerationMode,
  1904 |         batch_size: int,
  1905 |         max_cache_length: int,
  1906 |     ) -> bool:
  1907 |         """
  1908 |         Prepares the cache for generation (if applicable), given `generate`'s parameterization. If a cache is
  1909 |         instantiated, writes it to `model_kwargs`, under the name expected by the model.
  1910 |         """
  1911 | 
  1912 |         # TODO @raushan, unify cache arg naming for all models
  1913 |         is_linear_attn_cache = "mamba" in self.__class__.__name__.lower()
  1914 |         cache_name = "past_key_values" if not is_linear_attn_cache else "cache_params"
  1915 | 
  1916 |         # Quick escape route 1: if the user specifies a cache, we only need to check for conflicting `generate` arguments
  1917 |         user_defined_cache = model_kwargs.get(cache_name)
  1918 |         if user_defined_cache is not None:
  1919 |             if generation_config.cache_implementation is not None:
  1920 |                 raise ValueError(
  1921 |                     f"Passing both `cache_implementation` (used to initialize certain caches) and `{cache_name}` (a "
  1922 |                     "Cache object) is unsupported. Please use only one of the two."
  1923 |                 )
  1924 |             if isinstance(user_defined_cache, tuple):
  1925 |                 raise ValueError(
  1926 |                     "Passing a tuple of `past_key_values` is not supported anymore. Please use a `Cache` instance."
  1927 |                 )
  1928 |             return
  1929 | 
  1930 |         # Quick escape route 2: if the user specifies no cache is to be used. (conflicting arguments are handled in
  1931 |         # `generation_config.validate()`)
  1932 |         if generation_config.use_cache is False:
  1933 |             return
  1934 | 
  1935 |         # Quick escape route 3: model that supply it in `prepare_inputs_for_generation` (mamba, zamba, ...)
  1936 |         if not self._supports_default_dynamic_cache():
  1937 |             if generation_config.cache_implementation is not None:
  1938 |                 logger.warning_once(
  1939 |                     "This model does not support `Cache` instances. `cache_implementation` (set to "
  1940 |                     f"{generation_config.cache_implementation}) will be ignored.",
  1941 |                 )
  1942 |             return
  1943 | 
  1944 |         # Otherwise we NEED to prepare a cache, based on `generation_config.cache_implementation`
  1945 | 
  1946 |         # Assisted decoding and contrastive search require cache rollback, which is incompatible with sliding layers.
  1947 |         # To handle this, we skip passing the model config to DynamicCache (forcing a full-layer cache).
  1948 |         # The "dynamic_full" option is a shortcut for generate() users to avoid sliding layers on their own.
  1949 |         if generation_mode in (GenerationMode.ASSISTED_GENERATION, GenerationMode.CONTRASTIVE_SEARCH):
  1950 |             if generation_config.cache_implementation is not None:
  1951 |                 logger.warning_once(
  1952 |                     "An assistant model is provided, using a dynamic cache instead of a cache of type="
  1953 |                     f"'{generation_config.cache_implementation}'."
  1954 |                 )
  1955 |             generation_config.cache_implementation = "dynamic_full"
  1956 | 
  1957 |         dynamic_cache_kwargs = {}
  1958 |         dynamic_cache_kwargs["config"] = self.config.get_text_config(decoder=True)
  1959 | 
  1960 |         if generation_config.cache_implementation == "offloaded":
  1961 |             dynamic_cache_kwargs["offloading"] = True
  1962 | 
  1963 |         if generation_config.cache_implementation in ALL_STATIC_CACHE_IMPLEMENTATIONS:
  1964 |             if generation_config.cache_implementation in DEPRECATED_STATIC_CACHE_IMPLEMENTATIONS:
  1965 |                 logger.warning_once(
  1966 |                     f"Using `cache_implementation='{generation_config.cache_implementation}' is deprecated "
  1967 |                     f"and will be removed in v5.13. Please only use one of {STATIC_CACHE_IMPLEMENTATIONS}, "
  1968 |                     "and the layer structure will be inferred automatically."
  1969 |                 )
  1970 |             # `max_cache_len` lets the static cache be sized for the worst case across calls, so that later calls
  1971 |             # with a longer prompt or a larger `max_new_tokens` (up to that ceiling) reuse the same cache instead of
  1972 |             # triggering a reallocation (and a `torch.compile` recompilation). Without it, the cache is sized to the
  1973 |             # current call's `max_length` only. See #46424.
  1974 |             if generation_config.max_cache_len is not None:
  1975 |                 max_cache_length = max(max_cache_length, generation_config.max_cache_len)
  1976 |             cache_batch_size = max(generation_config.num_beams, generation_config.num_return_sequences) * batch_size
  1977 |             model_kwargs[cache_name] = self._prepare_static_cache(
  1978 |                 cache_implementation=generation_config.cache_implementation,
  1979 |                 batch_size=cache_batch_size,
  1980 |                 max_cache_len=max_cache_length,
  1981 |                 prefill_chunk_size=generation_config.prefill_chunk_size,
  1982 |                 model_kwargs=model_kwargs,
  1983 |             )
  1984 |         elif generation_config.cache_implementation == "quantized":
  1985 |             if self.config.is_encoder_decoder or not self._supports_default_dynamic_cache():
  1986 |                 raise ValueError(
  1987 |                     "This model does not support the quantized cache. If you want your model to support quantized "
  1988 |                     "cache, please open an issue and tag @zucchini-nlp."
  1989 |                 )
  1990 | 
  1991 |             cache_config = generation_config.cache_config if generation_config.cache_config is not None else {}
  1992 |             cache_config.setdefault("config", self.config.get_text_config(decoder=True))
  1993 |             backend = cache_config.pop("backend", "quanto")
  1994 |             model_kwargs[cache_name] = QuantizedCache(backend=backend, **cache_config)
  1995 |         # i.e. `cache_implementation` in [None, "dynamic", "offloaded", "dynamic_full"]
  1996 |         # TODO: prepare linear cache from a single API, instead of creating in modeling code
  1997 |         else:
  1998 |             model_kwargs[cache_name] = DynamicCache(**dynamic_cache_kwargs)
  1999 | 
  2000 |         if (
  2001 |             self.config.is_encoder_decoder
  2002 |             and cache_name in model_kwargs
  2003 |             and not isinstance(model_kwargs[cache_name], EncoderDecoderCache)
  2004 |         ):
  2005 |             model_kwargs[cache_name] = EncoderDecoderCache(
  2006 |                 model_kwargs[cache_name],  # self-attention cache
  2007 |                 DynamicCache(**dynamic_cache_kwargs),  # cross-attention cache
  2008 |             )
  2009 | 
  2010 |     def _supports_logits_to_keep(self: "GenerativePreTrainedModel") -> bool:
  2011 |         """
  2012 |         Return True if the current model supports the keyword argument `logits_to_keep` in forward()
  2013 |         to save memory. Checking it in this way allows to avoid using a new model attribute.
  2014 |         """
  2015 |         return "logits_to_keep" in set(inspect.signature(self.forward).parameters.keys())
  2016 | 
  2017 |     def _prepare_special_tokens(
  2018 |         self: "GenerativePreTrainedModel",
  2019 |         generation_config: GenerationConfig,
  2020 |         kwargs_has_attention_mask: bool | None = None,
  2021 |         device: torch.device | str | None = None,
  2022 |     ):
  2023 |         """
  2024 |         Prepares the special tokens for generation, overwriting the generation config with their processed versions
  2025 |         converted to tensor.
  2026 | 
  2027 |         Note that `generation_config` is changed in place and stops being serializable after this method is called.
  2028 |         That is no problem if called within `generate` (`generation_config` is a local copy that doesn't leave the
  2029 |         function). However, if called outside `generate`, consider creating a copy of `generation_config` first.
  2030 |         """
  2031 | 
  2032 |         # Convert special tokens to tensors
  2033 |         def _tensor_or_none(token, device=None):
  2034 |             if token is None:
  2035 |                 return token
  2036 | 
  2037 |             device = device if device is not None else self.device
  2038 |             if isinstance(token, torch.Tensor):
  2039 |                 return token.to(device)
  2040 |             return torch.tensor(token, device=device, dtype=torch.long)
  2041 | 
  2042 |         bos_token_tensor = _tensor_or_none(generation_config.bos_token_id, device=device)
  2043 |         eos_token_tensor = _tensor_or_none(generation_config.eos_token_id, device=device)
  2044 |         pad_token_tensor = _tensor_or_none(generation_config.pad_token_id, device=device)
  2045 |         decoder_start_token_tensor = _tensor_or_none(generation_config.decoder_start_token_id, device=device)
  2046 | 
  2047 |         # for BC we also try to get `decoder_start_token_id` or `bos_token_id` (#30892)
  2048 |         if self.config.is_encoder_decoder:
  2049 |             decoder_start_token_tensor = (
  2050 |                 decoder_start_token_tensor if decoder_start_token_tensor is not None else bos_token_tensor
  2051 |             )
  2052 | 
  2053 |         # We can have more than one eos token. Always treat it as a 1D tensor (when it exists).
  2054 |         if eos_token_tensor is not None and eos_token_tensor.ndim == 0:
  2055 |             eos_token_tensor = eos_token_tensor.unsqueeze(0)
  2056 | 
  2057 |         # Set pad token if unset (and there are conditions to do so)
  2058 |         if pad_token_tensor is None and eos_token_tensor is not None:
  2059 |             if kwargs_has_attention_mask is not None and not kwargs_has_attention_mask:
  2060 |                 logger.warning(
  2061 |                     "The attention mask and the pad token id were not set. As a consequence, you may observe "
