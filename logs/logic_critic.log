  2232 |     def set_experts_implementation(self, experts_implementation: str | dict):
  2233 |         """
  2234 |         Set the requested `experts_implementation` for this model.
  2235 | 
  2236 |         Args:
  2237 |             experts_implementation (`str` or `dict`):
  2238 |                 The experts implementation to set for this model. It can be either a `str`, in which case it will be
  2239 |                 dispatched to all submodels if relevant, or a `dict` where keys are the sub_configs name, in which case each
  2240 |                 submodel will dispatch the corresponding value.
  2241 |         """
  2242 |         requested_implementation = (
  2243 |             experts_implementation
  2244 |             if not isinstance(experts_implementation, dict)
  2245 |             else experts_implementation.get("", self.config._experts_implementation)
  2246 |         )
  2247 | 
  2248 |         # MegaMoE is locked at load time: its TP plan is baked into `base_model_tp_plan`
  2249 |         # by `update_tp_plan` (and isn't re-evaluated) and `setup_megamoe_weights`
  2250 |         # mutates the expert weights into UTCCP layout on first forward. Either side of
  2251 |         # a switch would silently produce garbage, so reject it with a clear pointer.
  2252 |         current = self.config._experts_implementation
  2253 |         if "deepgemm_megamoe" in (current, requested_implementation) and current != requested_implementation:
  2254 |             raise RuntimeError(
  2255 |                 f"Cannot switch experts implementation from {current!r} to {requested_implementation!r} "
  2256 |                 "at runtime: `deepgemm_megamoe` is a load-time choice. Reload via "
  2257 |                 "`from_pretrained(..., experts_implementation=...)` to switch."
  2258 |             )
  2259 | 
  2260 |         if requested_implementation != self.config._experts_implementation:
  2261 |             requested_implementation = self._check_and_adjust_experts_implementation(requested_implementation)
  2262 |             # Apply the change (on the internal attr, to avoid setting it recursively)
  2263 |             self.config._experts_implementation_internal = requested_implementation
  2264 | 
  2265 |         # Apply it to all submodels as well
  2266 |         for submodule in self.modules():
  2267 |             # We found a submodel (which is not self) with a different config (otherwise, it may be the same "actual model",
  2268 |             # e.g. ForCausalLM has a Model inside, but no need to check it again)
  2269 |             if (
  2270 |                 submodule is not self
  2271 |                 and isinstance(submodule, PreTrainedModel)
  2272 |                 and submodule.config.__class__ != self.config.__class__
  2273 |             ):
  2274 |                 # Set the experts on the submodule
  2275 |                 sub_implementation = requested_implementation
  2276 |                 if isinstance(experts_implementation, dict):
  2277 |                     for subconfig_key in self.config.sub_configs:
  2278 |                         # We need to check for exact object match here, with `is`
  2279 |                         if getattr(self.config, subconfig_key) is submodule.config:
  2280 |                             sub_implementation = experts_implementation.get(
  2281 |                                 subconfig_key, submodule.config._experts_implementation
  2282 |                             )
  2283 |                             break
  2284 |                 # Check the module can use correctly, otherwise we raise an error if requested experts can't be set for submodule
  2285 |                 sub_implementation = submodule.get_correct_experts_implementation(sub_implementation)
  2286 |                 submodule.config._experts_implementation_internal = sub_implementation
