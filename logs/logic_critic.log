   220 |     def _slice_and_cat(self, source, intervals, device, dtype):
   221 |         multi_interval_dim: int | None = None
   222 |         slices: list[slice] = []
   223 |         for source_dim, pieces in enumerate(intervals):
   224 |             if len(pieces) == 1:
   225 |                 start, end = pieces[0]
   226 |                 slices.append(slice(start, end))
   227 |                 continue
   228 |             if multi_interval_dim is not None:
   229 |                 raise ValueError("Shard-on-read only supports disjoint ranges on a single checkpoint dimension.")
   230 |             multi_interval_dim = source_dim
   231 |             slices.append(slice(None))  # placeholder, filled per-piece below
