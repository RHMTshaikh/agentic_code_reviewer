  3547 |             state_dict, filename_pattern=filename_pattern, max_shard_size=max_shard_size
  3548 |         )
  3549 |         # Save index if sharded
  3550 |         index = None
  3551 |         if state_dict_split.is_sharded:
  3552 |             index = {
  3553 |                 "metadata": {"total_parameters": self.num_parameters(), **state_dict_split.metadata},
  3554 |                 "weight_map": state_dict_split.tensor_to_filename,
  3555 |             }
  3556 | 
  3557 |         # Clean the folder from a previous save
