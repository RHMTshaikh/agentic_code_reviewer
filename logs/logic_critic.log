   9 | class Rect_2D:
  10 |     def __init__(self, x_min, y_min, x_max, y_max):
  11 |         self.x_min = x_min
  12 |         self.y_min = y_min
  13 |         self.x_max = x_max
  14 |         self.y_max = y_max
  15 |         
  16 |         self.corners = [
  17 |             (x_min, y_min),
  18 |             (x_max, y_min),
  19 |             (x_max, y_max),
  20 |             (x_min, y_max)
  21 |         ]
  22 |     
  23 |     def contains_point(self, x, y) -> bool:
  24 |         return self.x_min <= x <= self.x_max and self.y_min <= y <= self.y_max
  25 |     
  26 |     def contains_line(self, line: Line_3D) -> bool:
  27 |         # if all the corners of the rect are on one side of the line, return False
  28 |         side_values = []
  29 |         x0, y0 = line.point1[:2]
  30 |         dx, dy = line.direction[:2]
  31 | 
  32 |         for (x, y) in self.corners:
  33 |             value = (x - x0) * dy - (y - y0) * dx
  34 |             side_values.append(value)
  35 |             
  36 |         all_positive = all(v > 0 for v in side_values)
  37 |         all_negative = all(v < 0 for v in side_values)
  38 |         if all_positive or all_negative:
  39 |             return False
  40 |         return True
  41 |     
  42 |     def boundary_points_on_line(self, line: Line_3D) -> list[tuple]:
  43 |         # 1. Quick check: does the line even pass through the rect?
  44 |         if not self.contains_line(line):
  45 |             return []
  46 | 
  47 |         points = []
  48 |         x0, y0 = line.point1[:2]
  49 |         dx, dy = line.direction[:2] # Vector of the line
  50 | 
  51 |         edges = [
  52 |             ((self.x_min, self.y_min), (self.x_max, self.y_min)),  # Top
  53 |             ((self.x_max, self.y_min), (self.x_max, self.y_max)),  # Right
  54 |             ((self.x_max, self.y_max), (self.x_min, self.y_max)),  # Bottom
  55 |             ((self.x_min, self.y_max), (self.x_min, self.y_min)),  # Left
  56 |         ]
  57 | 
  58 |         for (x1, y1), (x2, y2) in edges:
  59 |             ex, ey = x2 - x1, y2 - y1 # Vector of the edge
  60 |             
  61 |             # Denominator is the cross product of the two vectors
  62 |             denom = (ex * dy) - (ey * dx)
  63 |             
  64 |             if np.isclose(denom, 0):
  65 |                 continue
  66 | 
  67 |             # Solve for the parameters
  68 |             # t is the distance along the LINE, u is the distance along the EDGE
  69 |             t = ((x1 - x0) * ey - (y1 - y0) * ex) / -denom
