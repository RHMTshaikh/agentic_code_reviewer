  2526 |         epsilon: float = 1e-8,
  2527 |         args: str | None = None,
  2528 |     ):
  2529 |         """
  2530 |         A method that regroups all arguments linked to the optimizer and its hyperparameters.
  2531 | 
  2532 |         Args:
  2533 |             name (`str` or [`training_args.OptimizerNames`], *optional*, defaults to `"adamw_torch"`):
  2534 |                 The optimizer to use: `"adamw_torch"`, `"adamw_torch_fused"`,
  2535 |                 `"adamw_anyprecision"` or `"adafactor"`.
  2536 |             learning_rate (`float`, *optional*, defaults to 5e-5):
  2537 |                 The initial learning rate.
  2538 |             weight_decay (`float`, *optional*, defaults to 0):
  2539 |                 The weight decay to apply (if not zero) to all layers except all bias and LayerNorm weights.
  2540 |             beta1 (`float`, *optional*, defaults to 0.9):
  2541 |                 The beta1 hyperparameter for the adam optimizer or its variants.
  2542 |             beta2 (`float`, *optional*, defaults to 0.999):
  2543 |                 The beta2 hyperparameter for the adam optimizer or its variants.
  2544 |             epsilon (`float`, *optional*, defaults to 1e-8):
  2545 |                 The epsilon hyperparameter for the adam optimizer or its variants.
  2546 |             args (`str`, *optional*):
  2547 |                 Optional arguments that are supplied to AnyPrecisionAdamW (only useful when
  2548 |                 `optim="adamw_anyprecision"`).
  2549 | 
  2550 |         Example:
  2551 | 
  2552 |         ```py
  2553 |         >>> from transformers import TrainingArguments
  2554 | 
  2555 |         >>> args = TrainingArguments("working_dir")
  2556 |         >>> args = args.set_optimizer(name="adamw_torch", beta1=0.8)
  2557 |         >>> args.optim
  2558 |         'adamw_torch'
  2559 |         ```
  2560 |         """
  2561 |         self.optim = OptimizerNames(name)
  2562 |         self.learning_rate = learning_rate
  2563 |         self.weight_decay = weight_decay
  2564 |         self.adam_beta1 = beta1
  2565 |         self.adam_beta2 = beta2
  2566 |         self.adam_epsilon = epsilon
  2567 |         self.optim_args = args
  2568 |         return self
