   237 |         names, modules = [], []
   238 |         for name, module in no_reshard_targets:
   239 |             names.append(name)
   240 |             modules.append(module)
   241 |         fully_shard(modules, mesh=fsdp_mesh, reshard_after_forward=False, **fsdp_policy_kwargs)
   242 |         logger.debug(f"Grouped tail {names} (reshard=False)")
   243 |     else:
   244 |         for name, module in no_reshard_targets:
   245 |             fully_shard(module, mesh=fsdp_mesh, reshard_after_forward=False, **fsdp_policy_kwargs)
   246 |             logger.debug(f"Applied fully_shard to {name} (reshard=False)")
   247 | 
