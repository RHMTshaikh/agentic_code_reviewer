  2962 | def _format_type_annotation_recursive(type_hint):
  2963 |     """
  2964 |     Recursively format a type annotation object as a string, preserving generic type arguments.
  2965 | 
  2966 |     This is an internal helper used by process_type_annotation for the type object path.
  2967 | 
  2968 |     Args:
  2969 |         type_hint: A type annotation object
  2970 | 
  2971 |     Returns:
  2972 |         str: Formatted type string
  2973 |     """
