   394 |     def update(
   395 |         self,
   396 |         key_states: torch.Tensor,  # shape [1, num_kv_heads, seqlen_kv, head_dim]
   397 |         value_states: torch.Tensor,  # shape [1, num_kv_heads, seqlen_kv, head_dim]
   398 |         layer_idx: int,
   399 |         read_index: list[torch.Tensor],  # shape [num_layer_groups, seqlen_kv + past_length]
   400 |         write_index: list[torch.Tensor],  # shape [num_layer_groups, seqlen_q]
   401 |     ) -> tuple[torch.Tensor, torch.Tensor]:  # shape [seqlen_kv + past_length, num_kv_heads, head_dim]
   402 |         """Update the cache with new key-value states for a specific layer, and retrieves the relevant KV states from
   403 |         the cache for attention computation. The behavior differs based on the layer's attention type:
   404 | 
   405 |         - Full attention: New KV states are written to cache, then complete sequence is read from cache
   406 |         - Sliding window: Old KV is read from cache along with extra spaces for the new KV, then new KV is written to
   407 |             cache. This is because new KV might overwrite the old KV, so we need to read the old KV first.
   408 | 
   409 |         When the layer's read index is empty, the batch has no cache reads (all requests are non-chunked prefills): we
   410 |         only write to the cache and return the input KV states directly, skipping the index_select read-back.
   411 | 
   412 |         Returns the complete KV states (cached + new) for attention computation.
   413 |         """
   414 |         # Retrieve the layer write index and the relevant cache tensors
   415 |         group_idx, layer_idx_in_group = self.layer_index_to_group_indices[layer_idx]
   416 |         layer_read_index = read_index[group_idx]
   417 |         layer_write_index = write_index[group_idx]
   418 |         k_cache = self.key_cache[layer_idx_in_group]
   419 |         v_cache = self.value_cache[layer_idx_in_group]
   420 |         # Transpose the key and value states to match the cache shape, after which shape is [seqlen_kv, num_kv_heads, head_dim]
   421 |         key_states = key_states.transpose(1, 2).squeeze(0)
   422 |         value_states = value_states.transpose(1, 2).squeeze(0)
   423 | 
   424 |         # Case: write-only, no cache read. The input KV states already contain everything the attention needs.
   425 |         if layer_read_index.numel() == 0:
   426 |             k_cache.index_copy_(0, layer_write_index, key_states)
   427 |             v_cache.index_copy_(0, layer_write_index, value_states)
   428 |             return key_states, value_states
   429 | 
   430 |         # Case: full attention
   431 |         sliding_window = self.sliding_windows[layer_idx]
   432 |         if sliding_window == 1:
   433 |             k_cache.index_copy_(0, layer_write_index, key_states)
   434 |             v_cache.index_copy_(0, layer_write_index, value_states)
   435 |             key_states_with_cache = torch.index_select(k_cache, 0, layer_read_index)
   436 |             value_states_with_cache = torch.index_select(v_cache, 0, layer_read_index)
   437 | 
   438 |         # Case: sliding window -- we  need to be careful of read/write order because of chunked prefill, because it's
   439 |         # the only case where you may write over cache you need to use
   440 |         else:
   441 |             # Sentinel positions in read_index mark new-token slots; index_select reads garbage there,
   442 |             # then masked_scatter_ overwrites them with the actual new key/value states.
   443 |             mask = (layer_read_index == self.sentinel_index).unsqueeze(-1).unsqueeze(-1)
   444 |             key_states_with_cache = torch.index_select(k_cache, 0, layer_read_index)
   445 |             key_states_with_cache.masked_scatter_(mask, key_states)
   446 |             value_states_with_cache = torch.index_select(v_cache, 0, layer_read_index)
   447 |             value_states_with_cache.masked_scatter_(mask, value_states)
   448 |             # Write new KV values to the cache (padding slots in write_index point to the trash position)
   449 |             k_cache.index_copy_(0, layer_write_index, key_states)
   450 |             v_cache.index_copy_(0, layer_write_index, value_states)
   451 | 
   452 |         # Return the new KV values
   453 |         return key_states_with_cache, value_states_with_cache
   454 | 
   455 |     def get_block_table_key(self, flash_attn_with_kvcache_fn: Any) -> str:
