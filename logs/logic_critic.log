  3462 | # Python < 3.12 fallback: naming heuristics when __orig_bases__ is not set (cpython#103699).
  3463 | # Order matters: check ImageProcessorKwargs before ProcessorKwargs.
  3464 | _BASIC_KWARGS_NAMES = frozenset({"ImagesKwargs", "ProcessingKwargs", "TextKwargs", "VideosKwargs", "AudioKwargs"})
  3465 | _BASIC_KWARGS_CLASSES = None  # Lazy-loaded name -> class mapping
