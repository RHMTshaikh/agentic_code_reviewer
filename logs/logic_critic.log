   162 | def repeat_kv(hidden_states: torch.Tensor, n_rep: int) -> torch.Tensor:
   163 |     """
   164 |     This is the equivalent of torch.repeat_interleave(x, dim=1, repeats=n_rep). The hidden states go from (batch,
   165 |     num_key_value_heads, seqlen, head_dim) to (batch, num_attention_heads, seqlen, head_dim)
   166 |     """
   167 |     batch, num_key_value_heads, slen, head_dim = hidden_states.shape
