   357 |     def extend_read_and_write_indices(
   358 |         self,
   359 |         request_id: str,
   360 |         past_length: int,
   361 |         query_length: int,
   362 |         read_index: list[list[int]] | None,
   363 |         write_index: list[list[int]],
   364 |     ) -> None:
   365 |         """Retrieve physical cache indices for reading KV states in the cache across all layer groups. This method
   366 |         coordinates with all cache managers to build the complete set of read indices needed for attention computation.
   367 |         When read_index is None, the batch has no cache reads and we only compute the write indices.
   368 |         """
   369 |         # Write indices are always computed
   370 |         for cm, write_indices in zip(self.group_cache_managers, write_index):
   371 |             write_indices.extend(cm.get_write_indices(request_id, past_length, query_length))
   372 |         # Read indices are only computed if there are cache indices
   373 |         if read_index is not None:
   374 |             for cm, read_indices in zip(self.group_cache_managers, read_index):
   375 |                 read_indices.extend(cm.get_read_indices(request_id, past_length, query_length))
