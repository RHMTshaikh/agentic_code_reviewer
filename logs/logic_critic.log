  1937 |                 "Unable to load tokenizer model from SPM, loading from TikToken will be attempted instead."
  1938 |                 "(Google protobuf error: Tried to load SPM model with non-SPM vocab file).",
  1939 |             )
  1940 |         except RuntimeError as e:
  1941 |             if "sentencepiece_processor.cc" in str(e):
