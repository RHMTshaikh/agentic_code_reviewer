  2760 |     def _pad(
  2761 |         self,
  2762 |         encoded_inputs: dict[str, EncodedInput] | BatchEncoding,
  2763 |         max_length: int | None = None,
  2764 |         padding_strategy: PaddingStrategy = PaddingStrategy.DO_NOT_PAD,
  2765 |         pad_to_multiple_of: int | None = None,
  2766 |         padding_side: str | None = None,
  2767 |         return_attention_mask: bool | None = None,
  2768 |     ) -> dict:
  2769 |         """
  2770 |         Pad encoded inputs (on left/right and up to predefined length or max length in the batch)
  2771 | 
  2772 |         Args:
  2773 |             encoded_inputs:
  2774 |                 Dictionary of tokenized inputs (`list[int]`) or batch of tokenized inputs (`list[list[int]]`).
  2775 |             max_length: maximum length of the returned list and optionally padding length (see below).
  2776 |                 Will truncate by taking into account the special tokens.
  2777 |             padding_strategy: PaddingStrategy to use for padding.
  2778 | 
  2779 |                 - PaddingStrategy.LONGEST Pad to the longest sequence in the batch
  2780 |                 - PaddingStrategy.MAX_LENGTH: Pad to the max length (default)
  2781 |                 - PaddingStrategy.DO_NOT_PAD: Do not pad
  2782 |                 The tokenizer padding sides are defined in `padding_side` argument:
  2783 | 
  2784 |                     - 'left': pads on the left of the sequences
  2785 |                     - 'right': pads on the right of the sequences
  2786 |             pad_to_multiple_of: (optional) Integer if set will pad the sequence to a multiple of the provided value.
  2787 |                 This is especially useful to enable the use of Tensor Core on NVIDIA hardware with compute capability
  2788 |                 `>= 7.5` (Volta).
  2789 |             padding_side:
  2790 |                 The side on which the model should have padding applied. Should be selected between ['right', 'left'].
  2791 |                 Default value is picked from the class attribute of the same name.
  2792 |             return_attention_mask:
  2793 |                 (optional) Set to False to avoid returning attention mask (default: set to model specifics)
  2794 |         """
  2795 |         # Load from model defaults
  2796 |         if return_attention_mask is None:
  2797 |             return_attention_mask = "attention_mask" in self.model_input_names
  2798 | 
  2799 |         required_input = encoded_inputs[self.model_input_names[0]]
  2800 | 
  2801 |         if padding_strategy == PaddingStrategy.LONGEST:
  2802 |             max_length = len(required_input)
  2803 | 
  2804 |         if max_length is not None and pad_to_multiple_of is not None and (max_length % pad_to_multiple_of != 0):
  2805 |             max_length = ((max_length // pad_to_multiple_of) + 1) * pad_to_multiple_of
  2806 | 
  2807 |         needs_to_be_padded = padding_strategy != PaddingStrategy.DO_NOT_PAD and len(required_input) != max_length
  2808 | 
  2809 |         # Initialize attention mask if not present.
  2810 |         if return_attention_mask and "attention_mask" not in encoded_inputs:
  2811 |             encoded_inputs["attention_mask"] = [1] * len(required_input)
  2812 | 
  2813 |         if needs_to_be_padded:
  2814 |             difference = max_length - len(required_input)
  2815 |             padding_side = padding_side if padding_side is not None else self.padding_side
  2816 | 
  2817 |             if padding_side == "right":
  2818 |                 if return_attention_mask:
  2819 |                     encoded_inputs["attention_mask"] = encoded_inputs["attention_mask"] + [0] * difference
  2820 |                 if "token_type_ids" in encoded_inputs:
  2821 |                     encoded_inputs["token_type_ids"] = (
  2822 |                         encoded_inputs["token_type_ids"] + [self.pad_token_type_id] * difference
  2823 |                     )
  2824 |                 if "special_tokens_mask" in encoded_inputs:
  2825 |                     encoded_inputs["special_tokens_mask"] = encoded_inputs["special_tokens_mask"] + [1] * difference
  2826 |                 encoded_inputs[self.model_input_names[0]] = required_input + [self.pad_token_id] * difference
  2827 |             elif padding_side == "left":
  2828 |                 if return_attention_mask:
  2829 |                     encoded_inputs["attention_mask"] = [0] * difference + encoded_inputs["attention_mask"]
  2830 |                 if "token_type_ids" in encoded_inputs:
  2831 |                     encoded_inputs["token_type_ids"] = [self.pad_token_type_id] * difference + encoded_inputs[
  2832 |                         "token_type_ids"
  2833 |                     ]
  2834 |                 if "special_tokens_mask" in encoded_inputs:
  2835 |                     encoded_inputs["special_tokens_mask"] = [1] * difference + encoded_inputs["special_tokens_mask"]
  2836 |                 encoded_inputs[self.model_input_names[0]] = [self.pad_token_id] * difference + required_input
  2837 |             else:
  2838 |                 raise ValueError(f"Invalid padding strategy:{padding_side}")
  2839 | 
  2840 |         return encoded_inputs
