  3399 |                 keys of the state dict of adapters needs to be prepended with `base_model.model`. Advanced users can
  3400 |                 disable this behaviours by setting `save_peft_format` to `False`.
  3401 |             save_original_format (`bool`, *optional*, defaults to `True`):
  3402 |                 For backward compatibility with the previous versions of `transformers` you can save the checkpoint with
  3403 |                 its reverse mapping. The reverse mapping needs to exists even if the model was loaded from a None legacy
  3404 |                 checkpoint.
  3405 |             kwargs (`dict[str, Any]`, *optional*):
  3406 |                 Additional key word arguments passed along to the [`~utils.PushToHubMixin.push_to_hub`] method.
  3407 |         """
  3408 |         if token is not None:
  3409 |             kwargs["token"] = token
  3410 | 
  3411 |         _hf_peft_config_loaded = getattr(self, "_hf_peft_config_loaded", False)
  3412 | 
  3413 |         hf_quantizer = getattr(self, "hf_quantizer", None)
  3414 |         quantization_serializable = (
  3415 |             hf_quantizer is not None and isinstance(hf_quantizer, HfQuantizer) and hf_quantizer.is_serializable()
  3416 |         )
  3417 | 
  3418 |         if hf_quantizer is not None and not _hf_peft_config_loaded and not quantization_serializable:
  3419 |             raise ValueError(
  3420 |                 f"The model is quantized with {hf_quantizer.quantization_config.quant_method} and is not serializable - check out the warnings from"
  3421 |                 " the logger on the traceback to understand the reason why the quantized model is not serializable."
  3422 |             )
