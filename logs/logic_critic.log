  2618 | def parse_docstring(docstring, max_indent_level=0, return_intro=False):
  2619 |     """
  2620 |     Parse the docstring to extract the Args section and return it as a dictionary.
  2621 |     The docstring is expected to be in the format:
  2622 |     Args:
  2623 |         arg1 (type):
  2624 |             Description of arg1.
  2625 |         arg2 (type):
  2626 |             Description of arg2.
  2627 | 
  2628 |     # This function will also return the remaining part of the docstring after the Args section.
  2629 |     Returns:/Example:
  2630 |     ...
  2631 |     """
  2632 |     match = _re_example_or_return.search(docstring)
  2633 |     if match:
  2634 |         remainder_docstring = docstring[match.start() :]
  2635 |         docstring = docstring[: match.start()]
  2636 |     else:
  2637 |         remainder_docstring = ""
  2638 | 
  2639 |     args_match = _re_args_section.search(docstring)
  2640 |     # still try to find args description in the docstring, if args are not preceded by "Args:"
  2641 |     docstring_intro = None
  2642 |     if args_match:
  2643 |         docstring_intro = docstring[: args_match.start()]
  2644 |         if docstring_intro.split("\n")[-1].strip() == '"""':
  2645 |             docstring_intro = "\n".join(docstring_intro.split("\n")[:-1])
  2646 |         if docstring_intro.split("\n")[0].strip() == 'r"""' or docstring_intro.split("\n")[0].strip() == '"""':
  2647 |             docstring_intro = "\n".join(docstring_intro.split("\n")[1:])
  2648 |         if docstring_intro.strip() == "":
  2649 |             docstring_intro = None
  2650 |     args_section = args_match.group(1).lstrip("\n") if args_match else docstring
  2651 |     if args_section.split("\n")[-1].strip() == '"""':
  2652 |         args_section = "\n".join(args_section.split("\n")[:-1])
  2653 |     if args_section.split("\n")[0].strip() == 'r"""' or args_section.split("\n")[0].strip() == '"""':
  2654 |         args_section = "\n".join(args_section.split("\n")[1:])
  2655 |     args_section = set_min_indent(args_section, 0)
  2656 |     params = {}
  2657 |     if args_section:
  2658 |         # Use the pre-compiled pattern (max_indent_level is always 0 at all call
  2659 |         # sites; if a non-zero value is ever needed, compile a fresh pattern).
  2660 |         if max_indent_level == 0:
  2661 |             param_pattern = _re_param
  2662 |         else:
  2663 |             param_pattern = re.compile(
  2664 |                 # |--- Group 1 ---|| Group 2 ||- Group 3 -||---------- Group 4 ----------|
  2665 |                 rf"^\s{{0,{max_indent_level}}}(\w+)\s*\(\s*([^, \)]*)(\s*.*?)\s*\)\s*:\s*((?:(?!\n^\s{{0,{max_indent_level}}}\w+\s*\().)*)",
  2666 |                 re.DOTALL | re.MULTILINE,
  2667 |             )
  2668 |         for match in param_pattern.finditer(args_section):
  2669 |             param_name = match.group(1)
  2670 |             param_type = match.group(2)
  2671 |             additional_info = match.group(3)
  2672 |             optional = "optional" in additional_info
  2673 |             shape = parse_shape(additional_info)
  2674 |             default = parse_default(additional_info)
  2675 |             param_description = match.group(4).strip()
  2676 |             # indent the first line of param_description to 4 spaces:
  2677 |             param_description = " " * 4 + param_description
  2678 |             param_description = f"\n{param_description}"
  2679 |             params[param_name] = {
  2680 |                 "type": param_type,
  2681 |                 "description": param_description,
  2682 |                 "optional": optional,
  2683 |                 "shape": shape,
  2684 |                 "default": default,
  2685 |                 "additional_info": additional_info,
  2686 |             }
  2687 | 
  2688 |     if params and remainder_docstring:
  2689 |         remainder_docstring = "\n" + remainder_docstring
  2690 | 
  2691 |     remainder_docstring = set_min_indent(remainder_docstring, 0)
  2692 | 
  2693 |     if return_intro:
  2694 |         return params, remainder_docstring, docstring_intro
  2695 |     return params, remainder_docstring
