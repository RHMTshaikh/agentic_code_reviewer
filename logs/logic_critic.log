  1351 |     @property
  1352 |     def special_tokens_map(self) -> dict[str, str]:
  1353 |         """
  1354 |         `dict[str, str]`: A flat dictionary mapping named special token attributes to their string values.
  1355 | 
  1356 |         Only includes the standard named special tokens (bos_token, eos_token, etc.), not extra_special_tokens.
  1357 |         This provides a clean, flat structure without mixed types.
  1358 | 
  1359 |         Returns:
  1360 |             A dictionary with keys like 'bos_token', 'eos_token', etc., and string values.
  1361 | 
  1362 |         **V5 Change**: This now returns only named tokens. Use `extra_special_tokens` for the additional tokens.
  1363 |         """
  1364 |         return {
  1365 |             attr: str(self._special_tokens_map[attr])
  1366 |             for attr in self.SPECIAL_TOKENS_ATTRIBUTES
  1367 |             if self._special_tokens_map.get(attr) is not None
  1368 |         }
