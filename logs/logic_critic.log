   371 |             # Case 3: Mixed attention, sliding window not yet full
   372 |             # needed_blocks = 2 * 1 + min(4 - 0, 2) * 1 = 2 + 2 = 4, free_blocks = 10 -> 4 <= 10 = True
   373 |             (2, 0, 1, 1, 4, 10, True),
   374 |             # Case 4: Mixed attention, sliding window partially filled
   375 |             # needed_blocks = 3 * 1 + min(4 - 2, 3) * 1 = 3 + 2 = 5, free_blocks = 5 -> 5 <= 5 = True
   376 |             (3, 2, 1, 1, 4, 5, True),
   377 |             # Case 5: Mixed attention, sliding window already full (allocated_blocks >= max_sliding)
   378 |             # blocks_left = max(4 - 5, 0) = 0, needed_blocks = 3 * 1 + 0 = 3, free_blocks = 5 -> 3 <= 5 = True
   379 |             (3, 5, 1, 1, 4, 5, True),
   380 |             # Case 6: Mixed attention, sliding window full, allocation fails due to full attention
   381 |             # blocks_left = max(4 - 4, 0) = 0, needed_blocks = 6 * 1 + 0 = 6, free_blocks = 5 -> 6 <= 5 = False
   382 |             (6, 4, 1, 1, 4, 5, False),
   383 |             # Case 7: Multiple full attention groups
   384 |             # needed_blocks = 3 * 2 = 6, free_blocks = 6 -> 6 <= 6 = True
   385 |             (3, 0, 2, 0, 0, 6, True),
   386 |             # Case 8: Multiple sliding attention groups, not full
   387 |             # needed_blocks = 2 * 1 + min(4 - 1, 2) * 2 = 2 + 4 = 6, free_blocks = 6 -> 6 <= 6 = True
   388 |             (2, 1, 1, 2, 4, 6, True),
   389 |             # Case 9: Edge case - requesting 0 blocks always succeeds
   390 |             # needed_blocks = 0, free_blocks = 0 -> 0 <= 0 = True
