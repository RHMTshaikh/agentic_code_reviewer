  4668 |     @property
  4669 |     def loss_function(self):
  4670 |         if hasattr(self, "_loss_function"):
  4671 |             return self._loss_function
  4672 | 
  4673 |         loss_type = getattr(self, "loss_type", None)
  4674 | 
  4675 |         if loss_type is None or loss_type not in LOSS_MAPPING:
  4676 |             logger.warning_once(
  4677 |                 f"`loss_type={loss_type}` was set in the config but it is unrecognized. "
  4678 |                 f"Using the default loss: `ForCausalLMLoss`."
  4679 |             )
  4680 |             loss_type = "ForCausalLM"
  4681 |         return LOSS_MAPPING[loss_type]
  4682 | 
  4683 |     @loss_function.setter
  4684 |     def loss_function(self, value):
