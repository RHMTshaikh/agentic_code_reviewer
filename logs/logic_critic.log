   819 |             config=self.config,
   820 |             inputs_embeds=inputs_embeds,
   821 |             attention_mask=encoder_attention_mask,
   822 |             encoder_hidden_states=encoder_hidden_states,
   823 |         )
   824 | 
   825 |         # embed positions
   826 |         positions = self.embed_positions(input_ids, inputs_embeds, past_key_values_length)
   827 |         positions = positions.to(inputs_embeds.device)
   828 | 
