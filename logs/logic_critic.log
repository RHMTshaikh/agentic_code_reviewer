   122 |     def _allocate_blocks_if_needed(self, state: RequestState, len_next_tokens: int) -> bool:
   123 |         """Allocate additional cache blocks for a request if the currently allocated blocks are insufficient to
   124 |         accommodate the next tokens. It calculates how many blocks are needed based on the request's current
   125 |         cache occupancy and the number of tokens to be processed. The allocation itself is done by the CacheAllocator
   126 |         objects. Returns a boolean indicating if the allocation was successful or not.
