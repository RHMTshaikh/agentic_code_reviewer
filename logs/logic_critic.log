   278 |             self.read_index_storage[:, : q_len + kv_len].fill_(self._read_trash_index)
   279 |         # If this is not a full reset, and we are going to use the block table, we only reset it
   280 |         elif self.use_block_table:
   281 |             self.block_table[:, :b_size].fill_(-1)
   282 |         # Otherwise, the read and write indices are the ones used, so we reset them
   283 |         else:
   284 |             self.write_index_storage[:, :q_len].fill_(self._write_trash_index)
