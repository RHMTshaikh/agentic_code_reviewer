   114 | def _resolve_tied_embed_lm_head_plan(
   115 |     fsdp_plan: dict[str, str],
   116 |     model: nn.Module,
   117 | ) -> dict[str, str]:
   118 |     """
   119 |     Rewrite the plan so tied embed/lm_head weights are wrapped once.
   120 |     Example:
   121 |         {"model.embed_tokens": "free_full_weight",
   122 |         "model.layers.*": "free_full_weight",
   123 |         "model.norm": "keep_full_weight",
   124 |         "lm_head": "keep_full_weight"}
   125 |     ->
   126 |         {"model.layers.*": "free_full_weight",
   127 |         "model.norm": "keep_full_weight",
   128 |         "model.embed_tokens": "keep_full_weight"}
   129 |     """
   130 |     tied_keys = getattr(model, "all_tied_weights_keys", None) or {}
   131 |     if not tied_keys:
   132 |         return fsdp_plan
   133 | 
   134 |     input_embed, output_head = _get_input_output_embeddings(model)
   135 |     name_by_module = {module: name for name, module in model.named_modules()}
   136 |     embed_module = name_by_module.get(input_embed)
   137 |     head_module = name_by_module.get(output_head)
   138 | 
   139 |     if embed_module is None or head_module is None:
   140 |         return fsdp_plan
   141 | 
   142 |     adapted_plan = fsdp_plan.copy()
   143 |     adapted_plan.pop(embed_module, None)
   144 | 
   145 |     if fsdp_plan.get(head_module) == "keep_full_weight":
   146 |         adapted_plan.pop(head_module, None)
   147 |         adapted_plan[embed_module] = "keep_full_weight"
   148 | 
   149 |     return adapted_plan
