  3349 |     def save_pretrained(
  3350 |         self,
  3351 |         save_directory: str | os.PathLike,
  3352 |         is_main_process: bool = True,
  3353 |         state_dict: dict | None = None,
  3354 |         push_to_hub: bool = False,
  3355 |         max_shard_size: int | str = "50GB",
  3356 |         variant: str | None = None,
  3357 |         token: str | bool | None = None,
  3358 |         save_peft_format: bool = True,
