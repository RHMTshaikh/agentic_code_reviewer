  3651 |     def get_memory_footprint(self, return_buffers=True):
  3652 |         r"""
  3653 |         Get the memory footprint of a model. This will return the memory footprint of the current model in bytes.
  3654 |         Useful to benchmark the memory footprint of the current model and design some tests. Solution inspired from the
  3655 |         PyTorch discussions: https://discuss.pytorch.org/t/gpu-memory-that-model-uses/56822/2
  3656 | 
  3657 |         Arguments:
  3658 |             return_buffers (`bool`, *optional*, defaults to `True`):
  3659 |                 Whether to return the size of the buffer tensors in the computation of the memory footprint. Buffers
  3660 |                 are tensors that do not require gradients and not registered as parameters. E.g. mean and std in batch
  3661 |                 norm layers. Please see: https://discuss.pytorch.org/t/what-pytorch-means-by-buffers/120266/2
  3662 |         """
  3663 |         mem = sum(param.nelement() * param.element_size() for param in self.parameters())
  3664 |         if return_buffers:
  3665 |             mem_bufs = sum(buf.nelement() * buf.element_size() for buf in self.buffers())
  3666 |             mem = mem + mem_bufs
  3667 |         return mem
  3668 | 
  3669 |     @wraps(torch.nn.Module.cuda)
  3670 |     def cuda(self, *args, **kwargs):
  3671 |         if getattr(self, "quantization_method", None) == QuantizationMethod.HQQ:
  3672 |             from hqq.core.quantize import HQQLinear
  3673 | 
  3674 |             # Since HQQLinear stores some tensors in the 'meta' attribute,
  3675 |             # it's necessary to manually call the `cuda` method on HQQLinear layers.
  3676 |             super().cuda(*args, **kwargs)
  3677 |             for module in self.modules():
  3678 |                 if isinstance(module, HQQLinear):
  3679 |                     if len(args) > 0:
  3680 |                         device = args[0]
  3681 |                     else:
  3682 |                         device = kwargs.get("device", "cuda")
  3683 |                     module.cuda(device)
  3684 |             return self
  3685 | 
  3686 |         # Checks if the model has been loaded in 4-bit or 8-bit with BNB
  3687 |         if getattr(self, "quantization_method", None) == QuantizationMethod.BITS_AND_BYTES:
  3688 |             if getattr(self, "is_loaded_in_8bit", False):
  3689 |                 raise ValueError(
  3690 |                     "Calling `cuda()` is not supported for `8-bit` quantized models. "
  3691 |                     " Please use the model as it is, since the model has already been set to the correct devices."
  3692 |                 )
  3693 |         return super().cuda(*args, **kwargs)
  3694 | 
  3695 |     @wraps(torch.nn.Module.to)
  3696 |     def to(self, *args, **kwargs):
  3697 |         # For BNB/GPTQ models, we prevent users from casting the model to another dtype to restrict unwanted behaviours.
  3698 |         # the correct API should be to load the model with the desired dtype directly through `from_pretrained`.
  3699 |         dtype_present_in_args = "dtype" in kwargs
  3700 | 
  3701 |         if not dtype_present_in_args:
  3702 |             for arg in args:
  3703 |                 if isinstance(arg, torch.dtype):
  3704 |                     dtype_present_in_args = True
  3705 |                     break
  3706 | 
  3707 |         if getattr(self, "quantization_method", None) == QuantizationMethod.HQQ:
  3708 |             from hqq.core.quantize import HQQLinear
  3709 | 
  3710 |             # Since HQQLinear stores some tensors in the 'meta' attribute, we must
  3711 |             # explicitly move the parameters to the target device for each HQQLinear layer after `to`.
  3712 |             super().to(*args, **kwargs)
  3713 |             for module in self.modules():
  3714 |                 if isinstance(module, HQQLinear):
  3715 |                     if "device" in kwargs:
  3716 |                         device = kwargs["device"]
  3717 |                     else:
  3718 |                         device = args[0]
  3719 |                     if "dtype" in kwargs:
  3720 |                         dtype = kwargs["dtype"]
  3721 |                     elif dtype_present_in_args:
  3722 |                         dtype = arg
  3723 |                     else:
  3724 |                         dtype = None
  3725 |                     # Due to the current messy implementation of HQQLinear, updating `compute_dtype`
  3726 |                     # followed by calling the `cuda` method achieves the intended behavior of `to`,
  3727 |                     # even when the target device is CPU.
  3728 |                     if dtype is not None:
  3729 |                         module.compute_dtype = dtype
  3730 |                     module.cuda(device)
  3731 |             return self
  3732 | 
  3733 |         if dtype_present_in_args and getattr(self, "quantization_method", None) == QuantizationMethod.QUARK:
  3734 |             raise ValueError("Casting a Quark quantized model to a new `dtype` is not supported.")
  3735 | 
  3736 |         # Checks if the model has been loaded in 4-bit or 8-bit with BNB
  3737 |         if getattr(self, "quantization_method", None) == QuantizationMethod.BITS_AND_BYTES:
  3738 |             if dtype_present_in_args:
  3739 |                 raise ValueError(
  3740 |                     "You cannot cast a bitsandbytes model in a new `dtype`. Make sure to load the model using `from_pretrained` using the"
  3741 |                     " desired `dtype` by passing the correct `dtype` argument."
  3742 |                 )
  3743 | 
  3744 |             if getattr(self, "is_loaded_in_8bit", False) and not is_bitsandbytes_available("0.48"):
  3745 |                 raise ValueError(
  3746 |                     "You need to install `pip install bitsandbytes>=0.48.0` if you want to move a 8-bit model across devices using to()."
  3747 |                 )
  3748 |         elif getattr(self, "quantization_method", None) == QuantizationMethod.GPTQ:
  3749 |             if dtype_present_in_args:
  3750 |                 raise ValueError(
  3751 |                     "You cannot cast a GPTQ model in a new `dtype`. Make sure to load the model using `from_pretrained` using the desired"
  3752 |                     " `dtype` by passing the correct `dtype` argument."
  3753 |                 )
  3754 |         return super().to(*args, **kwargs)
  3755 | 
  3756 |     def half(self, *args):
  3757 |         # Checks if the model is quantized
  3758 |         if getattr(self, "is_quantized", False):
  3759 |             raise ValueError(
  3760 |                 "`.half()` is not supported for quantized model. Please use the model as it is, since the"
  3761 |                 " model has already been casted to the correct `dtype`."
  3762 |             )
  3763 |         else:
  3764 |             return super().half(*args)
