  3019 |             import deepspeed
  3020 | 
  3021 |             params = [old_embeddings.weight, new_embeddings.weight]
  3022 |             with deepspeed.zero.GatheredParameters(params, modifier_rank=0):
  3023 |                 old_embeddings.weight = new_embeddings.weight
  3024 |                 old_embeddings.num_embeddings = new_embeddings.weight.data.shape[0]
  3025 | 
  3026 |                 # If the new number of tokens is smaller than the original `padding_idx`, the `padding_idx`
  3027 |                 # will be set to `None` in the resized embeddings.
  3028 |                 if old_embeddings.padding_idx is not None and (new_num_tokens - 1) < old_embeddings.padding_idx:
  3029 |                     old_embeddings.padding_idx = None
  3030 |         else:
  3031 |             old_embeddings.weight.data = new_embeddings.weight.data
  3032 |             old_embeddings.num_embeddings = new_embeddings.weight.data.shape[0]
  3033 |             if old_embeddings.padding_idx is not None and (new_num_tokens - 1) < old_embeddings.padding_idx:
  3034 |                 old_embeddings.padding_idx = None
  3035 | 
  3036 |         return old_embeddings
