  2871 | def get_checkpoint_from_config_class(config_class):
  2872 |     checkpoint = None
  2873 | 
  2874 |     # source code of `config_class`
  2875 |     # config_source = inspect.getsource(config_class)
  2876 |     config_source = config_class.__doc__
  2877 |     if not config_source:
  2878 |         return None
  2879 | 
  2880 |     checkpoints = _re_checkpoint.findall(config_source)
  2881 |     # Each `checkpoint` is a tuple of a checkpoint name and a checkpoint link.
  2882 |     # For example, `('google-bert/bert-base-uncased', 'https://huggingface.co/google-bert/bert-base-uncased')`
  2883 |     for ckpt_name, ckpt_link in checkpoints:
  2884 |         # allow the link to end with `/`
  2885 |         ckpt_link = ckpt_link.removesuffix("/")
  2886 | 
  2887 |         # verify the checkpoint name corresponds to the checkpoint link
  2888 |         ckpt_link_from_name = f"https://huggingface.co/{ckpt_name}"
  2889 |         if ckpt_link == ckpt_link_from_name:
  2890 |             checkpoint = ckpt_name
  2891 |             break
  2892 | 
  2893 |     return checkpoint
