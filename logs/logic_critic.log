  2323 |     def set_save(
  2324 |         self,
  2325 |         strategy: str | IntervalStrategy = "steps",
  2326 |         steps: int = 500,
  2327 |         total_limit: int | None = None,
  2328 |         on_each_node: bool = False,
  2329 |     ):
  2330 |         """
  2331 |         A method that regroups all arguments linked to checkpoint saving.
  2332 | 
  2333 |         Args:
  2334 |             strategy (`str` or [`~trainer_utils.IntervalStrategy`], *optional*, defaults to `"steps"`):
  2335 |                 The checkpoint save strategy to adopt during training. Possible values are:
  2336 | 
  2337 |                     - `"no"`: No save is done during training.
  2338 |                     - `"epoch"`: Save is done at the end of each epoch.
  2339 |                     - `"steps"`: Save is done every `save_steps`.
  2340 | 
  2341 |             steps (`int`, *optional*, defaults to 500):
  2342 |                 Number of updates steps before two checkpoint saves if `strategy="steps"`.
  2343 |             total_limit (`int`, *optional*):
  2344 |                 If a value is passed, will limit the total amount of checkpoints. Deletes the older checkpoints in
  2345 |                 `output_dir`.
  2346 |             on_each_node (`bool`, *optional*, defaults to `False`):
  2347 |                 When doing multi-node distributed training, whether to save models and checkpoints on each node, or
  2348 |                 only on the main one.
  2349 | 
  2350 |                 This should not be activated when the different nodes use the same storage as the files will be saved
  2351 |                 with the same names for each node.
  2352 | 
  2353 |         Example:
  2354 | 
  2355 |         ```py
  2356 |         >>> from transformers import TrainingArguments
  2357 | 
  2358 |         >>> args = TrainingArguments("working_dir")
  2359 |         >>> args = args.set_save(strategy="steps", steps=100)
  2360 |         >>> args.save_steps
  2361 |         100
  2362 |         ```
  2363 |         """
  2364 |         self.save_strategy = SaveStrategy(strategy)
  2365 |         if self.save_strategy == SaveStrategy.STEPS and steps == 0:
  2366 |             raise ValueError("Setting `strategy` as 'steps' requires a positive value for `steps`.")
  2367 |         self.save_steps = steps
  2368 |         self.save_total_limit = total_limit
  2369 |         self.save_on_each_node = on_each_node
  2370 |         return self
  2371 | 
  2372 |     def set_logging(
  2373 |         self,
  2374 |         strategy: str | IntervalStrategy = "steps",
  2375 |         steps: int = 500,
  2376 |         report_to: str | list[str] = "none",
  2377 |         level: str = "passive",
  2378 |         first_step: bool = False,
  2379 |         nan_inf_filter: bool = False,
  2380 |         on_each_node: bool = False,
  2381 |         replica_level: str = "passive",
  2382 |     ):
  2383 |         """
  2384 |         A method that regroups all arguments linked to logging.
  2385 | 
  2386 |         Args:
  2387 |             strategy (`str` or [`~trainer_utils.IntervalStrategy`], *optional*, defaults to `"steps"`):
  2388 |                 The logging strategy to adopt during training. Possible values are:
  2389 | 
  2390 |                     - `"no"`: No logging is done during training.
  2391 |                     - `"epoch"`: Logging is done at the end of each epoch.
  2392 |                     - `"steps"`: Logging is done every `logging_steps`.
  2393 | 
  2394 |             steps (`int`, *optional*, defaults to 500):
  2395 |                 Number of update steps between two logs if `strategy="steps"`.
  2396 |             level (`str`, *optional*, defaults to `"passive"`):
  2397 |                 Logger log level to use on the main process. Possible choices are the log levels as strings: `"debug"`,
  2398 |                 `"info"`, `"warning"`, `"error"` and `"critical"`, plus a `"passive"` level which doesn't set anything
  2399 |                 and lets the application set the level.
  2400 |             report_to (`str` or `list[str]`, *optional*, defaults to `"none"`):
  2401 |                 The list of integrations to report the results and logs to. Supported platforms are `"azure_ml"`,
  2402 |                 `"clearml"`, `"codecarbon"`, `"comet_ml"`, `"dagshub"`, `"dvclive"`, `"flyte"`, `"mlflow"`,
  2403 |                 `"swanlab"`, `"tensorboard"`, `"trackio"` and `"wandb"`. Use `"all"` to report to all integrations
  2404 |                 installed, `"none"` for no integrations.
  2405 |             first_step (`bool`, *optional*, defaults to `False`):
  2406 |                 Whether to log and evaluate the first `global_step` or not.
  2407 |             nan_inf_filter (`bool`, *optional*, defaults to `True`):
  2408 |                 Whether to filter `nan` and `inf` losses for logging. If set to `True` the loss of every step that is
  2409 |                 `nan` or `inf` is filtered and the average loss of the current logging window is taken instead.
  2410 | 
  2411 |                 <Tip>
  2412 | 
  2413 |                 `nan_inf_filter` only influences the logging of loss values, it does not change the behavior the
  2414 |                 gradient is computed or applied to the model.
  2415 | 
  2416 |                 </Tip>
  2417 | 
  2418 |             on_each_node (`bool`, *optional*, defaults to `True`):
  2419 |                 In multinode distributed training, whether to log using `log_level` once per node, or only on the main
  2420 |                 node.
  2421 |             replica_level (`str`, *optional*, defaults to `"passive"`):
  2422 |                 Logger log level to use on replicas. Same choices as `log_level`
  2423 | 
  2424 |         Example:
  2425 | 
  2426 |         ```py
  2427 |         >>> from transformers import TrainingArguments
  2428 | 
  2429 |         >>> args = TrainingArguments("working_dir")
  2430 |         >>> args = args.set_logging(strategy="steps", steps=100)
  2431 |         >>> args.logging_steps
  2432 |         100
  2433 |         ```
  2434 |         """
  2435 |         self.logging_strategy = IntervalStrategy(strategy)
  2436 |         if self.logging_strategy == IntervalStrategy.STEPS and steps == 0:
  2437 |             raise ValueError("Setting `strategy` as 'steps' requires a positive value for `steps`.")
  2438 |         self.logging_steps = steps
  2439 |         self.report_to = report_to
  2440 |         self.log_level = level
  2441 |         self.logging_first_step = first_step
  2442 |         self.logging_nan_inf_filter = nan_inf_filter
  2443 |         self.log_on_each_node = on_each_node
  2444 |         self.log_level_replica = replica_level
  2445 |         return self
