  3684 |                                     indent_level + 8,
  3685 |                                 )
  3686 | 
  3687 |                         # Skip processing the _kwargs parameter itself since we've processed its contents
  3688 |                         continue
  3689 |                     else:
  3690 |                         # If we can't get annotations, skip this parameter
  3691 |                         continue
  3692 | 
  3693 |                 if documented_kwargs and param_name not in documented_kwargs:
  3694 |                     continue
  3695 |                 param_type, optional = process_type_annotation(param_type_annotation, param_name)
  3696 | 
  3697 |                 # Check for default value
  3698 |                 param_default = ""
  3699 |                 if parent_class is not None:
  3700 |                     param_default = str(getattr(parent_class, param_name, ""))
  3701 |                     param_default = f", defaults to `{param_default}`" if param_default != "" else ""
  3702 | 
  3703 |                 param_type, optional_string, shape_string, additional_info, description, is_documented = (
  3704 |                     _get_parameter_info(param_name, documented_kwargs, source_args_dict, param_type, optional)
  3705 |                 )
  3706 | 
  3707 |                 if is_documented:
  3708 |                     # Check if type is missing
  3709 |                     if param_type == "":
  3710 |                         print(
  3711 |                             f"[ERROR] {param_name} for {kwarg_param.annotation.__args__[0].__qualname__} in file {func.__code__.co_filename} has no type"
  3712 |                         )
  3713 |                     param_type = param_type if "`" in param_type else f"`{param_type}`"
  3714 |                     # Format the parameter docstring (KWARGS_INDICATOR distinguishes from regular args)
  3715 |                     if additional_info:
  3716 |                         docstring += set_min_indent(
  3717 |                             f"{param_name} ({param_type}{KWARGS_INDICATOR}{additional_info}):{description}",
  3718 |                             indent_level + 8,
  3719 |                         )
  3720 |                     else:
  3721 |                         docstring += set_min_indent(
  3722 |                             f"{param_name} ({param_type}{KWARGS_INDICATOR}{shape_string}{optional_string}{param_default}):{description}",
  3723 |                             indent_level + 8,
  3724 |                         )
  3725 |                 else:
  3726 |                     undocumented_parameters.append(
  3727 |                         f"[ERROR] `{param_name}` is part of {kwarg_param.annotation.__args__[0].__qualname__}, but not documented. Make sure to add it to the docstring of the function in {func.__code__.co_filename}."
  3728 |                     )
  3729 | 
  3730 |         # Build **kwargs summary line (added after return_tensors in _process_parameters_section)
  3731 |         kwargs_annot_cls = kwarg_param.annotation.__args__[0]
  3732 |         kwargs_type_name = _get_base_kwargs_class(kwargs_annot_cls).__name__
  3733 |         kwargs_info = source_args_dict.get("__kwargs__", {})
  3734 |         kwargs_description = kwargs_info.get(
  3735 |             "description",
  3736 |             "Additional keyword arguments. Model-specific parameters are listed above.",
  3737 |         )
  3738 |         kwargs_summary = set_min_indent(
  3739 |             f"**kwargs ([`{kwargs_type_name}`], *optional*):{kwargs_description}",
  3740 |             indent_level + 8,
  3741 |         )
  3742 | 
  3743 |     return docstring, kwargs_summary
