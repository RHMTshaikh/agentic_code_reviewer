    50 |             quote = await self.pricing_engine.get_validated_quote(order.symbol)
    51 | 
    52 |             # 2. Calculate optimal fill price
    53 |             fill_price: Decimal | None = None
    54 |             if order.type == "MARKET":
    55 |                 fill_price = quote.ask if order.side == "BUY" else quote.bid
    56 |             elif order.type == "LIMIT":
    57 |                 if order.side == "BUY" and quote.ask <= order.limit_price:
    58 |                     fill_price = quote.ask
    59 |                 elif order.side == "SELL" and quote.bid >= order.limit_price:
    60 |                     fill_price = quote.bid
    61 | 
    62 |             if not fill_price:
    63 |                 return None
    64 | 
    65 |             # 3. Process Execution Quantities
    66 |             remaining_qty = order.requested_quantity - order.filled_quantity
    67 |             executed_qty = remaining_qty 
    68 |             broker_ref = f"EXEC-{uuid.uuid4().hex[:8].upper()}"
    69 | 
    70 |             execution = TradeExecution(
    71 |                 order_id=order.id,
    72 |                 execution_price=fill_price,
    73 |                 quantity=executed_qty,
    74 |                 broker_reference_id=broker_ref
    75 |             )
    76 |             self.session.add(execution)
    77 | 
