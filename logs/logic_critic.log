  2268 |             # e.g. ForCausalLM has a Model inside, but no need to check it again)
  2269 |             if (
  2270 |                 submodule is not self
  2271 |                 and isinstance(submodule, PreTrainedModel)
  2272 |                 and submodule.config.__class__ != self.config.__class__
  2273 |             ):
