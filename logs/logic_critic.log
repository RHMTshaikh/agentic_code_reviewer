  2483 | 
  2484 |         accepts_attention_mask = "attention_mask" in set(inspect.signature(self.forward).parameters.keys())
  2485 |         kwargs_has_attention_mask = model_kwargs.get("attention_mask", None) is not None
  2486 | 
  2487 |         # 3. Define model inputs
  2488 |         inputs_tensor, model_input_name, model_kwargs = self._prepare_model_inputs(
  2489 |             inputs, generation_config.bos_token_id, model_kwargs
  2490 |         )
  2491 |         # Some generation modes (e.g. assisted) need `inputs_tensor` to rerun encoder.forward()
  2492 |         if "inputs_tensor" in inspect.signature(decoding_method).parameters.keys():
