   275 | 
   276 |         self.conv_stem = MobileNetV2Stem(
   277 |             config,
   278 |             in_channels=config.num_channels,
   279 |             expanded_channels=apply_depth_multiplier(config, 32),
   280 |             out_channels=channels[0],
   281 |         )
   282 | 
   283 |         current_stride = 2  # first conv layer has stride 2
   284 |         dilation = 1
   285 | 
   286 |         self.layer = nn.ModuleList()
   287 |         for i in range(16):
   288 |             # Keep making the feature maps smaller or use dilated convolution?
   289 |             if current_stride == config.output_stride:
   290 |                 layer_stride = 1
   291 |                 layer_dilation = dilation
   292 |                 dilation *= strides[i]  # larger dilation starts in next block
   293 |             else:
   294 |                 layer_stride = strides[i]
   295 |                 layer_dilation = 1
   296 |                 current_stride *= layer_stride
   297 | 
   298 |             self.layer.append(
   299 |                 MobileNetV2InvertedResidual(
   300 |                     config,
   301 |                     in_channels=channels[i],
   302 |                     out_channels=channels[i + 1],
   303 |                     stride=layer_stride,
   304 |                     dilation=layer_dilation,
   305 |                 )
   306 |             )
   307 | 
   308 |         if config.finegrained_output and config.depth_multiplier < 1.0:
