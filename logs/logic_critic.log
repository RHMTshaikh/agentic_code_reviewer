   668 |     def test_continuous_batching_config_disables_nccl_graph_mixing(self) -> None:
   669 |         """Test that ContinuousBatchingConfig sets NCCL_GRAPH_MIXING_SUPPORT=0 only under a distributed launch
   670 |         (WORLD_SIZE > 1) and respects the disable_nccl_graph_mixing flag."""
   671 |         original_nccl = os.environ.pop("NCCL_GRAPH_MIXING_SUPPORT", None)
   672 |         original_ws = os.environ.pop("WORLD_SIZE", None)
   673 |         try:
   674 |             # Single-GPU launch (no WORLD_SIZE): env var is left untouched
   675 |             ContinuousBatchingConfig()
   676 |             self.assertNotIn("NCCL_GRAPH_MIXING_SUPPORT", os.environ)
   677 | 
   678 |             # Distributed launch (WORLD_SIZE > 1): env var is set to "0"
   679 |             os.environ["WORLD_SIZE"] = "2"
   680 |             ContinuousBatchingConfig()
   681 |             self.assertEqual(os.environ.get("NCCL_GRAPH_MIXING_SUPPORT"), "0")
   682 | 
   683 |             # Explicitly disabled flag: env var is left untouched even under a distributed launch
   684 |             os.environ.pop("NCCL_GRAPH_MIXING_SUPPORT", None)
   685 |             ContinuousBatchingConfig(disable_nccl_graph_mixing=False)
   686 |             self.assertNotIn("NCCL_GRAPH_MIXING_SUPPORT", os.environ)
   687 | 
   688 |             # setdefault semantics: a pre-existing value is preserved
   689 |             os.environ["NCCL_GRAPH_MIXING_SUPPORT"] = "1"
   690 |             ContinuousBatchingConfig()
   691 |             self.assertEqual(os.environ.get("NCCL_GRAPH_MIXING_SUPPORT"), "1")
   692 |         finally:
   693 |             if original_nccl is None:
   694 |                 os.environ.pop("NCCL_GRAPH_MIXING_SUPPORT", None)
   695 |             else:
   696 |                 os.environ["NCCL_GRAPH_MIXING_SUPPORT"] = original_nccl
   697 |             if original_ws is None:
   698 |                 os.environ.pop("WORLD_SIZE", None)
   699 |             else:
   700 |                 os.environ["WORLD_SIZE"] = original_ws
