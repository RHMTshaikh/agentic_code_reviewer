  4004 | def _process_example_section(
  4005 |     func_documentation, func, parent_class, class_name, model_name_lowercase, config_class, checkpoint, indent_level
  4006 | ):
  4007 |     """
  4008 |     Process the example section of the docstring.
  4009 | 
  4010 |     Args:
  4011 |         func_documentation (`str`): Existing function documentation (manually specified in the docstring)
  4012 |         func (`function`): Function being processed
  4013 |         parent_class (`class`): Parent class of the function
  4014 |         class_name (`str`): Name of the class
  4015 |         model_name_lowercase (`str`): Lowercase model name
  4016 |         config_class (`str`): Config class for the model
  4017 |         checkpoint: Checkpoint to use in examples
  4018 |         indent_level (`int`): Indentation level
  4019 |     """
  4020 |     # Import here to avoid circular import
  4021 |     from transformers.models import auto as auto_module
  4022 | 
  4023 |     example_docstring = ""
  4024 | 
  4025 |     # Use existing example section if available (with or without an "Example:" header)
  4026 |     if func_documentation is not None and (match := _re_example.search(func_documentation)):
  4027 |         example_docstring = func_documentation[match.start() :]
  4028 |         example_docstring = "\n" + set_min_indent(example_docstring, indent_level + 4)
  4029 |     # Skip examples for processors
  4030 |     elif _is_processor_class(func, parent_class):
  4031 |         # Processors don't get auto-generated examples
  4032 |         return example_docstring
  4033 |     # No examples for __init__ methods or if the class is not a model
  4034 |     elif parent_class is None and model_name_lowercase is not None:
  4035 |         global _re_model_task
  4036 |         if _re_model_task is None:
  4037 |             _re_model_task = re.compile(rf"({'|'.join(PT_SAMPLE_DOCSTRINGS.keys())})")
  4038 |         model_task = _re_model_task.search(class_name)
  4039 |         CONFIG_MAPPING = auto_module.configuration_auto.CONFIG_MAPPING
  4040 | 
  4041 |         # Get checkpoint example
  4042 |         if (checkpoint_example := checkpoint) is None:
  4043 |             try:
  4044 |                 checkpoint_example = get_checkpoint_from_config_class(CONFIG_MAPPING[model_name_lowercase])
  4045 |             except KeyError:
  4046 |                 # For models with inconsistent lowercase model name
  4047 |                 if model_name_lowercase in HARDCODED_CONFIG_FOR_MODELS:
  4048 |                     CONFIG_MAPPING_NAMES = auto_module.configuration_auto.CONFIG_MAPPING_NAMES
  4049 |                     config_class_name = HARDCODED_CONFIG_FOR_MODELS[model_name_lowercase]
  4050 |                     if config_class_name in CONFIG_MAPPING_NAMES.values():
  4051 |                         model_name_for_auto_config = [
  4052 |                             k for k, v in CONFIG_MAPPING_NAMES.items() if v == config_class_name
  4053 |                         ][0]
  4054 |                         if model_name_for_auto_config in CONFIG_MAPPING:
  4055 |                             checkpoint_example = get_checkpoint_from_config_class(
  4056 |                                 CONFIG_MAPPING[model_name_for_auto_config]
  4057 |                             )
  4058 | 
  4059 |         # Add example based on model task
  4060 |         if model_task is not None:
  4061 |             if checkpoint_example is not None:
  4062 |                 example_annotation = ""
  4063 |                 task = model_task.group()
  4064 |                 example_annotation = PT_SAMPLE_DOCSTRINGS[task].format(
  4065 |                     model_class=class_name,
  4066 |                     checkpoint=checkpoint_example,
  4067 |                     expected_output="...",
  4068 |                     expected_loss="...",
  4069 |                     qa_target_start_index=14,
  4070 |                     qa_target_end_index=15,
  4071 |                     mask="<mask>",
  4072 |                 )
  4073 |                 example_docstring = set_min_indent(example_annotation, indent_level + 4)
  4074 |             else:
  4075 |                 print(
  4076 |                     f"[ERROR] No checkpoint found for {class_name}.{func.__name__}. Please add a `checkpoint` arg to `auto_docstring` or add one in {config_class}'s docstring"
  4077 |                 )
  4078 |         else:
  4079 |             # Check if the model is in a pipeline to get an example
  4080 |             for name_model_list_for_task in MODELS_TO_PIPELINE:
  4081 |                 try:
  4082 |                     model_list_for_task = getattr(auto_module.modeling_auto, name_model_list_for_task)
  4083 |                 except (ImportError, AttributeError):
  4084 |                     continue
  4085 |                 if class_name in model_list_for_task.values():
  4086 |                     pipeline_name = MODELS_TO_PIPELINE[name_model_list_for_task]
  4087 |                     example_annotation = PIPELINE_TASKS_TO_SAMPLE_DOCSTRINGS[pipeline_name].format(
  4088 |                         model_class=class_name,
  4089 |                         checkpoint=checkpoint_example,
  4090 |                         expected_output="...",
  4091 |                         expected_loss="...",
  4092 |                         qa_target_start_index=14,
  4093 |                         qa_target_end_index=15,
  4094 |                     )
  4095 |                     example_docstring = set_min_indent(example_annotation, indent_level + 4)
  4096 |                     break
  4097 | 
  4098 |     return example_docstring
  4099 | 
