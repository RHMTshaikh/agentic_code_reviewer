  2698 | def contains_type(type_hint, target_type) -> tuple[bool, object | None]:
  2699 |     """
  2700 |     Check if a "nested" type hint contains a specific target type,
  2701 |     return the first-level type containing the target_type if found.
  2702 |     """
  2703 |     args = get_args(type_hint)
  2704 |     if args == ():
  2705 |         try:
  2706 |             return issubclass(type_hint, target_type), type_hint
  2707 |         except Exception:
  2708 |             return issubclass(type(type_hint), target_type), type_hint
  2709 |     found_type_tuple = [contains_type(arg, target_type)[0] for arg in args]
  2710 |     found_type = any(found_type_tuple)
  2711 |     if found_type:
  2712 |         type_hint = args[found_type_tuple.index(True)]
  2713 |     return found_type, type_hint
