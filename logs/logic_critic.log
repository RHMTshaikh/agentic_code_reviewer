  3776 |     @classmethod
  3777 |     def get_init_context(
  3778 |         cls, dtype: torch.dtype, is_quantized: bool, _is_ds_init_called: bool, allow_all_kernels: bool | None
  3779 |     ):
  3780 |         # Need to instantiate with correct dtype
  3781 |         init_contexts = [local_torch_dtype(dtype, cls.__name__), init.no_tie_weights(), apply_patches()]
  3782 |         # Needed as we cannot forward the `allow_all_kernels` arg in the model's __init__
  3783 |         if allow_all_kernels:
  3784 |             init_contexts.append(allow_all_hub_kernels())
  3785 |         if is_deepspeed_zero3_enabled():
  3786 |             import deepspeed
  3787 | 
  3788 |             # We cannot initialize the model on meta device with deepspeed when not quantized
  3789 |             if not is_quantized and not _is_ds_init_called:
  3790 |                 logger.info("Detected DeepSpeed ZeRO-3: activating zero.init() for this model")
  3791 |                 init_contexts.extend(
  3792 |                     [
  3793 |                         init.no_init_weights(),
  3794 |                         deepspeed.zero.Init(config_dict_or_path=deepspeed_config()),
  3795 |                         set_zero3_state(),
  3796 |                     ]
  3797 |                 )
  3798 |             elif is_quantized:
  3799 |                 init_contexts.extend([torch.device("meta"), set_quantized_state()])
  3800 |         else:
  3801 |             # meta_device_safe_creation_ops patches torch.linspace to default to CPU
  3802 |             # so that custom models calling .item() during __init__ (e.g. drop-path
  3803 |             # schedules) don't crash on meta tensors.
  3804 |             init_contexts.extend([torch.device("meta"), init.meta_device_safe_creation_ops()])
  3805 | 
  3806 |         return init_contexts
  3807 | 
  3808 |     def _get_dtype_plan(self, dtype: torch.dtype) -> dict:
  3809 |         """Create the dtype_plan describing modules/parameters that should use the `keep_in_fp32` flag."""
  3810 |         dtype_plan = {}
  3811 | 
  3812 |         # The _keep_in_fp32_modules flag is only used to avoid bf16 -> fp16 casting precision issues. It was introduced
  3813 |         # in case of force loading a model that should stay in bf16 in fp16
  3814 |         # See https://github.com/huggingface/transformers/issues/20287 for details.
  3815 |         if self._keep_in_fp32_modules is not None and dtype == torch.float16:
  3816 |             dtype_plan.update(dict.fromkeys(self._keep_in_fp32_modules, torch.float32))
  3817 | 
  3818 |         # The _keep_in_fp32_modules_strict was introduced to always force upcast to fp32, for both fp16 and bf16
  3819 |         if self._keep_in_fp32_modules_strict is not None and dtype in (torch.float16, torch.bfloat16):
  3820 |             dtype_plan.update(dict.fromkeys(self._keep_in_fp32_modules_strict, torch.float32))
  3821 | 
  3822 |         return dtype_plan
  3823 | 
  3824 |     def set_use_kernels(self, use_kernels, kernel_config: KernelConfig | None = None, mode: "Mode | None" = None):
  3825 |         """
  3826 |         Set whether or not to use the `kernels` library to kernelize some layers of the model.
  3827 |         Args:
  3828 |             use_kernels (`bool`):
  3829 |                 Whether or not to use the `kernels` library to kernelize some layers of the model.
  3830 |             kernel_config (`KernelConfig`, *optional*):
  3831 |                 The kernel configuration to use to kernelize the model. If `None`, the default kernel mapping will be used.
  3832 |             mode (`Mode`, *optional*):
  3833 |                 The mode that should be applied during `kernelize`. Optional, defaults to either training or inference mode
  3834 |                 based on the internal `training` flag.
  3835 |         """
  3836 |         if use_kernels:
  3837 |             if not is_kernels_available():
  3838 |                 raise ValueError(
  3839 |                     "Kernels are not available. "
  3840 |                     f"Please install a compatible version ({KERNELS_MIN_VERSION} <= version < {KERNELS_MAX_VERSION}), "
  3841 |                     f"e.g. `pip install kernels=={KERNELS_MIN_VERSION}`"
  3842 |                 )
  3843 |             from .integrations.hub_kernels import register_kernel_mapping_transformers
  3844 | 
  3845 |             register_kernel_mapping_transformers()
  3846 | 
  3847 |             if kernel_config is not None:
  3848 |                 if not isinstance(kernel_config, KernelConfig):
  3849 |                     raise ValueError(
  3850 |                         f"Expeced `kernel_config` to be of type `KernelConfig` but got {type(kernel_config)}"
  3851 |                     )
  3852 | 
  3853 |                 # Since kernel_config is a correct value, set it as an attribute of the model so it can be used.
  3854 |                 self.kernel_config = kernel_config
  3855 | 
  3856 |                 # This will make sure the mapping is valid, and the layers are registered in the model
  3857 |                 kernel_config.sanitize_kernel_mapping(self)
  3858 | 
  3859 |                 # This will create a compatible mapping for the model with the kernels library
  3860 |                 kernel_config.create_compatible_mapping(self)
  3861 | 
  3862 |             kernelize(self, mode=mode)
  3863 |         else:
  3864 |             self._use_kernels = False
  3865 | 
  3866 |     @classmethod
  3867 |     def from_pretrained(
  3868 |         cls: type[SpecificPreTrainedModelType],
  3869 |         pretrained_model_name_or_path: str | os.PathLike | None,
  3870 |         *model_args,
  3871 |         config: PreTrainedConfig | str | os.PathLike | None = None,
  3872 |         cache_dir: str | os.PathLike | None = None,
  3873 |         ignore_mismatched_sizes: bool = False,
  3874 |         force_download: bool = False,
  3875 |         local_files_only: bool = False,
  3876 |         token: str | bool | None = None,
  3877 |         revision: str = "main",
  3878 |         use_safetensors: bool | None = None,
  3879 |         weights_only: bool = True,
  3880 |         fusion_config: dict[str, bool | dict[str, Any]] | None = None,
  3881 |         disable_mmap: bool | None = None,
  3882 |         **kwargs,
  3883 |     ) -> SpecificPreTrainedModelType:
  3884 |         r"""
  3885 |         Instantiate a pretrained pytorch model from a pre-trained model configuration.
  3886 | 
  3887 |         The model is set in evaluation mode by default using `model.eval()` (Dropout modules are deactivated). To train
  3888 |         the model, you should first set it back in training mode with `model.train()`.
  3889 | 
  3890 |         The warning *Weights from XXX not initialized from pretrained model* means that the weights of XXX do not come
  3891 |         pretrained with the rest of the model. It is up to you to train those weights with a downstream fine-tuning
  3892 |         task.
  3893 | 
  3894 |         The warning *Weights from XXX not used in YYY* means that the layer XXX is not used by YYY, therefore those
  3895 |         weights are discarded.
  3896 | 
  3897 |         Parameters:
  3898 |             pretrained_model_name_or_path (`str` or `os.PathLike`, *optional*):
  3899 |                 Can be either:
  3900 | 
  3901 |                     - A string, the *model id* of a pretrained model hosted inside a model repo on huggingface.co.
  3902 |                     - A path to a *directory* containing model weights saved using
  3903 |                       [`~PreTrainedModel.save_pretrained`], e.g., `./my_model_directory/`.
  3904 |                     - `None` if you are both providing the configuration and state dictionary (resp. with keyword
  3905 |                       arguments `config` and `state_dict`).
  3906 |             model_args (sequence of positional arguments, *optional*):
  3907 |                 All remaining positional arguments will be passed to the underlying model's `__init__` method.
  3908 |             config (`Union[PreTrainedConfig, str, os.PathLike]`, *optional*):
  3909 |                 Can be either:
  3910 | 
  3911 |                     - an instance of a class derived from [`PreTrainedConfig`],
  3912 |                     - a string or path valid as input to [`~PreTrainedConfig.from_pretrained`].
  3913 | 
  3914 |                 Configuration for the model to use instead of an automatically loaded configuration. Configuration can
  3915 |                 be automatically loaded when:
  3916 | 
  3917 |                     - The model is a model provided by the library (loaded with the *model id* string of a pretrained
  3918 |                       model).
  3919 |                     - The model was saved using [`~PreTrainedModel.save_pretrained`] and is reloaded by supplying the
  3920 |                       save directory.
  3921 |                     - The model is loaded by supplying a local directory as `pretrained_model_name_or_path` and a
  3922 |                       configuration JSON file named *config.json* is found in the directory.
  3923 |             state_dict (`dict[str, torch.Tensor]`, *optional*):
  3924 |                 A state dictionary to use instead of a state dictionary loaded from saved weights file.
  3925 | 
  3926 |                 This option can be used if you want to create a model from a pretrained configuration but load your own
  3927 |                 weights. In this case though, you should check if using [`~PreTrainedModel.save_pretrained`] and
  3928 |                 [`~PreTrainedModel.from_pretrained`] is not a simpler option.
  3929 |             cache_dir (`Union[str, os.PathLike]`, *optional*):
  3930 |                 Path to a directory in which a downloaded pretrained model configuration should be cached if the
  3931 |                 standard cache should not be used.
  3932 |             ignore_mismatched_sizes (`bool`, *optional*, defaults to `False`):
  3933 |                 Whether or not to raise an error if some of the weights from the checkpoint do not have the same size
  3934 |                 as the weights of the model (if for instance, you are instantiating a model with 10 labels from a
  3935 |                 checkpoint with 3 labels).
  3936 |             force_download (`bool`, *optional*, defaults to `False`):
  3937 |                 Whether or not to force the (re-)download of the model weights and configuration files, overriding the
  3938 |                 cached versions if they exist.
  3939 |             proxies (`dict[str, str]`, *optional*):
  3940 |                 A dictionary of proxy servers to use by protocol or endpoint, e.g., `{'http': 'foo.bar:3128',
  3941 |                 'http://hostname': 'foo.bar:4012'}`. The proxies are used on each request.
  3942 |             output_loading_info(`bool`, *optional*, defaults to `False`):
  3943 |                 Whether or not to also return a dictionary containing missing keys, unexpected keys and error messages.
  3944 |             local_files_only(`bool`, *optional*, defaults to `False`):
  3945 |                 Whether or not to only look at local files (i.e., do not try to download the model).
  3946 |             token (`str` or `bool`, *optional*):
