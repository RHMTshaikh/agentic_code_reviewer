   871 |     @classmethod
   872 |     def from_json_file(
   873 |         cls: type[SpecificPreTrainedConfigType], json_file: str | os.PathLike
   874 |     ) -> SpecificPreTrainedConfigType:
   875 |         """
   876 |         Instantiates a [`PreTrainedConfig`] from the path to a JSON file of parameters.
   877 | 
   878 |         Args:
   879 |             json_file (`str` or `os.PathLike`):
   880 |                 Path to the JSON file containing the parameters.
