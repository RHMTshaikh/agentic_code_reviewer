   305 |     def blocks_needed(self, num_requested_blocks: int, allocated_blocks: int) -> int:
   306 |         """Returns the number of physical blocks needed to allocate (num_requested_blocks) blocks to a request that
   307 |         already has (allocated_blocks) blocks. The number of newly allocated blocks needed is predicted by the
   308 |         following rules:
   309 |         - for full attention groups: since there is no sliding window for full attention layers, one requested block is
   310 |             always equivalent to one newly allocated block for EACH full attention group
   311 |         - for sliding window groups: because of the sliding window, the number of blocks allocated to a request is
   312 |             capped. Using the number of already (allocated_blocks) we can compute the number of new blocks to actually
   313 |             allocate to the request, which can be lower than the number of requested blocks. That number is the same for
   314 |             all sliding window groups, as only one sliding window size is supported.
   315 |         """
   316 |         # This is not in a branch, because it is very rare to have zero full attention layer
   317 |         needed_blocks = num_requested_blocks * self.num_full_attention_groups
   318 |         # Only take this branch if the model has sliding window attention layers
   319 |         if self.num_sliding_attention_groups:
   320 |             blocks_left = max(self.max_sliding_window_blocks_per_request - allocated_blocks, 0)
   321 |             needed_blocks += min(blocks_left, num_requested_blocks) * self.num_sliding_attention_groups
   322 |         return needed_blocks
   323 | 
   324 |     def will_allocation_be_successful(self, num_requested_blocks: int, allocated_blocks: int) -> bool:
   325 |         """Returns a boolean indicating if the allocation of (num_requested_blocks) blocks will be successful."""
   326 |         return self.blocks_needed(num_requested_blocks, allocated_blocks) <= self.get_num_free_blocks()
   327 | 
   328 |     def blocks_in_use(self, request_id: str) -> int:
   329 |         """Returns the total number of physical blocks currently referenced by a request across all layer groups."""
   330 |         return sum(len(cm.block_table.get(request_id, ())) for cm in self.group_cache_managers)
   331 | 
   332 |     def allocate_blocks(self, n_blocks: int, request_id: str, allocated_blocks: int) -> int | None:
   333 |         """Allocate cache blocks across all layer groups for a given request. Actual allocation is done by the cache
   334 |         managers, and this method only returns the maximum number of blocks actually allocated across all managers."""
   335 |         # First check allocation will be successful before starting, to avoid partial allocations
   336 |         if not self.will_allocation_be_successful(n_blocks, allocated_blocks):
   337 |             return None
   338 |         # Allocate blocks across all cache managers
   339 |         max_allocated = 0
   340 |         for cm in self.group_cache_managers:
   341 |             num_allocated_blocks = cm.allocate_blocks(n_blocks, request_id, self._block_manager)
   342 |             if num_allocated_blocks is None:
   343 |                 raise ValueError(f"Failed to allocate {n_blocks} blocks for request {request_id}")
   344 |             max_allocated = max(max_allocated, num_allocated_blocks)
   345 |         return max_allocated
