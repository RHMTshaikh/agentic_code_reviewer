  97 |     backward_map_w = int((forward_map[..., 0].max() - forward_map[..., 0].min())/scale + 1)
  98 |     backward_map = cv.resize(backward_map, (backward_map_w, backward_map_h), interpolation=cv.INTER_LINEAR)
  99 |     backward_map /= scale
