  3474 |                     "Detected adapters on the model, saving the model in the PEFT format, only adapter weights will be saved."
  3475 |                 )
  3476 |                 state_dict = model_to_save.get_adapter_state_dict(state_dict=state_dict)
  3477 | 
  3478 |                 if save_peft_format:
  3479 |                     logger.info(
  3480 |                         "To match the expected format of the PEFT library, all keys of the state dict of adapters will be prepended with `base_model.model`."
  3481 |                     )
  3482 |                     peft_state_dict = {}
  3483 |                     for key, value in state_dict.items():
  3484 |                         peft_state_dict[f"base_model.model.{key}"] = value
  3485 |                     state_dict = peft_state_dict
