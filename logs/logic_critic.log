   198 |         """
   199 |         At serialization time, dataclasses get stored as a dictionary with an extra "_cls_name" field.
   200 |         This function converts those dictionaries back into their dataclass format, if they exist.
   201 | 
   202 |         NOTE: this dictionary input format is intentionally not documented in __init__, to ensure
   203 |         users use the dataclasses -- they have built-in validation.
   204 |         """
   205 |         # Assumption: all dataclasses that we want to load can be instantiated in this file
   206 |         current_module = sys.modules[__name__]
   207 | 
   208 |         for attr_name in ("sampler_config",):
   209 |             attr = getattr(self, attr_name)
   210 |             # Load the right dataclass using the `_cls_name` field
   211 |             if isinstance(attr, dict):
   212 |                 cls_name = attr.pop("_cls_name", None)
   213 |                 config_dataclass = getattr(current_module, cls_name)
   214 |                 loaded_attr = config_dataclass(**attr)
   215 |                 setattr(self, attr_name, loaded_attr)
