  3776 |     @classmethod
  3777 |     def get_init_context(
  3778 |         cls, dtype: torch.dtype, is_quantized: bool, _is_ds_init_called: bool, allow_all_kernels: bool | None
  3779 |     ):
  3780 |         # Need to instantiate with correct dtype
  3781 |         init_contexts = [local_torch_dtype(dtype, cls.__name__), init.no_tie_weights(), apply_patches()]
  3782 |         # Needed as we cannot forward the `allow_all_kernels` arg in the model's __init__
  3783 |         if allow_all_kernels:
  3784 |             init_contexts.append(allow_all_hub_kernels())
  3785 |         if is_deepspeed_zero3_enabled():
  3786 |             import deepspeed
  3787 | 
  3788 |             # We cannot initialize the model on meta device with deepspeed when not quantized
  3789 |             if not is_quantized and not _is_ds_init_called:
  3790 |                 logger.info("Detected DeepSpeed ZeRO-3: activating zero.init() for this model")
  3791 |                 init_contexts.extend(
  3792 |                     [
  3793 |                         init.no_init_weights(),
  3794 |                         deepspeed.zero.Init(config_dict_or_path=deepspeed_config()),
  3795 |                         set_zero3_state(),
  3796 |                     ]
  3797 |                 )
  3798 |             elif is_quantized:
  3799 |                 init_contexts.extend([torch.device("meta"), set_quantized_state()])
  3800 |         else:
  3801 |             # meta_device_safe_creation_ops patches torch.linspace to default to CPU
  3802 |             # so that custom models calling .item() during __init__ (e.g. drop-path
  3803 |             # schedules) don't crash on meta tensors.
  3804 |             init_contexts.extend([torch.device("meta"), init.meta_device_safe_creation_ops()])
  3805 | 
  3806 |         return init_contexts
  3807 | 
  3808 |     def _get_dtype_plan(self, dtype: torch.dtype) -> dict:
  3809 |         """Create the dtype_plan describing modules/parameters that should use the `keep_in_fp32` flag."""
  3810 |         dtype_plan = {}
  3811 | 
  3812 |         # The _keep_in_fp32_modules flag is only used to avoid bf16 -> fp16 casting precision issues. It was introduced
  3813 |         # in case of force loading a model that should stay in bf16 in fp16
  3814 |         # See https://github.com/huggingface/transformers/issues/20287 for details.
  3815 |         if self._keep_in_fp32_modules is not None and dtype == torch.float16:
  3816 |             dtype_plan.update(dict.fromkeys(self._keep_in_fp32_modules, torch.float32))
  3817 | 
  3818 |         # The _keep_in_fp32_modules_strict was introduced to always force upcast to fp32, for both fp16 and bf16
  3819 |         if self._keep_in_fp32_modules_strict is not None and dtype in (torch.float16, torch.bfloat16):
  3820 |             dtype_plan.update(dict.fromkeys(self._keep_in_fp32_modules_strict, torch.float32))
  3821 | 
  3822 |         return dtype_plan
  3823 | 
  3824 |     def set_use_kernels(self, use_kernels, kernel_config: KernelConfig | None = None, mode: "Mode | None" = None):
  3825 |         """
  3826 |         Set whether or not to use the `kernels` library to kernelize some layers of the model.
  3827 |         Args:
  3828 |             use_kernels (`bool`):
  3829 |                 Whether or not to use the `kernels` library to kernelize some layers of the model.
  3830 |             kernel_config (`KernelConfig`, *optional*):
  3831 |                 The kernel configuration to use to kernelize the model. If `None`, the default kernel mapping will be used.
  3832 |             mode (`Mode`, *optional*):
  3833 |                 The mode that should be applied during `kernelize`. Optional, defaults to either training or inference mode
  3834 |                 based on the internal `training` flag.
  3835 |         """
  3836 |         if use_kernels:
  3837 |             if not is_kernels_available():
  3838 |                 raise ValueError(
  3839 |                     "Kernels are not available. "
  3840 |                     f"Please install a compatible version ({KERNELS_MIN_VERSION} <= version < {KERNELS_MAX_VERSION}), "
  3841 |                     f"e.g. `pip install kernels=={KERNELS_MIN_VERSION}`"
  3842 |                 )
  3843 |             from .integrations.hub_kernels import register_kernel_mapping_transformers
  3844 | 
  3845 |             register_kernel_mapping_transformers()
  3846 | 
  3847 |             if kernel_config is not None:
  3848 |                 if not isinstance(kernel_config, KernelConfig):
  3849 |                     raise ValueError(
  3850 |                         f"Expeced `kernel_config` to be of type `KernelConfig` but got {type(kernel_config)}"
  3851 |                     )
  3852 | 
  3853 |                 # Since kernel_config is a correct value, set it as an attribute of the model so it can be used.
  3854 |                 self.kernel_config = kernel_config
  3855 | 
  3856 |                 # This will make sure the mapping is valid, and the layers are registered in the model
  3857 |                 kernel_config.sanitize_kernel_mapping(self)
  3858 | 
  3859 |                 # This will create a compatible mapping for the model with the kernels library
  3860 |                 kernel_config.create_compatible_mapping(self)
  3861 | 
  3862 |             kernelize(self, mode=mode)
  3863 |         else:
  3864 |             self._use_kernels = False
  3865 | 
  3866 |     @classmethod
  3867 |     def from_pretrained(
  3868 |         cls: type[SpecificPreTrainedModelType],
