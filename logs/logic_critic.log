  4788 |     def _initialize_missing_keys(self, is_quantized: bool) -> None:
  4789 |         """
  4790 |         Initialize the missing keys (keys that are part of the model parameters, but were NOT found in the loaded state dicts), according to
  4791 |         `_initialize_weights`. Indeed, since the corresponding weights are missing from the state dict, they will not be replaced and need to
  4792 |         be initialized correctly (i.e. weight initialization distribution).
  4793 | 
  4794 |         Also marks non-missing params/buffers with `_is_hf_initialized` and propagates this flag to modules,
  4795 |         so that `_initialize_weights` can skip fully-initialized modules entirely.
  4796 |         """
  4797 |         if is_fsdp_enabled() and not is_local_dist_rank_0():
  4798 |             # Handle FSDP edge case when using cpu ram efficient loading to ensure it is marked as initialized
  4799 |             # since it will get its weights broadcasted from rank0
  4800 |             # We actually need to do that only because we want to re-initialize non-persistent buffers with correct values.
  4801 |             # Everything else in the state_dict will be gathered from rank0, so we don't need re-initialization.
  4802 |             # We could simply early return after buffer inits if we had a way to init only the non-persistent buffers
  4803 |             for key in self.state_dict():
  4804 |                 try:
  4805 |                     param_or_buffer = self.get_parameter_or_buffer(key)
  4806 |                     param_or_buffer._is_hf_initialized = True
  4807 |                 except AttributeError:
  4808 |                     pass  # may happen when handling pre-quantized weights
  4809 |             self._is_hf_initialized = True
  4810 | 
  4811 |         # This will only initialize submodules that are not marked as initialized by the line above.
  4812 |         if is_deepspeed_zero3_enabled() and not is_quantized:
  4813 |             import deepspeed
  4814 | 
  4815 |             # keep_vars=True as we need the original tensors, so that the "_is_hf_initialized" is present on them
  4816 |             not_initialized_parameters = list(
  4817 |                 {v for v in self.state_dict(keep_vars=True).values() if not getattr(v, "_is_hf_initialized", False)}
  4818 |             )
  4819 |             with deepspeed.zero.GatheredParameters(not_initialized_parameters, modifier_rank=0):
  4820 |                 self.initialize_weights()
  4821 |         else:
  4822 |             self.initialize_weights()
