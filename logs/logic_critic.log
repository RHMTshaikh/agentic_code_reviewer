   181 |             op = _make_dtensor_shard_op(mesh, [Shard(0), Shard(0)], param_shape=(8, 8), local_shape=(2, 8))
   182 |             torch.testing.assert_close(op.shard_tensor(tensor), expected[rank], msg=f"rank {rank}")
   183 | 
   184 |     def test_2D_strided_shard_same_dim(self):
