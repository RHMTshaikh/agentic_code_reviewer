   220 |         other.true_write_sizes = self.true_write_sizes[:]
   221 |         other.use_block_table = self.use_block_table
   222 |         # Transfer scalar attributes
   223 |         other.total_seqlen_q = self.total_seqlen_q
   224 |         other.total_seqlen_k = dict(self.total_seqlen_k)
   225 |         other.max_seqlen_q = self.max_seqlen_q
   226 |         other.max_seqlen_k = dict(self.max_seqlen_k)
