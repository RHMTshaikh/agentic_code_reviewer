    89 | class TestDtensorShardOperation(unittest.TestCase):
    90 |     """Unit tests for DtensorShardOperation.
    91 | 
    92 |     See `DtensorShardOperation` in sharding_utils.py for the placement primer
    93 |     and table of checkpoint layouts. The rest of this docstring covers the
    94 |     test-specific conventions you need to write new cases here.
    95 | 
    96 |     Running example used throughout these tests: a stack of N MoE experts,
    97 |     each of shape [in, out]. The full parameter shape is [N, in, out].
    98 |     Tests are parameterized so every rank in a (fake) mesh is checked.
    99 | 
   100 |     The checkpoint can store this param in two layouts, and shard_tensor
   101 |     behaves differently for each:
   102 | 
   103 |     | Layout                       | tensor_idx        | source.shape   |
   104 |     |------------------------------|-------------------|----------------|
   105 |     | Single stacked tensor        | None              | [N, in, out]   |
   106 |     | N separate per-expert files  | 0, 1, ..., N-1    | [in, out]      |
   107 | 
   108 |     Single-tensor case: source has the full param shape, including axis 0.
   109 |     shard_tensor returns this rank's slice along every sharded dim.
   110 | 
   111 |     Per-piece case: shard_tensor is called once per expert. Each call's
   112 |     source is just that one expert's [in, out] tensor — note source has
   113 |     one fewer dim than the param, because the axis-0 index lives in
   114 |     `tensor_idx`, not in source.shape. shard_tensor returns:
   115 |       - None, if this rank doesn't own expert `tensor_idx` along axis 0
   116 |         (the piece is then dropped by the caller, MergeModulelist /
   117 |         Concatenate),
   118 |       - the inner-dim slice otherwise. After all N calls, the caller
   119 |         stacks the surviving slices along axis 0 to rebuild this rank's
   120 |         local [n_local, in, out].
   121 |     """
   122 | 
   123 |     def test_no_shard_placements_returns_full_copy(self):
   124 |         tensor = torch.arange(16).reshape(4, 4).float()
   125 |         expected = {
   126 |             0: tensor,  # rank 0 — no shards, full copy
   127 |             1: tensor,  # rank 1 — no shards, full copy
   128 |         }
   129 |         for rank in range(2):
   130 |             mesh = FakeMesh(shape=(2,), rank=rank)
   131 |             op = _make_dtensor_shard_op(mesh, [Replicate()], param_shape=(4, 4), local_shape=(4, 4))
   132 |             torch.testing.assert_close(op.shard_tensor(tensor), expected[rank], msg=f"rank {rank}")
   133 | 
   134 |     def test_1D_shard(self):
   135 |         tensor = torch.arange(16).reshape(4, 4).float()
   136 |         expected = {
   137 |             0: tensor[:2],  # rank 0 — first half
   138 |             1: tensor[2:],  # rank 1 — second half
   139 |         }
   140 |         for rank in range(2):
   141 |             mesh = FakeMesh(shape=(2,), rank=rank)
   142 |             op = _make_dtensor_shard_op(mesh, [Shard(0)], param_shape=(4, 4), local_shape=(2, 4))
   143 |             torch.testing.assert_close(op.shard_tensor(tensor), expected[rank], msg=f"rank {rank}")
   144 | 
   145 |     def test_1D_strided_shard(self):
   146 |         tensor = torch.arange(16).reshape(4, 4).float()
   147 |         expected = {
   148 |             0: tensor[[0, 2]],  # first piece of each group — rows {0, 2}
   149 |             1: tensor[[1, 3]],  # second piece of each group — rows {1, 3}
   150 |         }
   151 |         for rank in range(2):
   152 |             mesh = FakeMesh(shape=(2,), rank=rank)
