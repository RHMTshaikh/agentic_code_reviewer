  3169 |     def _init_added_embeddings_weights_with_mean(
  3170 |         self, old_embeddings, new_embeddings, old_num_tokens, added_num_tokens
  3171 |     ):
  3172 |         old_embeddings_weight = old_embeddings.weight.data.to(torch.float32)
  3173 |         mean_embeddings = torch.mean(old_embeddings_weight, axis=0)
  3174 |         old_centered_embeddings = old_embeddings_weight - mean_embeddings
  3175 |         covariance = old_centered_embeddings.T @ old_centered_embeddings / old_num_tokens
  3176 | 
  3177 |         # Check if the covariance is positive definite.
  3178 |         epsilon = 1e-9
  3179 |         is_covariance_psd = constraints.positive_definite.check(epsilon * covariance).all()
  3180 |         if is_covariance_psd:
  3181 |             # If covariances is positive definite, a distribution can be created. and we can sample new weights from it.
  3182 |             distribution = torch.distributions.multivariate_normal.MultivariateNormal(
  3183 |                 mean_embeddings, covariance_matrix=epsilon * covariance
  3184 |             )
  3185 |             new_embeddings.weight.data[-1 * added_num_tokens :, :] = distribution.sample(
  3186 |                 sample_shape=(added_num_tokens,)
  3187 |             ).to(old_embeddings.weight.dtype)
  3188 |         else:
  3189 |             # Otherwise, just initialize with the mean. because distribution will not be created.
  3190 |             new_embeddings.weight.data[-1 * added_num_tokens :, :] = (
  3191 |                 mean_embeddings[None, :].repeat(added_num_tokens, 1).to(old_embeddings.weight.dtype)
  3192 |             )
