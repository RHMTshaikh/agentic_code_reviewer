   541 | def process_target_pattern(pattern: str) -> tuple[str, str | None]:
   542 |     """
   543 |     Process a target pattern for reverse mapping (when targets become sources).
   544 | 
   545 |     This handles several edge cases in checkpoint conversion mappings:
   546 |     - Removes `^` prefix and `$` suffix (start/end of string anchors)
   547 |     - Removes negative lookahead/lookbehind assertions
   548 |     - Detects capturing groups and replaces them with `\\1` backreference
   549 | 
   550 |     Args:
   551 |         pattern: The target pattern to process for reverse mapping.
   552 | 
   553 |     Returns:
   554 |         A tuple of (processed_pattern, captured_group) where captured_group is
   555 |         the original capturing group found (e.g., "(encoder|decoder)") or None.
   556 |     """
