   236 |         modules = [module for _, module in no_reshard_targets]
   237 |         fully_shard(modules, mesh=fsdp_mesh, reshard_after_forward=False, **fsdp_policy_kwargs)
   238 |         logger.debug(f"Grouped tail {module_names} (reshard=False)")
   239 |     else:
   240 |         for module_name, module in no_reshard_targets:
   241 |             fully_shard(module, mesh=fsdp_mesh, reshard_after_forward=False, **fsdp_policy_kwargs)
   242 |             logger.debug(f"Applied fully_shard to {module_name} (reshard=False)")
   243 | 
   244 |     # Apply FSDP2 to the root module
   245 |     fully_shard(model, mesh=fsdp_mesh, **fsdp_policy_kwargs)
