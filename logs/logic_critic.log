   492 |         # Load the custom generate function
   493 |         check_python_requirements(
   494 |             pretrained_model_name_or_path, requirements_file="custom_generate/requirements.txt", **kwargs
   495 |         )
   496 |         custom_generate_function = get_class_in_module("generate", module)
