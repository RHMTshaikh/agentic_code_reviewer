 109 |         direction (tuple): (dx, dy, dz) direction vector of the line.
 110 |     Returns:
 111 |         Line_3D: An instance of the Line_3D class.
 112 |     """
 113 |     point1_np = np.array(point1)
 114 |     direction_np = np.array(direction) / np.linalg.norm(direction)
 115 |     point2_np = point1_np + direction_np
 116 | 
 117 |     line = Line_3D(point1_np, point2_np, direction_np)
 118 |     return line

