   217 |             f"{type(model).__name__} does not have a FSDP2 plan declared. Set "
   218 |             "`base_model_fsdp_plan` on the config and `_fsdp_plan` on the head class."
   219 |         )
   220 | 
   221 |     distributed_config = getattr(model.config, "distributed_config", None)
