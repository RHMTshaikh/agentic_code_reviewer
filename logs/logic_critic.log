   191 |     def _compute_strided_slice(
   192 |         self, intervals: list[tuple[int, int]], rank: int, world_size: int, split_factor: int
   193 |     ) -> list[tuple[int, int]]:
   194 |         local_intervals = []
   195 | 
   196 |         for interval_start, interval_end in intervals:
   197 |             # For each interval, we break it into split_factor consecutive groups.
   198 |             group_width = math.ceil((interval_end - interval_start) / split_factor)
   199 | 
   200 |             for group_idx in range(split_factor):
   201 |                 # Compute this group's boundaries in source coordinates.
   202 |                 group_start = interval_start + group_idx * group_width
   203 |                 group_end = min(group_start + group_width, interval_end)
   204 |                 group_len = group_end - group_start
   205 | 
   206 |                 if group_len > 0:
   207 |                     # Inside each group, we do a normal contiguous shard across world_size ranks.
   208 |                     local_shard_size, local_shard_offset = Shard.local_shard_size_and_offset(
   209 |                         group_len, world_size, rank
   210 |                     )
   211 |                     if local_shard_size > 0:
   212 |                         # Convert group-local offset back to global source coordinates.
   213 |                         shard_start = group_start + local_shard_offset
   214 |                         local_intervals.append((shard_start, shard_start + local_shard_size))
   215 | 
   216 |         return local_intervals
