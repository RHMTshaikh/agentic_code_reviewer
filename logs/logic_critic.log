  1319 |     def get_special_tokens_mask(
  1320 |         self, token_ids_0: list[int], token_ids_1: list[int] | None = None, already_has_special_tokens: bool = False
  1321 |     ) -> list[int]:
  1322 |         """
  1323 |         Retrieve sequence ids from a token list that has no special tokens added.
  1324 | 
  1325 |         For fast tokenizers, data collators call this with `already_has_special_tokens=True` to build a mask over an
  1326 |         already-formatted sequence. In that case, we compute the mask by checking membership in `all_special_ids`.
  1327 | 
  1328 |         Args:
  1329 |             token_ids_0: List of IDs for the (possibly already formatted) sequence.
  1330 |             token_ids_1: Unused when `already_has_special_tokens=True`. Must be None in that case.
  1331 |             already_has_special_tokens: Whether the sequence is already formatted with special tokens.
  1332 | 
  1333 |         Returns:
  1334 |             A list of integers in the range [0, 1]: 1 for a special token, 0 for a sequence token.
  1335 |         """
  1336 |         if already_has_special_tokens:
  1337 |             if token_ids_1 is not None:
  1338 |                 raise ValueError(
  1339 |                     "You should not supply a second sequence if the provided sequence of ids is already formatted "
  1340 |                     "with special tokens for the model."
  1341 |                 )
  1342 |             special_ids = set(self.all_special_ids)
  1343 |             return [1 if int(tid) in special_ids else 0 for tid in token_ids_0]
  1344 | 
  1345 |         # Default base implementation for non-formatted sequences is not provided here.
  1346 |         # Concrete tokenizer classes should override this for their specific formatting rules.
  1347 |         raise NotImplementedError(
  1348 |             f"{self.__class__.__name__} does not implement get_special_tokens_mask for non-formatted sequences"
  1349 |         )
