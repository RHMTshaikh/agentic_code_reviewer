   211 |         return_mm_token_type_ids = output_kwargs["text_kwargs"].pop("return_mm_token_type_ids", False)
   212 |         text_inputs = self.tokenizer(prompt_strings, **output_kwargs["text_kwargs"], return_tensors=None)
   213 |         self._check_special_mm_tokens(prompt_strings, text_inputs, modalities=["image"])
   214 | 
   215 |         if return_mm_token_type_ids:
   216 |             text_inputs["mm_token_type_ids"] = self.create_mm_token_type_ids(text_inputs["input_ids"])
   217 |         return BatchFeature(data={**text_inputs, **image_inputs}, tensor_type=return_tensors)
