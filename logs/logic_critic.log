  14 | def apply_fold(forward_map, line: Line_3D, angle_deg, mask):
  15 |     forward_map_copy = forward_map.copy()
  16 |     shape = forward_map_copy.shape
  17 |     flat_map = forward_map_copy.reshape(-1, 3)
  18 | 
  19 |     affected_points_flat = mask.flatten()
  20 | 
  21 |     R_matrix = _build_rotation_matrix(line.direction, angle_deg)
  22 |     points_to_rotate = flat_map[affected_points_flat]
  23 |     
  24 |     translated_points = points_to_rotate - line.point1
  25 |     rotated_points = translated_points @ R_matrix.T + line.point1
  26 |     
  27 |     warped_map = flat_map.copy()
  28 |     warped_map[affected_points_flat] = rotated_points
  29 |     return warped_map.reshape(shape)    


