  3468 |                 model_to_save.config.save_pretrained(save_directory)
  3469 |             if self.can_generate():
  3470 |                 model_to_save.generation_config.save_pretrained(save_directory)
  3471 | 
  3472 |             if _hf_peft_config_loaded:
  3473 |                 logger.info(
  3474 |                     "Detected adapters on the model, saving the model in the PEFT format, only adapter weights will be saved."
  3475 |                 )
  3476 |                 state_dict = model_to_save.get_adapter_state_dict(state_dict=state_dict)
  3477 | 
  3478 |                 if save_peft_format:
  3479 |                     logger.info(
  3480 |                         "To match the expected format of the PEFT library, all keys of the state dict of adapters will be prepended with `base_model.model`."
  3481 |                     )
  3482 |                     peft_state_dict = {}
  3483 |                     for key, value in state_dict.items():
  3484 |                         peft_state_dict[f"base_model.model.{key}"] = value
  3485 |                     state_dict = peft_state_dict
  3486 | 
  3487 |                 active_adapter = self.active_adapters()
  3488 | 
  3489 |                 if len(active_adapter) > 1:
  3490 |                     raise ValueError(
  3491 |                         "Multiple active adapters detected, saving multiple active adapters is not supported yet. You can save adapters separately one by one "
  3492 |                         "by iteratively calling `model.set_adapter(adapter_name)` then `model.save_pretrained(...)`"
  3493 |                     )
  3494 |                 active_adapter = active_adapter[0]
  3495 | 
  3496 |                 current_peft_config = self.peft_config[active_adapter]
  3497 |                 current_peft_config.save_pretrained(save_directory)
  3498 | 
  3499 |         # Get the model state_dict
  3500 |         if state_dict is None:
  3501 |             state_dict = model_to_save.state_dict()
  3502 | 
  3503 |         # if any model parameters are offloaded, we need to know it for later
  3504 |         is_offloaded = False
  3505 |         if (
  3506 |             hasattr(self, "hf_device_map")
  3507 |             and len(set(self.hf_device_map.values())) > 1
  3508 |             and ("cpu" in self.hf_device_map.values() or "disk" in self.hf_device_map.values())
  3509 |         ):
  3510 |             is_offloaded = True
  3511 |             warnings.warn(
  3512 |                 "Attempting to save a model with offloaded modules. Ensure that unallocated cpu memory "
  3513 |                 "exceeds the `shard_size` (50GB default)"
  3514 |             )
  3515 | 
  3516 |         # Translate state_dict from smp to hf if saving with smp >= 1.10
  3517 |         if IS_SAGEMAKER_MP_POST_1_10:
  3518 |             for smp_to_hf, _ in smp.state.module_manager.translate_functions:
