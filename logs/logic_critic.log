   514 |     def copy_cache(self, list_source_blocks: list[int], list_forked_blocks: list[int]) -> None:
   515 |         """Copy the cache from the source blocks to the forked blocks."""
   516 |         source_blocks = torch.tensor(list_source_blocks, device=self.device, dtype=torch.int32)
   517 |         forked_blocks = torch.tensor(list_forked_blocks, device=self.device, dtype=torch.int32)
   518 |         for key_cache, value_cache in zip(self.key_cache, self.value_cache):
   519 |             key_cache = key_cache.view(-1, self.block_size, self.num_key_value_heads, self.head_dim)
   520 |             value_cache = value_cache.view(-1, self.block_size, self.num_key_value_heads, self.head_dim)
   521 |             key_cache[forked_blocks] = key_cache[source_blocks]
   522 |             value_cache[forked_blocks] = value_cache[source_blocks]
   523 |         # FIXME: consolidate the cache into a single tensor of shape (group_size, 2, *self.k_or_v_cache_shape)
   524 |         # This will allow for  better .update and a single copy instead of one per cache tensor
   525 | 
   526 |     def compute_max_num_forks(self, source_request_id: str) -> int:
   527 |         """Computes the maximum number of children requests that can be forked from the source request."""
   528 |         # Count, across all groups, the new blocks each fork would have to allocate (i.e. non-shareable blocks)
   529 |         blocks_needed_per_fork = 0
   530 |         for cm in self.group_cache_managers:
   531 |             block_ids = cm.block_table[source_request_id]
   532 |             shareable_blocks = 0
   533 |             if cm.uses_block_sharing:
   534 |                 for block_id in block_ids:
   535 |                     if not self._block_manager._id_to_block[block_id].is_complete:
   536 |                         break
   537 |                     shareable_blocks += 1
   538 |             blocks_needed_per_fork += len(block_ids) - shareable_blocks
   539 |         # If every block can be shared, no new allocations are needed and any number of forks is possible
   540 |         if blocks_needed_per_fork == 0:
   541 |             return 2**31  # absurdly large number, virtually infinite number of forks
   542 |         return self.get_num_free_blocks() // blocks_needed_per_fork
