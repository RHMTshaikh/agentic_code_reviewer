  2447 |     def set_push_to_hub(
  2448 |         self,
  2449 |         model_id: str,
  2450 |         strategy: str | HubStrategy = "every_save",
  2451 |         token: str | None = None,
  2452 |         private_repo: bool | None = None,
  2453 |         always_push: bool = False,
  2454 |         revision: str | None = None,
  2455 |     ):
  2456 |         """
  2457 |         A method that regroups all arguments linked to synchronizing checkpoints with the Hub.
  2458 | 
  2459 |         <Tip>
  2460 | 
  2461 |         Calling this method will set `self.push_to_hub` to `True`, which means the `output_dir` will begin a git
  2462 |         directory synced with the repo (determined by `model_id`) and the content will be pushed each time a save is
  2463 |         triggered (depending on your `self.save_strategy`). Calling [`~Trainer.save_model`] will also trigger a push.
  2464 | 
  2465 |         </Tip>
  2466 | 
  2467 |         Args:
  2468 |             model_id (`str`):
  2469 |                 The name of the repository to keep in sync with the local *output_dir*. It can be a simple model ID in
  2470 |                 which case the model will be pushed in your namespace. Otherwise it should be the whole repository
  2471 |                 name, for instance `"user_name/model"`, which allows you to push to an organization you are a member of
  2472 |                 with `"organization_name/model"`.
  2473 |             strategy (`str` or [`~trainer_utils.HubStrategy`], *optional*, defaults to `"every_save"`):
  2474 |                 Defines the scope of what is pushed to the Hub and when. Possible values are:
  2475 | 
  2476 |                 - `"end"`: push the model, its configuration, the processing_class e.g. tokenizer (if passed along to the [`Trainer`]) and a
  2477 |                   draft of a model card when the [`~Trainer.save_model`] method is called.
  2478 |                 - `"every_save"`: push the model, its configuration, the processing_class e.g. tokenizer (if passed along to the [`Trainer`])
  2479 |                   and a draft of a model card each time there is a model save. The pushes are asynchronous to not block
  2480 |                   training, and in case the save are very frequent, a new push is only attempted if the previous one is
  2481 |                   finished. A last push is made with the final model at the end of training.
  2482 |                 - `"checkpoint"`: like `"every_save"` but the latest checkpoint is also pushed in a subfolder named
  2483 |                   last-checkpoint, allowing you to resume training easily with
  2484 |                   `trainer.train(resume_from_checkpoint="last-checkpoint")`.
  2485 |                 - `"all_checkpoints"`: like `"checkpoint"` but all checkpoints are pushed like they appear in the
  2486 |                   output folder (so you will get one checkpoint folder per folder in your final repository)
  2487 | 
  2488 |             token (`str`, *optional*):
  2489 |                 The token to use to push the model to the Hub. Will default to the token in the cache folder obtained
  2490 |                 with `hf auth login`.
  2491 |             private_repo (`bool`, *optional*, defaults to `False`):
  2492 |                 Whether to make the repo private. If `None` (default), the repo will be public unless the organization's default is private. This value is ignored if the repo already exists.
  2493 |             always_push (`bool`, *optional*, defaults to `False`):
  2494 |                 Unless this is `True`, the `Trainer` will skip pushing a checkpoint when the previous push is not
  2495 |                 finished.
  2496 |             revision (`str`, *optional*):
  2497 |                 The revision to use when pushing to the Hub. Can be a branch name, a tag, or a commit hash.
  2498 | 
  2499 |         Example:
  2500 | 
  2501 |         ```py
  2502 |         >>> from transformers import TrainingArguments
  2503 | 
  2504 |         >>> args = TrainingArguments("working_dir")
  2505 |         >>> args = args.set_push_to_hub("me/awesome-model")
  2506 |         >>> args.hub_model_id
  2507 |         'me/awesome-model'
  2508 |         ```
  2509 |         """
  2510 |         self.push_to_hub = True
  2511 |         self.hub_model_id = model_id
  2512 |         self.hub_strategy = HubStrategy(strategy)
  2513 |         self.hub_token = token
  2514 |         self.hub_private_repo = private_repo
  2515 |         self.hub_always_push = always_push
  2516 |         self.hub_revision = revision
  2517 |         return self
  2518 | 
  2519 |     def set_optimizer(
  2520 |         self,
  2521 |         name: str | OptimizerNames = "adamw_torch",
  2522 |         learning_rate: float = 5e-5,
  2523 |         weight_decay: float = 0,
