  4378 | def auto_docstring(obj=None, *, custom_intro=None, custom_args=None, checkpoint=None):
  4379 |     r"""
  4380 |     Automatically generates comprehensive docstrings for model classes and methods in the Transformers library.
  4381 | 
  4382 |     This decorator reduces boilerplate by automatically including standard argument descriptions while allowing
  4383 |     overrides to add new or custom arguments. It inspects function signatures, retrieves predefined docstrings
  4384 |     for common arguments (like `input_ids`, `attention_mask`, etc.), and generates complete documentation
  4385 |     including examples and return value descriptions.
  4386 | 
  4387 |     For complete documentation and examples, read this [guide](https://huggingface.co/docs/transformers/auto_docstring).
  4388 | 
  4389 |     Examples of usage:
  4390 | 
  4391 |         Basic usage (no parameters):
  4392 |         ```python
  4393 |         @auto_docstring
  4394 |         class MyAwesomeModel(PreTrainedModel):
  4395 |             def __init__(self, config, custom_parameter: int = 10):
  4396 |                 r'''
  4397 |                 custom_parameter (`int`, *optional*, defaults to 10):
  4398 |                     Description of the custom parameter for MyAwesomeModel.
  4399 |                 '''
  4400 |                 super().__init__(config)
  4401 |                 self.custom_parameter = custom_parameter
  4402 |         ```
  4403 | 
  4404 |         Using `custom_intro` with a class:
  4405 |         ```python
  4406 |         @auto_docstring(
  4407 |             custom_intro="This model implements a novel attention mechanism for improved performance."
  4408 |         )
  4409 |         class MySpecialModel(PreTrainedModel):
  4410 |             def __init__(self, config, attention_type: str = "standard"):
  4411 |                 r'''
  4412 |                 attention_type (`str`, *optional*, defaults to "standard"):
  4413 |                     Type of attention mechanism to use.
  4414 |                 '''
  4415 |                 super().__init__(config)
  4416 |         ```
  4417 | 
  4418 |         Using `custom_intro` with a method, and specify custom arguments and example directly in the docstring:
  4419 |         ```python
  4420 |         @auto_docstring(
  4421 |             custom_intro="Performs forward pass with enhanced attention computation."
  4422 |         )
  4423 |         def forward(
  4424 |             self,
  4425 |             input_ids: Optional[torch.Tensor] = None,
  4426 |             attention_mask: Optional[torch.Tensor] = None,
  4427 |         ):
  4428 |             r'''
  4429 |             custom_parameter (`int`, *optional*, defaults to 10):
  4430 |                 Description of the custom parameter for MyAwesomeModel.
  4431 | 
  4432 |             Example:
  4433 | 
  4434 |             ```python
  4435 |             >>> model = MyAwesomeModel(config)
  4436 |             >>> model.forward(input_ids=torch.tensor([1, 2, 3]), attention_mask=torch.tensor([1, 1, 1]))
  4437 |             ```
  4438 |             '''
  4439 |         ```
  4440 | 
  4441 |         Using `custom_args` to define reusable arguments:
  4442 |         ```python
  4443 |         VISION_ARGS = r'''
  4444 |         pixel_values (`torch.FloatTensor`, *optional*):
  4445 |             Pixel values of the input images.
  4446 |         image_features (`torch.FloatTensor`, *optional*):
  4447 |             Pre-computed image features for efficient processing.
  4448 |         '''
  4449 | 
  4450 |         @auto_docstring(custom_args=VISION_ARGS)
  4451 |         def encode_images(self, pixel_values=None, image_features=None):
  4452 |             # ... method implementation
  4453 |         ```
  4454 | 
  4455 |         Combining `custom_intro` and `custom_args`:
  4456 |         ```python
  4457 |         MULTIMODAL_ARGS = r'''
  4458 |         vision_features (`torch.FloatTensor`, *optional*):
  4459 |             Pre-extracted vision features from the vision encoder.
  4460 |         fusion_strategy (`str`, *optional*, defaults to "concat"):
  4461 |             Strategy for fusing text and vision modalities.
  4462 |         '''
  4463 | 
  4464 |         @auto_docstring(
  4465 |             custom_intro="Processes multimodal inputs combining text and vision.",
  4466 |             custom_args=MULTIMODAL_ARGS
  4467 |         )
  4468 |         def forward(
  4469 |             self,
  4470 |             input_ids,
  4471 |             attention_mask=None,
  4472 |             vision_features=None,
  4473 |             fusion_strategy="concat"
  4474 |         ):
  4475 |             # ... multimodal processing
  4476 |         ```
  4477 | 
  4478 |         Using with ModelOutput classes:
  4479 |         ```python
  4480 |         @dataclass
  4481 |         @auto_docstring(
  4482 |             custom_intro="Custom model outputs with additional fields."
  4483 |         )
  4484 |         class MyModelOutput(ImageClassifierOutput):
  4485 |             r'''
  4486 |             loss (`torch.FloatTensor`, *optional*):
  4487 |                 The loss of the model.
  4488 |             custom_field (`torch.FloatTensor` of shape `(batch_size, hidden_size)`, *optional*):
  4489 |                 A custom output field specific to this model.
  4490 |             '''
  4491 | 
  4492 |             # Standard fields like hidden_states, logits, attentions etc. can be automatically documented
  4493 |             # However, given that the loss docstring is often different per model, you should document it above
  4494 |             loss: Optional[torch.FloatTensor] = None
  4495 |             logits: Optional[torch.FloatTensor] = None
  4496 |             hidden_states: Optional[tuple[torch.FloatTensor, ...]] = None
  4497 |             attentions: Optional[tuple[torch.FloatTensor, ...]] = None
  4498 |             custom_field: Optional[torch.FloatTensor] = None
  4499 |         ```
  4500 | 
  4501 |     Args:
  4502 |         custom_intro (`str`, *optional*):
  4503 |             Custom introduction text to add to the docstring. This replaces the default
  4504 |             introduction text generated by the decorator before the Args section. Use this to describe what
  4505 |             makes your model or method special.
  4506 |         custom_args (`str`, *optional*):
  4507 |             Custom argument documentation in docstring format. This allows you to define
  4508 |             argument descriptions once and reuse them across multiple methods. The format should follow the
  4509 |             standard docstring convention: `arg_name (`type`, *optional*, defaults to `value`): Description.`
  4510 |         checkpoint (`str`, *optional*):
  4511 |             Checkpoint name to use in examples within the docstring. This is typically
  4512 |             automatically inferred from the model configuration class, but can be overridden if needed for
  4513 |             custom examples.
  4514 | 
  4515 |     Note:
  4516 |         - Standard arguments (`input_ids`, `attention_mask`, `pixel_values`, etc.) are automatically documented
  4517 |           from predefined descriptions and should not be redefined unless their behavior differs in your model.
  4518 |         - New or custom arguments should be documented in the method's docstring using the `r''' '''` block
  4519 |           or passed via the `custom_args` parameter.
  4520 |         - For model classes, the decorator derives parameter descriptions from the `__init__` method's signature
  4521 |           and docstring.
  4522 |         - Return value documentation is automatically generated for methods that return ModelOutput subclasses.
  4523 |     """
  4524 | 
  4525 |     def auto_docstring_decorator(obj):
  4526 |         if len(obj.__qualname__.split(".")) > 1:
  4527 |             return auto_method_docstring(
  4528 |                 obj, custom_args=custom_args, custom_intro=custom_intro, checkpoint=checkpoint
  4529 |             )
  4530 |         else:
  4531 |             return auto_class_docstring(obj, custom_args=custom_args, custom_intro=custom_intro, checkpoint=checkpoint)
  4532 | 
  4533 |     if obj:
  4534 |         return auto_docstring_decorator(obj)
  4535 | 
  4536 |     return auto_docstring_decorator

