  30 | def deform_image_randomly(image, num_folds=1, angle_range=(30, 60), draw_folds=False):
  31 |     """
  32 |     Deform the input image by applying random folds.
  33 |     Parameters:
  34 |         image (np.ndarray): Input image to be deformed.
  35 |         num_folds (int): Number of folds to apply.
  36 |         angle_range (tuple): Range of angles (in degrees) for each fold as (min_angle, max_angle).
  37 |     returns:
  38 |         np.ndarray: Deformed image after applying folds, image has 4 channels (RGBA), image is transparent where no content is present.
  39 |         np.ndarray: Forward Map used for deformation.
  40 |     """
  41 |     image_copy = image.copy()
  42 |     
  43 |     h, w = image_copy.shape[:2]
  44 |     scale = 0.1
  45 |     h, w = (int(h*scale), int(w*scale))
  46 |     
  47 |     forward_map = create_forward_map(h, w)
  48 |     # lines = generate_non_intersecting_lines_by_random_peremeter_point(h, w, num_folds)
  49 |     t = time.time()
  50 |     lines = generate_non_intersecting_lines_by_random_point(*forward_map.shape[:2], num_folds)
  51 |     print(f"Time taken to generate lines: {(time.time() - t) * 1000:6.2f} ms")
  52 |     masks = []
  53 |     sides = []
  54 |     for line in lines:
  55 |         side = random.choice([True, False])
  56 |         sides.append(side)
  57 |         masks.append(get_affected_points_mask(forward_map.shape, line, side))
  58 | 
  59 |     if draw_folds:
  60 |         for i, line in enumerate(lines):
  61 |             p1 = (int(line.point1[0]/scale), int(line.point1[1]/scale))
  62 |             p2 = (int(line.point2[0]/scale), int(line.point2[1]/scale))
  63 |             cv.line(image_copy, p1, p2, (0, 255, 0, 255), 3)
  64 |             text_pos = (
  65 |                 int((p1[0] + p2[0]) // 2),
  66 |                 int((p1[1] + p2[1]) // 2)
  67 |             )
  68 |             cv.putText(image_copy, f'{i+1}', text_pos, cv.FONT_HERSHEY_SIMPLEX, 0.7, (255, 0, 0, 255), 2)
  69 | 
  70 |     t = time.time()
  71 |     for i in range(num_folds):
  72 |         line = lines[i]
  73 |         angle = np.radians(np.random.uniform(*angle_range)) * np.random.choice([-1, 1])
  74 |         mask = masks[i]
  75 |         side = sides[i]
  76 |         
  77 |         while True:
  78 |             test_map = apply_fold(forward_map, line, angle, mask)
  79 |             if not map_overlaps(test_map):
  80 |                 forward_map = test_map
  81 |                 break
  82 |             angle = np.radians(np.random.uniform(*angle_range))* random.choice([-1, 1])
  83 |         
  84 |         # Apply fold to all subsequent lines to keep them consistent
  85 |         x0, y0, z0 = line.point1
  86 |         dx, dy, dz = line.direction
  87 |         for j in range(i + 1, num_folds):
  88 |             next_line = lines[j]
  89 |             x, y, z = next_line.point1
  90 |             if side == ((x - x0) * dy - (y - y0) * dx < 0):
  91 |                 next_line.rotate(line, angle)
  92 |     print(f"Time taken to apply folds: {(time.time() - t) * 1000:6.2f} ms")
  93 |     
  94 |     t = time.time()
  95 |     backward_map = convert_forward_to_backward_using_interp1d(forward_map)
  96 |     backward_map_h = int((forward_map[..., 1].max() - forward_map[..., 1].min())/scale + 1)
  97 |     backward_map_w = int((forward_map[..., 0].max() - forward_map[..., 0].min())/scale + 1)
  98 |     backward_map = cv.resize(backward_map, (backward_map_w, backward_map_h), interpolation=cv.INTER_LINEAR)
  99 |     backward_map /= scale
 100 |     print(f"Time taken to convert forward map to backward map: {(time.time() - t) * 1000:6.2f} ms")
 101 |     
