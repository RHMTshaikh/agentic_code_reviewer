    48 |         # Acquire lock to prevent the Thundering Herd problem
    49 |         async with redis_client.lock(lock_key, timeout=5.0, blocking_timeout=5.0):
    50 |             
    51 |             # Double-check cache inside the lock (another worker may have just populated it)
