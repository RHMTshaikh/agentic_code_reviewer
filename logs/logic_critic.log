   674 |                 if inputs is not None:
   675 |                     raise ValueError("You passed `inputs_embeds` and `input_ids` to `.generate()`. Please pick one.")
   676 |                 inputs, input_name = model_kwargs["inputs_embeds"], "inputs_embeds"
   677 | 
   678 |         # 4. if `inputs` is still None, try to create `input_ids` from BOS token
   679 |         inputs = self._maybe_initialize_input_ids_for_generation(inputs, bos_token_id, model_kwargs)
   680 |         return inputs, input_name, model_kwargs
   681 | 
   682 |     def _maybe_initialize_input_ids_for_generation(
   683 |         self: "GenerativePreTrainedModel",
   684 |         inputs: torch.Tensor | None,
   685 |         bos_token_id: torch.Tensor | None,
   686 |         model_kwargs: dict[str, torch.Tensor],
   687 |     ) -> torch.LongTensor:
   688 |         """Initializes input ids for generation, if necessary."""
   689 |         if inputs is not None:
   690 |             return inputs
   691 | 
   692 |         encoder_outputs = model_kwargs.get("encoder_outputs")
   693 |         last_hidden_state = getattr(encoder_outputs, "last_hidden_state", None)
   694 |         if self.config.is_encoder_decoder and last_hidden_state is not None:
   695 |             # make dummy input_ids with value -100, as a sanity check ensuring that they won't be used for encoding
   696 |             shape = last_hidden_state.size()[:-1]
   697 |             return torch.ones(shape, dtype=torch.long, device=self.device) * -100
   698 | 
   699 |         # If there is some tensor in `model_kwargs`, we can infer the batch size from it. This is helpful with
   700 |         # soft-prompting or in multimodal implementations built on top of decoder-only language models.
   701 |         batch_size = 1
   702 |         for value in model_kwargs.values():
   703 |             if isinstance(value, torch.Tensor):
   704 |                 batch_size = value.shape[0]
   705 |                 break
   706 | 
   707 |         if "inputs_embeds" in model_kwargs:
   708 |             return torch.ones(
   709 |                 (batch_size, 0),
   710 |                 dtype=torch.long,
   711 |                 # Use the device of the existing tensor to avoid any potential `meta` device isssue, which is likely
   712 |                 # linked to the offloading behavior (keeping it on meta device). See PR #44848. Previously, it used
   713 |                 # `self.device`.
   714 |                 device=self.device if self.device.type != "meta" else model_kwargs["inputs_embeds"].device,
   715 |             )
   716 | 
   717 |         if bos_token_id is None:
   718 |             raise ValueError("`bos_token_id` has to be defined when no `input_ids` are provided.")
   719 | 
   720 |         return torch.ones((batch_size, 1), dtype=torch.long, device=self.device) * bos_token_id
   721 | 
   722 |     def _prepare_position_ids_for_generation(self, inputs_tensor, model_kwargs):
   723 |         """
   724 |         Tries to infer position ids given attention mask and past kv cache length. All instances when
   725 |         `position_ids=None` should call this method.
   726 |         """
   727 |         # `input_ids` may be present in the model kwargs, instead of being the main input (e.g. multimodal model)
   728 |         if "input_ids" in model_kwargs and model_kwargs["input_ids"].shape[1] > 0:
   729 |             inputs_tensor = model_kwargs["input_ids"]
   730 | 
   731 |         seq_length = inputs_tensor.shape[1]
   732 | 
   733 |         if (attention_mask := model_kwargs.get("attention_mask")) is not None:
   734 |             position_ids = attention_mask.long().cumsum(-1) - 1
   735 |             # We need this as otherwise padding tokens appear as -1 in position
   736 |             position_ids = position_ids.masked_fill(attention_mask == 0, 0)
   737 |         else:
   738 |             past_length = 0
   739 |             if (cache := model_kwargs.get("past_key_values")) is not None:
   740 |                 past_length = cache.get_seq_length()
   741 | 
   742 |             position_ids = torch.arange(seq_length + past_length, dtype=torch.long, device=inputs_tensor.device)
   743 |             position_ids = position_ids.unsqueeze(0)
   744 |         return position_ids
   745 | 
   746 |     def _prepare_attention_mask_for_generation(
   747 |         self,
   748 |         inputs_tensor: torch.Tensor,
   749 |         generation_config: GenerationConfig,
   750 |         model_kwargs: dict[str, Any],
   751 |     ) -> torch.LongTensor:
   752 |         pad_token_id = generation_config._pad_token_tensor
   753 |         eos_token_id = generation_config._eos_token_tensor
   754 | 
   755 |         # `input_ids` may be present in the model kwargs, instead of being the main input (e.g. multimodal model)
   756 |         if "input_ids" in model_kwargs and model_kwargs["input_ids"].shape[1] > 0:
   757 |             inputs_tensor = model_kwargs["input_ids"]
   758 | 
   759 |         # No information for attention mask inference -> return default attention mask
   760 |         default_attention_mask = torch.ones(inputs_tensor.shape[:2], dtype=torch.long, device=inputs_tensor.device)
   761 |         if pad_token_id is None:
   762 |             return default_attention_mask
   763 | 
   764 |         is_input_ids = len(inputs_tensor.shape) == 2 and inputs_tensor.dtype in [torch.int, torch.long]
   765 |         if not is_input_ids:
   766 |             return default_attention_mask
   767 | 
   768 |         is_pad_token_in_inputs = (pad_token_id is not None) and (torch.isin(inputs_tensor, pad_token_id).any())
   769 |         is_pad_token_not_equal_to_eos_token_id = (eos_token_id is None) or ~(
   770 |             torch.isin(eos_token_id, pad_token_id).any()
   771 |         )
   772 |         can_infer_attention_mask = is_pad_token_in_inputs * is_pad_token_not_equal_to_eos_token_id
   773 |         attention_mask_from_padding = inputs_tensor.ne(pad_token_id).long()
   774 | 
   775 |         attention_mask = (
   776 |             attention_mask_from_padding * can_infer_attention_mask + default_attention_mask * ~can_infer_attention_mask
   777 |         )
   778 |         return attention_mask
   779 | 
   780 |     def _prepare_encoder_decoder_kwargs_for_generation(
   781 |         self: "GenerativePreTrainedModel",
   782 |         inputs_tensor: torch.Tensor,
   783 |         model_kwargs,
   784 |         model_input_name: str | None,
   785 |         generation_config: GenerationConfig,
   786 |     ) -> dict[str, Any]:
   787 |         # 1. get encoder
   788 |         encoder = self.get_encoder()
   789 |         # Compatibility with Accelerate big model inference: we need the encoder to outputs stuff on the same device
   790 |         # as the inputs.
   791 |         if hasattr(self, "hf_device_map"):
   792 |             if hasattr(encoder, "_hf_hook"):
   793 |                 encoder._hf_hook.io_same_device = True
   794 |             else:
   795 |                 add_hook_to_module(encoder, AlignDevicesHook(io_same_device=True))
   796 | 
   797 |         # 2. Prepare encoder args and encoder kwargs from model kwargs and generation config.
   798 |         irrelevant_prefix = ["decoder_", "cross_attn", "use_cache", "past_key_values", "cache_params"]
   799 |         encoder_kwargs = {
   800 |             argument: value
   801 |             for argument, value in model_kwargs.items()
   802 |             if not any(argument.startswith(p) for p in irrelevant_prefix)
   803 |         }
   804 |         encoder_signature = set(inspect.signature(encoder.forward).parameters)
   805 |         encoder_accepts_wildcard = "kwargs" in encoder_signature or "model_kwargs" in encoder_signature
   806 |         if not encoder_accepts_wildcard:
   807 |             encoder_kwargs = {
   808 |                 argument: value for argument, value in encoder_kwargs.items() if argument in encoder_signature
   809 |             }
   810 |         encoder_kwargs["output_attentions"] = generation_config.output_attentions
   811 |         encoder_kwargs["output_hidden_states"] = generation_config.output_hidden_states
   812 | 
   813 |         # 3. make sure that encoder returns `ModelOutput`
   814 |         model_input_name = model_input_name if model_input_name is not None else self.main_input_name
   815 |         encoder_kwargs["return_dict"] = True
   816 |         encoder_kwargs[model_input_name] = inputs_tensor
   817 |         model_kwargs["encoder_outputs"]: ModelOutput = encoder(**encoder_kwargs)
   818 | 
   819 |         return model_kwargs
   820 | 
   821 |     def _prepare_decoder_input_ids_for_generation(
   822 |         self: "GenerativePreTrainedModel",
   823 |         batch_size: int,
   824 |         model_input_name: str,
   825 |         model_kwargs: dict[str, torch.Tensor],
   826 |         decoder_start_token_id: torch.Tensor,
   827 |         device: torch.device | None = None,
   828 |     ) -> tuple[torch.LongTensor, dict[str, torch.Tensor]]:
   829 |         """Prepares `decoder_input_ids` for generation with encoder-decoder models"""
   830 |         # 1. Check whether the user has defined `decoder_input_ids` manually. To facilitate in terms of input naming,
   831 |         # we also allow the user to pass it under `input_ids`, if the encoder does not use it as the main input.
   832 |         if model_kwargs is not None and "decoder_input_ids" in model_kwargs:
   833 |             decoder_input_ids = model_kwargs.pop("decoder_input_ids")
   834 |         elif "input_ids" in model_kwargs and model_input_name != "input_ids":
   835 |             decoder_input_ids = model_kwargs.pop("input_ids")
   836 |         else:
   837 |             decoder_input_ids = None
   838 | 
   839 |         # 2. `decoder_start_token_id` must have shape (batch_size, 1)
   840 |         if device is None:
   841 |             device = self.device
   842 |         if decoder_start_token_id.ndim == 1:
   843 |             if decoder_start_token_id.shape[0] != batch_size:
   844 |                 raise ValueError(
   845 |                     f"`decoder_start_token_id` expected to have length {batch_size} but got {decoder_start_token_id.shape[0]}"
   846 |                 )
   847 |             decoder_start_token_id = decoder_start_token_id.view(-1, 1)
   848 |         else:
   849 |             decoder_start_token_id = (
   850 |                 torch.ones((batch_size, 1), dtype=torch.long, device=device) * decoder_start_token_id
   851 |             )
   852 | 
   853 |         # 3. Encoder-decoder models expect the `decoder_input_ids` to start with a special token. Let's ensure that.
   854 |         # no user input -> use decoder_start_token_id as decoder_input_ids
   855 |         if decoder_input_ids is None:
   856 |             decoder_input_ids = decoder_start_token_id
   857 |         # exception: Donut checkpoints have task-specific decoder starts and don't expect a BOS token. Note that the
   858 |         # original checkpoints can't be detected through `self.__class__.__name__.lower()`, needing custom logic.
   859 |         # See: https://github.com/huggingface/transformers/pull/31470
   860 |         elif "donut" in self.__class__.__name__.lower() or (
   861 |             self.config.model_type == "vision-encoder-decoder" and "donut" in self.config.encoder.model_type.lower()
   862 |         ):
   863 |             pass
   864 |         elif self.config.model_type == "whisper":
   865 |             pass
   866 |         # user input but doesn't start with decoder_start_token_id -> prepend decoder_start_token_id (and adjust
   867 |         # decoder_attention_mask if provided)
   868 |         elif (decoder_input_ids[:, 0] != decoder_start_token_id[:, 0]).all().item():
   869 |             decoder_input_ids = torch.cat([decoder_start_token_id, decoder_input_ids], dim=-1)
   870 |             if "decoder_attention_mask" in model_kwargs:
   871 |                 decoder_attention_mask = model_kwargs["decoder_attention_mask"]
   872 |                 decoder_attention_mask = torch.cat(
   873 |                     (torch.ones_like(decoder_attention_mask)[:, :1], decoder_attention_mask),
   874 |                     dim=-1,
   875 |                 )
   876 |                 model_kwargs["decoder_attention_mask"] = decoder_attention_mask
   877 | 
   878 |         return decoder_input_ids, model_kwargs
   879 | 
   880 |     @staticmethod
   881 |     def _expand_inputs_for_generation(
   882 |         expand_size: int = 1,
   883 |         is_encoder_decoder: bool = False,
   884 |         input_ids: torch.LongTensor | None = None,
   885 |         **model_kwargs,
   886 |     ) -> tuple[torch.LongTensor, dict[str, Any]]:
   887 |         """Expands tensors from [batch_size, ...] to [batch_size * expand_size, ...]"""
   888 |         # Do not call torch.repeat_interleave if expand_size is 1 because it clones
   889 |         # the input tensor and thus requires more memory although no change is applied
   890 |         if expand_size == 1:
   891 |             return input_ids, model_kwargs
   892 | 
   893 |         def _expand_dict_for_generation(dict_to_expand):
   894 |             for key in dict_to_expand:
   895 |                 if dict_to_expand[key] is not None and isinstance(dict_to_expand[key], torch.Tensor):
   896 |                     dict_to_expand[key] = dict_to_expand[key].repeat_interleave(expand_size, dim=0)
   897 |             return dict_to_expand
   898 | 
   899 |         if input_ids is not None:
   900 |             input_ids = input_ids.repeat_interleave(expand_size, dim=0)
   901 | 
   902 |         model_kwargs = _expand_dict_for_generation(model_kwargs)
   903 | 
   904 |         if is_encoder_decoder:
   905 |             if model_kwargs.get("encoder_outputs") is None:
   906 |                 raise ValueError("If `is_encoder_decoder` is True, make sure that `encoder_outputs` is defined.")
   907 |             model_kwargs["encoder_outputs"] = _expand_dict_for_generation(model_kwargs["encoder_outputs"])
   908 | 
   909 |         return input_ids, model_kwargs
   910 | 
   911 |     def _update_model_kwargs_for_generation(
   912 |         self,
   913 |         outputs: ModelOutput,
   914 |         model_kwargs: dict[str, Any],
   915 |         is_encoder_decoder: bool = False,
   916 |         num_new_tokens: int = 1,
   917 |     ) -> dict[str, Any]:
   918 |         """
   919 |         Update the model kwargs to account for the `num_new_tokens` new tokens that were just generated.
   920 |         That is, update the `attention_mask`, `position_ids`, and `token_type_ids` to account for the
   921 |         new tokens of the total sequence.
   922 |         Note that this function never slices inputs, this is performed in `prepare_inputs_for_generation`.
   923 |         """
   924 |         # update past_key_values keeping its naming used in model code
   925 |         for possible_cache_name in ALL_CACHE_NAMES:
   926 |             if possible_cache_name in outputs:
   927 |                 # TODO (joao): remove output/input mismatch when these old models (xlnet, reformer) are deprecated
   928 |                 if possible_cache_name in ("past_buckets_states", "mems"):
   929 |                     cache_name = "past_key_values"
   930 |                 else:
   931 |                     cache_name = possible_cache_name
   932 |                 model_kwargs[cache_name] = getattr(outputs, possible_cache_name)
   933 |                 break
   934 | 
   935 |         # update token_type_ids with last value
   936 |         if (token_type_ids := model_kwargs.get("token_type_ids")) is not None:
   937 |             model_kwargs["token_type_ids"] = torch.cat([token_type_ids, token_type_ids[:, -num_new_tokens:]], dim=-1)
   938 | 
   939 |         # update mm_token_type_ids with zeros (only-text)
   940 |         if (mm_token_type_ids := model_kwargs.get("mm_token_type_ids")) is not None:
   941 |             model_kwargs["mm_token_type_ids"] = torch.cat(
   942 |                 [mm_token_type_ids, mm_token_type_ids.new_zeros((mm_token_type_ids.shape[0], num_new_tokens))], dim=-1
   943 |             )
   944 | 
   945 |         # Position ids (2D or 3D sometimes)
   946 |         position_ids_key = "position_ids" if not is_encoder_decoder else "decoder_position_ids"
   947 |         if (position_ids := model_kwargs.get(position_ids_key)) is not None:
   948 |             # We want to expand to the same number of dims which is not always the same
   949 |             required_dim = [1] * (position_ids.dim() - 1) + [-1]
   950 |             next_position_ids = (
   951 |                 torch.arange(num_new_tokens, dtype=position_ids.dtype, device=position_ids.device).view(*required_dim)
   952 |                 + position_ids[..., -1:]
   953 |                 + 1
   954 |             )
   955 |             next_position_ids = torch.cat([position_ids, next_position_ids], dim=-1)
   956 |             model_kwargs[position_ids_key] = next_position_ids
   957 | 
   958 |         # 2D attention mask (always 2D here)
   959 |         attention_mask_key = "attention_mask" if not is_encoder_decoder else "decoder_attention_mask"
   960 |         if (attention_mask := model_kwargs.get(attention_mask_key)) is not None:
   961 |             model_kwargs[attention_mask_key] = torch.cat(
   962 |                 [attention_mask, attention_mask.new_ones((attention_mask.shape[0], num_new_tokens))], dim=-1
   963 |             )
   964 | 
   965 |         return model_kwargs
   966 | 
   967 |     def _get_candidate_generator(
   968 |         self: "GenerativePreTrainedModel",
   969 |         generation_config: GenerationConfig,
   970 |         input_ids: torch.LongTensor,
   971 |         inputs_tensor: torch.Tensor,
   972 |         logits_processor: LogitsProcessorList,
   973 |         model_kwargs: dict[str, Any],
   974 |         assistant_model: Optional["PreTrainedModel"] = None,
   975 |         target_tokenizer: Optional["PreTrainedTokenizerBase"] = None,
   976 |         assistant_tokenizer: Optional["PreTrainedTokenizerBase"] = None,
   977 |     ) -> CandidateGenerator:
   978 |         """
   979 |         Returns the candidate generator to be used in `assisted_generation`
   980 |         """
   981 |         different_tokenizers = all(v is not None for v in (assistant_model, target_tokenizer, assistant_tokenizer))
   982 | 
   983 |         if generation_config.assistant_early_exit is not None:
   984 |             candidate_generator = EarlyExitCandidateGenerator(
   985 |                 input_ids=input_ids,
   986 |                 assistant_model=self,
   987 |                 generation_config=generation_config,
   988 |                 model_kwargs=model_kwargs,
   989 |                 inputs_tensor=inputs_tensor,
   990 |                 logits_processor=logits_processor,
   991 |             )
   992 |         elif generation_config.prompt_lookup_num_tokens is not None:
   993 |             candidate_generator = PromptLookupCandidateGenerator(
   994 |                 eos_token_id=generation_config._eos_token_tensor,
   995 |                 num_output_tokens=generation_config.prompt_lookup_num_tokens,
   996 |                 max_matching_ngram_size=generation_config.max_matching_ngram_size or 2,
   997 |                 max_length=generation_config.max_length,
   998 |                 logits_processor=logits_processor,
   999 |                 vocab_size=self.config.get_text_config().vocab_size,
  1000 |             )
  1001 |         # SinglePositionMultiTokenCandidateGenerator requires a target model that can provide, and an assistant model that
  1002 |         # can work from a shared_kv_states dictionary. Currently, the only models that can provide this are Gemma 3n and
  1003 |         # Gemma 4, and the only model that can work from it is a Gemma 4 Assistant
  1004 |         elif assistant_model is not None and assistant_model.__class__.__name__.startswith(
  1005 |             ("Gemma4Assistant", "Gemma4UnifiedAssistant")
  1006 |         ):
  1007 |             if not self.__class__.__name__.startswith(("Gemma4", "Gemma3n")):
  1008 |                 raise ValueError(
  1009 |                     f"Expected class name to start with Gemma4 or Gemma3n. Got {self.__class__.__name__}."
  1010 |                     " Gemma4Assistant models require a target model that provides a shared_kv_states dictionary."
  1011 |                     " Currently, only Gemma4 and Gemma3n provide a shared_kv_states dictionary."
  1012 |                 )
  1013 | 
  1014 |             candidate_generator = SinglePositionMultiTokenCandidateGenerator(
  1015 |                 input_ids=input_ids,
  1016 |                 assistant_model=assistant_model,
  1017 |                 target_model_input_embeddings=self.get_input_embeddings(),
  1018 |                 generation_config=generation_config,
  1019 |                 model_kwargs=model_kwargs,
  1020 |                 inputs_tensor=inputs_tensor,
  1021 |                 logits_processor=logits_processor,
  1022 |             )
  1023 |         elif different_tokenizers:
  1024 |             assistant_model = cast("PreTrainedModel", assistant_model)
  1025 |             target_tokenizer = cast("PreTrainedTokenizerBase", target_tokenizer)
  1026 |             assistant_tokenizer = cast("PreTrainedTokenizerBase", assistant_tokenizer)
  1027 |             if generation_config.do_sample is True:
  1028 |                 atm_translator = AssistantVocabTranslatorCache.get_translator(
  1029 |                     target_tokenizer,
  1030 |                     assistant_tokenizer,
  1031 |                     self.config.get_text_config().vocab_size,
  1032 |                     assistant_model=assistant_model,
  1033 |                     assistant_prune_lm_head=True,  # prune LM head of assistant model
  1034 |                 )
  1035 |                 # Since we prune the LM head, we cannot use the repetition penalty on the assistant model due to mismatches between token ids and logits index
  1036 |                 assistant_model.generation_config.repetition_penalty = None
  1037 |                 candidate_generator = UniversalSpeculativeDecodingGenerator(
  1038 |                     input_ids=input_ids,
  1039 |                     assistant_model=assistant_model,
  1040 |                     generation_config=generation_config,
  1041 |                     model_kwargs=model_kwargs,
  1042 |                     inputs_tensor=inputs_tensor,
  1043 |                     logits_processor=logits_processor,
  1044 |                     target_tokenizer=target_tokenizer,
  1045 |                     assistant_tokenizer=assistant_tokenizer,
  1046 |                     atm_translator=atm_translator,
  1047 |                 )
  1048 |             elif generation_config.do_sample is False:
  1049 |                 candidate_generator = AssistedCandidateGeneratorDifferentTokenizers(
  1050 |                     input_ids=input_ids,
  1051 |                     assistant_model=assistant_model,
  1052 |                     generation_config=generation_config,
  1053 |                     model_kwargs=model_kwargs,
  1054 |                     inputs_tensor=inputs_tensor,
  1055 |                     logits_processor=logits_processor,
  1056 |                     target_tokenizer=target_tokenizer,
  1057 |                     assistant_tokenizer=assistant_tokenizer,
  1058 |                 )
  1059 |             else:
  1060 |                 raise ValueError(
  1061 |                     f"Invalid value for `do_sample`: expected a boolean, got {type(generation_config.do_sample).__name__}"
  1062 |                 )
  1063 |         else:
  1064 |             candidate_generator = AssistedCandidateGenerator(
  1065 |                 input_ids=input_ids,
  1066 |                 assistant_model=assistant_model,
  1067 |                 generation_config=generation_config,
  1068 |                 model_kwargs=model_kwargs,
  1069 |                 inputs_tensor=inputs_tensor,
  1070 |                 logits_processor=logits_processor,
  1071 |             )
  1072 |         return candidate_generator
  1073 | 
  1074 |     def _get_logits_processor(
  1075 |         self: "GenerativePreTrainedModel",
  1076 |         generation_config: GenerationConfig,
  1077 |         input_ids_seq_length: int | None = None,
  1078 |         encoder_input_ids: torch.LongTensor | None = None,
  1079 |         prefix_allowed_tokens_fn: Callable[[int, torch.Tensor], list[int]] | None = None,
  1080 |         logits_processor: LogitsProcessorList | None = None,
  1081 |         device: str | None = None,
  1082 |         model_kwargs: dict[str, Any] | None = None,
  1083 |         negative_prompt_ids: torch.Tensor | None = None,
  1084 |         negative_prompt_attention_mask: torch.Tensor | None = None,
  1085 |     ) -> LogitsProcessorList:
  1086 |         """
  1087 |         This class returns a [`LogitsProcessorList`] list object that contains all relevant [`LogitsProcessor`]
  1088 |         instances used to modify the scores of the language model head.
  1089 |         """
  1090 |         # instantiate processors list
  1091 |         processors = LogitsProcessorList()
  1092 |         if logits_processor is None:
  1093 |             logits_processor = []
  1094 | 
  1095 |         if generation_config.guidance_scale is not None and generation_config.guidance_scale != 1:
  1096 |             processors.append(
  1097 |                 UnbatchedClassifierFreeGuidanceLogitsProcessor(
  1098 |                     generation_config.guidance_scale,
  1099 |                     self,
  1100 |                     unconditional_ids=negative_prompt_ids,
  1101 |                     unconditional_attention_mask=negative_prompt_attention_mask,
  1102 |                     use_cache=generation_config.use_cache,
  1103 |                 )
  1104 |             )
  1105 |         if generation_config.sequence_bias is not None:
  1106 |             processors.append(SequenceBiasLogitsProcessor(sequence_bias=generation_config.sequence_bias))
  1107 | 
  1108 |         if (
  1109 |             generation_config.encoder_repetition_penalty is not None
  1110 |             and generation_config.encoder_repetition_penalty != 1.0
  1111 |         ):
  1112 |             if encoder_input_ids is not None and len(encoder_input_ids.shape) == 2:
  1113 |                 processors.append(
  1114 |                     EncoderRepetitionPenaltyLogitsProcessor(
  1115 |                         penalty=generation_config.encoder_repetition_penalty,
  1116 |                         encoder_input_ids=encoder_input_ids,
  1117 |                     )
  1118 |                 )
  1119 |             else:
  1120 |                 warnings.warn(
  1121 |                     "Passing `encoder_repetition_penalty` requires some form of `input_ids` to be passed to "
  1122 |                     "`generate`, ignoring the argument.",
  1123 |                     UserWarning,
  1124 |                 )
  1125 |         if generation_config.repetition_penalty is not None and generation_config.repetition_penalty != 1.0:
  1126 |             processors.append(RepetitionPenaltyLogitsProcessor(penalty=generation_config.repetition_penalty))
  1127 |             if not self.config.is_encoder_decoder and (input_ids_seq_length is None or input_ids_seq_length == 0):
  1128 |                 warnings.warn(
  1129 |                     "Passing `repetition_penalty` with `inputs_embeds` and without `input_ids` to `generate` will "
  1130 |                     "apply the penalty only to newly generated tokens, not to the prompt.",
  1131 |                     UserWarning,
  1132 |                 )
  1133 |         if generation_config.no_repeat_ngram_size is not None and generation_config.no_repeat_ngram_size > 0:
  1134 |             processors.append(NoRepeatNGramLogitsProcessor(generation_config.no_repeat_ngram_size))
  1135 |             if not self.config.is_encoder_decoder and (input_ids_seq_length is None or input_ids_seq_length == 0):
  1136 |                 warnings.warn(
  1137 |                     "Passing `no_repeat_ngram_size` with `inputs_embeds` and without `input_ids` to `generate` will "
  1138 |                     "apply n-gram constraints only to newly generated tokens, not to the prompt.",
  1139 |                     UserWarning,
  1140 |                 )
  1141 |         if (
  1142 |             generation_config.encoder_no_repeat_ngram_size is not None
  1143 |             and generation_config.encoder_no_repeat_ngram_size > 0
  1144 |         ):
  1145 |             if encoder_input_ids is not None and len(encoder_input_ids.shape) == 2:
  1146 |                 processors.append(
  1147 |                     EncoderNoRepeatNGramLogitsProcessor(
  1148 |                         generation_config.encoder_no_repeat_ngram_size,
  1149 |                         encoder_input_ids,
  1150 |                     )
  1151 |                 )
  1152 |             else:
  1153 |                 warnings.warn(
  1154 |                     "Passing `encoder_no_repeat_ngram_size` requires some form of `input_ids` to be passed to "
  1155 |                     "`generate`, ignoring the argument.",
  1156 |                     UserWarning,
  1157 |                 )
  1158 |         if generation_config.bad_words_ids is not None:
  1159 |             processors.append(
  1160 |                 NoBadWordsLogitsProcessor(
  1161 |                     generation_config.bad_words_ids,
  1162 |                     generation_config._eos_token_tensor,
  1163 |                 )
  1164 |             )
  1165 |         if (
  1166 |             generation_config.min_length is not None
  1167 |             and getattr(generation_config, "_eos_token_tensor", None) is not None
  1168 |             and generation_config.min_length > 0
  1169 |         ):
  1170 |             processors.append(
  1171 |                 MinLengthLogitsProcessor(
  1172 |                     generation_config.min_length,
  1173 |                     generation_config._eos_token_tensor,
  1174 |                     device=device,
  1175 |                 )
  1176 |             )
  1177 |         if (
  1178 |             generation_config.min_new_tokens is not None
  1179 |             and getattr(generation_config, "_eos_token_tensor", None) is not None
  1180 |             and generation_config.min_new_tokens > 0
  1181 |         ):
  1182 |             processors.append(
  1183 |                 MinNewTokensLengthLogitsProcessor(
  1184 |                     input_ids_seq_length,
  1185 |                     generation_config.min_new_tokens,
  1186 |                     generation_config._eos_token_tensor,
  1187 |                     device=device,
  1188 |                 )
  1189 |             )
  1190 |         if prefix_allowed_tokens_fn is not None:
  1191 |             processors.append(
  1192 |                 PrefixConstrainedLogitsProcessor(
  1193 |                     prefix_allowed_tokens_fn,
  1194 |                     generation_config.num_beams,
  1195 |                 )
  1196 |             )
  1197 |         if generation_config.forced_bos_token_id is not None:
  1198 |             processors.append(
  1199 |                 ForcedBOSTokenLogitsProcessor(
  1200 |                     generation_config.forced_bos_token_id,
  1201 |                 )
  1202 |             )
  1203 |         if generation_config.forced_eos_token_id is not None:
  1204 |             processors.append(
  1205 |                 ForcedEOSTokenLogitsProcessor(
  1206 |                     generation_config.max_length,
  1207 |                     generation_config.forced_eos_token_id,
  1208 |                     device=device,
  1209 |                 )
  1210 |             )
  1211 |         if generation_config.remove_invalid_values is True:
  1212 |             processors.append(InfNanRemoveLogitsProcessor())
  1213 |         if generation_config.exponential_decay_length_penalty is not None:
  1214 |             processors.append(
  1215 |                 ExponentialDecayLengthPenalty(
  1216 |                     generation_config.exponential_decay_length_penalty,
  1217 |                     generation_config._eos_token_tensor,
  1218 |                     input_ids_seq_length,
  1219 |                 )
  1220 |             )
  1221 |         if generation_config.suppress_tokens is not None:
  1222 |             processors.append(
  1223 |                 SuppressTokensLogitsProcessor(
  1224 |                     generation_config.suppress_tokens,
  1225 |                     device=device,
  1226 |                 )
  1227 |             )
  1228 |         if generation_config.begin_suppress_tokens is not None:
  1229 |             begin_index = input_ids_seq_length
  1230 |             begin_index = (
  1231 |                 begin_index
  1232 |                 if (input_ids_seq_length > 1 or generation_config.forced_bos_token_id is None)
  1233 |                 else begin_index + 1
  1234 |             )
  1235 |             processors.append(
  1236 |                 SuppressTokensAtBeginLogitsProcessor(
  1237 |                     generation_config.begin_suppress_tokens,
  1238 |                     begin_index,
  1239 |                     device=device,
  1240 |                 )
  1241 |             )
  1242 | 
  1243 |         # TODO (joao): find a strategy to specify the order of the processors
  1244 |         processors = self._merge_criteria_processor_list(processors, logits_processor)
  1245 | 
  1246 |         # Processors previously known as `LogitsWarpers`, only applied with sampling strategies
  1247 |         if generation_config.do_sample:
  1248 |             # In beam methods, we need to keep at least one non-eos token to explore continuations that might have a
  1249 |             # better score (i.e. keep len(list(generation_config._eos_token_tensor)) + 1)
  1250 |             if generation_config.num_beams is not None and generation_config.num_beams > 1:
  1251 |                 if isinstance(generation_config._eos_token_tensor, list):
  1252 |                     min_tokens_to_keep = len(generation_config._eos_token_tensor) + 1
  1253 |                 elif isinstance(generation_config._eos_token_tensor, torch.Tensor):
  1254 |                     min_tokens_to_keep = generation_config._eos_token_tensor.shape[0] + 1
  1255 |                 else:
  1256 |                     min_tokens_to_keep = 2
  1257 |             else:
  1258 |                 min_tokens_to_keep = 1
  1259 | 
  1260 |             # the following idea is largely copied from this PR: https://github.com/huggingface/transformers/pull/5420/files
  1261 |             # all samplers can be found in `generation_utils_samplers.py`
  1262 |             if generation_config.temperature is not None and generation_config.temperature != 1.0:
  1263 |                 processors.append(TemperatureLogitsWarper(generation_config.temperature))
  1264 |             if generation_config.top_h is not None:
  1265 |                 processors.append(TopHLogitsWarper(top_h=generation_config.top_h))
  1266 |             if generation_config.top_k is not None and generation_config.top_k != 0:
  1267 |                 processors.append(
  1268 |                     TopKLogitsWarper(top_k=generation_config.top_k, min_tokens_to_keep=min_tokens_to_keep)
  1269 |                 )
  1270 |             if generation_config.top_p is not None and generation_config.top_p < 1.0:
  1271 |                 processors.append(
  1272 |                     TopPLogitsWarper(top_p=generation_config.top_p, min_tokens_to_keep=min_tokens_to_keep)
  1273 |                 )
  1274 |             if generation_config.min_p is not None:
  1275 |                 # Applied after temperature scaling (see https://github.com/ggerganov/llama.cpp/pull/3841#issuecomment-2073826084)
  1276 |                 processors.append(
  1277 |                     MinPLogitsWarper(min_p=generation_config.min_p, min_tokens_to_keep=min_tokens_to_keep)
  1278 |                 )
  1279 |             if generation_config.typical_p is not None and generation_config.typical_p < 1.0:
  1280 |                 processors.append(
  1281 |                     TypicalLogitsWarper(mass=generation_config.typical_p, min_tokens_to_keep=min_tokens_to_keep)
  1282 |                 )
  1283 |             if generation_config.epsilon_cutoff is not None and 0.0 < generation_config.epsilon_cutoff < 1.0:
  1284 |                 processors.append(
  1285 |                     EpsilonLogitsWarper(
  1286 |                         epsilon=generation_config.epsilon_cutoff, min_tokens_to_keep=min_tokens_to_keep
  1287 |                     )
  1288 |                 )
  1289 |             if generation_config.eta_cutoff is not None and 0.0 < generation_config.eta_cutoff < 1.0:
  1290 |                 processors.append(
  1291 |                     EtaLogitsWarper(
  1292 |                         epsilon=generation_config.eta_cutoff, min_tokens_to_keep=min_tokens_to_keep, device=device
  1293 |                     )
  1294 |                 )
  1295 | 
  1296 |         # Watermarking should be after all logits processing is finished (see #34630)
  1297 |         if generation_config.watermarking_config is not None:
  1298 |             processors.append(
  1299 |                 generation_config.watermarking_config.construct_processor(
  1300 |                     self.config.get_text_config().vocab_size, device
  1301 |                 )
  1302 |             )
  1303 | 
  1304 |         # `LogitNormalization` should always be the last logit processor, when present
  1305 |         if generation_config.renormalize_logits is True:
  1306 |             processors.append(LogitNormalization())
