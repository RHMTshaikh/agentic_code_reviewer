   295 |             self.group_cache_managers.append(cm)
   296 | 
   297 |         # We only use prefix sharing if the whole model has only full attention layers and block sharing is allowed
   298 |         self.use_prefix_sharing = self.allow_block_sharing and group_types == ["full_attention"]
   299 |         self._block_manager = BlockManager(num_blocks, self.block_size, tp_on=tp_size > 1)
   300 |         self._total_prefix_length: int = 0  # a counter to measure the impact of prefix sharing, also used in tests
   301 | 
   302 |         # For block table support, we lazy init the name of the block table key
   303 |         self._block_table_key = None
