  3635 |     @wraps(PushToHubMixin.push_to_hub)
  3636 |     def push_to_hub(self, *args, **kwargs):
  3637 |         tags = self.model_tags if self.model_tags is not None else []
  3638 | 
  3639 |         tags_kwargs = kwargs.get("tags", [])
  3640 |         if isinstance(tags_kwargs, str):
  3641 |             tags_kwargs = [tags_kwargs]
  3642 | 
  3643 |         for tag in tags_kwargs:
  3644 |             if tag not in tags:
  3645 |                 tags.append(tag)
  3646 | 
  3647 |         if tags:
  3648 |             kwargs["tags"] = tags
  3649 |         return super().push_to_hub(*args, **kwargs)
