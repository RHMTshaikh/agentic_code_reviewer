   265 | def is_flash_attention_requested(
   266 |     config=None, requested_attention_implementation: str | None = None, version: int | list[int] | None = None
   267 | ) -> bool:
   268 |     """
   269 |     Checks whether some flavor of flash attention is requested or not. Optionally, checks for specific versions of
   270 |     flash attention.
   271 | 
   272 |     This is checked against one of the two arguments, i.e. either the `config` or the directly passed value
   273 |     `requested_attention_implementation`. Otherwise, an error will be raised (ambiguity).
   274 | 
   275 |     The different versions of flash attention are usually
   276 |     - Implementations based on the original flash attention repo: https://github.com/Dao-AILab/flash-attention
   277 |     - Kernels implementations such as: https://huggingface.co/kernels-community/vllm-flash-attn3
   278 |     """
   279 |     if config is not None and requested_attention_implementation is not None:
   280 |         raise ValueError(
   281 |             "Requested attention implementation is ambiguous: "
   282 |             "Please pass either the config or the name of the attention implementation, not both."
   283 |         )
   284 | 
   285 |     if config is not None:
   286 |         checked_attention_implementation = config._attn_implementation
   287 |     else:
   288 |         checked_attention_implementation = requested_attention_implementation
   289 | 
   290 |     # theoretically can happen, equivalent to default implementation (sdpa/eager)
   291 |     if checked_attention_implementation is None:
   292 |         return False
   293 | 
   294 |     # If a specific version is requested, look for a pattern of type "flash...{version}"
   295 |     if version is not None:
   296 |         if isinstance(version, int):
   297 |             version = [version]
   298 |         return any(re.match(r".*flash.*" + str(v), checked_attention_implementation) is not None for v in version)
   299 | 
   300 |     # Otherwise, just check "flash" is in the attention implementation
   301 |     return "flash" in checked_attention_implementation
   302 | 

