   389 |                 current_subconfig_attn = getattr(subconfig, "_attn_implementation", None)
   390 |                 sub_implementation = (
   391 |                     value if not isinstance(value, dict) else value.get(subconfig_key, current_subconfig_attn)
   392 |                 )
   393 |                 subconfig._attn_implementation = sub_implementation
