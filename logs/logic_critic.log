  2747 | def generate_processor_intro(cls) -> str:
  2748 |     """
  2749 |     Generate the intro docstring for a processor class based on its attributes.
  2750 | 
  2751 |     Args:
  2752 |         cls: Processor class to generate intro for
  2753 | 
  2754 |     Returns:
  2755 |         str: Generated intro text
  2756 |     """
  2757 |     class_name = cls.__name__
  2758 | 
  2759 |     # Get attributes and their corresponding class names
  2760 |     attributes = cls.get_attributes()
  2761 |     if not attributes:
  2762 |         return ""
  2763 | 
  2764 |     # Build list of component names and their classes
  2765 |     components = []
  2766 |     component_classes = []
  2767 | 
  2768 |     for attr in attributes:
  2769 |         # Get the class name for this attribute
  2770 |         class_attr = f"{attr}_class"
  2771 |         # Format attribute name for display
  2772 |         attr_display = attr.replace("_", " ")
  2773 |         components.append(attr_display)
  2774 |         component_classes.append(f"[`{{{class_attr}}}`]")
  2775 |     if not components:
  2776 |         return ""
  2777 | 
  2778 |     # Generate the intro text
  2779 |     if len(components) == 1:
  2780 |         components_text = f"a {components[0]}"
  2781 |         classes_text = component_classes[0]
  2782 |         classes_text_short = component_classes[0].replace("[`", "[`~")
  2783 |     elif len(components) == 2:
  2784 |         components_text = f"a {components[0]} and a {components[1]}"
  2785 |         classes_text = f"{component_classes[0]} and {component_classes[1]}"
  2786 |         classes_text_short = (
  2787 |             f"{component_classes[0].replace('[`', '[`~')} and {component_classes[1].replace('[`', '[`~')}"
  2788 |         )
  2789 |     else:
  2790 |         components_text = ", ".join(f"a {c}" for c in components[:-1]) + f", and a {components[-1]}"
  2791 |         classes_text = ", ".join(component_classes[:-1]) + f", and {component_classes[-1]}"
  2792 |         classes_short = [c.replace("[`", "[`~") for c in component_classes]
  2793 |         classes_text_short = ", ".join(classes_short[:-1]) + f", and {classes_short[-1]}"
  2794 | 
  2795 |     intro = f"""Constructs a {class_name} which wraps {components_text} into a single processor.
  2796 | 
  2797 | [`{class_name}`] offers all the functionalities of {classes_text}. See the
  2798 | {classes_text_short} for more information.
  2799 | """
  2800 | 
  2801 |     return intro
