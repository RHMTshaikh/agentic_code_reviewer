    92 |         if images is not None:
    93 |             image_inputs = self.image_processor(images=images, **output_kwargs["images_kwargs"])
    94 |             batch_num_patches = iter(image_inputs.pop("num_patches"))
    95 |             processed_text = []
    96 |             for sample in text:
    97 |                 while self.image_token in sample:
    98 |                     num_patches = next(batch_num_patches)
    99 |                     img_patches_per_tile = int(self.patch_size**2)
