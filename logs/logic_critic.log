   471 |     def search_prefix_match(self, request_id: str, prompt_ids: list[int]) -> int:
   472 |         """Searches for a prefix match in the cache for the given (prompts_ids). If one is found, we reference the
   473 |         matching blocks in the (request_id), increase the reference count of the blocks and return the number of blocks
   474 |         that match. If no prefix match is found, we return 0."""
   475 |         current_hash = None
   476 |         allocated_blocks = []
   477 |         for b in range(len(prompt_ids) // self.block_size):
   478 |             tokens = prompt_ids[b * self.block_size : (b + 1) * self.block_size]
   479 |             # Prefix sharing is only supported when there is only one full attention layer group, so group_id=0.
   480 |             current_hash = self._block_manager.compute_hash(current_hash, tokens, group_id=0)
   481 |             block_id = self._block_manager._hash_to_id.get(current_hash)
   482 |             if block_id is not None:
   483 |                 allocated_blocks.append(block_id)
   484 |                 self._block_manager.increase_ref_count(block_id)
   485 |             else:
   486 |                 break
   487 |         # If we found a matching prefix, we reference the blocks in the request
   488 |         if allocated_blocks:
   489 |             logger.debug(f"Found prefix match for request {request_id} with {len(allocated_blocks)} blocks")
   490 |             cm = self.group_cache_managers[0]
   491 |             cm.block_table[request_id] = allocated_blocks
   492 | 
   493 |         prefix_length = len(allocated_blocks) * self.block_size
   494 |         self._total_prefix_length += prefix_length
   495 |         return prefix_length
   496 | 
   497 |     def mark_shareable_blocks_as_complete(self, state: RequestState, num_complete_blocks: int) -> None:
   498 |         """Marks the blocks allocated to a request (state) as complete if they are shareable and they have been computed
   499 |         in the forward pass. A complete block is a block where the KV cache has been fully computed: if the block has
   500 |         enough space to hold the cache for N tokens, the block is marked as complete when the cache data is present for
   501 |         the N tokens. If block sharing is off, this is a no-op."""
   502 |         # The status can be FINISHED in async mode, because batch N+1 offloaded the request before batch N was over. So
   503 |         # we need to check for this case to avoid looking in the block table for blocks that no longer exist.
   504 |         if num_complete_blocks == 0 or state.status == RequestStatus.FINISHED:
   505 |             return None
   506 |         for cm in self.group_cache_managers:
   507 |             if cm.uses_block_sharing:
   508 |                 self._block_manager.mark_shareable_blocks_as_complete(
   509 |                     num_complete_blocks=num_complete_blocks,
   510 |                     allocated_blocks=cm.block_table[state.request_id],
   511 |                     prompt_ids=(state.initial_tokens + state.generated_tokens),
   512 |                 )
