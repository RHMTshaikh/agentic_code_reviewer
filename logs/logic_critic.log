   211 |             if isinstance(attr, dict):
   212 |                 cls_name = attr.pop("_cls_name", None)
   213 |                 config_dataclass = getattr(current_module, cls_name)
   214 |                 loaded_attr = config_dataclass(**attr)
   215 |                 setattr(self, attr_name, loaded_attr)
