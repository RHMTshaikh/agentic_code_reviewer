  3258 |     def gradient_checkpointing_enable(self, gradient_checkpointing_kwargs=None):
  3259 |         """
  3260 |         Activates gradient checkpointing for the current model.
  3261 | 
  3262 |         We pass the `__call__` method of the modules instead of `forward` because `__call__` attaches all the hooks of
  3263 |         the module. https://discuss.pytorch.org/t/any-different-between-model-input-and-model-forward-input/3690/2
  3264 | 
  3265 |         Args:
  3266 |             gradient_checkpointing_kwargs (dict, *optional*):
  3267 |                 Additional keyword arguments passed along to the `torch.utils.checkpoint.checkpoint` function.
  3268 |         """
  3269 |         if not self.supports_gradient_checkpointing:
  3270 |             raise ValueError(f"{self.__class__.__name__} does not support gradient checkpointing.")
  3271 | 
  3272 |         if gradient_checkpointing_kwargs is None:
  3273 |             gradient_checkpointing_kwargs = {"use_reentrant": False}
  3274 | 
  3275 |         gradient_checkpointing_func = functools.partial(checkpoint, **gradient_checkpointing_kwargs)
  3276 | 
  3277 |         # For old GC format (transformers < 4.35.0) for models that live on the Hub
  3278 |         # we will fall back to the overwritten `_set_gradient_checkpointing` method
  3279 |         _is_using_old_format = "value" in inspect.signature(self._set_gradient_checkpointing).parameters
  3280 | 
  3281 |         if not _is_using_old_format:
  3282 |             self._set_gradient_checkpointing(enable=True, gradient_checkpointing_func=gradient_checkpointing_func)
  3283 |         else:
  3284 |             self.apply(partial(self._set_gradient_checkpointing, value=True))
  3285 |             logger.warning(
  3286 |                 "You are using an old version of the checkpointing format that is deprecated (We will also silently ignore `gradient_checkpointing_kwargs` in case you passed it)."
  3287 |                 "Please update to the new format on your modeling file. To use the new format, you need to completely remove the definition of the method `_set_gradient_checkpointing` in your model."
  3288 |             )
  3289 | 
  3290 |         needs_embedding_grads = self.main_input_name == "input_ids"
  3291 |         # we use that also to detect whether or not we have to raise if embeddings are missing (the submodel might not have embeddings at all)
  3292 |         enable_input_grads = needs_embedding_grads or getattr(self, "_hf_peft_config_loaded", False)
  3293 |         if enable_input_grads:
  3294 |             # When using PEFT + gradient checkpointing + Trainer we need to make sure the input has requires_grad=True
  3295 |             # we do it also on PEFT: https://github.com/huggingface/peft/blob/85013987aa82aa1af3da1236b6902556ce3e483e/src/peft/peft_model.py#L334
  3296 |             # When training with PEFT, only LoRA layers will have requires grad set to True, but the output of frozen layers need to propagate
  3297 |             # the gradients to make sure the gradient flows.
  3298 |             self.enable_input_require_grads()
  3299 | 
  3300 |     def _set_gradient_checkpointing(self, enable: bool = True, gradient_checkpointing_func: Callable = checkpoint):
  3301 |         is_gradient_checkpointing_set = False
  3302 | 
  3303 |         # Apply it on the top-level module in case the top-level modules supports it
  3304 |         # for example, LongT5Stack inherits from `PreTrainedModel`.
  3305 |         if hasattr(self, "gradient_checkpointing"):
  3306 |             self._gradient_checkpointing_func = gradient_checkpointing_func
  3307 |             self.gradient_checkpointing = enable
  3308 |             is_gradient_checkpointing_set = True
  3309 | 
  3310 |         for module in self.modules():
  3311 |             if hasattr(module, "gradient_checkpointing"):
  3312 |                 setattr(module, "_gradient_checkpointing_func", gradient_checkpointing_func)
  3313 |                 setattr(module, "gradient_checkpointing", enable)
  3314 |                 is_gradient_checkpointing_set = True
  3315 | 
  3316 |         if not is_gradient_checkpointing_set:
  3317 |             raise ValueError(
  3318 |                 f"{self.__class__.__name__} is not compatible with gradient checkpointing. Make sure all the architecture support it by setting a boolean attribute"
  3319 |                 " `gradient_checkpointing` to modules of the model that uses checkpointing."
  3320 |             )
  3321 | 
  3322 |     def gradient_checkpointing_disable(self):
  3323 |         """
  3324 |         Deactivates gradient checkpointing for the current model.
  3325 |         """
  3326 |         if self.supports_gradient_checkpointing:
  3327 |             # For old GC format (transformers < 4.35.0) for models that live on the Hub
  3328 |             # we will fall back to the overwritten `_set_gradient_checkpointing` method
  3329 |             _is_using_old_format = "value" in inspect.signature(self._set_gradient_checkpointing).parameters
  3330 |             if not _is_using_old_format:
  3331 |                 self._set_gradient_checkpointing(enable=False)
  3332 |             else:
  3333 |                 logger.warning(
  3334 |                     "You are using an old version of the checkpointing format that is deprecated (We will also silently ignore `gradient_checkpointing_kwargs` in case you passed it)."
  3335 |                     "Please update to the new format on your modeling file. To use the new format, you need to completely remove the definition of the method `_set_gradient_checkpointing` in your model."
  3336 |                 )
  3337 |                 self.apply(partial(self._set_gradient_checkpointing, value=False))
  3338 | 
  3339 |         if getattr(self, "_hf_peft_config_loaded", False):
  3340 |             self.disable_input_require_grads()
  3341 | 
  3342 |     @property
  3343 |     def is_gradient_checkpointing(self) -> bool:
  3344 |         """
  3345 |         Whether gradient checkpointing is activated for this model or not.
  3346 |         """
  3347 |         return any(hasattr(m, "gradient_checkpointing") and m.gradient_checkpointing for m in self.modules())
