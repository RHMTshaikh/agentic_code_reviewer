    97 |     def shard_tensor(
    98 |         self, source: torch.Tensor, tensor_idx: int | None = None, device=None, dtype=None
    99 |     ) -> torch.Tensor | None:
   100 |         """Return this rank's local shard of a checkpoint tensor.
   101 | 
   102 |         Two layouts (example param shape [N, in, out]):
   103 | 
   104 |         - tensor_idx is None: one stacked [N, in, out] tensor;
   105 |           slice every sharded dim (including axis 0).
   106 |         - tensor_idx given: one [in, out] tensor per expert;
   107 |           return None if this rank does not own that expert, else slice
   108 |           inner dims only. Surviving pieces are stacked by MergeModulelist
   109 |           into this rank's local [n_local, in, out] shard.
   110 |         """
   111 |         source_shape = list(source.shape) if isinstance(source, torch.Tensor) else source.get_shape()
   112 |         dim_placements = [
   113 |             (mesh_dim, placement) for mesh_dim, placement in enumerate(self.placements) if hasattr(placement, "dim")
   114 |         ]
   115 | 
   116 |         # Dense path
   117 |         if tensor_idx is None:
   118 |             if not dim_placements:
   119 |                 return source[...].to(device=device, dtype=dtype)
   120 | 
   121 |             # Determine for each tensor dimension, which type of sharding operations to apply (_StridedShard or Shard) and which rank to apply it to.
   122 |             # i.e: dim 0 -> [ Strided(rank0, size=2, sf=2), Shard(rank1, size=2) ]
   123 |             # i.e: dim 1 -> [ Shard(rank0, size=2)]
   124 |             planned_ops_by_dim = [[] for _ in source_shape]
   125 |             for mesh_dim, placement in dim_placements:
   126 |                 sub_mesh = self._get_sub_mesh(mesh_dim)
   127 |                 rank, world_size = sub_mesh.get_local_rank(), sub_mesh.size()
   128 |                 dim_idx = self._normalize_param_dim(placement.dim)
   129 |                 planned_ops_by_dim[dim_idx].append((placement, rank, world_size))
   130 | 
   131 |             # Apply the sharding operations to each tensor dimension.
   132 |             intervals_by_dim = [[(0, size)] for size in source_shape]
   133 |             for dim_idx, planned_ops in enumerate(planned_ops_by_dim):
   134 |                 intervals = intervals_by_dim[dim_idx]
   135 |                 for placement, rank, world_size in planned_ops:
   136 |                     if placement.is_shard():
   137 |                         intervals = self._apply_contiguous_shard(intervals, rank, world_size)
   138 |                     else:
   139 |                         intervals = self._apply_strided_shard(intervals, rank, world_size, placement.split_factor)
   140 |                 intervals_by_dim[dim_idx] = intervals
   141 | 
   142 |             has_strided_shard = any(not placement.is_shard() for _, placement in dim_placements)
   143 |             if has_strided_shard:
   144 |                 # Multi-interval dim: read each piece separately, then concatenate.
   145 |                 return self._slice_and_cat(source, intervals_by_dim, device, dtype)
   146 |             else:
   147 |                 slice_parts = []
   148 |                 for intervals in intervals_by_dim:
   149 |                     start, end = intervals[0] if len(intervals) > 0 else (0, 0)
   150 |                     slice_parts.append(slice(start, end))
   151 | 
   152 |                 return source[tuple(slice_parts)].to(device=device, dtype=dtype)
   153 | 
   154 |         # MoE path
   155 |         # tensor_idx identifies the axis-0 piece in param space (not in source.shape).
   156 |         normalized_dim_placements = [
   157 |             (mesh_dim, placement, self._normalize_param_dim(placement.dim)) for mesh_dim, placement in dim_placements
   158 |         ]
   159 | 
   160 |         # if this rank owns expert `tensor_idx` along axis 0, we need to slice the inner dimensions, else we drop it
   161 |         has_axis0_shard = any(param_dim == 0 for _, _, param_dim in normalized_dim_placements)
   162 |         owns_tensor_idx = self._axis0_offset <= tensor_idx < self._axis0_offset + self._axis0_local_size
   163 |         if has_axis0_shard and not owns_tensor_idx:
   164 |             return None
   165 | 
   166 |         # `param_dim` indexes the full parameter layout [N, in, out] (expert axis first).
   167 |         # In per-expert loading, leading axis is absent ([in, out]).
   168 |         # Therefore we need to shift the dimensions by 1 to the left so that sharding operations can be applied to the inner dimensions.
   169 |         #   param [N, in, out]  ↔  source [in, out]
   170 |         #   Shard(param dim 1)  →  slice source dim 0
   171 |         #   Shard(param dim 2)  →  slice source dim 1
   172 |         planned_ops_by_source_dim = [[] for _ in source_shape]
   173 |         for mesh_dim, _, param_dim in normalized_dim_placements:
   174 |             if param_dim > 0:
   175 |                 source_dim = param_dim - 1
   176 |                 sub_mesh = self._get_sub_mesh(mesh_dim)
   177 |                 rank, world_size = sub_mesh.get_local_rank(), sub_mesh.size()
   178 |                 planned_ops_by_source_dim[source_dim].append((rank, world_size))
   179 | 
   180 |         intervals_by_source_dim = [[(0, size)] for size in source_shape]
   181 |         for source_dim, planned_ops in enumerate(planned_ops_by_source_dim):
   182 |             intervals = intervals_by_source_dim[source_dim]
   183 |             for rank, world_size in planned_ops:
   184 |                 intervals = self._apply_contiguous_shard(intervals, rank, world_size)
   185 |             intervals_by_source_dim[source_dim] = intervals
   186 | 
   187 |         slice_parts = []
   188 |         for intervals in intervals_by_source_dim:
   189 |             start, end = intervals[0] if intervals else (0, 0)
   190 |             slice_parts.append(slice(start, end))
