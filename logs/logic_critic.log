   276 |             assistant_model,
   277 |             streamer,
   278 |         )
   279 |         generation_config, model_kwargs = self._prepare_generation_config(generation_config, **kwargs)
   280 |         generation_mode = generation_config.get_generation_mode(assistant_model)
   281 | 
   282 |         if generation_mode not in (GenerationMode.SAMPLE, GenerationMode.GREEDY_SEARCH):
   283 |             raise ValueError(
   284 |                 "Got incompatible mode for generation, should be one of greedy or sampling. "
   285 |                 "Ensure that beam search is de-activated by setting `num_beams=1`."
   286 |             )
   287 | 
   288 |         self._validate_model_kwargs(model_kwargs.copy())
   289 |         self._validate_generation_mode(generation_mode, generation_config, generation_mode_kwargs)
   290 | 
   291 |         # 2. Set generation parameters if not already defined
   292 |         if synced_gpus is None:
   293 |             synced_gpus = (is_deepspeed_zero3_enabled() or is_fsdp_managed_module(self)) and dist.get_world_size() > 1
   294 | 
   295 |         logits_processor = logits_processor if logits_processor is not None else LogitsProcessorList()
   296 |         stopping_criteria = stopping_criteria if stopping_criteria is not None else StoppingCriteriaList()
   297 | 
   298 |         # 3. Define model inputs
   299 |         kwargs_has_attention_mask = model_kwargs.get("attention_mask", None) is not None
   300 |         inputs_tensor, model_input_name, model_kwargs = self._prepare_model_inputs(
   301 |             inputs, generation_config.bos_token_id, model_kwargs
   302 |         )
   303 |         batch_size = inputs_tensor.shape[0]
   304 | 
   305 |         device = inputs_tensor.device
   306 |         self._prepare_special_tokens(generation_config, kwargs_has_attention_mask, device=device)
   307 | 
   308 |         # 4. Define other model kwargs
   309 |         if "encoder_outputs" not in model_kwargs:
   310 |             # if model is encoder decoder encoder_outputs are created and added to `model_kwargs`
   311 |             model_kwargs = self._prepare_encoder_decoder_kwargs_for_generation(
   312 |                 inputs_tensor, model_kwargs, model_input_name, generation_config
   313 |             )
   314 | 
   315 |         # 5. Prepare `input_ids` which will be used for auto-regressive generation
   316 |         input_ids, model_kwargs = self._prepare_decoder_input_ids_for_generation(
   317 |             batch_size=batch_size,
   318 |             model_input_name=model_input_name,
   319 |             model_kwargs=model_kwargs,
   320 |             decoder_start_token_id=generation_config._decoder_start_token_tensor,
   321 |             device=inputs_tensor.device,
   322 |         )
   323 | 
   324 |         if generation_config.token_healing:
   325 |             input_ids = self.heal_tokens(input_ids, generation_mode_kwargs.get("tokenizer"))
   326 | 
   327 |         if streamer is not None:
   328 |             streamer.put(input_ids.cpu())
   329 | 
   330 |         # 6. Prepare `max_length` depending on other stopping criteria.
   331 |         # NOTE: incorrect `input_ids.shape[1]` previously
   332 |         input_ids_length = input_ids.shape[-1]
   333 |         has_default_max_length = kwargs.get("max_length") is None and generation_config.max_length is not None
   334 |         has_default_min_length = kwargs.get("min_length") is None and generation_config.min_length is not None
   335 |         generation_config = self._prepare_generated_length(
   336 |             generation_config=generation_config,
   337 |             has_default_max_length=has_default_max_length,
   338 |             has_default_min_length=has_default_min_length,
   339 |             model_input_name=model_input_name,
   340 |             inputs_tensor=inputs_tensor,
   341 |             input_ids_length=input_ids_length,
   342 |         )
   343 | 
   344 |         # If the model supports `logits_to_keep` in forward(), set it to 1 to avoid computing the whole
   345 |         # logit matrix. This can save a lot of memory during the first forward pass. Note that assisted decoding
   346 |         # dynamically overrides this value as it can need more than the last token logits
   347 |         if self._supports_logits_to_keep() and "logits_to_keep" not in model_kwargs:
   348 |             model_kwargs["logits_to_keep"] = 1
   349 | 
   350 |         self._validate_generated_length(generation_config, input_ids_length, has_default_max_length)
   351 | 
   352 |         # 7. Prepare the cache.
   353 |         # - `model_kwargs` may be updated in place with a cache as defined by the parameters in `generation_config`.
   354 |         # - different models have a different cache name expected by the model (default = "past_key_values")
   355 |         # - `max_length`, prepared above, is used to determine the maximum cache length
   356 |         max_cache_length = generation_config.max_length - 1
   357 |         if (
   358 |             inputs_tensor.shape[1] != input_ids_length
   359 |             and model_input_name == "inputs_embeds"
   360 |             and not self.config.is_encoder_decoder
   361 |         ):
   362 |             max_cache_length += inputs_tensor.shape[1]
   363 |         self._prepare_cache_for_generation(
   364 |             generation_config, model_kwargs, generation_mode, batch_size, max_cache_length
   365 |         )
   366 | 
   367 |         # 8. prepare logits processors and stopping criteria
   368 |         prepared_logits_processor = self._get_logits_processor(
   369 |             generation_config=generation_config,
   370 |             input_ids_seq_length=input_ids_length,
   371 |             encoder_input_ids=inputs_tensor,
   372 |             prefix_allowed_tokens_fn=prefix_allowed_tokens_fn,
   373 |             logits_processor=logits_processor,
   374 |             device=inputs_tensor.device,
   375 |             model_kwargs=model_kwargs,
   376 |             negative_prompt_ids=negative_prompt_ids,
   377 |             negative_prompt_attention_mask=negative_prompt_attention_mask,
   378 |         )
   379 |         prepared_stopping_criteria = self._get_stopping_criteria(
   380 |             generation_config=generation_config,
   381 |             stopping_criteria=stopping_criteria,
   382 |             tokenizer=generation_mode_kwargs.get("tokenizer"),
   383 |         )
   384 | 
   385 |         # Set model_kwargs `use_cache` so we can use it later in forward runs
   386 |         model_kwargs["use_cache"] = generation_config.use_cache
   387 |         # ******************* taken from main generate function up to calling the different methods *******************
   388 | 
   389 |         # Prepare inner 2D logic in generation loop
   390 |         input_ids = input_ids.reshape(-1, input_ids.shape[-1])
   391 | 
   392 |         # 10. expand input_ids with `num_return_sequences` additional sequences per batch
   393 |         if generation_config.num_return_sequences > 1:
   394 |             raise ValueError("`num_return_sequences>1` is incompatible with Dia.")
   395 | 
   396 |         # 11. run sample (it degenerates to greedy search when `generation_config.do_sample=False`)
   397 |         return self._sample(
   398 |             input_ids,
   399 |             logits_processor=prepared_logits_processor,
   400 |             stopping_criteria=prepared_stopping_criteria,
   401 |             generation_config=generation_config,
   402 |             **generation_mode_kwargs,
   403 |             **model_kwargs,
   404 |         )
