  2862 | @lru_cache(maxsize=16)
  2863 | def _merge_args_dicts(args_classes_tuple: tuple) -> dict:
  2864 |     """Cached merger of args-doc dicts. The input classes are static so caching is safe."""
  2865 |     result = {}
  2866 |     for cls in args_classes_tuple:
