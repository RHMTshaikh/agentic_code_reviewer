  4319 | 
  4320 |             if hf_quantizer is not None:  # replace module with quantized modules (does not touch weights)
  4321 |                 hf_quantizer.preprocess_model(
  4322 |                     model=model,
  4323 |                     dtype=dtype,
  4324 |                     device_map=device_map,
  4325 |                     checkpoint_files=checkpoint_files,
  4326 |                     use_kernels=use_kernels,
  4327 |                 )
  4328 | 
  4329 |         # Create the dtype_plan to potentially use the `keep_in_fp32` flags (this needs to be called on the already
  4330 |         # instantiated model, as the flags can be modified by instances sometimes)
  4331 |         dtype_plan = model._get_dtype_plan(dtype)
  4332 | 
  4333 |         # Obtain the weight conversion mapping for this model if any are registered and apply to all submodels recursively
  4334 |         weight_conversions = get_model_conversion_mapping(model, key_mapping, hf_quantizer)
  4335 | 
  4336 |         if _torch_distributed_available and device_mesh is not None:  # add hooks to nn.Modules: no weights
