   500 |     def save_pretrained(self, save_directory: str | os.PathLike, push_to_hub: bool = False, **kwargs):
   501 |         """
   502 |         Save a configuration object to the directory `save_directory`, so that it can be re-loaded using the
   503 |         [`~PreTrainedConfig.from_pretrained`] class method.
   504 | 
   505 |         Args:
   506 |             save_directory (`str` or `os.PathLike`):
   507 |                 Directory where the configuration JSON file will be saved (will be created if it does not exist).
   508 |             push_to_hub (`bool`, *optional*, defaults to `False`):
   509 |                 Whether or not to push your model to the Hugging Face model hub after saving it. You can specify the
   510 |                 repository you want to push to with `repo_id` (will default to the name of `save_directory` in your
   511 |                 namespace).
   512 |             kwargs (`dict[str, Any]`, *optional*):
   513 |                 Additional key word arguments passed along to the [`~utils.PushToHubMixin.push_to_hub`] method.
   514 |         """
   515 |         if os.path.isfile(save_directory):
   516 |             raise AssertionError(f"Provided path ({save_directory}) should be a directory, not a file")
   517 | 
   518 |         generation_parameters = self._get_generation_parameters()
   519 |         if len(generation_parameters) > 0:
   520 |             raise ValueError(
   521 |                 "Some generation parameters are set in the model config. These should go into `model.generation_config`"
   522 |                 f"as opposed to `model.config`. \nGeneration parameters found: {str(generation_parameters)}",
   523 |             )
   524 | 
   525 |         os.makedirs(save_directory, exist_ok=True)
   526 | 
   527 |         if push_to_hub:
   528 |             commit_message = kwargs.pop("commit_message", None)
   529 |             repo_id = kwargs.pop("repo_id", save_directory.split(os.path.sep)[-1])
   530 |             repo_id = hf_api().create_repo(repo_id, exist_ok=True, **kwargs).repo_id
   531 |             files_timestamps = self._get_files_timestamps(save_directory)
   532 | 
   533 |         # This attribute is important to know on load, but should not be serialized on save.
   534 |         if "transformers_weights" in self:
   535 |             delattr(self, "transformers_weights")
   536 | 
   537 |         # If we have a custom config, we copy the file defining it in the folder and set the attributes so it can be
   538 |         # loaded from the Hub.
   539 |         if self._auto_class is not None:
   540 |             custom_object_save(self, save_directory, config=self)
   541 | 
   542 |         # If we save using the predefined names, we can load using `from_pretrained`
   543 |         output_config_file = os.path.join(save_directory, CONFIG_NAME)
   544 | 
   545 |         # Strict validation at save-time: prevent bad patterns from propagating
   546 |         # Using `strict` decorator guarantees that `self.validate` exists , but not all
   547 |         # model config might have the decorator added
   548 |         if hasattr(self, "validate"):
   549 |             self.validate()
   550 |         self.to_json_file(output_config_file, use_diff=True)
   551 |         logger.info(f"Configuration saved in {output_config_file}")
   552 | 
   553 |         if push_to_hub:
   554 |             self._upload_modified_files(
   555 |                 save_directory,
   556 |                 repo_id,
   557 |                 files_timestamps,
   558 |                 commit_message=commit_message,
   559 |                 token=kwargs.get("token"),
   560 |             )
   561 | 
   562 |     @classmethod
   563 |     def from_pretrained(
   564 |         cls: type[SpecificPreTrainedConfigType],
   565 |         pretrained_model_name_or_path: str | os.PathLike,
   566 |         cache_dir: str | os.PathLike | None = None,
   567 |         force_download: bool = False,
   568 |         local_files_only: bool = False,
   569 |         token: str | bool | None = None,
   570 |         revision: str = "main",
   571 |         **kwargs,
   572 |     ) -> SpecificPreTrainedConfigType:
   573 |         r"""
   574 |         Instantiate a [`PreTrainedConfig`] (or a derived class) from a pretrained model configuration.
   575 | 
   576 |         Args:
   577 |             pretrained_model_name_or_path (`str` or `os.PathLike`):
   578 |                 This can be either:
   579 | 
   580 |                 - a string, the *model id* of a pretrained model configuration hosted inside a model repo on
   581 |                   huggingface.co.
   582 |                 - a path to a *directory* containing a configuration file saved using the
   583 |                   [`~PreTrainedConfig.save_pretrained`] method, e.g., `./my_model_directory/`.
   584 |                 - a path to a saved configuration JSON *file*, e.g., `./my_model_directory/configuration.json`.
   585 |             cache_dir (`str` or `os.PathLike`, *optional*):
   586 |                 Path to a directory in which a downloaded pretrained model configuration should be cached if the
   587 |                 standard cache should not be used.
   588 |             force_download (`bool`, *optional*, defaults to `False`):
   589 |                 Whether or not to force to (re-)download the configuration files and override the cached versions if
   590 |                 they exist.
   591 |             proxies (`dict[str, str]`, *optional*):
   592 |                 A dictionary of proxy servers to use by protocol or endpoint, e.g., `{'http': 'foo.bar:3128',
   593 |                 'http://hostname': 'foo.bar:4012'}.` The proxies are used on each request.
   594 |             token (`str` or `bool`, *optional*):
   595 |                 The token to use as HTTP bearer authorization for remote files. If `True`, or not specified, will use
   596 |                 the token generated when running `hf auth login` (stored in `~/.huggingface`).
   597 |             revision (`str`, *optional*, defaults to `"main"`):
   598 |                 The specific model version to use. It can be a branch name, a tag name, or a commit id, since we use a
   599 |                 git-based system for storing models and other artifacts on huggingface.co, so `revision` can be any
   600 |                 identifier allowed by git.
   601 | 
   602 |                 <Tip>
   603 | 
   604 |                 To test a pull request you made on the Hub, you can pass `revision="refs/pr/<pr_number>"`.
   605 | 
   606 |                 </Tip>
   607 | 
   608 |             return_unused_kwargs (`bool`, *optional*, defaults to `False`):
   609 |                 If `False`, then this function returns just the final configuration object.
   610 | 
   611 |                 If `True`, then this functions returns a `Tuple(config, unused_kwargs)` where *unused_kwargs* is a
   612 |                 dictionary consisting of the key/value pairs whose keys are not configuration attributes: i.e., the
   613 |                 part of `kwargs` which has not been used to update `config` and is otherwise ignored.
   614 |             subfolder (`str`, *optional*, defaults to `""`):
   615 |                 In case the relevant files are located inside a subfolder of the model repo on huggingface.co, you can
   616 |                 specify the folder name here.
   617 |             kwargs (`dict[str, Any]`, *optional*):
   618 |                 The values in kwargs of any keys which are configuration attributes will be used to override the loaded
   619 |                 values. Behavior concerning key/value pairs whose keys are *not* configuration attributes is controlled
   620 |                 by the `return_unused_kwargs` keyword parameter.
   621 | 
   622 |         Returns:
   623 |             [`PreTrainedConfig`]: The configuration object instantiated from this pretrained model.
   624 | 
   625 |         Examples:
   626 | 
   627 |         ```python
   628 |         # We can't instantiate directly the base class *PreTrainedConfig* so let's show the examples on a
   629 |         # derived class: BertConfig
   630 |         config = BertConfig.from_pretrained(
   631 |             "google-bert/bert-base-uncased"
   632 |         )  # Download configuration from huggingface.co and cache.
   633 |         config = BertConfig.from_pretrained(
   634 |             "./test/saved_model/"
   635 |         )  # E.g. config (or model) was saved using *save_pretrained('./test/saved_model/')*
   636 |         config = BertConfig.from_pretrained("./test/saved_model/my_configuration.json")
   637 |         config = BertConfig.from_pretrained("google-bert/bert-base-uncased", output_attentions=True, foo=False)
   638 |         assert config.output_attentions == True
   639 |         config, unused_kwargs = BertConfig.from_pretrained(
   640 |             "google-bert/bert-base-uncased", output_attentions=True, foo=False, return_unused_kwargs=True
   641 |         )
   642 |         assert config.output_attentions == True
   643 |         assert unused_kwargs == {"foo": False}
   644 |         ```"""
   645 |         kwargs["cache_dir"] = cache_dir
   646 |         kwargs["force_download"] = force_download
   647 |         kwargs["local_files_only"] = local_files_only
   648 |         kwargs["revision"] = revision
   649 | 
   650 |         config_dict, kwargs = cls.get_config_dict(pretrained_model_name_or_path, **kwargs)
   651 |         if cls.base_config_key and cls.base_config_key in config_dict:
   652 |             config_dict = config_dict[cls.base_config_key]
   653 | 
   654 |         if "model_type" in config_dict and hasattr(cls, "model_type") and config_dict["model_type"] != cls.model_type:
   655 |             # sometimes the config has no `base_config_key` if the config is used in several composite models
   656 |             # e.g. LlamaConfig. In that case we try to see if there is match in `model_type` before raising a warning
   657 |             for v in config_dict.values():
   658 |                 if isinstance(v, dict) and v.get("model_type") == cls.model_type:
   659 |                     config_dict = v
   660 | 
   661 |             # raise warning only if we still can't see a match in `model_type`
   662 |             if config_dict["model_type"] != cls.model_type:
   663 |                 logger.warning(
   664 |                     f"You are using a model of type `{config_dict['model_type']}` to instantiate a model of type "
   665 |                     f"`{cls.model_type}`. This may be expected if you are loading a checkpoint that shares a subset "
   666 |                     f"of the architecture (e.g., loading a `sam2_video` checkpoint into `Sam2Model`), but is otherwise "
   667 |                     f"not supported and can yield errors. Please verify that the checkpoint is compatible with the "
   668 |                     f"model you are instantiating."
   669 |                 )
   670 | 
   671 |         return cls.from_dict(config_dict, **kwargs)
   672 | 
   673 |     @classmethod
   674 |     def get_config_dict(
   675 |         cls, pretrained_model_name_or_path: str | os.PathLike, **kwargs
   676 |     ) -> tuple[dict[str, Any], dict[str, Any]]:
   677 |         """
   678 |         From a `pretrained_model_name_or_path`, resolve to a dictionary of parameters, to be used for instantiating a
   679 |         [`PreTrainedConfig`] using `from_dict`.
   680 | 
   681 |         Parameters:
   682 |             pretrained_model_name_or_path (`str` or `os.PathLike`):
   683 |                 The identifier of the pre-trained checkpoint from which we want the dictionary of parameters.
   684 | 
   685 |         Returns:
   686 |             `tuple[Dict, Dict]`: The dictionary(ies) that will be used to instantiate the configuration object.
   687 | 
   688 |         """
   689 |         original_kwargs = copy.deepcopy(kwargs)
   690 |         # Get config dict associated with the base config file
   691 |         config_dict, kwargs = cls._get_config_dict(pretrained_model_name_or_path, **kwargs)
   692 |         if config_dict is None:
   693 |             return {}, kwargs
   694 |         if "_commit_hash" in config_dict:
   695 |             original_kwargs["_commit_hash"] = config_dict["_commit_hash"]
   696 | 
   697 |         # That config file may point us toward another config file to use.
   698 |         if "configuration_files" in config_dict:
   699 |             configuration_file = get_configuration_file(config_dict["configuration_files"])
   700 |             config_dict, kwargs = cls._get_config_dict(
   701 |                 pretrained_model_name_or_path, _configuration_file=configuration_file, **original_kwargs
   702 |             )
   703 | 
   704 |         return config_dict, kwargs
   705 | 
   706 |     @classmethod
   707 |     def _get_config_dict(
   708 |         cls, pretrained_model_name_or_path: str | os.PathLike, **kwargs
   709 |     ) -> tuple[dict[str, Any], dict[str, Any]]:
   710 |         cache_dir = kwargs.pop("cache_dir", None)
   711 |         force_download = kwargs.pop("force_download", False)
   712 |         proxies = kwargs.pop("proxies", None)
   713 |         token = kwargs.pop("token", None)
   714 |         local_files_only = kwargs.pop("local_files_only", False)
   715 |         revision = kwargs.pop("revision", None)
   716 |         trust_remote_code = kwargs.pop("trust_remote_code", None)
   717 |         subfolder = kwargs.pop("subfolder", "")
   718 |         from_pipeline = kwargs.pop("_from_pipeline", None)
   719 |         from_auto_class = kwargs.pop("_from_auto", False)
   720 |         commit_hash = kwargs.pop("_commit_hash", None)
   721 | 
   722 |         gguf_file = kwargs.get("gguf_file")
   723 | 
   724 |         if trust_remote_code is True:
   725 |             logger.warning(
   726 |                 "The argument `trust_remote_code` is to be used with Auto classes. It has no effect here and is"
   727 |                 " ignored."
   728 |             )
   729 | 
   730 |         user_agent = {"file_type": "config", "from_auto_class": from_auto_class}
   731 |         if from_pipeline is not None:
   732 |             user_agent["using_pipeline"] = from_pipeline
   733 | 
   734 |         pretrained_model_name_or_path = str(pretrained_model_name_or_path)
   735 | 
   736 |         is_local = os.path.isdir(pretrained_model_name_or_path)
   737 |         if os.path.isfile(os.path.join(subfolder, pretrained_model_name_or_path)):
   738 |             # Special case when pretrained_model_name_or_path is a local file
   739 |             resolved_config_file = pretrained_model_name_or_path
   740 |             is_local = True
   741 |         else:
   742 |             configuration_file = kwargs.pop("_configuration_file", CONFIG_NAME) if gguf_file is None else gguf_file
   743 | 
   744 |             try:
   745 |                 # Load from local folder or from cache or download from model Hub and cache
   746 |                 resolved_config_file = cached_file(
   747 |                     pretrained_model_name_or_path,
   748 |                     configuration_file,
   749 |                     cache_dir=cache_dir,
   750 |                     force_download=force_download,
   751 |                     proxies=proxies,
   752 |                     local_files_only=local_files_only,
   753 |                     token=token,
   754 |                     user_agent=user_agent,
   755 |                     revision=revision,
   756 |                     subfolder=subfolder,
   757 |                     _commit_hash=commit_hash,
   758 |                 )
   759 |                 if resolved_config_file is None:
   760 |                     return None, kwargs
   761 |                 commit_hash = extract_commit_hash(resolved_config_file, commit_hash)
   762 |             except OSError:
   763 |                 # Raise any environment error raise by `cached_file`. It will have a helpful error message adapted to
   764 |                 # the original exception.
   765 |                 raise
   766 |             except Exception:
   767 |                 # For any other exception, we throw a generic error.
   768 |                 raise OSError(
   769 |                     f"Can't load the configuration of '{pretrained_model_name_or_path}'. If you were trying to load it"
   770 |                     " from 'https://huggingface.co/models', make sure you don't have a local directory with the same"
   771 |                     f" name. Otherwise, make sure '{pretrained_model_name_or_path}' is the correct path to a directory"
   772 |                     f" containing a {configuration_file} file"
   773 |                 )
   774 | 
   775 |         try:
   776 |             if gguf_file:
   777 |                 config_dict = load_gguf_checkpoint(resolved_config_file, return_tensors=False)["config"]
   778 |             else:
   779 |                 # Load config dict
   780 |                 config_dict = cls._dict_from_json_file(resolved_config_file)
   781 | 
   782 |             config_dict["_commit_hash"] = commit_hash
   783 |         except (json.JSONDecodeError, UnicodeDecodeError):
   784 |             raise OSError(f"It looks like the config file at '{resolved_config_file}' is not a valid JSON file.")
   785 | 
   786 |         if is_local:
   787 |             logger.info(f"loading configuration file {resolved_config_file}")
   788 |         else:
   789 |             logger.info(f"loading configuration file {configuration_file} from cache at {resolved_config_file}")
   790 | 
   791 |         # timm models are not saved with the model_type in the config file
   792 |         if "model_type" not in config_dict and is_timm_config_dict(config_dict):
   793 |             config_dict["model_type"] = "timm_wrapper"
   794 | 
   795 |         # Some checkpoints may contain the wrong model_type in the config file.
   796 |         # Allow the user to override it but warn them that it might not work.
   797 |         if "model_type" in kwargs and config_dict["model_type"] != kwargs["model_type"]:
   798 |             logger.warning(
   799 |                 f"{configuration_file} has 'model_type={config_dict['model_type']}' but you overrode "
   800 |                 f"it with 'model_type={kwargs['model_type']}'. This may lead to unexpected behavior."
   801 |             )
   802 |             config_dict["model_type"] = kwargs["model_type"]
   803 | 
   804 |         return config_dict, kwargs
