   801 |     def prepare_conditioning(
   802 |         self,
   803 |         atom_inputs: EsmFold2AtomInputs,
   804 |         pair_trunk: Tensor,
   805 |         relative_position_encoding: Tensor,
   806 |         single_inputs: Tensor,
   807 |         attention_mask: Tensor | None = None,
   808 |         num_diffusion_samples: int = 1,
   809 |     ) -> EsmFold2DenoiserConditioning:
   810 |         """Precompute the conditioning that every denoising step reuses.
   811 | 
   812 |         Order matters: the featurization and the projections run at the unexpanded batch size and only
   813 |         their (much narrower) results are expanded.
   814 | 
   815 |         ``num_diffusion_samples`` is a replica axis rather than a batch axis -- every tensor built here
   816 |         is identical across samples, while the sampler runs the denoiser at
   817 |         ``batch_size * num_diffusion_samples``. The two attention masks are only ever broadcast
   818 |         against, so they stay at the unexpanded batch size whenever that broadcasts over the sample
   819 |         batch (``batch_size == 1``, i.e. every single-sequence fold) and are materialized only when it
   820 |         cannot. They are also the only large tensors here: at length 1000 the per-layer token biases
   821 |         are ~366 MiB unexpanded, against ~11.4 GiB expanded across the 32 samples the released
   822 |         checkpoints ask for (the class default is 8). Everything else is a few MB, and expanding it
   823 |         keeps the scatter/gather helpers on a single shape.
   824 |         """
   825 |         samples = num_diffusion_samples
   826 |         # A batch dim of 1 broadcasts over the sample batch; anything else has to be materialized.
   827 |         masks_broadcastable = single_inputs.shape[0] == 1
   828 | 
   829 |         # --- precomputed at batch_size ---
   830 |         atom_embeds, position_embeddings = self.atom_encoder.embed_atoms(atom_inputs)
   831 |         atom_window_mask = self.atom_encoder.build_attention_mask(atom_inputs.atom_attention_mask, atom_embeds)
   832 |         pair_states = self.conditioning.compute_pair_repr(pair_trunk, relative_position_encoding)
   833 |         token_attention_bias = self.token_transformer.compute_pair_biases(pair_states, attention_mask)
   834 |         if not masks_broadcastable:
   835 |             atom_window_mask = atom_window_mask.repeat_interleave(samples, 0)
   836 |             token_attention_bias = [bias.repeat_interleave(samples, 0) for bias in token_attention_bias]
   837 | 
   838 |         # --- everything else: batch_size -> batch_size * num_diffusion_samples ---
   839 |         cos, sin = position_embeddings
   840 |         atom_embeds = atom_embeds.repeat_interleave(samples, 0)
   841 |         cos = cos.repeat_interleave(samples, 0)
   842 |         sin = sin.repeat_interleave(samples, 0)
   843 |         atom_mask = atom_inputs.atom_attention_mask.repeat_interleave(samples, 0)
   844 |         atom_to_token = atom_inputs.atom_to_token.repeat_interleave(samples, 0)
   845 |         expanded_single_inputs = single_inputs.repeat_interleave(samples, 0)
   846 |         return EsmFold2DenoiserConditioning(
   847 |             atom_embeds=atom_embeds,
   848 |             attention_mask=atom_window_mask,
   849 |             position_embeddings=(cos, sin),
   850 |             atom_mask=atom_mask,
   851 |             atom_to_token=atom_to_token,
   852 |             # Projected after expanding, unlike the pair bias: a Linear reassociates per batch size.
   853 |             projected_single_inputs=self.conditioning.compute_single_repr(expanded_single_inputs),
   854 |             token_attention_bias=token_attention_bias,
   855 |         )
   856 | 

