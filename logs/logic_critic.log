  4306 |             from .integrations.hub_kernels import register_kernel_replacements_and_fusions
  4307 | 
  4308 |             # For remote kernels, we need to apply the context manager
  4309 |             allow_all_kernels_context = [allow_all_hub_kernels()] if allow_all_kernels else []
  4310 |             with ContextManagers(allow_all_kernels_context):
  4311 |                 register_kernel_replacements_and_fusions(cls, config, kernel_config)
  4312 | 
  4313 |         model_init_context = cls.get_init_context(dtype, is_quantized, _is_ds_init_called, allow_all_kernels)
  4314 | 
  4315 |         config = copy.deepcopy(config)  # We do not want to modify the config inplace in from_pretrained.
  4316 |         with ContextManagers(model_init_context):
  4317 |             model = cls(config, *model_args, **model_kwargs)
