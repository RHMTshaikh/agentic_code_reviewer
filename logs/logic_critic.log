  2804 | def get_placeholders_dict(placeholders: set[str], model_name: str) -> Mapping[str, str | None]:
  2805 |     """
  2806 |     Get the dictionary of placeholders for the given model name.
  2807 |     """
  2808 |     # import here to avoid circular import
  2809 |     from transformers.models import auto as auto_module
  2810 | 
  2811 |     placeholders_dict = {}
  2812 |     for placeholder in placeholders:
  2813 |         # Infer placeholders from the model name and the auto modules
  2814 |         if placeholder in PLACEHOLDER_TO_AUTO_MODULE:
  2815 |             try:
  2816 |                 place_holder_value = getattr(
  2817 |                     getattr(auto_module, PLACEHOLDER_TO_AUTO_MODULE[placeholder][0]),
  2818 |                     PLACEHOLDER_TO_AUTO_MODULE[placeholder][1],
  2819 |                 ).get(model_name, None)
  2820 |             except ImportError:
  2821 |                 # In case a library is not installed, we don't want to fail the docstring generation
  2822 |                 place_holder_value = None
  2823 |             if place_holder_value is not None:
  2824 |                 if isinstance(place_holder_value, list | tuple):
  2825 |                     place_holder_value = (
  2826 |                         place_holder_value[-1] if place_holder_value[-1] is not None else place_holder_value[0]
  2827 |                     )
  2828 |                 placeholders_dict[placeholder] = place_holder_value if place_holder_value is not None else placeholder
  2829 |             else:
  2830 |                 placeholders_dict[placeholder] = placeholder
  2831 | 
  2832 |     return placeholders_dict
  2833 | 
