  4745 |     def _move_missing_keys_from_meta_to_device(
  4746 |         self,
  4747 |         missing_keys: list[str],
  4748 |         device_map: dict | None,
  4749 |         device_mesh: "DeviceMeshLike | None",
  4750 |         hf_quantizer: HfQuantizer | None,
  4751 |     ) -> None:
  4752 |         """Move the missing keys (keys that are part of the model parameters, but were NOT found in the loaded state dicts)
  4753 |         back from meta device to their device according to the `device_map` if any, else cpu. Takes care of sharding those
  4754 |         missing parameters if `device_mesh` is provided, i.e. we are using TP.
  4755 |         All non-persistent buffers are also moved back to the correct device (they are not part of the state_dict, but are
  4756 |         not missing either).
  4757 |         """
  4758 |         is_quantized = hf_quantizer is not None
  4759 |         # This is the only case where we do not initialize the model on meta device, so we don't have to do anything here
  4760 |         if is_deepspeed_zero3_enabled() and not is_quantized:
  4761 |             return
  4762 | 
  4763 |         # In this case we need to move everything back
  4764 |         if is_fsdp_enabled() and not is_local_dist_rank_0() and not is_quantized:
  4765 |             for key, param in self.named_parameters():
  4766 |                 value = torch.zeros_like(param, device="cpu")
  4767 |                 _load_parameter_into_model(self, key, value)
  4768 |             for key, buffer in self.named_buffers():
  4769 |                 value = torch.zeros_like(buffer, device="cpu")
  4770 |                 _load_parameter_into_model(self, key, value)
  4771 |             return
  4772 | 
  4773 |         # The tied weight keys are in the "missing" usually, but they should not be moved (they will be tied anyway)
  4774 |         # This is especially important because if they are moved, they will lose the `_is_hf_initialized` flag, and they
  4775 |         # will be re-initialized for nothing (which can be quite long)
  4776 |         for key in missing_keys - self.all_tied_weights_keys.keys():
  4777 |             param = self.get_parameter_or_buffer(key)
  4778 |             param_device = get_device(device_map, key, valid_torch_device=True)
  4779 |             value = torch.empty_like(param, device=param_device)
  4780 |             # For TP, we may need to shard the param
  4781 |             if device_mesh is not None:
  4782 |                 shard_and_distribute_module(
  4783 |                     self, value, param, key, None, False, device_mesh.get_local_rank(), device_mesh
  4784 |                 )
  4785 |             # Otherwise, just move it to device
  4786 |             else:
  4787 |                 _load_parameter_into_model(self, key, value)
  4788 |         # We need to move back non-persistent buffers as well, as they are not part of loaded weights anyway
  4789 |         for key, buffer in self.named_non_persistent_buffers():
  4790 |             buffer_device = get_device(device_map, key, valid_torch_device=True)
  4791 |             value = torch.empty_like(buffer, device=buffer_device)
