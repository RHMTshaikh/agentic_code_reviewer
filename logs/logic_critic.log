  2856 | def get_args_doc_from_source(args_classes: object | list[object]) -> dict:
  2857 |     if isinstance(args_classes, list | tuple):
  2858 |         return _merge_args_dicts(tuple(args_classes))
  2859 |     return args_classes.__dict__
