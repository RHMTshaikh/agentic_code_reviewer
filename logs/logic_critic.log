   132 |         if occupancy < len_next_tokens or state.allocated_blocks == 0:
   133 |             blocks_needed = ((len_next_tokens - occupancy + 1) // self.cache.block_size) + 1
   134 |             allocated = self.cache.allocate_blocks(blocks_needed, state.request_id, state.allocated_blocks)
