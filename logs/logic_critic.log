  4338 | 
  4339 |         # Prepare the full device map
  4340 |         if device_map is not None:
  4341 |             device_map = _get_device_map(model, device_map, max_memory, hf_quantizer)
  4342 | 
  4343 |         # Finalize model weight initialization
  4344 |         load_config = LoadStateDictConfig(
  4345 |             pretrained_model_name_or_path=pretrained_model_name_or_path,
  4346 |             ignore_mismatched_sizes=ignore_mismatched_sizes,
  4347 |             sharded_metadata=sharded_metadata,
  4348 |             device_map=device_map,
  4349 |             disk_offload_folder=offload_folder,
  4350 |             offload_buffers=offload_buffers,
  4351 |             dtype=dtype,
  4352 |             dtype_plan=dtype_plan,
  4353 |             hf_quantizer=hf_quantizer,
  4354 |             device_mesh=device_mesh,
  4355 |             weights_only=weights_only,
  4356 |             weight_mapping=weight_conversions,
  4357 |             use_safetensors=use_safetensors,
  4358 |             download_kwargs=download_kwargs,
  4359 |             disable_mmap=disable_mmap,
