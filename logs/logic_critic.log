  1496 |     @classmethod
  1497 |     def from_pretrained(
  1498 |         cls,
  1499 |         pretrained_model_name_or_path: str | os.PathLike,
  1500 |         *init_inputs,
  1501 |         cache_dir: str | os.PathLike | None = None,
  1502 |         force_download: bool = False,
  1503 |         local_files_only: bool = False,
  1504 |         token: str | bool | None = None,
  1505 |         revision: str = "main",
  1506 |         trust_remote_code=False,
  1507 |         **kwargs,
  1508 |     ):
  1509 |         r"""
  1510 |         Instantiate a [`~tokenization_utils_base.PreTrainedTokenizerBase`] (or a derived class) from a predefined
  1511 |         tokenizer.
  1512 | 
  1513 |         Args:
  1514 |             pretrained_model_name_or_path (`str` or `os.PathLike`):
  1515 |                 Can be either:
  1516 | 
  1517 |                 - A string, the *model id* of a predefined tokenizer hosted inside a model repo on huggingface.co.
  1518 |                 - A path to a *directory* containing vocabulary files required by the tokenizer, for instance saved
  1519 |                   using the [`~tokenization_utils_base.PreTrainedTokenizerBase.save_pretrained`] method, e.g.,
  1520 |                   `./my_model_directory/`.
  1521 |                 - (**Deprecated**, not applicable to all derived classes) a path to a single saved vocabulary
  1522 |                   file (if and only if the tokenizer only requires a single vocabulary file like Bert or XLNet), e.g.,
  1523 |                   `./my_model_directory/vocab.txt`.
  1524 |             cache_dir (`str` or `os.PathLike`, *optional*):
  1525 |                 Path to a directory in which a downloaded predefined tokenizer vocabulary files should be cached if the
  1526 |                 standard cache should not be used.
  1527 |             force_download (`bool`, *optional*, defaults to `False`):
  1528 |                 Whether or not to force the (re-)download the vocabulary files and override the cached versions if they
  1529 |                 exist.
  1530 |             proxies (`dict[str, str]`, *optional*):
  1531 |                 A dictionary of proxy servers to use by protocol or endpoint, e.g., `{'http': 'foo.bar:3128',
  1532 |                 'http://hostname': 'foo.bar:4012'}`. The proxies are used on each request.
  1533 |             token (`str` or *bool*, *optional*):
  1534 |                 The token to use as HTTP bearer authorization for remote files. If `True`, will use the token generated
  1535 |                 when running `hf auth login` (stored in `~/.huggingface`).
  1536 |             local_files_only (`bool`, *optional*, defaults to `False`):
  1537 |                 Whether or not to only rely on local files and not to attempt to download any files.
  1538 |             revision (`str`, *optional*, defaults to `"main"`):
  1539 |                 The specific model version to use. It can be a branch name, a tag name, or a commit id, since we use a
  1540 |                 git-based system for storing models and other artifacts on huggingface.co, so `revision` can be any
  1541 |                 identifier allowed by git.
  1542 |             subfolder (`str`, *optional*):
  1543 |                 In case the relevant files are located inside a subfolder of the model repo on huggingface.co (e.g. for
  1544 |                 facebook/rag-token-base), specify it here.
  1545 |             inputs (additional positional arguments, *optional*):
  1546 |                 Will be passed along to the Tokenizer `__init__` method.
  1547 |             trust_remote_code (`bool`, *optional*, defaults to `False`):
  1548 |                 Whether or not to allow for custom models defined on the Hub in their own modeling files. This option
  1549 |                 should only be set to `True` for repositories you trust and in which you have read the code, as it will
  1550 |                 execute code present on the Hub on your local machine.
  1551 |             kwargs (additional keyword arguments, *optional*):
  1552 |                 Will be passed to the Tokenizer `__init__` method. Can be used to set special tokens like `bos_token`,
  1553 |                 `eos_token`, `unk_token`, `sep_token`, `pad_token`, `cls_token`, `mask_token`,
  1554 |                 `extra_special_tokens`. See parameters in the `__init__` for more details.
  1555 | 
  1556 |         <Tip>
  1557 | 
  1558 |         Passing `token=True` is required when you want to use a private model.
  1559 | 
  1560 |         </Tip>
  1561 | 
  1562 |         Examples:
  1563 | 
  1564 |         ```python
  1565 |         # We can't instantiate directly the base class *PreTrainedTokenizerBase* so let's show our examples on a derived class: BertTokenizer
  1566 |         # Download vocabulary from huggingface.co and cache.
  1567 |         tokenizer = BertTokenizer.from_pretrained("google-bert/bert-base-uncased")
  1568 | 
  1569 |         # Download vocabulary from huggingface.co (user-uploaded) and cache.
  1570 |         tokenizer = BertTokenizer.from_pretrained("dbmdz/bert-base-german-cased")
  1571 | 
  1572 |         # If vocabulary files are in a directory (e.g. tokenizer was saved using *save_pretrained('./test/saved_model/')*)
  1573 |         tokenizer = BertTokenizer.from_pretrained("./test/saved_model/")
  1574 | 
  1575 |         # If the tokenizer uses a single vocabulary file, you can point directly to this file
  1576 |         tokenizer = BertTokenizer.from_pretrained("./test/saved_model/my_vocab.txt")
  1577 | 
  1578 |         # You can link tokens to special vocabulary when instantiating
  1579 |         tokenizer = BertTokenizer.from_pretrained("google-bert/bert-base-uncased", unk_token="<unk>")
  1580 |         # You should be sure '<unk>' is in the vocabulary when doing that.
  1581 |         # Otherwise use tokenizer.add_special_tokens({'unk_token': '<unk>'}) instead)
  1582 |         assert tokenizer.unk_token == "<unk>"
