  2951 |     def _eventual_warn_about_too_long_sequence(self, ids: list[int], max_length: int | None, verbose: bool):
  2952 |         """
  2953 |         Depending on the input and internal state we might trigger a warning about a sequence that is too long for its
  2954 |         corresponding model
  2955 | 
  2956 |         Args:
  2957 |             ids (`list[str]`): The ids produced by the tokenization
  2958 |             max_length (`int`, *optional*): The max_length desired (does not trigger a warning if it is set)
  2959 |             verbose (`bool`): Whether or not to print more information and warnings.
  2960 | 
  2961 |         """
  2962 |         if max_length is None and len(ids) > self.model_max_length and verbose and self.model_max_length != 0:
  2963 |             if not self.deprecation_warnings.get("sequence-length-is-longer-than-the-specified-maximum", False):
  2964 |                 logger.warning(
  2965 |                     "Token indices sequence length is longer than the specified maximum sequence length "
  2966 |                     f"for this model ({len(ids)} > {self.model_max_length}). Running this sequence through the model "
  2967 |                     "will result in indexing errors"
  2968 |                 )
  2969 |             self.deprecation_warnings["sequence-length-is-longer-than-the-specified-maximum"] = True
