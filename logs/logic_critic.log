    28 |     def __init__(self, shape, rank, dim_names=None):
    29 |         if isinstance(shape, int):
    30 |             shape = (shape,)
    31 |         self.shape = tuple(shape)
    32 |         self.ndim = len(self.shape)
    33 |         self.mesh_dim_names = dim_names or tuple(f"dim{i}" for i in range(self.ndim))
    34 |         # Compute nD coordinate (row-major: last dim changes fastest)
    35 |         self._coord = []
    36 |         r = rank
    37 |         for s in reversed(self.shape):
    38 |             self._coord.insert(0, r % s)
    39 |             r //= s
    40 | 
    41 |     def get_local_rank(self):
    42 |         return self._coord[0]
    43 | 
    44 |     def get_coordinate(self):
    45 |         return tuple(self._coord)
    46 | 
    47 |     def size(self):
    48 |         result = 1
    49 |         for s in self.shape:
    50 |             result *= s
    51 |         return result
    52 | 
    53 |     def _is_current_rank_part_of_mesh(self):
    54 |         return True
    55 | 
    56 |     def _sym_get_coordinate(self, dim):
    57 |         return self._coord[dim]
    58 | 
