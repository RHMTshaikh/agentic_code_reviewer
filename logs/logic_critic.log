  3543 |             weights_name = ADAPTER_SAFE_WEIGHTS_NAME
  3544 | 
  3545 |         filename_pattern = weights_name.replace(".bin", "{suffix}.bin").replace(".safetensors", "{suffix}.safetensors")
  3546 |         state_dict_split = split_torch_state_dict_into_shards(
  3547 |             state_dict, filename_pattern=filename_pattern, max_shard_size=max_shard_size
  3548 |         )
  3549 |         # Save index if sharded
  3550 |         index = None
  3551 |         if state_dict_split.is_sharded:
  3552 |             index = {
  3553 |                 "metadata": {"total_parameters": self.num_parameters(), **state_dict_split.metadata},
