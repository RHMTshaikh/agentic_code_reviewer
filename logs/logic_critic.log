  3221 |     def _copy_lm_head_original_to_resized(
  3222 |         self, new_lm_head, old_lm_head, num_tokens_to_copy, transposed, has_new_lm_head_bias
  3223 |     ):
  3224 |         # Copy old lm head weights to new lm head
  3225 |         if not transposed:
  3226 |             new_lm_head.weight.data[:num_tokens_to_copy, :] = old_lm_head.weight.data[:num_tokens_to_copy, :]
