  3306 |             self._gradient_checkpointing_func = gradient_checkpointing_func
  3307 |             self.gradient_checkpointing = enable
  3308 |             is_gradient_checkpointing_set = True
  3309 | 
  3310 |         for module in self.modules():
  3311 |             if hasattr(module, "gradient_checkpointing"):
  3312 |                 setattr(module, "_gradient_checkpointing_func", gradient_checkpointing_func)
  3313 |                 setattr(module, "gradient_checkpointing", enable)
  3314 |                 is_gradient_checkpointing_set = True
  3315 | 
  3316 |         if not is_gradient_checkpointing_set:
  3317 |             raise ValueError(
  3318 |                 f"{self.__class__.__name__} is not compatible with gradient checkpointing. Make sure all the architecture support it by setting a boolean attribute"
  3319 |                 " `gradient_checkpointing` to modules of the model that uses checkpointing."
  3320 |             )
  3321 | 
  3322 |     def gradient_checkpointing_disable(self):
