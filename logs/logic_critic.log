  1223 |     """Sort key for state-dict names: split on `"."` and sort digits numerically
  1224 |     and strings alphabetically. We emit a tuple at each point to sort ints
  1225 |     first and strings second to avoid int-string comparison failures.
  1226 |     """
  1227 |     parts = []
  1228 |     for part in s.split("."):
  1229 |         if part.isdigit():
  1230 |             parts.append((0, int(part)))
  1231 |         else:
  1232 |             parts.append((1, part))
  1233 |     return parts
