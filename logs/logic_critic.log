  4175 | def auto_class_docstring(cls, custom_intro=None, custom_args=None, checkpoint=None):
  4176 |     """
  4177 |     Wrapper that automatically generates a docstring for classes based on their attributes and methods.
  4178 |     """
  4179 |     # import here to avoid circular import
  4180 |     from transformers.models import auto as auto_module
  4181 | 
  4182 |     is_dataclass = False
  4183 |     is_processor = False
  4184 |     is_config = False
  4185 |     is_image_processor = False
  4186 |     docstring_init = ""
  4187 |     docstring_args = ""
  4188 |     if "PreTrainedModel" in (x.__name__ for x in cls.__mro__):
  4189 |         docstring_init = auto_method_docstring(
