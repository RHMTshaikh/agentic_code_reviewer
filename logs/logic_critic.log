    54 |             if order.type == "MARKET":
    55 |                 fill_price = quote.ask if order.side == "BUY" else quote.bid
    56 |             elif order.type == "LIMIT":
    57 |                 if order.side == "BUY" and quote.ask <= order.limit_price:
    58 |                     fill_price = quote.ask
    59 |                 elif order.side == "SELL" and quote.bid >= order.limit_price:
