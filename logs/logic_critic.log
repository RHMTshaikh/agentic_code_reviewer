  2975 |     if type_hint is type(...) or type_hint is Ellipsis:
  2976 |         return "..."
  2977 |     # Note: NoneType handling is done later to preserve "NoneType" in Union[] but "None" in | syntax
  2978 | 
  2979 |     # Check if this is a generic type (e.g., list[str], dict[str, int])
  2980 |     origin = get_origin(type_hint)
  2981 |     args = get_args(type_hint)
  2982 | 
  2983 |     if origin is not None and args:
  2984 |         # This is a generic type - format it with its arguments
  2985 |         # Get the origin type name
  2986 |         if hasattr(origin, "__module__") and hasattr(origin, "__name__"):
  2987 |             # Clean up module name - need to handle both 'typing.' prefix and just 'typing'
  2988 |             module_name = origin.__module__
  2989 |             if module_name in ("typing", "types", "builtins"):
  2990 |                 module_name = ""
  2991 |             else:
  2992 |                 module_name = (
  2993 |                     module_name.replace("transformers.", "~")
  2994 |                     .replace("typing.", "")
  2995 |                     .replace("types.", "")
  2996 |                     .replace("builtins.", "")
  2997 |                 )
  2998 | 
  2999 |             if module_name:
  3000 |                 origin_str = f"{module_name}.{origin.__name__}"
  3001 |             else:
  3002 |                 origin_str = origin.__name__
  3003 |         else:
  3004 |             origin_str = str(origin)
  3005 | 
  3006 |         # Handle special origin types
  3007 |         if origin_str == "UnionType":
  3008 |             # Python 3.13's X | Y syntax - format it nicely
  3009 |             arg_strs = [_format_type_annotation_recursive(arg) for arg in args]
  3010 |             return " | ".join(arg_strs)
  3011 | 
  3012 |         # Special handling for Annotated[Union[...], ...] and Annotated[UnionType[...], ...]
  3013 |         # Check if first arg is a Union/UnionType and format it specially
  3014 |         if origin_str == "Annotated" and args:
  3015 |             first_arg_origin = get_origin(args[0])
  3016 |             # Check if it's a UnionType (modern | syntax) or Union (old Union[] syntax)
  3017 |             if first_arg_origin is UnionType:
  3018 |                 # Modern union type - format as X | Y | Z (with None not NoneType)
  3019 |                 union_args = get_args(args[0])
  3020 |                 union_strs = []
  3021 |                 for arg in union_args:
  3022 |                     if arg is type(None):
  3023 |                         union_strs.append("None")  # Modern syntax uses "None"
  3024 |                     else:
  3025 |                         union_strs.append(_format_type_annotation_recursive(arg))
  3026 |                 formatted_union = " | ".join(union_strs)
  3027 |                 # Include the rest of the Annotated metadata
  3028 |                 remaining_args = [_format_type_annotation_recursive(arg) for arg in args[1:]]
  3029 |                 all_args = [formatted_union] + remaining_args
  3030 |                 return f"{origin_str}[{', '.join(all_args)}]"
  3031 |             elif first_arg_origin is Union:
  3032 |                 # Old-style Union - format as Union[X, Y, Z]
  3033 |                 union_args = get_args(args[0])
  3034 |                 union_strs = [_format_type_annotation_recursive(arg) for arg in union_args]
  3035 |                 formatted_union = f"Union[{', '.join(union_strs)}]"
  3036 |                 # Include the rest of the Annotated metadata
  3037 |                 remaining_args = [_format_type_annotation_recursive(arg) for arg in args[1:]]
  3038 |                 all_args = [formatted_union] + remaining_args
  3039 |                 return f"{origin_str}[{', '.join(all_args)}]"
  3040 | 
  3041 |         # Recursively format the generic arguments
  3042 |         arg_strs = [_format_type_annotation_recursive(arg) for arg in args]
  3043 |         return f"{origin_str}[{', '.join(arg_strs)}]"
  3044 |     elif hasattr(type_hint, "__module__") and hasattr(type_hint, "__name__"):
  3045 |         # Simple type with module and name
  3046 |         # Clean up module name - need to handle both 'typing.' prefix and just 'typing'
  3047 |         module_name = type_hint.__module__
  3048 |         if module_name in ("typing", "types", "builtins"):
  3049 |             module_name = ""
  3050 |         else:
  3051 |             module_name = (
  3052 |                 module_name.replace("transformers.", "~")
  3053 |                 .replace("typing.", "")
  3054 |                 .replace("types.", "")
  3055 |                 .replace("builtins.", "")
  3056 |             )
  3057 | 
  3058 |         if module_name:
  3059 |             type_name = f"{module_name}.{type_hint.__name__}"
  3060 |         else:
  3061 |             type_name = type_hint.__name__
  3062 | 
  3063 |         return type_name
  3064 |     else:
  3065 |         # Fallback to string representation
  3066 |         type_str = str(type_hint)
  3067 |         # Clean up ForwardRef
  3068 |         if "ForwardRef" in type_str:
  3069 |             type_str = _re_forward_ref.sub(r"\1", type_str)
  3070 |         # Clean up module prefixes
  3071 |         type_str = type_str.replace("typing.", "").replace("types.", "")
  3072 |         return type_str
