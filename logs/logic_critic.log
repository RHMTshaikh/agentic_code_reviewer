  2372 |     def set_logging(
  2373 |         self,
  2374 |         strategy: str | IntervalStrategy = "steps",
  2375 |         steps: int = 500,
  2376 |         report_to: str | list[str] = "none",
  2377 |         level: str = "passive",
  2378 |         first_step: bool = False,
  2379 |         nan_inf_filter: bool = False,
  2380 |         on_each_node: bool = False,
  2381 |         replica_level: str = "passive",
  2382 |     ):
  2383 |         """
  2384 |         A method that regroups all arguments linked to logging.
  2385 | 
  2386 |         Args:
  2387 |             strategy (`str` or [`~trainer_utils.IntervalStrategy`], *optional*, defaults to `"steps"`):
  2388 |                 The logging strategy to adopt during training. Possible values are:
  2389 | 
  2390 |                     - `"no"`: No logging is done during training.
  2391 |                     - `"epoch"`: Logging is done at the end of each epoch.
  2392 |                     - `"steps"`: Logging is done every `logging_steps`.
  2393 | 
  2394 |             steps (`int`, *optional*, defaults to 500):
  2395 |                 Number of update steps between two logs if `strategy="steps"`.
  2396 |             level (`str`, *optional*, defaults to `"passive"`):
  2397 |                 Logger log level to use on the main process. Possible choices are the log levels as strings: `"debug"`,
  2398 |                 `"info"`, `"warning"`, `"error"` and `"critical"`, plus a `"passive"` level which doesn't set anything
  2399 |                 and lets the application set the level.
  2400 |             report_to (`str` or `list[str]`, *optional*, defaults to `"none"`):
  2401 |                 The list of integrations to report the results and logs to. Supported platforms are `"azure_ml"`,
  2402 |                 `"clearml"`, `"codecarbon"`, `"comet_ml"`, `"dagshub"`, `"dvclive"`, `"flyte"`, `"mlflow"`,
  2403 |                 `"swanlab"`, `"tensorboard"`, `"trackio"` and `"wandb"`. Use `"all"` to report to all integrations
  2404 |                 installed, `"none"` for no integrations.
  2405 |             first_step (`bool`, *optional*, defaults to `False`):
  2406 |                 Whether to log and evaluate the first `global_step` or not.
  2407 |             nan_inf_filter (`bool`, *optional*, defaults to `True`):
