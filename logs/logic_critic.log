   243 |         self.layer_idx = layer_idx
   244 |         self.attention_dropout = config.attention_dropout
   245 |         self.hidden_size = config.hidden_size
   246 |         self.num_heads = config.num_attention_heads
   247 |         self.head_dim = config.head_dim
   248 |         self.max_position_embeddings = config.max_position_embeddings
   249 | 
   250 |         self.q_lora_rank = config.q_lora_rank
   251 |         self.qk_rope_head_dim = config.qk_rope_head_dim
   252 |         self.kv_lora_rank = config.kv_lora_rank
   253 |         self.v_head_dim = config.v_head_dim
   254 |         self.qk_nope_head_dim = config.qk_nope_head_dim
   255 |         self.qk_head_dim = config.qk_nope_head_dim + config.qk_rope_head_dim
   256 |         self.num_key_value_groups = config.num_attention_heads // config.num_key_value_heads
   257 | 
   258 |         self.is_causal = True
   259 | 
   260 |         if self.q_lora_rank is None:
   261 |             self.q_proj = nn.Linear(self.hidden_size, self.num_heads * self.qk_head_dim, bias=False)
   262 |         else:
   263 |             self.q_a_proj = nn.Linear(self.hidden_size, config.q_lora_rank, bias=config.attention_bias)
   264 |             self.q_a_layernorm = MiniCPM3RMSNorm(config.q_lora_rank)
   265 |             self.q_b_proj = nn.Linear(config.q_lora_rank, self.num_heads * self.qk_head_dim, bias=False)
   266 | 
   267 |         self.kv_a_proj_with_mqa = nn.Linear(
   268 |             self.hidden_size,
   269 |             config.kv_lora_rank + config.qk_rope_head_dim,
   270 |             bias=config.attention_bias,
   271 |         )
   272 |         self.kv_a_layernorm = MiniCPM3RMSNorm(config.kv_lora_rank)
   273 |         self.kv_b_proj = nn.Linear(
   274 |             config.kv_lora_rank,
   275 |             self.num_heads * (self.qk_head_dim - self.qk_rope_head_dim + self.v_head_dim),
   276 |             bias=False,
   277 |         )
   278 | 
   279 |         self.o_proj = nn.Linear(
   280 |             self.num_heads * self.v_head_dim,
   281 |             self.hidden_size,
   282 |             bias=config.attention_bias,
   283 |         )
