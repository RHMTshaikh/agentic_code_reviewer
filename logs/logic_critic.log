    71 |         # Authentication is assumed to be handled upstream by the load balancer
    72 |         if client_token:
    73 |             self._local_subscribers[f"private:{client_token}"].add(queue)
    74 | 
    75 |         try:
    76 |             while True:
    77 |                 # Wait for next incoming tick
    78 |                 tick = await queue.get()
    79 |                 yield tick
    80 |         except (asyncio.CancelledError, GeneratorExit):
    81 |             pass
    82 |         finally:
    83 |             # Clean up subscriber references
    84 |             for s in clean_symbols:
    85 |                 self._local_subscribers[s].discard(queue)
