  2060 |                 logger.warning(
  2061 |                     "The attention mask and the pad token id were not set. As a consequence, you may observe "
  2062 |                     "unexpected behavior. Please pass your input's `attention_mask` to obtain reliable results."
  2063 |                 )
  2064 |             pad_token_tensor = eos_token_tensor[0]
