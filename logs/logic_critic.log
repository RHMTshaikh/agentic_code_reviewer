   451 |                 should only be set to `True` for repositories you trust and in which you have read the code, as it will
   452 |                 execute code present on the Hub on your local machine.
   453 |             **kwargs:
   454 |                 Additional keyword arguments for remote code loading.
   455 | 
   456 |         Raises:
   457 |             OSError: If `pretrained_model_name_or_path` does not contain a `custom_generate` subdirectory.
   458 | 
   459 |         Returns:
   460 |             A callable that can be used to generate text.
   461 |         """
   462 |         # Fetches the generate.py file from the model repo. If it doesn't exist, a file in `.no_exist` cache directory
   463 |         # is created (preventing future hub requests), and an OSError is raised.
   464 |         try:
   465 |             module = get_cached_module_file(
   466 |                 pretrained_model_name_or_path, module_file="custom_generate/generate.py", **kwargs
   467 |             )
   468 |         except OSError:
   469 |             raise OSError(
   470 |                 f"`{pretrained_model_name_or_path}` does not contain a `custom_generate` subdirectory with a "
   471 |                 "`generate.py` file, can't load the custom generate function."
   472 |             )
   473 | 
   474 |         # Loading a custom generate function executes the repository's `custom_generate/generate.py`
   475 |         # (via `get_class_in_module` below), so it is remote code and must be gated by
   476 |         # `trust_remote_code` -- including when it is loaded from a local directory. `from_pretrained`
   477 |         # likewise requires `trust_remote_code` for custom modeling code that lives in a local repo;
   478 |         # treating a local path as trusted here previously let `custom_generate/generate.py` run with
   479 |         # no opt-in.
   480 |         error_message = (
   481 |             f"The repository `{pretrained_model_name_or_path}` contains custom generation code that will override "
   482 |             "the default `generate` method."
   483 |         )
   484 |         resolve_trust_remote_code(
   485 |             trust_remote_code,
   486 |             pretrained_model_name_or_path,
   487 |             has_local_code=False,
   488 |             has_remote_code=True,
   489 |             error_message=error_message,
   490 |         )
