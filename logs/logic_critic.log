 135 | def get_affected_points_mask(map_shape, line: Line_3D):
 136 |     """
 137 |     Creates a boolean mask such that majority of poits are false.
 138 | 
 139 |     Args:
 140 |         map_shape (tuple): The shape of the map (height, width, depth).
 141 |         line (Line_3D): The line used to create the mask.
 142 |         side (bool): Whether to mask points on the left (True) or right (False) side of the line.
 143 |     Returns:
 144 |         np.ndarray: A boolean mask of the given shape.
 145 |     """
 146 |     x1, y1, z1 =  line.point1
 147 |     dx, dy, dz = line.direction
 148 | 
 149 |     height, width, _ = map_shape
 150 |     y_coords, x_coords = np.mgrid[0:height, 0:width]
 151 |     
 152 |     mask = (x_coords - x1) * dy - (y_coords - y1) * dx < 0
 153 | 
 154 |     if np.sum(mask) > (height * width) / 2:
 155 |         mask = ~mask
 156 |     return mask


