  2197 |     def _extract_generation_mode_kwargs(
  2198 |         self,
  2199 |         custom_generate,
  2200 |         kwargs,
  2201 |         synced_gpus,
  2202 |         assistant_model,
  2203 |         streamer,
  2204 |     ) -> dict[str, Any]:
  2205 |         """
  2206 |         Extracts and returns the generation mode related keyword arguments from the provided kwargs.
  2207 |         """
  2208 |         generation_mode_kwargs = {
  2209 |             "tokenizer": kwargs.pop("tokenizer", None),
  2210 |             "assistant_tokenizer": kwargs.pop("assistant_tokenizer", None),
  2211 |             "assistant_model": assistant_model,
  2212 |             "streamer": streamer,
  2213 |         }
  2214 |         world_size = dist.get_world_size() if dist.is_available() and dist.is_initialized() else 1  # type: ignore
  2215 |         generation_mode_kwargs["synced_gpus"] = (
  2216 |             (is_deepspeed_zero3_enabled() or is_fsdp_managed_module(self)) and world_size > 1
  2217 |             if synced_gpus is None
  2218 |             else synced_gpus
  2219 |         )
  2220 |         generation_mode_kwargs = {k: v for k, v in generation_mode_kwargs.items() if v is not None}
  2221 |         # Custom_generate callables can have their own set of arguments
  2222 |         # To extract them, we compare the signature with the standard _sample method
  2223 |         if isinstance(custom_generate, Callable):
  2224 |             usual_mode_kwargs = inspect.signature(GenerationMixin._sample).parameters.keys()
  2225 |             custom_generate_kwargs = inspect.signature(custom_generate).parameters.keys()
  2226 |             new_custom_keys = custom_generate_kwargs - usual_mode_kwargs
  2227 |             generation_mode_kwargs = {k: kwargs.pop(k) for k in new_custom_keys if k in kwargs}
  2228 |         return generation_mode_kwargs
