  1452 |     def get_vocab(self) -> dict[str, int]:
  1453 |         """
  1454 |         Returns the vocabulary as a dictionary of token to index.
  1455 | 
  1456 |         `tokenizer.get_vocab()[token]` is equivalent to `tokenizer.convert_tokens_to_ids(token)` when `token` is in the
  1457 |         vocab.
  1458 | 
  1459 |         Returns:
  1460 |             `dict[str, int]`: The vocabulary.
  1461 |         """
  1462 |         raise NotImplementedError()
