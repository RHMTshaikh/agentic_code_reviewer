  1978 |     def save_pretrained(
  1979 |         self,
  1980 |         save_directory: str | os.PathLike,
  1981 |         legacy_format: bool | None = None,
  1982 |         filename_prefix: str | None = None,
  1983 |         push_to_hub: bool = False,
  1984 |         **kwargs,
  1985 |     ) -> tuple[str, ...]:
  1986 |         """
  1987 |         Save the full tokenizer state.
  1988 | 
  1989 | 
  1990 |         This method make sure the full tokenizer can then be re-loaded using the
  1991 |         [`~tokenization_utils_base.PreTrainedTokenizer.from_pretrained`] class method..
  1992 | 
  1993 |         Warning,None This won't save modifications you may have applied to the tokenizer after the instantiation (for
  1994 |         instance, modifying `tokenizer.do_lower_case` after creation).
  1995 | 
  1996 |         Args:
  1997 |             save_directory (`str` or `os.PathLike`): The path to a directory where the tokenizer will be saved.
  1998 |             legacy_format (`bool`, *optional*):
  1999 |                 Only applicable for a fast tokenizer. If unset (default), will save the tokenizer in the unified JSON
  2000 |                 format as well as in legacy format if it exists, i.e. with tokenizer specific vocabulary and a separate
  2001 |                 added_tokens files.
  2002 | 
  2003 |                 If `False`, will only save the tokenizer in the unified JSON format. This format is incompatible with
  2004 |                 "slow" tokenizers (not powered by the *tokenizers* library), so the tokenizer will not be able to be
  2005 |                 loaded in the corresponding "slow" tokenizer.
  2006 | 
  2007 |                 If `True`, will save the tokenizer in legacy format. If the "slow" tokenizer doesn't exits, a value
  2008 |                 error is raised.
  2009 |             filename_prefix (`str`, *optional*):
  2010 |                 A prefix to add to the names of the files saved by the tokenizer.
  2011 |             push_to_hub (`bool`, *optional*, defaults to `False`):
  2012 |                 Whether or not to push your model to the Hugging Face model hub after saving it. You can specify the
  2013 |                 repository you want to push to with `repo_id` (will default to the name of `save_directory` in your
  2014 |                 namespace).
  2015 |             kwargs (`dict[str, Any]`, *optional*):
  2016 |                 Additional key word arguments passed along to the [`~utils.PushToHubMixin.push_to_hub`] method.
  2017 | 
  2018 |         Returns:
  2019 |             A tuple of `str`: The files saved.
  2020 |         """
  2021 | 
  2022 |         if os.path.isfile(save_directory):
  2023 |             logger.error(f"Provided path ({save_directory}) should be a directory, not a file")
  2024 |             return
  2025 | 
  2026 |         os.makedirs(save_directory, exist_ok=True)
  2027 | 
  2028 |         if push_to_hub:
  2029 |             commit_message = kwargs.pop("commit_message", None)
  2030 |             repo_id = kwargs.pop("repo_id", str(save_directory).split(os.path.sep)[-1])
  2031 |             repo_id = hf_api().create_repo(repo_id, exist_ok=True, **kwargs).repo_id
  2032 |             files_timestamps = self._get_files_timestamps(save_directory)
  2033 | 
  2034 |         tokenizer_config_file = os.path.join(
  2035 |             save_directory, (filename_prefix + "-" if filename_prefix else "") + TOKENIZER_CONFIG_FILE
  2036 |         )
  2037 | 
  2038 |         tokenizer_config = copy.deepcopy(self.init_kwargs)
  2039 |         tokenizer_config.pop("add_bos_token", None)
  2040 |         tokenizer_config.pop("add_eos_token", None)
  2041 | 
  2042 |         # Let's save the init kwargs
  2043 |         target_keys = set(self.init_kwargs.keys())
  2044 |         target_keys.discard("add_bos_token")
  2045 |         target_keys.discard("add_eos_token")
  2046 |         # Let's save the special tokens map (only the strings)
  2047 |         target_keys.update(["model_max_length"])
  2048 | 
  2049 |         for k in target_keys:
  2050 |             if hasattr(self, k):
  2051 |                 tokenizer_config[k] = getattr(self, k)
  2052 | 
  2053 |         # Let's make sure we properly save the special tokens
  2054 |         # V5: Save both named tokens and extra tokens
  2055 |         tokenizer_config.update(self.special_tokens_map)
  2056 |         if self._extra_special_tokens:
  2057 |             tokenizer_config["extra_special_tokens"] = self.extra_special_tokens
  2058 | 
  2059 |         save_jinja_files = kwargs.get("save_jinja_files", True)
  2060 |         tokenizer_config, saved_raw_chat_template_files = self.save_chat_templates(
  2061 |             save_directory, tokenizer_config, filename_prefix, save_jinja_files
  2062 |         )
  2063 | 
  2064 |         if getattr(self, "response_schema", None) is not None:
  2065 |             tokenizer_config["response_schema"] = self.response_schema
  2066 | 
  2067 |         if len(self.init_inputs) > 0:
  2068 |             tokenizer_config["init_inputs"] = copy.deepcopy(self.init_inputs)
  2069 |         for file_id in self.vocab_files_names:
  2070 |             tokenizer_config.pop(file_id, None)
  2071 | 
  2072 |         # no typefields, this way old fast and slow can load it
  2073 |         tokenizer_config = self.convert_added_tokens(tokenizer_config, add_type_field=True, save=True)
  2074 |         # Process added tokens separately: allows previous versions to ignore it!
  2075 |         added_tokens = {}
  2076 |         for key, value in self.added_tokens_decoder.items():
  2077 |             added_tokens[key] = value.__getstate__()
  2078 |         tokenizer_config["added_tokens_decoder"] = added_tokens
  2079 | 
  2080 |         # Add tokenizer class to the tokenizer config to be able to reload it with from_pretrained
  2081 |         tokenizer_class = self.__class__.__name__
  2082 | 
  2083 |         # tokenizers backend don't need to save added_tokens_decoder and additional_special_tokens
  2084 |         if any(base.__name__ == "TokenizersBackend" for base in self.__class__.__mro__):
  2085 |             tokenizer_config.pop("added_tokens_decoder", None)
  2086 |             tokenizer_config.pop("additional_special_tokens", None)
  2087 | 
  2088 |         # Remove the Fast at the end if we can save the slow tokenizer
  2089 |         if tokenizer_class.endswith("Fast") and getattr(self, "can_save_slow_tokenizer", False):
  2090 |             tokenizer_class = tokenizer_class[:-4]
  2091 |         tokenizer_config["tokenizer_class"] = tokenizer_class
  2092 |         if getattr(self, "_auto_map", None) is not None:
  2093 |             tokenizer_config["auto_map"] = self._auto_map
  2094 |         if getattr(self, "_processor_class", None) is not None:
  2095 |             tokenizer_config["processor_class"] = self._processor_class
  2096 |         tokenizer_config.pop("files_loaded", None)
  2097 |         # If we have a custom model, we copy the file defining it in the folder and set the attributes so it can be
  2098 |         # loaded from the Hub.
  2099 |         if self._auto_class is not None:
  2100 |             custom_object_save(self, save_directory, config=tokenizer_config)
  2101 | 
  2102 |         # remove private information
  2103 |         if "name_or_path" in tokenizer_config:
  2104 |             tokenizer_config.pop("name_or_path")
  2105 |             tokenizer_config.pop("special_tokens_map_file", None)
  2106 |             tokenizer_config.pop("tokenizer_file", None)
  2107 |         if "device_map" in tokenizer_config:
  2108 |             tokenizer_config.pop("device_map")
  2109 |         if "slow_tokenizer_class" in tokenizer_config:
  2110 |             tokenizer_config.pop("slow_tokenizer_class")
  2111 | 
  2112 |         with open(tokenizer_config_file, "w", encoding="utf-8") as f:
  2113 |             out_str = json.dumps(tokenizer_config, indent=2, sort_keys=True, ensure_ascii=False) + "\n"
  2114 |             f.write(out_str)
  2115 |         logger.info(f"tokenizer config file saved in {tokenizer_config_file}")
  2116 | 
  2117 |         # Sanitize AddedTokens in special_tokens_map
  2118 | 
  2119 |         file_names = (tokenizer_config_file, *saved_raw_chat_template_files)
  2120 | 
  2121 |         save_files = self._save_pretrained(
  2122 |             save_directory=save_directory,
  2123 |             file_names=file_names,
  2124 |             legacy_format=legacy_format,
  2125 |             filename_prefix=filename_prefix,
  2126 |         )
  2127 | 
  2128 |         if push_to_hub:
  2129 |             self._upload_modified_files(
  2130 |                 save_directory,
  2131 |                 repo_id,
  2132 |                 files_timestamps,
  2133 |                 commit_message=commit_message,
  2134 |                 token=kwargs.get("token"),
  2135 |             )
  2136 | 
  2137 |         return save_files
