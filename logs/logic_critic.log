  3622 | 
  3623 |             # Update model card if needed:
  3624 |             model_card.save(os.path.join(save_directory, "README.md"))
  3625 | 
  3626 |             self._upload_modified_files(
  3627 |                 save_directory,
  3628 |                 repo_id,
  3629 |                 files_timestamps,
  3630 |                 commit_message=commit_message,
  3631 |                 token=token,
  3632 |                 create_pr=create_pr,
  3633 |             )
