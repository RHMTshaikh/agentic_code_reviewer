  1943 |                     "Unable to load tokenizer model from SPM, loading from TikToken will be attempted instead."
  1944 |                     "(SentencePiece RuntimeError: Tried to load SPM model with non-SPM vocab file).",
  1945 |                 ) from e
  1946 |             else:
  1947 |                 raise e
  1948 |         except OSError:
  1949 |             raise OSError(
  1950 |                 "Unable to load vocabulary from file. "
  1951 |                 "Please check that the provided vocabulary is accessible and not corrupted."
  1952 |             )
