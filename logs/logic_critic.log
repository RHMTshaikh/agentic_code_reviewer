  3359 | def find_sig_line(lines, line_end):
  3360 |     parenthesis_count = 0
  3361 |     sig_line_end = line_end
  3362 |     found_sig = False
  3363 |     while not found_sig:
  3364 |         for char in lines[sig_line_end]:
  3365 |             if char == "(":
  3366 |                 parenthesis_count += 1
  3367 |             elif char == ")":
  3368 |                 parenthesis_count -= 1
  3369 |                 if parenthesis_count == 0:
  3370 |                     found_sig = True
  3371 |                     break
  3372 |         sig_line_end += 1
  3373 |     return sig_line_end
