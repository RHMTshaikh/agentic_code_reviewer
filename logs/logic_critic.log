   179 |     def _strided_intervals(
   180 |         self, intervals: list[tuple[int, int]], rank: int, world_size: int, split_factor: int
   181 |     ) -> list[tuple[int, int]]:
   182 |         narrowed = []
   183 |         for start, end in intervals:
   184 |             group_size = math.ceil((end - start) / split_factor)
   185 |             for group_idx in range(split_factor):
   186 |                 group_start = start + group_idx * group_size
   187 |                 group_end = min(group_start + group_size, end)
   188 |                 if group_end <= group_start:
   189 |                     continue
   190 |                 size, offset = Shard.local_shard_size_and_offset(group_end - group_start, world_size, rank)
   191 |                 if size > 0:
   192 |                     narrowed.append((group_start + offset, group_start + offset + size))
   193 |         return narrowed
