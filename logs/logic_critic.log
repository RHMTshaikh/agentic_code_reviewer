  1361 | def rename_source_key(
  1362 |     source_key: str,
  1363 |     weight_renamings: list[WeightRenaming],
  1364 |     weight_converters: list[WeightConverter],
  1365 |     base_model_prefix: str | None = None,
  1366 |     meta_state_dict: dict | None = None,
  1367 | ) -> tuple[str, str | None]:
  1368 |     """
  1369 |     Rename a checkpoint key by first applying all `WeightRenaming`s, then at most one `WeightConverter`.
  1370 | 
  1371 |     A renaming and a converter may act on the same key in that order: the renaming normalises the
  1372 |     key into the namespace the converter expects. The reverse holds on the save path (converter
  1373 |     first, then renaming). There is no need for a converter-then-rename order because converters
  1374 |     act only on specific leaf patterns; no subsequent renamings should ever target their output.
  1375 | 
  1376 |     Args:
  1377 |         source_key (`str`):
  1378 |             The original checkpoint key to rename.
  1379 |         weight_renamings (`list[WeightRenaming]`):
  1380 |             Applied in order; every matching renaming fires (they may chain).
  1381 |         weight_converters (`list[WeightConverter]`):
  1382 |             Applied after all renamings; at most one may match. Subsequent converters are skipped.
  1383 |         base_model_prefix (`str`, *optional*):
  1384 |             Base-model prefix to add or strip when both `base_model_prefix` and `meta_state_dict` are given.
  1385 |         meta_state_dict (`dict`, *optional*):
  1386 |             Meta state dict used to decide whether `base_model_prefix` should be added or stripped.
  1387 | 
  1388 |     Returns:
  1389 |         `tuple[str, str | None]`: The renamed key and the matched converter's source pattern
  1390 |         (or `None` if no converter matched).
  1391 |     """
  1392 |     renamed_key = source_key
  1393 |     # 1. apply all renamings in turns (if multiple match, it's the responsibility of the mappings to make sure they
  1394 |     # are coherent)
  1395 |     for renaming in weight_renamings:
  1396 |         renamed_key, _ = renaming.rename_source_key(renamed_key)
  1397 | 
  1398 |     # 2. apply renaming through weight conversions on the key if we have any WeightConverter (here we stop after
  1399 |     # the first match, as we assume only 1 converter can match any source key)
  1400 |     source_pattern = None
  1401 |     for converter in weight_converters:
  1402 |         renamed_key, source_pattern = converter.rename_source_key(renamed_key)
  1403 |         if source_pattern is not None:
  1404 |             break
  1405 | 
  1406 |     # 3. check if we need to add or remove base_model_prefix if necessary (only during loading, not saving)
  1407 |     if base_model_prefix is not None and meta_state_dict is not None:
  1408 |         if (
  1409 |             renamed_key.startswith(base_model_prefix)
  1410 |             and meta_state_dict.get(re.sub(f"^{base_model_prefix}.", "", renamed_key, count=1)) is not None
  1411 |         ):
  1412 |             renamed_key = re.sub(f"^{base_model_prefix}.", "", renamed_key, count=1)
  1413 |         elif meta_state_dict.get(f"{base_model_prefix}.{renamed_key}") is not None:
  1414 |             renamed_key = f"{base_model_prefix}.{renamed_key}"
  1415 | 
  1416 |     return renamed_key, source_pattern
