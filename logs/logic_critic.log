   922 |             tensors = self.collected_tensors.pop(key)
   923 |             # Async loading
   924 |             if isinstance(tensors[0], Future):
   925 |                 tensors = [future.result() for future in tensors if future.result() is not None]
   926 |             # Sync loading
   927 |             elif callable(tensors[0]):
   928 |                 tensors = [func() for func in tensors]
