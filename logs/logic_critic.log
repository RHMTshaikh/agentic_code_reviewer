  1432 |         "model.layers.0.attention.q.weight": # Notice here there is only the first key of the target keys
  1433 |             WeightConverter(
  1434 |                 source_patterns=["qkv"],
  1435 |                 target_patterns=["q", "k","v"],
  1436 |                 operations=[Chunk(dim=0, chunks=3)]),
  1437 |                 collected_tensors={
  1438 |                     "qkv": [Future]},
  1439 |                 layer_targets={
  1440 |                     "model.layers.0.attention.q.weight": {"model.layers.0.attention.qkv.weight"},
  1441 |                     "model.layers.0.attention.k.weight": {"model.layers.0.attention.qkv.weight"},
  1442 |                     "model.layers.0.attention.v.weight": {"model.layers.0.attention.qkv.weight"},
  1443 |                 }
  1444 |             ),
  1445 |         ...
  1446 |     }
