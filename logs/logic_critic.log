  10 | class Line_3D:
  11 |     def __init__(self, point1: np.ndarray, point2: np.ndarray, direction: np.ndarray):
  12 |         """
  13 |         Initializes a Line_3D instance with two points.
  14 | 
  15 |         Args:
  16 |             point1 (np.ndarray): A 3-element array representing the first point.
  17 |             point2 (np.ndarray): A 3-element array representing the second point.
  18 |             direction (np.ndarray): A 3-element array representing the direction vector.
  19 |         """
  20 |         self.point1 = point1
  21 |         self.point2 = point2
  22 |         self.direction = direction / np.linalg.norm(direction)
  23 |     
  24 |     def rotate(self, line: "Line_3D", angle_rad: float):
  25 |         """
  26 |         Rotates the line around a given direction vector by a specified angle.
  27 | 
  28 |         Args:
  29 |             direction_vector (np.ndarray): A 3-element array representing the rotation axis.
  30 |             angle_rad (float): The rotation angle in radians.
  31 |         """
  32 |         rect = Rect_2D(min(point1[0], point2[0]), min(point1[1], point2[1]), max(point1[0], point2[0]), max(point1[1], point2[1]))
  33 | 
  34 |         R = _build_rotation_matrix(line.direction, angle_rad)
  35 |         self.point1 = R @ (self.point1 - line.point1) + line.point1 
  36 |         self.point2 = R @ (self.point2 - line.point1) + line.point1 
  37 |         d = self.point2 - self.point1
  38 |         self.direction = d / np.linalg.norm(d)
  39 |     
  40 |     def intersection_point(self, other: "Line_3D") -> np.ndarray:
  41 |         """
  42 |         Computes the intersection point of this line with another line in 3D space.
  43 | 
  44 |         Args:
  45 |             other (Line_3D): Another Line_3D instance.
  46 | 
  47 |         Returns:
  48 |             np.ndarray: A 3-element array representing the intersection point.
  49 |         """
  50 |         p1 = self.point1
  51 |         d1 = self.direction
  52 |         p2 = other.point1
  53 |         d2 = other.direction
  54 | 
  55 |         cross_d1_d2 = np.cross(d1, d2)
  56 |         denom = np.linalg.norm(cross_d1_d2) ** 2
  57 | 
  58 |         if np.isclose(denom, 0):
  59 |             raise ValueError("Lines are parallel and do not intersect.")
  60 | 
  61 |         t = np.dot(np.cross((p2 - p1), d2), cross_d1_d2) / denom
  62 |         intersection = p1 + t * d1
  63 |         return intersection
  64 |     
  65 |     def does_intersect_on_rect(self, line: "Line_3D", rect: Rect_2D) -> bool:
  66 |         points1 = rect.boundary_points_on_line(self)
  67 |         points2 = rect.boundary_points_on_line(line)
  68 | 
  69 |         if len(points1) < 2 or len(points2) < 2:
  70 |             return False
  71 | 
  72 |         p1_start, p1_end = points1[0], points1[1]
  73 |         p2_start, p2_end = points2[0], points2[1]
  74 | 
  75 |         def ccw(A, B, C):
  76 |             return (C[1]-A[1]) * (B[0]-A[0]) > (B[1]-A[1]) * (C[0]-A[0])
  77 | 
  78 |         return ccw(p1_start, p2_start, p2_end) != ccw(p1_end, p2_start, p2_end) and ccw(p1_start, p1_end, p2_start) != ccw(p1_start, p1_end, p2_end)    
  79 |     
  80 |     def set_boundary_points(self, rect: Rect_2D):
  81 |         if not rect.contains_line(self):
  82 |             raise ValueError("The line does not pass through the rectangle.")
  83 |         
  84 |         (x1, y1), (x2, y2) = rect.boundary_points_on_line(self)
  85 |         self.point1 = np.array([x1, y1, 0])
  86 |         self.point2 = np.array([x2, y2, 0])
  87 |         direction = self.point2 - self.point1
  88 |         self.direction = direction / np.linalg.norm(direction)


