   908 |     def materialize_tensors(self) -> dict[str, list[torch.Tensor]]:
   909 |         """
   910 |         Materialize all the tensors that were saved in `self.collected_tensors`. This function removes them from the
   911 |         internal attribute to avoid keeping them in memory during the different `self.convert` operations, and return
   912 |         a new dictionary (otherwise we use more memory than needed during loading).
   913 | 
   914 |         We basically have 3 cases here:
   915 |         - async loading (default): the tensors are Future instances that we need to wait for
   916 |         - sync loading: the tensors are Callable, we need to call the Callable to actually load them from disk
   917 |         - saving: the tensors are already torch.Tensor instances (the existing model weights)
   918 |         """
   919 |         collected_tensors = {}
   920 |         for key in list(self.collected_tensors.keys()):
   921 |             # Remove from internal attribute
   922 |             tensors = self.collected_tensors.pop(key)
   923 |             # Async loading
   924 |             if isinstance(tensors[0], Future):
   925 |                 tensors = [future.result() for future in tensors if future.result() is not None]
   926 |             # Sync loading
   927 |             elif callable(tensors[0]):
   928 |                 tensors = [func() for func in tensors]
   929 |                 # Some may be None for some distributed setups
   930 |                 tensors = [tensor for tensor in tensors if tensor is not None]
   931 |             # Add them to the new dictionary
   932 |             collected_tensors[key] = tensors
   933 | 
   934 |         return collected_tensors
