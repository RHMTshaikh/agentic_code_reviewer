   440 |         self.position_ids[: len(position_ids)] = to_tensor(position_ids)
   441 |         self.cumulative_seqlens_q[: len(cumulative_seqlens_q)] = to_tensor(cumulative_seqlens_q)
   442 |         self.logits_indices[: len(logits_indices)] = to_tensor(logits_indices)
   443 | 
   444 |         # Those kwargs are either dict of tensors or tensors, so we need to handle both cases
   445 |         for layer_type, layer_type_seqlens_k in cumulative_seqlens_k.items():
   446 |             total_seqlen_k = layer_type_seqlens_k[-1]
   447 |             self.total_seqlen_k[layer_type] = total_seqlen_k
   448 |             layer_type_seqlens_k.extend(repeat(total_seqlen_k, fake_sequences))
   449 |             self.cumulative_seqlens_k[layer_type][: len(layer_type_seqlens_k)] = to_tensor(layer_type_seqlens_k)
   450 | 
   451 |         # If we are not using the block table, we populate the write indices (and maybe the read indices)
   452 |         if not self.use_block_table:
   453 |             to_index_tensor = partial(torch.tensor, dtype=torch.int64, device=self.device)
