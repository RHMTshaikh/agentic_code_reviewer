  2795 |     @staticmethod
  2796 |     def _apply_legacy_fsdp_to_config(fsdp, fsdp_config):
  2797 |         """
  2798 |         Translate legacy `fsdp` values (string / list of [`~trainer_utils.FSDPOption`]) into
  2799 |         `fsdp_config` entries, using the shape expected by the target FSDP version:
  2800 | 
  2801 |         - `"offload"` → `fsdp_config["cpu_offload"] = True`
  2802 |         - Sharding strategies → `fsdp_config["reshard_after_forward"]`. For FSDP2 this is a
  2803 |           bool (`"full_shard"` → `True`, `"shard_grad_op"` → `False`); for FSDP1 it is the
  2804 |           lowercase strategy name (`"full_shard"`, `"hybrid_shard"`, ...).
  2805 |         - `"auto_wrap"` → no-op (default `auto_wrap_policy` already wraps).
  2806 | 
  2807 |         Isolated so the deprecated path can be removed in one place once support is dropped.
  2808 |         """
  2809 |         if isinstance(fsdp, str):
  2810 |             logger.warning(
  2811 |                 "Passing `fsdp` as a string is deprecated and will be removed in Transformers v5.20. "
  2812 |                 "Use `fsdp=True` and configure everything via `fsdp_config` instead."
  2813 |             )
  2814 |             items = fsdp.split()
  2815 |         else:
  2816 |             logger.warning(
  2817 |                 "Passing `fsdp` as a list is deprecated and will be removed in Transformers v5.20. "
  2818 |                 "Use `fsdp=True` and configure everything via `fsdp_config` instead."
  2819 |             )
  2820 |             items = list(fsdp)
  2821 | 
  2822 |         from accelerate.utils.constants import FSDP_SHARDING_STRATEGY
  2823 | 
  2824 |         version = int(fsdp_config.get("version", 2))
  2825 |         for item in items:
  2826 |             if item.upper() in FSDP_SHARDING_STRATEGY:
  2827 |                 if version == 2:
  2828 |                     # FSDP2 `reshard_after_forward` is a bool; only full_shard / shard_grad_op
  2829 |                     # are supported. The other strategies are FSDP1-only.
  2830 |                     if item == FSDPOption.FULL_SHARD:
  2831 |                         fsdp_config.setdefault("reshard_after_forward", True)
  2832 |                     elif item == FSDPOption.SHARD_GRAD_OP:
  2833 |                         fsdp_config.setdefault("reshard_after_forward", False)
  2834 |                     else:
  2835 |                         raise ValueError(
  2836 |                             f"`fsdp={item}` is only available with FSDP1. Set `fsdp_config['version'] = 1` to "
  2837 |                             f"use it, but note that FSDP1 is deprecated and will be removed in Transformers v5.20."
  2838 |                         )
  2839 |                 else:
  2840 |                     fsdp_config.setdefault("reshard_after_forward", item)
  2841 |             elif item == FSDPOption.OFFLOAD:
  2842 |                 fsdp_config.setdefault("cpu_offload", True)
  2843 |             elif item == FSDPOption.AUTO_WRAP:
  2844 |                 pass
  2845 |             else:
  2846 |                 raise ValueError(f"Unknown `fsdp` option: {item}")
