  1955 |     @classmethod
  1956 |     def convert_to_native_format(cls, **kwargs):
  1957 |         return kwargs
  1958 | 
  1959 |     @classmethod
  1960 |     def convert_added_tokens(cls, obj: AddedToken | Any, save=False, add_type_field=True):
  1961 |         if isinstance(obj, dict) and "__type" in obj and obj["__type"] == "AddedToken":
  1962 |             obj.pop("__type")
  1963 |             return AddedToken(**obj)
  1964 |         if isinstance(obj, AddedToken) and save:
  1965 |             obj = obj.__getstate__()
  1966 |             if add_type_field:
  1967 |                 obj["__type"] = "AddedToken"
  1968 |             else:
  1969 |                 # Don't save "special" for previous tokenizers
  1970 |                 obj.pop("special")
  1971 |             return obj
  1972 |         elif isinstance(obj, (list, tuple)):
  1973 |             return [cls.convert_added_tokens(o, save=save, add_type_field=add_type_field) for o in obj]
  1974 |         elif isinstance(obj, dict):
  1975 |             return {k: cls.convert_added_tokens(v, save=save, add_type_field=add_type_field) for k, v in obj.items()}
  1976 |         return obj
