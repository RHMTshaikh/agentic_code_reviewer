  4287 |             state_dict = load_gguf_checkpoint(
  4288 |                 checkpoint_files[0], return_tensors=True, model_to_load=dummy_model, torch_dtype=dtype
  4289 |             )["tensors"]
  4290 | 
  4291 |         config.name_or_path = pretrained_model_name_or_path
  4292 | 
  4293 |         # Overwrite `config.fusion_config` if it is provided.
  4294 |         if fusion_config is not None:
  4295 |             config.fusion_config = copy.deepcopy(fusion_config)
  4296 | 
  4297 |         # Register fusion patches
  4298 |         fusion_config = getattr(config, "fusion_config", None)
  4299 |         if fusion_config is not None:
  4300 |             from .fusion_mapping import register_fusion_patches
  4301 | 
