  2399 |                 "Asking to pad but the tokenizer does not have a padding token. "
  2400 |                 "Please select a token to use as `pad_token` `(tokenizer.pad_token = tokenizer.eos_token e.g.)` "
  2401 |                 "or add a new pad token via `tokenizer.add_special_tokens({'pad_token': '[PAD]'})`."
  2402 |             )
  2403 | 
  2404 |         # Check that we will truncate to a multiple of pad_to_multiple_of if both are provided
  2405 |         if (
  2406 |             truncation_strategy != TruncationStrategy.DO_NOT_TRUNCATE
  2407 |             and padding_strategy != PaddingStrategy.DO_NOT_PAD
  2408 |             and pad_to_multiple_of is not None
  2409 |             and max_length is not None
  2410 |             and (max_length % pad_to_multiple_of != 0)
  2411 |         ):
  2412 |             raise ValueError(
  2413 |                 "Truncation and padding are both activated but "
  2414 |                 f"truncation length ({max_length}) is not a multiple of pad_to_multiple_of ({pad_to_multiple_of})."
  2415 |             )
