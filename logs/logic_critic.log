  2734 |                 inputs,
  2735 |                 max_length=max_length,
  2736 |                 padding_strategy=padding_strategy,
  2737 |                 pad_to_multiple_of=pad_to_multiple_of,
  2738 |                 padding_side=padding_side,
  2739 |                 return_attention_mask=return_attention_mask,
  2740 |             )
