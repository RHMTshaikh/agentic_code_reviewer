  2604 | def parse_shape(docstring):
  2605 |     match = _re_shape.search(docstring)
  2606 |     if match:
  2607 |         return " " + match.group(1)
  2608 |     return None
  2609 | 
  2610 | 
  2611 | def parse_default(docstring):
  2612 |     match = _re_default.search(docstring)
  2613 |     if match:
  2614 |         return " " + match.group(1)
  2615 |     return None
