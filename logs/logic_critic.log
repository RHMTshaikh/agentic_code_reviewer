   352 | class MiniCPM3DecoderLayer(GradientCheckpointingLayer):
   353 |     def __init__(self, config: MiniCPM3Config, layer_idx: int):
   354 |         super().__init__()
   355 |         self.hidden_size = config.hidden_size
   356 | 
   357 |         self.self_attn = MiniCPM3Attention(config=config, layer_idx=layer_idx)
