   289 |             text = [text]
   290 | 
   291 |         if not isinstance(text, list) or not all(isinstance(token, str) for token in text):
   292 |             raise ValueError("`text` must be a string or list of strings.")
   293 | 
   294 |         if isinstance(images, list) and len(images) != len(text):
   295 |             raise ValueError(f"Number of images ({len(images)}) must match number of texts ({len(text)}).")
   296 | 
   297 |         prompt_strings = self._construct_prompts(text)
