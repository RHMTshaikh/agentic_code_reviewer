  2384 |         # NOTE: new models need to use existing names for layers if possible, so this list doesn't grow infinitely
  2385 |         if modality in ["image", "video"]:
  2386 |             possible_module_names = ["vision_tower", "visual", "vision_model", "vision_encoder", "image_tower"]
  2387 |         elif modality == "audio":
  2388 |             possible_module_names = ["audio_tower", "audio_encoder"]
  2389 |         elif modality is None:
  2390 |             possible_module_names = ["text_encoder", "encoder"]
  2391 |         else:
  2392 |             raise ValueError(f'Unnrecognized modality, has to be "image", "video" or "audio" but found {modality}')
  2393 | 
  2394 |         for name in possible_module_names:
  2395 |             if hasattr(self, name):
  2396 |                 setattr(self, name, encoder)
  2397 |                 return
  2398 | 
  2399 |         if self.base_model is not self:
  2400 |             if hasattr(self.base_model, "set_encoder"):
  2401 |                 self.base_model.set_encoder(encoder, modality=modality)
  2402 |             else:
  2403 |                 self.model = encoder
  2404 | 
  2405 |     def get_decoder(self):
  2406 |         """
  2407 |         Best-effort lookup of the *decoder* module.
  2408 | 
  2409 |         Order of attempts (covers ~85 % of current usages):
  2410 | 
  2411 |         1. `self.decoder/self.language_model/self.text_model`
  2412 |         2. `self.base_model`                  (many wrappers store the decoder here)
  2413 |         3. `self.base_model.get_decoder()`    (nested wrappers)
  2414 |         4. fallback: raise for the few exotic models that need a bespoke rule
  2415 |         """
  2416 |         possible_module_names = ["language_model", "text_model", "decoder", "text_decoder"]
  2417 |         for name in possible_module_names:
  2418 |             if hasattr(self, name):
  2419 |                 return getattr(self, name)
  2420 | 
  2421 |         if self.base_model is not self and hasattr(self.base_model, "get_decoder"):
  2422 |             return self.base_model.get_decoder()
  2423 | 
  2424 |         # If this is a base transformer model (no decoder/model attributes), return self
  2425 |         # This handles cases like MistralModel which is itself the decoder
  2426 |         return self
