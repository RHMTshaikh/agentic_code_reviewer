   233 |                         )
   234 |                     logger.info(message)
   235 | 
   236 |             # Update all values in `vision_config` with the ones in `_vision_config_dict`.
   237 |             vision_config.update(_vision_config_dict)
   238 | 
   239 |         # Finally we can convert back our unified text/vision configs to `PretrainedConfig`
   240 |         self.text_config = AltCLIPTextConfig(**text_config)
   241 |         self.vision_config = AltCLIPVisionConfig(**vision_config)
   242 | 
