  3249 | def _process_regular_parameters(
  3250 |     sig,
  3251 |     func,
  3252 |     class_name,
  3253 |     documented_params,
  3254 |     indent_level,
  3255 |     undocumented_parameters,
  3256 |     source_args_dict,
  3257 |     parent_class,
  3258 |     allowed_params=None,
