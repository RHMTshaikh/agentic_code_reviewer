  1323 |     def __init_subclass__(cls, **kwargs):
  1324 |         super().__init_subclass__(**kwargs)
  1325 |         # For BC we keep the original `config_class` definition in case
  1326 |         # there is a `config_class` attribute (e.g. remote code models),
  1327 |         # otherwise we derive it from the annotated `config` attribute.
  1328 | 
  1329 |         # defined in this particular subclass
  1330 |         child_annotation = inspect.get_annotations(cls).get("config", None)
  1331 |         child_attribute = cls.__dict__.get("config_class", None)
  1332 | 
  1333 |         # defined in the class (this subclass or any parent class)
  1334 |         full_annotation = get_type_hints(cls).get("config", None)
  1335 |         full_attribute = cls.config_class
  1336 | 
  1337 |         # priority (child class_config -> child annotation -> global class_config -> global annotation)
  1338 |         if child_attribute is not None:
  1339 |             cls.config_class = child_attribute
  1340 |         elif child_annotation is not None:
  1341 |             cls.config_class = child_annotation
  1342 |         elif full_attribute is not None:
  1343 |             cls.config_class = full_attribute
  1344 |         elif full_annotation is not None:
  1345 |             cls.config_class = full_annotation
  1346 | 
  1347 |     def __init__(self, config: PreTrainedConfig, *inputs, **kwargs):
  1348 |         super().__init__()
  1349 |         if not isinstance(config, PreTrainedConfig):
  1350 |             raise TypeError(
  1351 |                 f"Parameter config in `{self.__class__.__name__}(config)` should be an instance of class "
  1352 |                 "`PreTrainedConfig`. To create a model from a pretrained model use "
  1353 |                 f"`model = {self.__class__.__name__}.from_pretrained(PRETRAINED_MODEL_NAME)`"
  1354 |             )
  1355 |         self.config = config
  1356 |         self.name_or_path = config.name_or_path
  1357 | 
  1358 |         # Make kernel_config an attribute that can be used by the model.
  1359 |         self.kernel_config = None
  1360 | 
  1361 |         # Check the attention implementation is supported, or set it if not yet set (on the internal attr, to avoid
  1362 |         # setting it recursively)
  1363 |         self.config._attn_implementation_internal = self._check_and_adjust_attn_implementation(
  1364 |             self.config._attn_implementation,
  1365 |             is_init_check=True,
  1366 |             # We need to use this constant that is set through context manager as it cannot be forwarded in the model's __init__
  1367 |             allow_all_kernels=hub_kernels.ALLOW_ALL_KERNELS,
  1368 |         )
  1369 |         # Check the experts implementation is supported, or set it if not yet set (on the internal attr, to avoid
  1370 |         # setting it recursively)
  1371 |         self.config._experts_implementation_internal = self._check_and_adjust_experts_implementation(
  1372 |             self.config._experts_implementation
  1373 |         )
  1374 |         if self.can_generate():
  1375 |             # `from_model_config` is a legacy behavior -- we shouldn't set generation flags in the model config
  1376 |             try:
  1377 |                 self.generation_config = self.generation_config_class.from_model_config(config)
  1378 |             except NotImplementedError:
  1379 |                 self.generation_config = self.generation_config_class()
  1380 | 
  1381 |         # for initialization of the loss
  1382 |         loss_type = self.__class__.__name__
  1383 |         if loss_type not in LOSS_MAPPING:
  1384 |             loss_groups = f"({'|'.join(LOSS_MAPPING)})"
  1385 |             loss_type = re.findall(loss_groups, self.__class__.__name__)
  1386 |             if len(loss_type) > 0:
  1387 |                 loss_type = loss_type[0]
  1388 |             else:
  1389 |                 loss_type = None
  1390 |         self.loss_type = loss_type
  1391 | 
  1392 |         _CAN_RECORD_REGISTRY[str(self.__class__)] = self._can_record_outputs  # added for executorch support only
  1393 | 
  1394 |     def post_init(self):
  1395 |         """
  1396 |         A method executed at the end of each Transformer model initialization, to execute code that needs the model's
  1397 |         modules properly initialized (such as weight initialization).
  1398 |         It is also used to obtain all correct static properties (parallelism plans, tied_weights_keys, _keep_in_fp32_modules, etc)
  1399 |         correctly in the case of composite models (that is, the top level model should know about those properties from its children).
  1400 |         """
  1401 |         # Attach the different parallel plans and tied weight keys to the top-most model, so that everything is
  1402 |         # easily available.
  1403 |         self._tp_plan, self._ep_plan, self._pp_plan, self._fsdp_plan = {}, {}, {}, {}
  1404 |         # If current model is a base model, attach `base_model_tp_plan` and `base_model_pp_plan` from config
  1405 |         if self.base_model is self:
  1406 |             self._pp_plan = self.config.base_model_pp_plan.copy() if self.config.base_model_pp_plan is not None else {}
  1407 |             self._tp_plan = self.config.base_model_tp_plan.copy() if self.config.base_model_tp_plan is not None else {}
  1408 |             self._ep_plan = self.config.base_model_ep_plan.copy() if self.config.base_model_ep_plan is not None else {}
  1409 |             self._fsdp_plan = (
  1410 |                 self.config.base_model_fsdp_plan.copy() if self.config.base_model_fsdp_plan is not None else {}
  1411 |             )
  1412 |         # Current submodel should register its tied weights
  1413 |         self.all_tied_weights_keys = self.get_expanded_tied_weights_keys(all_submodels=False)
  1414 |         # Current submodel should register its `_keep_in_fp32_modules`
  1415 |         self._keep_in_fp32_modules = set(self._keep_in_fp32_modules or [])
  1416 |         self._keep_in_fp32_modules_strict = set(self._keep_in_fp32_modules_strict or [])
  1417 |         # Current submodel must register its `_no_split_modules`/`_skip_keys_device_placement` as well for device_map
  1418 |         self._no_split_modules = set(self._no_split_modules or [])
  1419 |         self._skip_keys_device_placement = set(self._skip_keys_device_placement or [])
  1420 |         # Current submodel must register the `_keys_to_ignore_on_load_unexpected/missing`
  1421 |         self._keys_to_ignore_on_load_unexpected = set(self._keys_to_ignore_on_load_unexpected or [])
  1422 |         self._keys_to_ignore_on_load_missing = set(self._keys_to_ignore_on_load_missing or [])
  1423 |         self._keys_to_ignore_on_save = set(self._keys_to_ignore_on_save or [])
  1424 | 
  1425 |         # Iterate over children only: as the final model is created, this is enough to gather the properties from all submodels.
  1426 |         # This works because the way the `__init__` and `post_init` are called on all submodules is depth-first in the graph
  1427 |         for name, module in self.named_children():
  1428 |             # Parallel plans
  1429 |             if plan := getattr(module, "_ep_plan", None):
  1430 |                 self._ep_plan.update({f"{name}.{k}": v for k, v in plan.copy().items()})
  1431 |             if plan := getattr(module, "_tp_plan", None):
  1432 |                 self._tp_plan.update({f"{name}.{k}": v for k, v in plan.copy().items()})
  1433 |             if plan := getattr(module, "_pp_plan", None):
  1434 |                 self._pp_plan.update({f"{name}.{k}": v for k, v in plan.copy().items()})
  1435 |             if plan := getattr(module, "_fsdp_plan", None):
  1436 |                 self._fsdp_plan.update({f"{name}.{k}": v for k, v in plan.copy().items()})
  1437 |             # Always attach the keys of the children (if the children's config says to NOT tie, then it's empty)
  1438 |             if tied_keys := getattr(module, "all_tied_weights_keys", None):
  1439 |                 self.all_tied_weights_keys.update({f"{name}.{k}": f"{name}.{v}" for k, v in tied_keys.copy().items()})
  1440 |             # Record keep_in_fp_32 modules from the children as well
  1441 |             if keep_fp32 := getattr(module, "_keep_in_fp32_modules", None):
  1442 |                 self._keep_in_fp32_modules.update(keep_fp32)
  1443 |             if keep_fp32_strict := getattr(module, "_keep_in_fp32_modules_strict", None):
  1444 |                 self._keep_in_fp32_modules_strict.update(keep_fp32_strict)
  1445 |             # Record `_no_split_modules`/`_skip_keys_device_placement` from the children
  1446 |             if no_split := getattr(module, "_no_split_modules", None):
  1447 |                 self._no_split_modules.update(no_split)
  1448 |             if skip_keys := getattr(module, "_skip_keys_device_placement", None):
  1449 |                 self._skip_keys_device_placement.update(skip_keys)
  1450 |             # Record `_keys_to_ignore_on_load_unexpected/missing` from the children - note that we do not add the name (prefix)
  1451 |             # of the current module to the child's key, as this is matched by regex anyway and adding prefix could break the regex
  1452 |             if ignore_unexpected := getattr(module, "_keys_to_ignore_on_load_unexpected", None):
  1453 |                 self._keys_to_ignore_on_load_unexpected.update(ignore_unexpected)
  1454 |             if ignore_missing := getattr(module, "_keys_to_ignore_on_load_missing", None):
  1455 |                 self._keys_to_ignore_on_load_missing.update(ignore_missing)
  1456 |             # This one is matched exactly, not by regex, so we need to add the prefix
  1457 |             if ignore_save := getattr(module, "_keys_to_ignore_on_save", None):
  1458 |                 self._keys_to_ignore_on_save.update({f"{name}.{k}" for k in ignore_save})
  1459 | 
  1460 |         # Maybe initialize the weights and tie the keys
  1461 |         self.init_weights()
  1462 |         self._backward_compatibility_gradient_checkpointing()
  1463 | 
  1464 |     @property
  1465 |     def tp_plan(self) -> dict[str, str]:
  1466 |         """
  1467 |         The full tp plan for the model's modules
  1468 |         """
  1469 |         if hasattr(self.config, "distributed_config") and self.config.distributed_config.enable_expert_parallel:
  1470 |             return self._ep_plan
  1471 |         return self._tp_plan
  1472 | 
  1473 |     @property
  1474 |     def fsdp_plan(self) -> dict[str, str]:
  1475 |         return self._fsdp_plan
  1476 | 
  1477 |     @property
  1478 |     def pp_plan(self) -> dict[str, tuple[str, str]]:
  1479 |         return self._pp_plan
  1480 | 
  1481 |     @tp_plan.setter
  1482 |     def tp_plan(self, plan: dict[str, str] | None):
  1483 |         if plan is None:
  1484 |             self._tp_plan = {}
  1485 |             return
  1486 |         if not isinstance(plan, dict):
  1487 |             raise ValueError("Can only set a dictionary as `tp_plan`")
  1488 | 
  1489 |         # Ensure the styles are all valid
  1490 |         for layer_pattern, parallel_style in plan.items():
  1491 |             if parallel_style not in ALL_PARALLEL_STYLES:
  1492 |                 raise ValueError(
  1493 |                     f"Unsupported tensor parallel style '{parallel_style}' for layer '{layer_pattern}'. "
  1494 |                     f"Supported styles are {list(ALL_PARALLEL_STYLES.keys())}"
  1495 |                 )
  1496 | 
  1497 |         # Validate that the layer patterns match existing model structure. We check this by getting all parameter
  1498 |         # names and seeing if any match the patterns
  1499 |         model_param_names = [name for name, _ in self.named_parameters()]
  1500 |         for layer_pattern in plan.keys():
  1501 |             # Convert pattern to regex (replace * with .*)
  1502 |             regex_pattern = layer_pattern.replace("*", r"\d+")
  1503 |             pattern_matched = False
  1504 |             for param_name in model_param_names:
  1505 |                 if re.match(regex_pattern, param_name):
  1506 |                     pattern_matched = True
  1507 |                     break
  1508 |             if not pattern_matched:
  1509 |                 warnings.warn(
  1510 |                     f"Layer pattern '{layer_pattern}' does not match any parameters in the model. This rule may not "
  1511 |                     "be applied during tensor parallelization, or may lead to dimension mismatches"
  1512 |                 )
  1513 | 
  1514 |         # Set the plan
  1515 |         self._tp_plan = plan
  1516 | 
  1517 |     @pp_plan.setter
  1518 |     def pp_plan(self, plan: dict[str, tuple[str, str]] | None):
  1519 |         if plan is None:
  1520 |             self._pp_plan = {}
  1521 |             return
  1522 |         if not isinstance(plan, dict):
  1523 |             raise ValueError("Can only set a dictionary as `pp_plan`")
  1524 | 
  1525 |         self._pp_plan = plan
  1526 | 
  1527 |     def dequantize(self, dtype=None):
  1528 |         """
  1529 |         Potentially dequantize the model in case it has been quantized by a quantization method that support
  1530 |         dequantization.
  1531 |         """
  1532 |         hf_quantizer = getattr(self, "hf_quantizer", None)
  1533 | 
  1534 |         if hf_quantizer is None:
  1535 |             raise ValueError("You need to first quantize your model in order to dequantize it")
  1536 | 
  1537 |         return hf_quantizer.dequantize(self, dtype=dtype)
  1538 | 
  1539 |     def _backward_compatibility_gradient_checkpointing(self):
  1540 |         if self.supports_gradient_checkpointing and getattr(self.config, "gradient_checkpointing", False):
  1541 |             self.gradient_checkpointing_enable()
  1542 |             # Remove the attribute now that is has been consumed, so it's no saved in the config.
  1543 |             delattr(self.config, "gradient_checkpointing")
  1544 | 
  1545 |     def add_model_tags(self, tags: list[str] | str) -> None:
  1546 |         r"""
  1547 |         Add custom tags into the model that gets pushed to the Hugging Face Hub. Will
  1548 |         not overwrite existing tags in the model.
  1549 | 
  1550 |         Args:
  1551 |             tags (`Union[list[str], str]`):
  1552 |                 The desired tags to inject in the model
  1553 | 
  1554 |         Examples:
  1555 | 
  1556 |         ```python
  1557 |         from transformers import AutoModel
  1558 | 
  1559 |         model = AutoModel.from_pretrained("google-bert/bert-base-cased")
  1560 | 
  1561 |         model.add_model_tags(["custom", "custom-bert"])
  1562 | 
  1563 |         # Push the model to your namespace with the name "my-custom-bert".
  1564 |         model.push_to_hub("my-custom-bert")
  1565 |         ```
  1566 |         """
  1567 |         if isinstance(tags, str):
  1568 |             tags = [tags]
  1569 | 
  1570 |         if self.model_tags is None:
  1571 |             self.model_tags = []
  1572 | 
  1573 |         for tag in tags:
  1574 |             if tag not in self.model_tags:
  1575 |                 self.model_tags.append(tag)
  1576 | 
  1577 |     @classmethod
  1578 |     def _from_config(cls, config, **kwargs):
  1579 |         """
  1580 |         All context managers that the model should be initialized under go here.
  1581 | 
  1582 |         Args:
  1583 |             dtype (`torch.dtype`, *optional*):
  1584 |                 Override the default `dtype` and load the model under this dtype.
  1585 |         """
  1586 |         # For BC on the old `torch_dtype`
  1587 |         dtype = kwargs.pop("dtype", config.dtype)
  1588 |         if (torch_dtype := kwargs.pop("torch_dtype", None)) is not None:
  1589 |             logger.warning_once("`torch_dtype` is deprecated! Use `dtype` instead!")
  1590 |             # if both kwargs are provided, use `dtype`
  1591 |             dtype = dtype if dtype != config.dtype else torch_dtype
  1592 |         if isinstance(dtype, str):
  1593 |             dtype = getattr(torch, dtype)
  1594 | 
  1595 |         # Keep the resolved `dtype` on the config so it matches the actual weights, the same way
  1596 |         # `from_pretrained` does. Also set it on all subconfigs to avoid dtype mismatch. When "auto"
  1597 |         # dtype with nested models, we can't dispatch different dtype per backbone module
  1598 |         config.dtype = dtype
  1599 |         for sub_config_key in config.sub_configs:
  1600 |             if (sub_config := getattr(config, sub_config_key)) is not None:
  1601 |                 sub_config.dtype = dtype
  1602 | 
  1603 |         # If passing `attn_implementation` as kwargs, respect it (it will be applied recursively on subconfigs)
  1604 |         if "attn_implementation" in kwargs:
  1605 |             config._attn_implementation = kwargs.pop("attn_implementation")
  1606 | 
  1607 |         # If passing `experts_implementation` as kwargs, respect it (it will be applied recursively on subconfigs)
  1608 |         if "experts_implementation" in kwargs:
  1609 |             config._experts_implementation = kwargs.pop("experts_implementation")
  1610 | 
  1611 |         # Needed if the attn_implementation is an outside `kernels-community` kernel
  1612 |         allow_all_kernels = kwargs.get("allow_all_kernels", False)
  1613 | 
  1614 |         init_contexts = [apply_patches()]
  1615 |         if dtype is not None:
  1616 |             init_contexts.append(local_torch_dtype(dtype, cls.__name__))
  1617 |         if allow_all_kernels:
  1618 |             init_contexts.append(allow_all_hub_kernels())
  1619 | 
  1620 |         needs_zero3_init = is_deepspeed_zero3_enabled() and not _is_quantized and not _is_ds_init_called
  1621 |         if needs_zero3_init:
  1622 |             logger.info("Detected DeepSpeed ZeRO-3: activating zero.init() for this model")
  1623 |             # this immediately partitions the model across all gpus, to avoid the overhead in time
  1624 |             # and memory copying it on CPU or each GPU first
  1625 |             import deepspeed
  1626 | 
  1627 |             init_contexts.extend(
  1628 |                 [
  1629 |                     init.no_init_weights(),
  1630 |                     deepspeed.zero.Init(config_dict_or_path=deepspeed_config()),
  1631 |                     set_zero3_state(),
  1632 |                 ]
  1633 |             )
  1634 | 
  1635 |         # Instantiate the model
  1636 |         with ContextManagers(init_contexts):
  1637 |             model = cls(config, **kwargs)
  1638 |             patch_output_recorders(model)
  1639 | 
  1640 |         # Under ZeRO-3, parameters were partitioned into empty tensors during construction,
  1641 |         # so weight init was suppressed. Re-initialize using the ZeRO-3 variant which gathers
  1642 |         # each module's parameters before init to avoid OOM on large models.
  1643 |         if needs_zero3_init:
  1644 |             from .integrations.deepspeed import initialize_weights_zero3
  1645 | 
  1646 |             initialize_weights_zero3(model)
  1647 |             model.tie_weights()
  1648 | 
  1649 |         return model
  1650 | 
  1651 |     @property
  1652 |     def base_model(self) -> nn.Module:
  1653 |         """
  1654 |         `torch.nn.Module`: The main body of the model.
  1655 |         """
  1656 |         return getattr(self, self.base_model_prefix, self)
  1657 | 
  1658 |     @classmethod
  1659 |     def can_generate(cls) -> bool:
  1660 |         """
  1661 |         Returns whether this model can generate sequences with `.generate()`, from the `GenerationMixin`
  1662 |         or one with a similar interface.
  1663 | 
  1664 |         Under the hood, on classes where this function returns True, some generation-specific changes are triggered:
  1665 |         for instance, the model instance will have a populated `generation_config` attribute.
  1666 | 
  1667 |         Returns:
  1668 |             `bool`: Whether this model can generate sequences with `.generate()`.
  1669 |         """
  1670 |         # Directly inherits `GenerationMixin` (or a class ending in the same substring) -> can generate
  1671 |         if "GenerationMixin" in str(cls.__bases__):
  1672 |             return True
  1673 |         # The class inherits from a class that can generate (recursive check) -> can generate
  1674 |         for base in cls.__bases__:
  1675 |             if not hasattr(base, "can_generate"):
  1676 |                 continue
  1677 |             if "PreTrainedModel" not in str(base) and base.can_generate():
  1678 |                 return True
  1679 |         # Detects whether `prepare_inputs_for_generation` has been overwritten in the model. Prior to v4.45, this
  1680 |         # was how we detected whether a model could generate.
  1681 |         if hasattr(cls, "prepare_inputs_for_generation"):  # implicit: doesn't inherit `GenerationMixin`
  1682 |             logger.warning(
  1683 |                 f"{cls.__name__} has generative capabilities, as `prepare_inputs_for_generation` is explicitly "
  1684 |                 "defined. However, it doesn't directly inherit from `GenerationMixin`. From 👉v4.50👈 onwards, "
  1685 |                 "`PreTrainedModel` will NOT inherit from `GenerationMixin`, and this model will lose the ability "
  1686 |                 "to call `generate` and other related functions."
  1687 |                 "\n  - If you're using `trust_remote_code=True`, you can get rid of this warning by loading the "
  1688 |                 "model with an auto class. See https://huggingface.co/docs/transformers/en/model_doc/auto#auto-classes"
  1689 |                 "\n  - If you are the owner of the model architecture code, please modify your model class such that "
  1690 |                 "it inherits from `GenerationMixin` (after `PreTrainedModel`, otherwise you'll get an exception)."
  1691 |                 "\n  - If you are not the owner of the model architecture class, please contact the model code owner "
  1692 |                 "to update it."
  1693 |             )
  1694 |         # Otherwise, can't generate
  1695 |         return False
  1696 | 
  1697 |     def _flash_attn_import_error(
  1698 |         self,
  1699 |         flash_attn_version: int,
  1700 |         general_availability_check: Callable,
  1701 |         pkg_availability_check: Callable,
  1702 |         supported_devices: tuple[tuple[Callable, str], ...],
  1703 |         custom_supported_devices: tuple[tuple[Callable, str], ...] = (),
  1704 |         cuda_min_major_version: int | None = None,
  1705 |     ):
  1706 |         """
  1707 |         Checks whether the specified Flash Attention version is supported and if not, searches for the specific reason
  1708 |         on why it failed - package import and/or device incompatibility issues.
  1709 | 
  1710 |         Args:
  1711 |             flash_attn_version (`int`):
  1712 |                 The requested version of Flash Attention.
  1713 |             general_availability_check (`Callable`):
  1714 |                 Checks whether our `is_available` function detects the specific FA version. Failing reasons
  1715 |                 are then checked for one-by-one.
  1716 |             pkg_availability_check (`Callable`):
  1717 |                 Checks whether the package could theoretically be detected in the environment by the init structures.
  1718 |                 This is not a sure-fire check as device compatibility with FA is just as important.
  1719 |             supported_devices (`tuple[tuple[Callable, str]]`):
  1720 |                 Essentially a list (for mutable kwargs reasons a tuple) of the supported devices in the format of
  1721 |                 `(device_availability_check, device_name)`, i.e. a pair of the associated device's name and whether
  1722 |                 it is available in the environment.
  1723 |             custom_supported_devices (`tuple[tuple[Callable, str]]`, *optional*, defaults to `()`):
  1724 |                 Essentially a list (for mutable kwargs reasons a tuple) of the custom supported devices in the format of
  1725 |                 `(device_availability_check, info_message)`. These custom devices have custom logic outside the torch
  1726 |                 ecosystem either via kernels or other packages and hence have early checks for availability.
  1727 |             cuda_min_major_version (`int`, *optional*):
  1728 |                 The minimum major cuda version supported for this version of Flash Attention. This is mostly
  1729 |                 affecting more recent versions which are more specialized to the features of new hardware.
  1730 |         """
  1731 |         # Certain devices have custom workarounds e.g. with their own package distribution (NPU) or via kernels (XPU)
  1732 |         for device_availability_check, info_message in custom_supported_devices:
  1733 |             if device_availability_check():
  1734 |                 logger.info(info_message)
  1735 |                 return
  1736 | 
  1737 |         if not general_availability_check():
  1738 |             preface = f"FlashAttention{flash_attn_version} has been toggled on, but it cannot be used due to the following error:"
  1739 | 
  1740 |             # Can the package be seen in the import structure
  1741 |             if not pkg_availability_check():
  1742 |                 raise ImportError(
  1743 |                     f"{preface} the package for FlashAttention{flash_attn_version} doesn't seem to be installed."
  1744 |                 )
  1745 |             # Minimum version (FA2 only)
  1746 |             elif flash_attn_version == 2 and not is_flash_attn_greater_or_equal("2.3.3"):
