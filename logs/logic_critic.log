   127 | def replace_layer_number_by_wildcard(name: str) -> str:
   128 |     """
   129 |     Replace the numbers in the `name` by wildcards, only if they are in-between dots (`.`) or if they are between
   130 |     a dot (`.`) and the end of the string.
   131 |     This matches how modules are named/numbered when using a nn.ModuleList or nn.Sequential, but will NOT match
   132 |     numbers in a parameter name itself, e.g. if the param is named `"w1"` or `"w2"`.
   133 |     """
   134 |     return re.sub(r"\.\d+(\.|$)", lambda m: ".*" + m.group(1), name)
   135 | 

