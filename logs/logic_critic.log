  2570 |     def set_lr_scheduler(
  2571 |         self,
  2572 |         name: str | SchedulerType = "linear",
  2573 |         num_epochs: float = 3.0,
  2574 |         max_steps: int = -1,
  2575 |         warmup_steps: float = 0,
  2576 |         warmup_ratio: float | None = None,
  2577 |     ):
  2578 |         """
  2579 |         A method that regroups all arguments linked to the learning rate scheduler and its hyperparameters.
  2580 | 
  2581 |         Args:
  2582 |             name (`str` or [`SchedulerType`], *optional*, defaults to `"linear"`):
  2583 |                 The scheduler type to use. See the documentation of [`SchedulerType`] for all possible values.
  2584 |             num_epochs(`float`, *optional*, defaults to 3.0):
  2585 |                 Total number of training epochs to perform (if not an integer, will perform the decimal part percents
  2586 |                 of the last epoch before stopping training).
  2587 |             max_steps (`int`, *optional*, defaults to -1):
  2588 |                 If set to a positive number, the total number of training steps to perform. Overrides `num_train_epochs`.
  2589 |                 For a finite dataset, training is reiterated through the dataset (if all data is exhausted) until
  2590 |                 `max_steps` is reached.
  2591 |             warmup_steps (`float`, *optional*, defaults to 0):
  2592 |                 Number of steps used for a linear warmup from 0 to `learning_rate`.  Should be an integer or a float in range `[0,1)`.
  2593 |                 If smaller than 1, will be interpreted as ratio of steps used for a linear warmup from 0 to `learning_rate`.
  2594 | 
  2595 |         Example:
  2596 | 
  2597 |         ```py
  2598 |         >>> from transformers import TrainingArguments
  2599 | 
  2600 |         >>> args = TrainingArguments("working_dir")
  2601 |         >>> args = args.set_lr_scheduler(name="cosine", warmup_steps=0.05)
  2602 |         >>> args.warmup_steps
  2603 |         0.05
  2604 |         ```
  2605 |         """
  2606 |         if warmup_ratio is not None:
  2607 |             logger.warning("warmup_ratio is deprecated and will be removed in v5.2 . Use `warmup_steps` instead.")
  2608 |             warmup_steps = warmup_ratio
  2609 | 
  2610 |         self.lr_scheduler_type = SchedulerType(name)
  2611 |         self.num_train_epochs = num_epochs
  2612 |         self.max_steps = max_steps
  2613 |         self.warmup_steps = warmup_steps
  2614 |         return self
