  2015 |             # preload flash attention here to allow compile with fullgraph
  2016 |             if is_flash_attention_requested(requested_attention_implementation=applicable_attn_implementation):
  2017 |                 lazy_import_flash_attention(applicable_attn_implementation)
  2018 | 
  2019 |         return applicable_attn_implementation
