  3769 |             raise ValueError(
  3770 |                 "`.float()` is not supported for quantized model. Please use the model as it is, since the"
  3771 |                 " model has already been casted to the correct `dtype`."
  3772 |             )
  3773 |         else:
  3774 |             return super().float(*args)
