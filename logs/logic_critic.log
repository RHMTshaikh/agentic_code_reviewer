   297 |     def test_compute_strided_slice(self):
   298 |         # Direct tests for _compute_strided_slice(intervals, rank, world_size, split_factor).
   299 |         # Keys: (input_interval, rank, world_size, split_factor) -> expected output list.
   300 |         mesh = FakeMesh(shape=(2,), rank=0)
   301 |         op = _make_dtensor_shard_op(mesh, [Shard(0)], param_shape=(8,), local_shape=(4,))
   302 |         expected = {
   303 |             # Even (0, 8) sf=2 ws=2 -> groups (0,4) (4,8); each rank takes half of each
   304 |             ((0, 8), 0, 2, 2): [(0, 2), (4, 6)],
   305 |             ((0, 8), 1, 2, 2): [(2, 4), (6, 8)],
   306 |             # Uneven (0, 7) sf=2 -> group 0 = (0,4), group 1 = (4,7) -> size 3
   307 |             ((0, 7), 0, 2, 2): [(0, 2), (4, 6)],  # rank 0 -> half of each group
