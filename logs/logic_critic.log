  3376 | def _is_image_processor_class(func, parent_class):
  3377 |     """
  3378 |     Check if a function belongs to a ProcessorMixin class.
  3379 | 
  3380 |     Uses two methods:
  3381 |     1. Check parent_class inheritance (if provided)
  3382 |     2. Check if the source file is named processing_*.py (multimodal processors)
  3383 |        vs image_processing_*.py, video_processing_*.py, etc. (single-modality processors)
  3384 | 
  3385 |     Args:
  3386 |         func: The function to check
  3387 |         parent_class: Optional parent class (if available)
  3388 | 
  3389 |     Returns:
  3390 |         bool: True if this is a multimodal processor (inherits from ProcessorMixin), False otherwise
  3391 |     """
  3392 |     # First, check if parent_class is provided and use it
  3393 |     if parent_class is not None:
  3394 |         return "BaseImageProcessor" in parent_class.__name__ or any(
  3395 |             "BaseImageProcessor" in base.__name__ for base in parent_class.__mro__
  3396 |         )
  3397 | 
  3398 |     # If parent_class is None, check the filename
  3399 |     # Multimodal processors are in files named "processing_*.py"
  3400 |     # Single-modality processors are in "image_processing_*.py", "video_processing_*.py", etc.
  3401 |     try:
  3402 |         source_file = inspect.getsourcefile(func)
  3403 |     except TypeError:
  3404 |         return False
  3405 |     if not source_file:
  3406 |         return False
  3407 | 
  3408 |     # Exception for DummyProcessorForTest
  3409 |     if func.__qualname__.split(".")[0] == "DummyForTestImageProcessorFast":
  3410 |         return True
  3411 | 
  3412 |     filename = os.path.basename(source_file)
  3413 | 
  3414 |     # Multimodal processors are implemented in processing_*.py modules
  3415 |     # (single-modality processors use image_processing_*, video_processing_*, etc.)self.
  3416 |     return filename.startswith("image_processing_") and filename.endswith(".py")
  3417 | 
  3418 | 
  3419 | def _is_processor_class(func, parent_class):
  3420 |     """
  3421 |     Check if a function belongs to a ProcessorMixin class.
  3422 | 
  3423 |     Uses two methods:
