   130 |               `None`).
   131 |             - **pixel_values** -- Pixel values to be fed to a model. Returned when `images` is not `None`.
   132 |         """
   133 |         if videos is not None:
   134 |             raise ValueError("QianfanOCR does not support video input.")
   135 |         if text is None:
   136 |             raise ValueError("You have to specify text.")
   137 | 
   138 |         output_kwargs = self._merge_kwargs(
   139 |             QianfanOCRProcessorKwargs,
   140 |             tokenizer_init_kwargs=self.tokenizer.init_kwargs,
   141 |             **kwargs,
   142 |         )
   143 | 
   144 |         if not isinstance(text, (list, tuple)):
   145 |             text = [text]
   146 | 
   147 |         # Process images and videos separately, as videos don't support crop_to_patches
   148 |         image_num_patches = []
   149 |         image_pixel_values = None
   150 |         image_num_patches_indices = np.array([0])
   151 |         if images is not None:
   152 |             images = self.image_processor.fetch_images(images)
   153 |             images = make_flat_list_of_images(images)
   154 |             image_inputs = self.image_processor(images=images, **output_kwargs["images_kwargs"])
   155 |             image_num_patches = image_inputs.pop("num_patches")
   156 |             image_pixel_values = image_inputs.pop("pixel_values")
   157 |             image_num_patches_indices = np.cumsum(image_num_patches)
   158 | 
   159 |         video_num_patches = []  # per frame
   160 |         video_pixel_values = None
   161 |         video_patch_indices = np.array([0])
   162 |         video_num_patches_indices = np.array([0])
   163 |         if videos is not None:
   164 |             video_kwargs = output_kwargs["videos_kwargs"]
   165 |             video_inputs = self.video_processor(videos=videos, **video_kwargs)
   166 |             video_pixel_values = video_inputs.pop("pixel_values_videos")
   167 | 
   168 |             batch_size, num_frames, *_ = video_pixel_values.shape
   169 |             num_frames_per_video = np.full(batch_size, num_frames)
   170 |             num_frames = sum(num_frames_per_video)  # total
   171 |             video_patch_indices = np.empty(batch_size + 1, int)
   172 |             video_patch_indices[0] = 0
   173 |             video_patch_indices[1:] = np.cumsum(num_frames_per_video)
   174 |             video_num_patches = [1] * num_frames
   175 |             video_num_patches_indices = np.empty(num_frames + 1, int)
   176 |             video_num_patches_indices[0] = 0
   177 |             video_num_patches_indices[1:] = np.cumsum(video_num_patches)
   178 |             video_pixel_values = video_pixel_values.flatten(0, 1)
   179 | 
   180 |         image_videos_inputs = {}
   181 |         if images is not None or videos is not None:
   182 |             text, image_video_patches, image_index, video_index = self._insert_media_placeholders(
   183 |                 text,
   184 |                 image_pixel_values,
   185 |                 video_pixel_values,
   186 |                 image_num_patches,
   187 |                 video_num_patches,
   188 |                 image_num_patches_indices,
   189 |                 video_num_patches_indices,
   190 |                 video_patch_indices,
   191 |             )
   192 |             if images is not None and image_index != len(images):
   193 |                 raise ValueError("Number of image placeholders in the prompt does not match the number of images.")
   194 |             if videos is not None and video_index != len(num_frames_per_video):
   195 |                 raise ValueError("Number of video placeholders in the prompt does not match the number of videos.")
   196 | 
   197 |             # Concatenate the interleaved image and video patches (function agnostic to the patches type (list, numpy array, torch tensor))
   198 |             image_videos_inputs = {"pixel_values": concatenate_list(image_video_patches)}
   199 | 
   200 |         return_tensors = output_kwargs["text_kwargs"].pop("return_tensors", None)
   201 |         return_mm_token_type_ids = output_kwargs["text_kwargs"].pop("return_mm_token_type_ids", None)
   202 |         text_inputs = self.tokenizer(text, **output_kwargs["text_kwargs"])
   203 |         self._check_special_mm_tokens(text, text_inputs, modalities=["image"])
   204 | 
   205 |         if return_mm_token_type_ids:
   206 |             text_inputs["mm_token_type_ids"] = self.create_mm_token_type_ids(text_inputs["input_ids"])
   207 |         return BatchFeature(data={**text_inputs, **image_videos_inputs}, tensor_type=return_tensors)
