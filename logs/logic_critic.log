  1464 |     def convert_tokens_to_ids(self, tokens: str | list[str]) -> int | list[int]:
  1465 |         """
  1466 |         Converts a token string (or a sequence of tokens) in a single integer id (or a sequence of ids), using the
  1467 |         vocabulary.
  1468 | 
  1469 |         Args:
  1470 |             tokens (`str` or `list[str]`): One or several token(s) to convert to token id(s).
  1471 | 
  1472 |         Returns:
  1473 |             `int` or `list[int]`: The token id or list of token ids.
  1474 |         """
  1475 |         if isinstance(tokens, str):
  1476 |             return self._convert_token_to_id_with_added_voc(tokens)
  1477 | 
  1478 |         return [self._convert_token_to_id_with_added_voc(token) for token in tokens]
