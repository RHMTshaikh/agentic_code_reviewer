   155 | class MiniCPM3Attention(DeepseekV2Attention):
   156 |     """
   157 |     Multi-head Latent Attention (MLA), structurally identical to `DeepseekV2Attention`.
   158 |     The only difference is the rotary convention: MiniCPM3 keeps the original cos/sin RoPE
   159 |     (`apply_rotary_pos_emb`) instead of DeepSeek-V2's complex rotary, so we inherit the
   160 |     module construction and override only `forward`.
   161 |     """
   162 | 
   163 |     def forward(
   164 |         self,
   165 |         hidden_states: torch.Tensor,
   166 |         position_embeddings: tuple[torch.Tensor, torch.Tensor],
   167 |         attention_mask: torch.Tensor | None = None,
   168 |         past_key_values: Cache | None = None,
   169 |         **kwargs,
   170 |     ) -> tuple[torch.Tensor, torch.Tensor | None]:
   171 |         batch_size, seq_length = hidden_states.shape[:-1]
   172 |         query_shape = (batch_size, seq_length, -1, self.qk_head_dim)
   173 |         key_shape = (batch_size, seq_length, -1, self.qk_nope_head_dim + self.v_head_dim)
   174 | 
   175 |         if self.q_lora_rank is None:
   176 |             q_states = self.q_proj(hidden_states)
   177 |         else:
   178 |             q_states = self.q_b_proj(self.q_a_layernorm(self.q_a_proj(hidden_states)))
   179 |         q_states = q_states.view(query_shape).transpose(1, 2)
   180 |         q_pass, q_rot = torch.split(q_states, [self.qk_nope_head_dim, self.qk_rope_head_dim], dim=-1)
   181 | 
   182 |         compressed_kv = self.kv_a_proj_with_mqa(hidden_states)
   183 |         k_pass, k_rot = torch.split(compressed_kv, [self.kv_lora_rank, self.qk_rope_head_dim], dim=-1)
   184 | 
   185 |         k_pass = self.kv_b_proj(self.kv_a_layernorm(k_pass)).view(key_shape).transpose(1, 2)
   186 |         k_pass, value_states = torch.split(k_pass, [self.qk_nope_head_dim, self.v_head_dim], dim=-1)
   187 | 
   188 |         k_rot = k_rot.view(batch_size, 1, seq_length, self.qk_rope_head_dim)
   189 | 
   190 |         cos, sin = position_embeddings
   191 |         # Same MLA forward as DeepSeek-V2/V3, except MiniCPM3 keeps the standard (non-interleaved)
   192 |         # cos/sin rotary (`apply_rotary_pos_emb`) instead of DeepSeek's complex/interleaved variant.
   193 |         q_rot, k_rot = apply_rotary_pos_emb(q_rot, k_rot, cos, sin)
