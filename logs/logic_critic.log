   475 |     def allocate_blocks(self, n_blocks: int, request_id: str, block_manager: BlockManager) -> int | None:
   476 |         """Allocate (n_blocks) for a given (request_id) using the (block_manager). Returns the number of blocks
   477 |         allocated otherwise. For group of sliding window attention layers, we only allocate up to the point where we can
   478 |         fit an entire sliding window in the cache tensor."""
