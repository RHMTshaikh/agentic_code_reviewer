   241 | 
   242 |         # Disjoint intervals case.
   243 |         # 1) Build flat mapping from source intervals.
   244 |         # Example: intervals=[(0,3), (10,15)] -> flat segments: (0,3,0) and (3,8,10)
   245 |         # meaning flat [0,3) maps to source [0,3), and flat [3,8) maps to source [10,15).
   246 |         flat_segments = []  # (interval_flat_start, interval_flat_end, source_start)
   247 |         idx = 0
   248 |         for source_start, source_end in intervals:
   249 |             interval_len = source_end - source_start
   250 |             if interval_len > 0:
   251 |                 flat_segments.append((idx, idx + interval_len, source_start))
   252 |                 idx += interval_len
   253 | 
   254 |         # 2) Intersect this rank's flat span with each flat segment, then map overlap
   255 |         # back to source coordinates.
   256 |         # Example: local flat span [2,6) with segments above gives:
   257 |         #   overlap with [0,3) => [2,3) -> source (2,3)
   258 |         #   overlap with [3,8) => [3,6) -> source (10,13)
   259 |         # result: local_intervals = [(2,3), (10,13)]
   260 |         local_intervals = []
   261 |         for interval_flat_start, interval_flat_end, source_start in flat_segments:
   262 |             overlap_flat_start = max(interval_flat_start, local_flat_start)
   263 |             overlap_flat_end = min(interval_flat_end, local_flat_end)
   264 |             if overlap_flat_start < overlap_flat_end:
   265 |                 source_overlap_start = source_start + (overlap_flat_start - interval_flat_start)
   266 |                 source_overlap_end = source_start + (overlap_flat_end - interval_flat_start)
   267 |                 local_intervals.append((source_overlap_start, source_overlap_end))
   268 | 
   269 |         return local_intervals
   270 | 

