  2033 |     @contextlib.contextmanager
  2034 |     def main_process_first(self, local=True, desc="work"):
  2035 |         """
  2036 |         A context manager for torch distributed environment where on needs to do something on the main process, while
  2037 |         blocking replicas, and when it's finished releasing the replicas.
  2038 | 
  2039 |         One such use is for `datasets`'s `map` feature which to be efficient should be run once on the main process,
  2040 |         which upon completion saves a cached version of results and which then automatically gets loaded by the
  2041 |         replicas.
  2042 | 
  2043 |         Args:
  2044 |             local (`bool`, *optional*, defaults to `True`):
  2045 |                 if `True` first means process of rank 0 of each node if `False` first means process of rank 0 of node
  2046 |                 rank 0 In multi-node environment with a shared filesystem you most likely will want to use
  2047 |                 `local=False` so that only the main process of the first node will do the processing. If however, the
  2048 |                 filesystem is not shared, then the main process of each node will need to do the processing, which is
  2049 |                 the default behavior.
  2050 |             desc (`str`, *optional*, defaults to `"work"`):
  2051 |                 a work description to be used in debug logs
  2052 | 
  2053 |         """
  2054 |         if is_torch_available() and self.world_size > 1:
  2055 |             main_process_desc = "main local process" if local else "main process"
  2056 |             if self.distributed_state is not None:
  2057 |                 is_main_process = (
  2058 |                     self.distributed_state.is_local_main_process if local else self.distributed_state.is_main_process
  2059 |                 )
  2060 |             elif is_sagemaker_mp_enabled():
  2061 |                 is_main_process = smp.rank() == 0
  2062 | 
  2063 |             try:
  2064 |                 if not is_main_process:
  2065 |                     # tell all replicas to wait
  2066 |                     logger.debug(f"{self.process_index}: waiting for the {main_process_desc} to perform {desc}")
  2067 | 
  2068 |                     if is_torch_xla_available():
  2069 |                         xm.rendezvous(desc)
  2070 |                     else:
  2071 |                         dist.barrier()
  2072 |                 yield
  2073 |             finally:
  2074 |                 if is_main_process:
  2075 |                     # the wait is over
  2076 |                     logger.debug(f"{self.process_index}: {main_process_desc} completed {desc}, releasing all replicas")
  2077 |                     if is_torch_xla_available():
  2078 |                         xm.rendezvous(desc)
  2079 |                     else:
  2080 |                         dist.barrier()
  2081 |         else:
  2082 |             yield
  2083 | 
  2084 |     def get_warmup_steps(self, num_training_steps: int):
  2085 |         """
  2086 |         Get number of steps used for a linear warmup.
  2087 |         """
  2088 |         warmup_steps = (
  2089 |             int(self.warmup_steps) if self.warmup_steps >= 1 else math.ceil(num_training_steps * self.warmup_steps)
  2090 |         )
  2091 |         return warmup_steps
  2092 | 
  2093 |     def _dict_dtype_to_str(self, d: dict[str, Any]) -> None:
  2094 |         """
  2095 |         Checks whether the passed dictionary and its nested dicts have a *dtype* key and if it's not None,
  2096 |         converts torch.dtype to a string of just the type. For example, `torch.float32` get converted into *"float32"*
  2097 |         string, which can then be stored in the json format.
  2098 |         """
  2099 |         if d.get("dtype") is not None and not isinstance(d["dtype"], str):
  2100 |             d["dtype"] = str(d["dtype"]).split(".")[1]
  2101 |         for value in d.values():
  2102 |             if isinstance(value, dict):
  2103 |                 self._dict_dtype_to_str(value)
  2104 | 
  2105 |     def to_dict(self):
  2106 |         """
  2107 |         Serializes this instance while replace `Enum` by their values (for JSON serialization support). It obfuscates
  2108 |         the token values by removing their value.
  2109 |         """
  2110 |         # Exclude non-init fields (they aren't user-facing config)
  2111 |         d = {field.name: getattr(self, field.name) for field in fields(self) if field.init}
  2112 | 
  2113 |         for k, v in d.items():
  2114 |             if isinstance(v, Enum):
  2115 |                 d[k] = v.value
  2116 |             if isinstance(v, list) and len(v) > 0 and isinstance(v[0], Enum):
  2117 |                 d[k] = [x.value for x in v]
  2118 |             if k.endswith("_token"):
  2119 |                 d[k] = f"<{k.upper()}>"
  2120 |             # Serialize AcceleratorConfig to dict
  2121 |             if is_accelerate_available() and isinstance(v, AcceleratorConfig):
  2122 |                 d[k] = v.to_dict()
  2123 |             # Serialize quantization_config if nested inside model_init_kwargs
  2124 |             if k == "model_init_kwargs" and isinstance(v, dict) and "quantization_config" in v:
  2125 |                 quantization_config = v.get("quantization_config")
  2126 |                 if quantization_config and not isinstance(quantization_config, dict):
  2127 |                     d[k]["quantization_config"] = quantization_config.to_dict()
  2128 |             if k == "parallelism_config" and v is not None:
  2129 |                 d[k] = v.to_json()
  2130 | 
  2131 |         self._dict_dtype_to_str(d)
  2132 | 
  2133 |         return d
  2134 | 
  2135 |     def to_json_string(self):
  2136 |         """
  2137 |         Serializes this instance to a JSON string.
  2138 |         """
  2139 |         return json.dumps(self.to_dict(), indent=2)
  2140 | 
  2141 |     def to_sanitized_dict(self) -> dict[str, Any]:
  2142 |         """
  2143 |         Sanitized serialization to use with TensorBoard's hparams
  2144 |         """
  2145 |         d = self.to_dict()
  2146 |         d = {**d, "train_batch_size": self.train_batch_size, "eval_batch_size": self.eval_batch_size}
  2147 | 
  2148 |         valid_types = [bool, int, float, str]
  2149 |         if is_torch_available():
  2150 |             valid_types.append(torch.Tensor)
  2151 | 
  2152 |         return {k: v if type(v) in valid_types else str(v) for k, v in d.items()}
  2153 | 
  2154 |     # Convenience setters for grouped configuration
  2155 |     def set_training(
  2156 |         self,
  2157 |         learning_rate: float = 5e-5,
  2158 |         batch_size: int = 8,
  2159 |         weight_decay: float = 0,
  2160 |         num_epochs: float = 3,
  2161 |         max_steps: int = -1,
  2162 |         gradient_accumulation_steps: int = 1,
  2163 |         seed: int = 42,
  2164 |         gradient_checkpointing: bool = False,
  2165 |     ):
  2166 |         """
  2167 |         A method that regroups all basic arguments linked to the training.
  2168 | 
  2169 |         <Tip>
  2170 | 
  2171 |         Calling this method will automatically set `self.do_train` to `True`.
  2172 | 
  2173 |         </Tip>
  2174 | 
  2175 |         Args:
  2176 |             learning_rate (`float`, *optional*, defaults to 5e-5):
  2177 |                 The initial learning rate for the optimizer.
  2178 |             batch_size (`int` *optional*, defaults to 8):
  2179 |                 The batch size per device (GPU/TPU core/CPU...) used for training.
  2180 |             weight_decay (`float`, *optional*, defaults to 0):
  2181 |                 The weight decay to apply (if not zero) to all layers except all bias and LayerNorm weights in the
  2182 |                 optimizer.
  2183 |             num_train_epochs(`float`, *optional*, defaults to 3.0):
  2184 |                 Total number of training epochs to perform (if not an integer, will perform the decimal part percents
  2185 |                 of the last epoch before stopping training).
  2186 |             max_steps (`int`, *optional*, defaults to -1):
  2187 |                 If set to a positive number, the total number of training steps to perform. Overrides `num_train_epochs`.
  2188 |                 For a finite dataset, training is reiterated through the dataset (if all data is exhausted) until
  2189 |                 `max_steps` is reached.
  2190 |             gradient_accumulation_steps (`int`, *optional*, defaults to 1):
  2191 |                 Number of updates steps to accumulate the gradients for, before performing a backward/update pass.
  2192 | 
  2193 |                 <Tip warning={true}>
  2194 | 
  2195 |                 When using gradient accumulation, one step is counted as one step with backward pass. Therefore,
  2196 |                 logging, evaluation, save will be conducted every `gradient_accumulation_steps * xxx_step` training
  2197 |                 examples.
  2198 | 
  2199 |                 </Tip>
  2200 | 
  2201 |             seed (`int`, *optional*, defaults to 42):
  2202 |                 Random seed that will be set at the beginning of training. To ensure reproducibility across runs, use
  2203 |                 the [`~Trainer.model_init`] function to instantiate the model if it has some randomly initialized
  2204 |                 parameters.
  2205 |             gradient_checkpointing (`bool`, *optional*, defaults to `False`):
  2206 |                 If True, use gradient checkpointing to save memory at the expense of slower backward pass.
  2207 | 
  2208 |         Example:
  2209 | 
  2210 |         ```py
  2211 |         >>> from transformers import TrainingArguments
  2212 | 
  2213 |         >>> args = TrainingArguments("working_dir")
  2214 |         >>> args = args.set_training(learning_rate=1e-4, batch_size=32)
  2215 |         >>> args.learning_rate
  2216 |         1e-4
  2217 |         ```
  2218 |         """
  2219 |         self.do_train = True
  2220 |         self.learning_rate = learning_rate
  2221 |         self.per_device_train_batch_size = batch_size
  2222 |         self.weight_decay = weight_decay
  2223 |         self.num_train_epochs = num_epochs
  2224 |         self.max_steps = max_steps
  2225 |         self.gradient_accumulation_steps = gradient_accumulation_steps
  2226 |         self.seed = seed
  2227 |         self.gradient_checkpointing = gradient_checkpointing
  2228 |         return self
  2229 | 
  2230 |     def set_evaluate(
  2231 |         self,
  2232 |         strategy: str | IntervalStrategy = "no",
  2233 |         steps: int = 500,
  2234 |         batch_size: int = 8,
  2235 |         accumulation_steps: int | None = None,
  2236 |         delay: float | None = None,
  2237 |         loss_only: bool = False,
  2238 |     ):
  2239 |         """
  2240 |         A method that regroups all arguments linked to evaluation.
  2241 | 
  2242 |         Args:
  2243 |             strategy (`str` or [`~trainer_utils.IntervalStrategy`], *optional*, defaults to `"no"`):
  2244 |                 The evaluation strategy to adopt during training. Possible values are:
  2245 | 
  2246 |                     - `"no"`: No evaluation is done during training.
  2247 |                     - `"steps"`: Evaluation is done (and logged) every `steps`.
  2248 |                     - `"epoch"`: Evaluation is done at the end of each epoch.
  2249 | 
  2250 |                 Setting a `strategy` different from `"no"` will set `self.do_eval` to `True`.
  2251 |             steps (`int`, *optional*, defaults to 500):
  2252 |                 Number of update steps between two evaluations if `strategy="steps"`.
  2253 |             batch_size (`int` *optional*, defaults to 8):
  2254 |                 The batch size per device (GPU/TPU core/CPU...) used for evaluation.
  2255 |             accumulation_steps (`int`, *optional*):
  2256 |                 Number of predictions steps to accumulate the output tensors for, before moving the results to the CPU.
  2257 |                 If left unset, the whole predictions are accumulated on GPU/TPU before being moved to the CPU (faster
  2258 |                 but requires more memory).
  2259 |             delay (`float`, *optional*):
  2260 |                 Number of epochs or steps to wait for before the first evaluation can be performed, depending on the
  2261 |                 eval_strategy.
  2262 |             loss_only (`bool`, *optional*, defaults to `False`):
  2263 |                 Ignores all outputs except the loss.
  2264 | 
  2265 |         Example:
  2266 | 
  2267 |         ```py
  2268 |         >>> from transformers import TrainingArguments
  2269 | 
  2270 |         >>> args = TrainingArguments("working_dir")
  2271 |         >>> args = args.set_evaluate(strategy="steps", steps=100)
  2272 |         >>> args.eval_steps
  2273 |         100
  2274 |         ```
  2275 |         """
  2276 |         self.eval_strategy = IntervalStrategy(strategy)
  2277 |         if self.eval_strategy == IntervalStrategy.STEPS and steps == 0:
  2278 |             raise ValueError("Setting `strategy` as 'steps' requires a positive value for `steps`.")
  2279 |         self.do_eval = self.eval_strategy != IntervalStrategy.NO
  2280 |         self.eval_steps = steps
  2281 |         self.per_device_eval_batch_size = batch_size
  2282 |         self.eval_accumulation_steps = accumulation_steps
  2283 |         self.eval_delay = delay
  2284 |         self.prediction_loss_only = loss_only
  2285 |         return self
  2286 | 
  2287 |     def set_testing(
  2288 |         self,
  2289 |         batch_size: int = 8,
  2290 |         loss_only: bool = False,
  2291 |     ):
  2292 |         """
  2293 |         A method that regroups all basic arguments linked to testing on a held-out dataset.
  2294 | 
  2295 |         <Tip>
  2296 | 
  2297 |         Calling this method will automatically set `self.do_predict` to `True`.
  2298 | 
  2299 |         </Tip>
  2300 | 
  2301 |         Args:
  2302 |             batch_size (`int` *optional*, defaults to 8):
  2303 |                 The batch size per device (GPU/TPU core/CPU...) used for testing.
  2304 |             loss_only (`bool`, *optional*, defaults to `False`):
  2305 |                 Ignores all outputs except the loss.
  2306 | 
  2307 |         Example:
  2308 | 
  2309 |         ```py
  2310 |         >>> from transformers import TrainingArguments
  2311 | 
  2312 |         >>> args = TrainingArguments("working_dir")
  2313 |         >>> args = args.set_testing(batch_size=32)
  2314 |         >>> args.per_device_eval_batch_size
  2315 |         32
  2316 |         ```
  2317 |         """
  2318 |         self.do_predict = True
  2319 |         self.per_device_eval_batch_size = batch_size
  2320 |         self.prediction_loss_only = loss_only
