    54 | def build_glob_alternation(
    55 |     globs: list[WeightRenaming | WeightConverter | str],
    56 | ) -> tuple[re.Pattern, dict[str, str], dict[str, str]]:
    57 |     """
    58 |     Build a single alternation regex with one named group per glob.
    59 |     """
    60 |     src_group_to_glob: dict[str, str] = {}
    61 |     tgt_group_to_glob: dict[str, str] = {}
    62 |     branches: list[str] = []
    63 |     i = 0
    64 |     for glob in globs:
    65 |         if isinstance(glob, (WeightRenaming, WeightConverter)):
    66 |             for src in glob.source_patterns:
    67 |                 group_name = f"g{i}"
    68 |                 src_group_to_glob[group_name] = src
    69 |                 i += 1
    70 |                 body = src.replace("*", r".*")
    71 |                 branches.append(f"(?P<{group_name}>{body})")
    72 |                 tgt_group_to_glob[group_name] = glob.target_patterns[0]  # we index with the first target
    73 |         else:
    74 |             group_name = f"g{i}"
    75 |             src_group_to_glob[group_name] = glob
    76 |             i += 1
    77 |             body = glob
    78 |             body = body.replace("*", r".*")
    79 |             branches.append(f"(?P<{group_name}>{body})")
    80 |             tgt_group_to_glob[group_name] = glob
    81 | 
    82 |     alternation = re.compile("|".join(branches))
    83 |     return alternation, src_group_to_glob, tgt_group_to_glob
