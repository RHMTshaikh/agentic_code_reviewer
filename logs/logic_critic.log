   162 |     def __post_init__(self, **kwargs):
   163 |         if self.text_config is None:
   164 |             text_config = {}
   165 |             logger.info("`text_config` is `None`. Initializing the `AltCLIPTextConfig` with default values.")
   166 |         elif isinstance(self.text_config, AltCLIPTextConfig):
   167 |             text_config = self.text_config.to_dict()
   168 |         else:
   169 |             text_config = self.text_config
   170 | 
   171 |         if self.vision_config is None:
   172 |             vision_config = {}
   173 |             logger.info("`vision_config` is `None`. initializing the `AltCLIPVisionConfig` with default values.")
   174 |         elif isinstance(self.vision_config, AltCLIPVisionConfig):
