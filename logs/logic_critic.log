   544 |     def fork_request(self, source_request_id: str, destination_request_ids: list[str]) -> tuple[list[int], list[int]]:
   545 |         """Fork the cache of a request (state) into the one of a list of requests with the given (dst_request_ids)."""
   546 |         # These lists will be the accumulators for the source and destination blocks for the cache copy
   547 |         source_blocks, destination_blocks = [], []
   548 |         # Main fork loop
   549 |         for cm in self.group_cache_managers:
   550 |             src_blocks, dst_blocks = cm.fork_blocks(source_request_id, destination_request_ids, self._block_manager)
   551 |             source_blocks.extend(src_blocks)
   552 |             destination_blocks.extend(dst_blocks)
   553 |         return source_blocks, destination_blocks
