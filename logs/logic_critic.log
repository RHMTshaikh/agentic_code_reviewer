   332 |             # Multi-input intervals (8 elems): rank -> takes its slice from whichever interval(s) cover it
   333 |             (((0, 4), (10, 14)), 0, 2): [(0, 4)],  # rank 0 -> first 4 elems = first interval entirely
   334 |             (((0, 4), (10, 14)), 1, 2): [(10, 14)],  # rank 1 -> last 4 elems = second interval entirely
   335 |             (((0, 4), (10, 14)), 2, 4): [(10, 12)],  # ws=4, rank 2 -> cuts mid-input-interval
   336 |         }
   337 |         for (intervals, rank, ws), exp in expected.items():
   338 |             with self.subTest(intervals=intervals, rank=rank, ws=ws):
   339 |                 self.assertEqual(op._compute_contiguous_slice(list(intervals), rank=rank, world_size=ws), exp)
