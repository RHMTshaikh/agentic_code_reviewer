    91 | def strtobool(val) -> int:
    92 |     """Convert a string representation of truth to true (1) or false (0).
    93 | 
    94 |     True values are 'y', 'yes', 't', 'true', 'on', and '1'; false values are 'n', 'no', 'f', 'false', 'off', and '0'.
    95 |     Raises ValueError if 'val' is anything else.
    96 |     """
    97 |     val = val.lower()
    98 |     if val in {"y", "yes", "t", "true", "on", "1"}:
    99 |         return 1
   100 |     if val in {"n", "no", "f", "false", "off", "0"}:
   101 |         return 0
   102 |     raise ValueError(f"invalid truth value {val!r}")
