   348 |         # we do not store `num_labels` attribute in config, but instead
   349 |         # compute it based on the length of the `id2label` map
   350 |         if self.id2label is None or self.num_labels != num_labels:
   351 |             self.id2label = {i: f"LABEL_{i}" for i in range(num_labels)}
   352 |             self.label2id = dict(zip(self.id2label.values(), self.id2label.keys()))
