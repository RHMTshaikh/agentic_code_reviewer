    76 |               `None`).
    77 |             - **pixel_values** -- Pixel values to be fed to a model. Returned when `images` is not `None`.
    78 |         """
    79 |         if text is None:
    80 |             raise ValueError("You have to specify text.")
    81 |         elif not isinstance(text, (list, tuple)):
    82 |             text = [text]
    83 | 
    84 |         output_kwargs = self._merge_kwargs(
