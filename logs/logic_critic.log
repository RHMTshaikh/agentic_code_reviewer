   431 |         else:
   432 |             fake_sequences = 0
   433 | 
   434 |         # When looping over request is done, we can build the actual tensors. This is faster than modifying the static
   435 |         # tensors inside the loop.
   436 |         to_tensor = partial(torch.tensor, dtype=torch.int32, device=self.device)
