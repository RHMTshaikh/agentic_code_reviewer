  2574 | def get_indent_level(func):
  2575 |     # Use this instead of `inspect.getsource(func)` as getsource can be very slow
  2576 |     return (len(func.__qualname__.split(".")) - 1) * 4
  2577 | 
  2578 | 
  2579 | def equalize_indent(docstring: str, indent_level: int) -> str:
  2580 |     """
  2581 |     Adjust the indentation of a docstring to match the specified indent level.
  2582 |     """
  2583 |     prefix = " " * indent_level
  2584 |     # Uses splitlines() (no keepends) to match previous behaviour that dropped
  2585 |     # any trailing newline via the old splitlines() + "\n".join() + textwrap.indent path.
  2586 |     return "\n".join(prefix + line.lstrip() if line.strip() else "" for line in docstring.splitlines())
  2587 | 
  2588 | 
  2589 | def set_min_indent(docstring: str, indent_level: int) -> str:
  2590 |     """
  2591 |     Adjust the indentation of a docstring to match the specified indent level.
  2592 |     """
  2593 |     # Equivalent to textwrap.dedent + textwrap.indent but avoids the two regex
  2594 |     # passes that textwrap uses internally (one per call in dedent, one in indent).
  2595 |     lines = docstring.split("\n")
  2596 |     min_indent = min(
  2597 |         (len(line) - len(line.lstrip()) for line in lines if line.strip()),
  2598 |         default=0,
  2599 |     )
  2600 |     prefix = " " * indent_level
  2601 |     return "\n".join(prefix + line[min_indent:] if line.strip() else "" for line in lines)
  2602 | 
