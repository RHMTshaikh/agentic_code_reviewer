  1995 |     def get_process_log_level(self):
  1996 |         """
  1997 |         Returns the log level to be used depending on whether this process is the main process of node 0, main process
  1998 |         of node non-0, or a non-main process.
  1999 | 
  2000 |         For the main process the log level defaults to the logging level set (`logging.WARNING` if you didn't do
  2001 |         anything) unless overridden by `log_level` argument.
  2002 | 
  2003 |         For the replica processes the log level defaults to `logging.WARNING` unless overridden by `log_level_replica`
  2004 |         argument.
  2005 | 
  2006 |         The choice between the main and replica process settings is made according to the return value of `should_log`.
  2007 |         """
  2008 | 
  2009 |         # convert to int
  2010 |         log_level = trainer_log_levels[self.log_level]
  2011 |         log_level_replica = trainer_log_levels[self.log_level_replica]
  2012 | 
  2013 |         log_level_main_node = logging.get_verbosity() if log_level == -1 else log_level
  2014 |         log_level_replica_node = logging.get_verbosity() if log_level_replica == -1 else log_level_replica
  2015 |         return log_level_main_node if self.should_log else log_level_replica_node
