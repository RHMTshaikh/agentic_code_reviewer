    92 |                         account_id=order.account_id,
    93 |                         symbol=order.symbol,
    94 |                         quantity=executed_qty,
    95 |                         execution_price=fill_price,
    96 |                         is_buy=(order.side == "BUY"),
    97 |                         reference_id=broker_ref
    98 |                     )
