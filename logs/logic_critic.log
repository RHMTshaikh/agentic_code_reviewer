  2141 |     def to_sanitized_dict(self) -> dict[str, Any]:
  2142 |         """
  2143 |         Sanitized serialization to use with TensorBoard's hparams
  2144 |         """
  2145 |         d = self.to_dict()
  2146 |         d = {**d, "train_batch_size": self.train_batch_size, "eval_batch_size": self.eval_batch_size}
  2147 | 
  2148 |         valid_types = [bool, int, float, str]
  2149 |         if is_torch_available():
  2150 |             valid_types.append(torch.Tensor)
  2151 | 
  2152 |         return {k: v if type(v) in valid_types else str(v) for k, v in d.items()}
