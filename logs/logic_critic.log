   244 |     @torch.no_grad()
   245 |     def _reset_static_tensors(self, full_reset: bool = False) -> None:
   246 |         """Reset static tensors for the next batch. For efficiency, this only resets the portions of tensors that were
   247 |         actually used in the previous batch, using the attributes num_q_tokens and max_kv_read. If a (full_reset)
   248 |         is requested, the entire tensor storage is reset.
