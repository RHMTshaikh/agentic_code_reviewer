  4101 | def auto_method_docstring(
  4102 |     func,
  4103 |     parent_class=None,
  4104 |     custom_intro=None,
  4105 |     custom_args=None,
  4106 |     checkpoint=None,
  4107 |     source_args_dict=None,
  4108 |     allowed_params=None,
  4109 | ):
  4110 |     """
  4111 |     Wrapper that automatically generates docstring.
  4112 |     """
  4113 | 
  4114 |     # Use inspect to retrieve the method's signature
  4115 |     sig = inspect.signature(func)
  4116 |     indent_level = get_indent_level(func) if not parent_class else get_indent_level(parent_class)
  4117 | 
  4118 |     # Get model information
  4119 |     model_name_lowercase, class_name, config_class = _get_model_info(func, parent_class)
  4120 |     func_documentation = func.__doc__
  4121 | 
  4122 |     if custom_args is not None and func_documentation is not None:
  4123 |         func_documentation = "\n" + set_min_indent(custom_args.strip("\n"), 0) + "\n" + func_documentation
  4124 |     elif custom_args is not None:
  4125 |         func_documentation = "\n" + set_min_indent(custom_args.strip("\n"), 0)
  4126 | 
  4127 |     # Add intro to the docstring before args description if needed
  4128 |     if custom_intro is not None:
  4129 |         docstring = set_min_indent(custom_intro, indent_level + 4)
  4130 |         if not docstring.strip().endswith("\n"):
  4131 |             docstring += "\n"
  4132 |     else:
  4133 |         docstring = add_intro_docstring(func, class_name=class_name, indent_level=indent_level)
  4134 | 
  4135 |     # Process Parameters section
  4136 |     docstring += _process_parameters_section(
  4137 |         func_documentation,
  4138 |         sig,
  4139 |         func,
  4140 |         class_name,
  4141 |         model_name_lowercase,
  4142 |         parent_class,
  4143 |         indent_level,
  4144 |         source_args_dict,
  4145 |         allowed_params,
  4146 |     )
  4147 | 
  4148 |     # Process Returns section
  4149 |     return_docstring, func_documentation = _process_returns_section(
  4150 |         func_documentation, sig, config_class, indent_level
  4151 |     )
  4152 |     docstring += return_docstring
  4153 | 
  4154 |     # Process Example section
  4155 |     example_docstring = _process_example_section(
  4156 |         func_documentation,
  4157 |         func,
  4158 |         parent_class,
  4159 |         class_name,
  4160 |         model_name_lowercase,
  4161 |         config_class,
  4162 |         checkpoint,
  4163 |         indent_level,
  4164 |     )
  4165 |     docstring += example_docstring
  4166 | 
  4167 |     # Format the docstring with the placeholders
  4168 |     docstring = format_args_docstring(docstring, model_name_lowercase)
  4169 | 
  4170 |     # Assign the dynamically generated docstring to the wrapper function
  4171 |     func.__doc__ = docstring
  4172 |     return func
  4173 | 
