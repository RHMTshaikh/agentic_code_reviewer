  1409 |     def _set_model_specific_special_tokens(self, special_tokens: dict[str, str | AddedToken]):
  1410 |         """
  1411 |         Adds new model-specific special tokens (e.g., for multimodal models).
  1412 | 
  1413 |         These tokens are added to the named special tokens map and will be saved in tokenizer config.
  1414 |         For example: if the model tokenizer is multimodal, we can support special image or audio tokens.
  1415 | 
  1416 |         Args:
  1417 |             special_tokens: Dictionary of {token_name: token_value}
  1418 |         """
  1419 |         self.SPECIAL_TOKENS_ATTRIBUTES = self.SPECIAL_TOKENS_ATTRIBUTES + list(special_tokens.keys())
  1420 |         for key, value in special_tokens.items():
  1421 |             if isinstance(value, (str, AddedToken)):
  1422 |                 self._special_tokens_map[key] = value
  1423 |             else:
  1424 |                 raise TypeError(f"Special token {key} has to be either str or AddedToken but got: {type(value)}")
  1425 | 
  1426 |     @property
  1427 |     def added_tokens_decoder(self) -> dict[int, AddedToken]:
  1428 |         raise NotImplementedError()
  1429 | 
  1430 |     def __repr__(self) -> str:
  1431 |         added_tokens_decoder_rep = "\n\t".join([f"{k}: {v.__repr__()}," for k, v in self.added_tokens_decoder.items()])
  1432 |         if added_tokens_decoder_rep:
  1433 |             added_tokens_decoder_rep = f"\n\t{added_tokens_decoder_rep}\n"
  1434 |         return (
  1435 |             f"{self.__class__.__name__}(name_or_path='{self.name_or_path}',"
  1436 |             f" vocab_size={self.vocab_size}, model_max_length={self.model_max_length},"
  1437 |             f" padding_side='{self.padding_side}', truncation_side='{self.truncation_side}',"
  1438 |             f" special_tokens={self.special_tokens_map},"
  1439 |             f" added_tokens_decoder={{{added_tokens_decoder_rep}}})"
  1440 |         )
