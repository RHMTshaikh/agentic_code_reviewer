  3575 |                 os.remove(full_filename)
  3576 | 
  3577 |         # Save the model
  3578 |         for shard_file, tensor_names in logging.tqdm(
  3579 |             state_dict_split.filename_to_tensors.items(), desc="Writing model shards"
  3580 |         ):
  3581 |             filename = os.path.join(save_directory, shard_file)
  3582 |             shard_state_dict = {}
  3583 |             for tensor_name in tensor_names:
