   457 |     def test_full_attention_get_indices(
   458 |         self,
   459 |         block_size: int,
   460 |         block_table: list[int],
   461 |         past_length: int,
   462 |         query_length: int,
   463 |     ) -> None:
   464 |         """Test FullAttentionCacheAllocator.get_read_indices and get_write_indices return correct physical indices."""
   465 | 
   466 |         def reference_indices(start: int, end: int) -> list[int]:
   467 |             """Reference implementation: converts logical indices to physical indices."""
   468 |             return [block_table[i // block_size] * block_size + i % block_size for i in range(start, end)]
   469 | 
   470 |         allocator = FullAttentionCacheAllocator(index=0, block_size=block_size, allow_block_sharing=False)
   471 |         allocator.block_table["req"] = block_table
   472 | 
   473 |         # Test read indices (from 0 to past_length + query_length)
   474 |         expected_read = reference_indices(0, past_length + query_length)
   475 |         self.assertEqual(allocator.get_read_indices("req", past_length, query_length), expected_read)
   476 | 
   477 |         # Test write indices (from past_length to past_length + query_length)
   478 |         expected_write = reference_indices(past_length, past_length + query_length)
   479 |         self.assertEqual(allocator.get_write_indices("req", past_length, query_length), expected_write)
   480 | 
   481 |     @parameterized.expand(
   482 |         [
   483 |             # (block_size, sliding_window, block_table, past_length, query_length)
   484 |             # Prefill from empty: no cache read, only sentinels in the read indices
   485 |             (4, 8, [0, 1], 0, 3),
   486 |             # Decode within the window
   487 |             (4, 8, [0, 1], 5, 1),
   488 |             # Chunked prefill in the middle of the window
   489 |             (4, 8, [0, 1], 2, 4),
   490 |             # Past length beyond the window: rolling-buffer wrap-around
   491 |             (4, 8, [0, 1], 10, 1),
   492 |             (4, 8, [0, 1], 14, 3),
   493 |             # Non-contiguous blocks
   494 |             (4, 8, [3, 5], 6, 2),
   495 |             # Query longer than the window: write indices get left-padded with the write trash index
   496 |             (4, 8, [0, 1], 0, 10),
   497 |             # Single-block window (block_size == sliding_window)
   498 |             (4, 4, [7], 3, 1),
   499 |             # Larger block size
   500 |             (16, 32, [0, 1], 20, 4),
   501 |         ]
   502 |     )
   503 |     def test_sliding_attention_get_indices(
   504 |         self,
   505 |         block_size: int,
   506 |         sliding_window: int,
   507 |         block_table: list[int],
   508 |         past_length: int,
   509 |         query_length: int,
   510 |     ) -> None:
   511 |         """Test SlidingAttentionCacheAllocator.get_read_indices and get_write_indices place the cache, sentinel and
   512 |         write trash indices correctly, including for small block sizes and rolling-buffer wrap-around."""
   513 |         # The special indices live in the padding zone above the allocatable blocks (see PagedAttentionCache). We pick a
   514 |         # num_blocks larger than any block id used here so they never collide with real cache positions.
   515 |         num_blocks = 64
   516 |         self.assertTrue(all(b < num_blocks for b in block_table))
   517 |         sentinel_index = num_blocks * block_size + 1
   518 |         write_trash_index = (num_blocks + 1) * block_size
   519 | 
   520 |         def to_physical(i: int) -> int:
   521 |             """Reference logical-to-physical mapping inside the rolling buffer."""
   522 |             i %= sliding_window
   523 |             return block_table[i // block_size] * block_size + i % block_size
   524 | 
   525 |         allocator = SlidingAttentionCacheAllocator(
   526 |             index=0,
   527 |             block_size=block_size,
   528 |             sliding_window=sliding_window,
   529 |             sentinel_index=sentinel_index,
   530 |             write_trash_index=write_trash_index,
   531 |         )
   532 |         allocator.block_table["req"] = block_table
   533 | 
   534 |         # Read indices: cache positions followed by one sentinel per query token
   535 |         read_start = 0 if past_length < sliding_window else past_length % sliding_window
   536 |         read_cache_length = min(past_length, sliding_window - 1)
   537 |         expected_read = [to_physical(i) for i in range(read_start, read_start + read_cache_length)]
   538 |         expected_read += [sentinel_index] * query_length
   539 |         read = allocator.get_read_indices("req", past_length, query_length)
   540 | 
   541 |         # Main check
   542 |         self.assertEqual(read, expected_read)
   543 |         # No sentinel in the real indices
   544 |         self.assertNotIn(sentinel_index, read[:read_cache_length])
   545 |         # Cache reads land in allocated blocks
   546 |         for idx in read[:read_cache_length]:
   547 |             self.assertIn(idx // block_size, block_table)
   548 | 
   549 |         # Write indices: one slot per query token, left-padded with the write trash index when the query overflows the
   550 |         # window
   551 |         write_start = past_length % sliding_window
   552 |         write_cache_length = min(query_length, sliding_window)
   553 |         padding_length = query_length - write_cache_length
   554 |         expected_write = [write_trash_index] * padding_length
   555 |         expected_write += [to_physical(i) for i in range(write_start, write_start + write_cache_length)]
   556 |         write = allocator.get_write_indices("req", past_length, query_length)
   557 | 
   558 |         # Main check
   559 |         self.assertEqual(write, expected_write)
   560 |         # Trash only at the front
   561 |         self.assertNotIn(write_trash_index, write[padding_length:])
   562 |         # Cache writes land in allocated blocks
   563 |         for idx in write[padding_length:]:
   564 |             self.assertIn(idx // block_size, block_table)
   565 | 
