   359 |         self,
   360 |         hidden_states: torch.tensor,
   361 |         attention_mask: torch.Tensor | None = None,
   362 |         output_attentions: bool = False,
   363 |         output_hidden_states: bool = False,
   364 |         return_dict: bool = True,
   365 |     ):
