   106 |     def __call__(
   107 |         self,
   108 |         images: ImageInput | None = None,
   109 |         text: TextInput | PreTokenizedInput | list[TextInput] | list[PreTokenizedInput] = None,
   110 |         **kwargs: Unpack[PixtralProcessorKwargs],
   111 |     ) -> BatchFeature:
   112 |         r"""
   113 |         Returns:
   114 |             [`BatchFeature`]: A [`BatchFeature`] with the following fields:
   115 | 
   116 |             - **input_ids** -- List of token ids to be fed to a model. Returned when `text` is not `None`.
   117 |             - **attention_mask** -- List of indices specifying which tokens should be attended to by the model (when
   118 |               `return_attention_mask=True` or if *"attention_mask"* is in `self.model_input_names` and if `text` is not
   119 |             `None`).
   120 |             - **pixel_values** -- Pixel values to be fed to a model. Returned when `images` is not `None`.
   121 |         """
   122 | 
   123 |         output_kwargs = self._merge_kwargs(
   124 |             PixtralProcessorKwargs,
   125 |             tokenizer_init_kwargs=getattr(self.tokenizer, "init_kwargs", {}),
   126 |             **kwargs,
   127 |         )
   128 | 
   129 |         patch_size = self.patch_size * self.spatial_merge_size
   130 | 
   131 |         if images is not None:
   132 |             output_kwargs["images_kwargs"]["patch_size"] = patch_size
   133 |             image_inputs = self.image_processor(images, **output_kwargs["images_kwargs"])
   134 |         else:
   135 |             image_inputs = {}
   136 | 
   137 |         if isinstance(text, str):
   138 |             text = [text]
   139 |         elif not isinstance(text, list) and not isinstance(text[0], str):
   140 |             raise TypeError("Invalid input text. Please provide a string, or a list of strings")
   141 | 
   142 |         # try to expand inputs in processing if we have the necessary parts
   143 |         prompt_strings = text
   144 |         if image_inputs.get("pixel_values") is not None:
   145 |             # Replace the image token with the expanded image token sequence
   146 |             image_sizes = iter(image_inputs["image_sizes"])
   147 |             prompt_strings = []
   148 |             replace_strings = []
   149 | 
   150 |             for sample in text:
   151 |                 while self.image_token in sample:
   152 |                     height, width = next(image_sizes)
   153 |                     num_height_tokens = height // patch_size
   154 |                     num_width_tokens = width // patch_size
   155 |                     replace_tokens = [
   156 |                         [self.image_token] * num_width_tokens + [self.image_break_token]
   157 |                     ] * num_height_tokens
   158 |                     # Flatten list
   159 |                     replace_tokens = [item for sublist in replace_tokens for item in sublist]
   160 |                     replace_tokens[-1] = self.image_end_token
   161 |                     replace_str = "".join(replace_tokens)
   162 |                     replace_strings.append(replace_str)
   163 |                     sample = sample.replace(self.image_token, "<placeholder>", 1)
   164 | 
   165 |                 while "<placeholder>" in sample:
   166 |                     replace_str = replace_strings.pop(0)
   167 |                     sample = sample.replace("<placeholder>", replace_str, 1)
   168 |                 prompt_strings.append(sample)
   169 | 
   170 |         return_tensors = output_kwargs["text_kwargs"].pop("return_tensors", None)
   171 |         return_mm_token_type_ids = output_kwargs["text_kwargs"].pop("return_mm_token_type_ids", False)
   172 |         # Remove return_token_type_ids as MistralCommonBackend doesn't support it
   173 |         output_kwargs["text_kwargs"].pop("return_token_type_ids", None)
   174 |         text_inputs = self.tokenizer(prompt_strings, **output_kwargs["text_kwargs"], return_tensors=None)
   175 |         self._check_special_mm_tokens(prompt_strings, text_inputs, modalities=["image"])
   176 | 
   177 |         if return_mm_token_type_ids:
   178 |             text_inputs["mm_token_type_ids"] = self.create_mm_token_type_ids(text_inputs["input_ids"])
   179 |         return BatchFeature(data={**text_inputs, **image_inputs}, tensor_type=return_tensors)
   180 | 

