    68 | def _make_dtensor_shard_op(mesh, placements, param_shape, local_shape):
    69 |     """Build a DtensorShardOperation without requiring a real DTensor / distributed init.
    70 | 
    71 |     The axis-0 ownership cache is computed by mimicking
    72 |     ``compute_local_shape_and_global_offset`` for the leading dim only:
    73 |     locate the mesh dim that shards param dim 0 (if any) and use its local rank.
    74 |     """
    75 |     op = object.__new__(DtensorShardOperation)
    76 |     op.device_mesh = mesh
    77 |     op.placements = tuple(placements)
    78 |     op.param_ndim = len(param_shape)
    79 |     op._axis0_offset = 0
    80 |     op._axis0_local_size = local_shape[0]
    81 |     for mesh_dim, p in enumerate(placements):
    82 |         if hasattr(p, "dim") and (p.dim % len(param_shape)) == 0:
    83 |             sub = mesh[mesh.mesh_dim_names[mesh_dim]] if mesh.ndim > 1 else mesh
    84 |             op._axis0_offset = sub.get_local_rank() * local_shape[0]
    85 |             break
    86 |     return op
    87 | 



