  2542 |             model_kwargs = self._prepare_encoder_decoder_kwargs_for_generation(
  2543 |                 inputs_tensor, model_kwargs, model_input_name, generation_config
  2544 |             )
  2545 | 
  2546 |         # 5. Prepare `input_ids` which will be used for auto-regressive generation
  2547 |         if self.config.is_encoder_decoder:
  2548 |             input_ids, model_kwargs = self._prepare_decoder_input_ids_for_generation(
  2549 |                 batch_size=batch_size,
  2550 |                 model_input_name=model_input_name,
  2551 |                 model_kwargs=model_kwargs,
  2552 |                 decoder_start_token_id=generation_config._decoder_start_token_tensor,
