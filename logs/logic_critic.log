  4858 |     def mark_tied_weights_as_initialized(self, loading_info):
  4859 |         """Adds the `_is_hf_initialized` flag on parameters that will be tied, in order to avoid initializing them
  4860 |         later as they will be tied (overwritten) anyway.
  4861 |         This is very important as most embeddings are tied, and they are huge params (vocabularies are often 256k), so
  4862 |         running inits on them is very costly."""
  4863 |         for tied_param in getattr(self, "all_tied_weights_keys", {}).keys():
  4864 |             param = self.get_parameter(tied_param)
  4865 |             setattr(param, "_is_hf_initialized", True)
  4866 | 
  4867 |         # Some remote code models define module tying (not parameter tying) in their __init__. When modules themselves are shared,
  4868 |         # weights inside both modules appear in the `state_dict` but only one will appear in the safetensors checkpoints
  4869 |         # as they are inherently tied because the 2 modules are the same object. In this case, once we load a parameter
  4870 |         # inside one of the 2 modules, the other will also automatically be loaded and will have the `_is_hf_initialized`
  4871 |         # flag (because we call `setattr` with the loaded param on the module, which is the same object), but its counterpart
  4872 |         # will still appear as a missing key as we never get it out of the set (because it appears in the state_dict as well).
  4873 |         # So we remove it now - otherwise it's considered missing and will be wrongly reinitialized
  4874 |         # Note: this is never an issue in main Transformers, as we never do module-tying, only parameter-tying, and we know
  4875 |         # which params are supposed to be tied to which other params
  4876 |         if self.is_remote_code():
  4877 |             # Remove those that are already initialized, but appear as missing due to module tying (only if they are not known
  4878 |             # tied weights, i.e. we did not explicitly mark them as initialized just above)
  4879 |             loading_info.missing_keys = {
  4880 |                 key
  4881 |                 for key in loading_info.missing_keys
  4882 |                 if key in self.all_tied_weights_keys
  4883 |                 or not getattr(self.get_parameter_or_buffer(key), "_is_hf_initialized", False)
  4884 |             }
