    34 |     async def attempt_execution(self, order_id: uuid.UUID) -> TradeExecution | None:
    35 |         """
    36 |         Attempts to fill an open order, utilizing automatic retries for optimistic lock failures.
    37 |         """
    38 |         max_retries = 3
    39 |         
    40 |         for attempt in range(max_retries):
    41 |             try:
    42 |                 # Wrap the entire execution attempt in a savepoint
    43 |                 async with self.session.begin_nested():
    44 |                     stmt = select(Order).where(Order.id == order_id)
    45 |                     result = await self.session.execute(stmt)
    46 |                     order = result.scalar_one_or_none()
