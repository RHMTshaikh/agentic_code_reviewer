  1194 | def spawn_materialize(
  1195 |     thread_pool: ThreadPoolExecutor | None,
  1196 |     tensor: torch.Tensor,
  1197 |     device=None,
  1198 |     dtype=None,
  1199 |     sharding_op: DtensorShardOperation | None = None,
  1200 |     tensor_idx: int | None = None,
  1201 | ) -> Future | Callable:
  1202 |     """Materialize (and optionally shard) a tensor, asynchronously if a thread pool is provided.
  1203 | 
  1204 |     When ``sharding_op`` is given the tensor is sharded (DTensor placement or legacy TP plan);
  1205 |     otherwise it is simply copied to *device*/*dtype*. Without a thread pool a deferred
  1206 |     callable is returned instead of a Future.
  1207 |     """
  1208 | 
  1209 |     def _job():
  1210 |         if sharding_op is not None:
  1211 |             return sharding_op.shard_tensor(tensor, tensor_idx=tensor_idx, device=device, dtype=dtype)
  1212 |         return _materialize_copy(tensor, device, dtype)
  1213 | 
  1214 |     if thread_pool is not None:
  1215 |         return thread_pool.submit(_job)
  1216 |     else:
  1217 |         # Return the Callable here, not the Tensor itself, so we actually delay loading to avoid saturating cpu
