   304 |             ((0, 8), 0, 2, 2): [(0, 2), (4, 6)],
   305 |             ((0, 8), 1, 2, 2): [(2, 4), (6, 8)],
   306 |             # Uneven (0, 7) sf=2 -> group 0 = (0,4), group 1 = (4,7) -> size 3
   307 |             ((0, 7), 0, 2, 2): [(0, 2), (4, 6)],  # rank 0 -> half of each group
   308 |             ((0, 7), 1, 2, 2): [(2, 4), (6, 7)],  # rank 1's piece in group 1 is 1 elem wide
   309 |             # split_factor=1 collapses to a single group -> contiguous behavior
   310 |             ((0, 4), 0, 2, 1): [(0, 2)],
   311 |             # split_factor=4 on size-2: groups (0,1), (1,2), (2,2), (3,2) -> last 2 empty -> skipped
   312 |             ((0, 2), 0, 2, 4): [(0, 1), (1, 2)],
   313 |         }
   314 |         for (interval, rank, ws, sf), exp in expected.items():
   315 |             with self.subTest(interval=interval, rank=rank, ws=ws, sf=sf):
   316 |                 self.assertEqual(op._compute_strided_slice([interval], rank=rank, world_size=ws, split_factor=sf), exp)
