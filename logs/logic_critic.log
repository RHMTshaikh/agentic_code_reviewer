  3791 | def _process_parameters_section(
  3792 |     func_documentation,
  3793 |     sig,
  3794 |     func,
  3795 |     class_name,
  3796 |     model_name_lowercase,
  3797 |     parent_class,
  3798 |     indent_level,
  3799 |     source_args_dict,
  3800 |     allowed_params,
  3801 | ):
  3802 |     """
  3803 |     Process the parameters section of the docstring.
  3804 | 
  3805 |     Args:
  3806 |         func_documentation (`str`): Existing function documentation (manually specified in the docstring)
  3807 |         sig (`inspect.Signature`): Function signature
  3808 |         func (`function`): Function the parameters belong to
  3809 |         class_name (`str`): Name of the class the function belongs to
  3810 |         model_name_lowercase (`str`): Lowercase model name
  3811 |         parent_class (`class`): Parent class of the function (if any)
  3812 |         indent_level (`int`): Indentation level
  3813 |     """
  3814 |     # Start Args section — constant string, min_indent is always 0, so skip set_min_indent
  3815 |     docstring = " " * (indent_level + 4) + "Args:\n"
  3816 |     undocumented_parameters = []
  3817 |     documented_params = {}
  3818 |     documented_kwargs = {}
  3819 | 
  3820 |     # Parse existing docstring if available
  3821 |     if func_documentation is not None:
  3822 |         documented_params, func_documentation = parse_docstring(func_documentation)
  3823 | 
  3824 |     # Process regular parameters
  3825 |     param_docstring, missing_args = _process_regular_parameters(
  3826 |         sig,
  3827 |         func,
  3828 |         class_name,
  3829 |         documented_params,
  3830 |         indent_level,
  3831 |         undocumented_parameters,
  3832 |         source_args_dict,
  3833 |         parent_class,
  3834 |         allowed_params,
  3835 |     )
  3836 |     docstring += param_docstring
  3837 | 
  3838 |     # Process **kwargs parameters if needed
  3839 |     kwargs_docstring, kwargs_summary = _process_kwargs_parameters(
  3840 |         sig, func, parent_class, documented_kwargs, indent_level, undocumented_parameters
  3841 |     )
  3842 |     docstring += kwargs_docstring
  3843 | 
  3844 |     # Add return_tensors for processor __call__ methods if not already present
  3845 |     docstring = _add_return_tensors_to_docstring(func, parent_class, docstring, indent_level)
  3846 | 
  3847 |     # Add **kwargs summary line after return_tensors
  3848 |     docstring += kwargs_summary
  3849 | 
  3850 |     # Report undocumented parameters
  3851 |     if len(undocumented_parameters) > 0:
  3852 |         print("\n".join(undocumented_parameters))
  3853 | 
  3854 |     return docstring
  3855 | 
