  2230 |     def set_evaluate(
  2231 |         self,
  2232 |         strategy: str | IntervalStrategy = "no",
  2233 |         steps: int = 500,
  2234 |         batch_size: int = 8,
  2235 |         accumulation_steps: int | None = None,
  2236 |         delay: float | None = None,
  2237 |         loss_only: bool = False,
  2238 |     ):
  2239 |         """
  2240 |         A method that regroups all arguments linked to evaluation.
  2241 | 
  2242 |         Args:
  2243 |             strategy (`str` or [`~trainer_utils.IntervalStrategy`], *optional*, defaults to `"no"`):
  2244 |                 The evaluation strategy to adopt during training. Possible values are:
  2245 | 
  2246 |                     - `"no"`: No evaluation is done during training.
  2247 |                     - `"steps"`: Evaluation is done (and logged) every `steps`.
  2248 |                     - `"epoch"`: Evaluation is done at the end of each epoch.
  2249 | 
  2250 |                 Setting a `strategy` different from `"no"` will set `self.do_eval` to `True`.
  2251 |             steps (`int`, *optional*, defaults to 500):
  2252 |                 Number of update steps between two evaluations if `strategy="steps"`.
  2253 |             batch_size (`int` *optional*, defaults to 8):
  2254 |                 The batch size per device (GPU/TPU core/CPU...) used for evaluation.
  2255 |             accumulation_steps (`int`, *optional*):
  2256 |                 Number of predictions steps to accumulate the output tensors for, before moving the results to the CPU.
  2257 |                 If left unset, the whole predictions are accumulated on GPU/TPU before being moved to the CPU (faster
  2258 |                 but requires more memory).
  2259 |             delay (`float`, *optional*):
  2260 |                 Number of epochs or steps to wait for before the first evaluation can be performed, depending on the
  2261 |                 eval_strategy.
  2262 |             loss_only (`bool`, *optional*, defaults to `False`):
  2263 |                 Ignores all outputs except the loss.
  2264 | 
  2265 |         Example:
  2266 | 
  2267 |         ```py
  2268 |         >>> from transformers import TrainingArguments
  2269 | 
  2270 |         >>> args = TrainingArguments("working_dir")
  2271 |         >>> args = args.set_evaluate(strategy="steps", steps=100)
  2272 |         >>> args.eval_steps
  2273 |         100
  2274 |         ```
  2275 |         """
  2276 |         self.eval_strategy = IntervalStrategy(strategy)
  2277 |         if self.eval_strategy == IntervalStrategy.STEPS and steps == 0:
  2278 |             raise ValueError("Setting `strategy` as 'steps' requires a positive value for `steps`.")
  2279 |         self.do_eval = self.eval_strategy != IntervalStrategy.NO
  2280 |         self.eval_steps = steps
  2281 |         self.per_device_eval_batch_size = batch_size
  2282 |         self.eval_accumulation_steps = accumulation_steps
  2283 |         self.eval_delay = delay
  2284 |         self.prediction_loss_only = loss_only
  2285 |         return self
