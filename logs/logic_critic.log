  1317 |     def dummy_inputs(self) -> dict[str, torch.Tensor]:
  1318 |         """
  1319 |         `dict[str, torch.Tensor]`: Dummy inputs to do a forward pass in the network.
  1320 |         """
  1321 |         return {"input_ids": torch.tensor(DUMMY_INPUTS)}
