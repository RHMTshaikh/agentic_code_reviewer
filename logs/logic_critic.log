  1351 |     @property
  1352 |     def special_tokens_map(self) -> dict[str, str]:
  1353 |         """
  1354 |         `dict[str, str]`: A flat dictionary mapping named special token attributes to their string values.
  1355 | 
  1356 |         Only includes the standard named special tokens (bos_token, eos_token, etc.), not extra_special_tokens.
  1357 |         This provides a clean, flat structure without mixed types.
  1358 | 
  1359 |         Returns:
  1360 |             A dictionary with keys like 'bos_token', 'eos_token', etc., and string values.
  1361 | 
  1362 |         **V5 Change**: This now returns only named tokens. Use `extra_special_tokens` for the additional tokens.
  1363 |         """
  1364 |         return {
  1365 |             attr: str(self._special_tokens_map[attr])
  1366 |             for attr in self.SPECIAL_TOKENS_ATTRIBUTES
  1367 |             if self._special_tokens_map.get(attr) is not None
  1368 |         }
  1369 | 
  1370 |     # Note: extra_special_tokens and extra_special_tokens_ids are handled by __getattr__ and __setattr__
  1371 |     # We don't define them as @property to keep the implementation simpler
  1372 | 
  1373 |     @property
  1374 |     def all_special_tokens(self) -> list[str]:
  1375 |         """
  1376 |         `list[str]`: A list of all unique special tokens (named + extra) as strings.
  1377 | 
  1378 |         Includes both named special tokens (bos_token, eos_token, etc.) and extra special tokens.
  1379 |         Converts tokens of `tokenizers.AddedToken` type to string.
  1380 |         """
  1381 |         seen = set()
  1382 |         all_toks = []
  1383 | 
  1384 |         # Add named special tokens
  1385 |         for attr in self.SPECIAL_TOKENS_ATTRIBUTES:
  1386 |             value = self._special_tokens_map.get(attr)
  1387 |             if value is not None:
  1388 |                 token_str = str(value)
  1389 |                 if token_str not in seen:
  1390 |                     all_toks.append(token_str)
  1391 |                     seen.add(token_str)
  1392 | 
  1393 |         # Add extra special tokens
  1394 |         for token in self._extra_special_tokens:
  1395 |             token_str = str(token)
  1396 |             if token_str not in seen:
  1397 |                 all_toks.append(token_str)
  1398 |                 seen.add(token_str)
  1399 | 
  1400 |         return all_toks
  1401 | 
  1402 |     @property
  1403 |     def all_special_ids(self) -> list[int]:
  1404 |         """
  1405 |         `list[int]`: List the ids of the special tokens(`'<unk>'`, `'<cls>'`, etc.) mapped to class attributes.
  1406 |         """
  1407 |         return self.convert_tokens_to_ids(self.all_special_tokens)
