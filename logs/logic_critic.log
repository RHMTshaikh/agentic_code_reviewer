   185 |             image_sizes_iter = iter(image_inputs["image_sizes"])
   186 |             prompt_strings = []
   187 | 
   188 |             for sample in text:
   189 |                 replace_strings = []
   190 | 
   191 |                 while self.image_token in sample:
   192 |                     image_height, image_width = next(image_sizes_iter)
   193 |                     num_height_tokens = image_height // self.effective_patch_size
   194 |                     num_width_tokens = image_width // self.effective_patch_size
   195 |                     num_patches = num_height_tokens * num_width_tokens
   196 | 
   197 |                     replace_str = self.image_token * num_patches
   198 |                     replace_strings.append(replace_str)
   199 | 
   200 |                     sample = sample.replace(self.image_token, "<placeholder>", 1)
   201 | 
   202 |                 while "<placeholder>" in sample:
   203 |                     replace_str = replace_strings.pop(0)
   204 |                     sample = sample.replace("<placeholder>", replace_str, 1)
   205 | 
   206 |                 prompt_strings.append(sample)
   207 |         else:
   208 |             prompt_strings = text
   209 | 
