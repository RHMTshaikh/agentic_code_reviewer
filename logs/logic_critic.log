   297 |     def test_apply_strided_shard(self):
   298 |         # Direct tests for _apply_strided_shard(intervals, rank, world_size, split_factor).
   299 |         # Keys: (input_interval, rank, world_size, split_factor) -> expected output list.
   300 |         mesh = FakeMesh(shape=(2,), rank=0)
   301 |         op = _make_dtensor_shard_op(mesh, [Shard(0)], param_shape=(8,), local_shape=(4,))
   302 |         expected = {
   303 |             # Even (0, 8) sf=2 ws=2 -> groups (0,4) (4,8); each rank takes half of each
   304 |             ((0, 8), 0, 2, 2): [(0, 2), (4, 6)],
   305 |             ((0, 8), 1, 2, 2): [(2, 4), (6, 8)],
   306 |             # Uneven (0, 7) sf=2 -> group 0 = (0,4), group 1 = (4,7) -> size 3
   307 |             ((0, 7), 0, 2, 2): [(0, 2), (4, 6)],  # rank 0 -> half of each group
   308 |             ((0, 7), 1, 2, 2): [(2, 4), (6, 7)],  # rank 1's piece in group 1 is 1 elem wide
   309 |             # split_factor=1 collapses to a single group -> contiguous behavior
   310 |             ((0, 4), 0, 2, 1): [(0, 2)],
   311 |             # split_factor=4 on size-2: groups (0,1), (1,2), (2,2), (3,2) -> last 2 empty -> skipped
   312 |             ((0, 2), 0, 2, 4): [(0, 1), (1, 2)],
   313 |         }
   314 |         for (interval, rank, ws, sf), exp in expected.items():
   315 |             with self.subTest(interval=interval, rank=rank, ws=ws, sf=sf):
   316 |                 self.assertEqual(op._apply_strided_shard([interval], rank=rank, world_size=ws, split_factor=sf), exp)
   317 | 
   318 |     def test_apply_contiguous_shard(self):
   319 |         # Direct tests for _apply_contiguous_shard(intervals, rank, world_size).
   320 |         # Keys: (input_intervals, rank, world_size) -> expected output list.
   321 |         mesh = FakeMesh(shape=(2,), rank=0)
   322 |         op = _make_dtensor_shard_op(mesh, [Shard(0)], param_shape=(8,), local_shape=(4,))
   323 |         expected = {
   324 |             # Single interval, even split -> rank 0 -> first 4 elems, rank 1 -> last 4 elems
   325 |             (((0, 8),), 0, 2): [(0, 4)],
   326 |             (((0, 8),), 1, 2): [(4, 8)],
   327 |             # Uneven: size 5 / 2 ranks -> rank 0 -> first 3 elems, rank 1 -> last 2 elems
   328 |             (((0, 5),), 0, 2): [(0, 3)],
   329 |             (((0, 5),), 1, 2): [(3, 5)],
   330 |             # Empty: size 3 / 4 ranks -> rank 3 -> nothing
   331 |             (((0, 3),), 3, 4): [],
   332 |             # Multi-input intervals (8 elems): rank -> takes its slice from whichever interval(s) cover it
   333 |             (((0, 4), (10, 14)), 0, 2): [(0, 4)],  # rank 0 -> first 4 elems = first interval entirely
   334 |             (((0, 4), (10, 14)), 1, 2): [(10, 14)],  # rank 1 -> last 4 elems = second interval entirely
   335 |             (((0, 4), (10, 14)), 2, 4): [(10, 12)],  # ws=4, rank 2 -> cuts mid-input-interval
   336 |         }
   337 |         for (intervals, rank, ws), exp in expected.items():
   338 |             with self.subTest(intervals=intervals, rank=rank, ws=ws):
   339 |                 self.assertEqual(op._apply_contiguous_shard(list(intervals), rank=rank, world_size=ws), exp)
   340 | 
   341 |     def test_slice_and_cat(self):
   342 |         # Direct tests for _slice_and_cat(source, intervals, device, dtype).
   343 |         tensor = torch.arange(64).reshape(8, 8).float()
   344 |         mesh = FakeMesh(shape=(2,), rank=0)
   345 |         op = _make_dtensor_shard_op(mesh, [Shard(0)], param_shape=(8, 8), local_shape=(4, 8))
   346 |         expected = {
   347 |             # Fast path: every dim is single-interval -> one slice read, no cat
   348 |             "fast_path": ([[(0, 4)], [(0, 8)]], tensor[:4, :]),
   349 |             # Cat along dim 1: two disjoint col ranges -> read separately and concat
   350 |             "cat_dim1": ([[(0, 4)], [(0, 2), (4, 6)]], torch.cat([tensor[:4, :2], tensor[:4, 4:6]], dim=1)),
   351 |             # Cat along dim 0: two disjoint row ranges -> read separately and concat
   352 |             "cat_dim0": ([[(0, 2), (4, 6)], [(0, 8)]], torch.cat([tensor[:2, :], tensor[4:6, :]], dim=0)),
   353 |         }
   354 |         for case, (intervals, exp) in expected.items():
   355 |             with self.subTest(case=case):
   356 |                 torch.testing.assert_close(op._slice_and_cat(tensor, intervals, None, None), exp)
   357 | 
   358 |         # Reject: two dims with disjoint ranges -> would require an outer-product of reads.
   359 |         with self.assertRaises(ValueError):
   360 |             op._slice_and_cat(tensor, [[(0, 2), (4, 6)], [(0, 2), (4, 6)]], None, None)
   361 | 
   362 |         result = op._slice_and_cat(tensor, [[(0, 4)], [(0, 8)]], None, torch.float16)
   363 |         self.assertEqual(result.dtype, torch.float16)
