   235 |             else:
   236 |                 other.write_index_storage.copy_(self.write_index_storage, non_blocking=non_blocking)
   237 |                 if self.max_kv_read > 0:
   238 |                     other.read_index_storage.copy_(self.read_index_storage, non_blocking=non_blocking)
   239 |             # Transfer the attention masks if needed
   240 |             if self.attention_mask is not None and other.attention_mask is not None:
   241 |                 for layer_type in self.attention_mask.keys():
   242 |                     other.attention_mask[layer_type].copy_(self.attention_mask[layer_type], non_blocking=non_blocking)
