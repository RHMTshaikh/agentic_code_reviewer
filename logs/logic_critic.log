   229 |     def assertInterval(self, member, container, msg=None):
   230 |         r"""
   231 |         Simple utility function to check if a member is inside an interval.
   232 |         """
   233 |         if isinstance(member, torch.Tensor):
   234 |             max_value, min_value = member.max().item(), member.min().item()
   235 |         elif isinstance(member, (list, tuple)):
   236 |             max_value, min_value = max(member), min(member)
   237 | 
   238 |         if not isinstance(container, list):
   239 |             raise TypeError("container should be a list or tuple")
   240 |         elif len(container) != 2:
   241 |             raise ValueError("container should have 2 elements")
   242 | 
   243 |         expected_min, expected_max = container
   244 | 
   245 |         is_inside_interval = (min_value >= expected_min) and (max_value <= expected_max)
   246 | 
   247 |         if not is_inside_interval:
   248 |             standardMsg = f"{safe_repr(member)} not found in {safe_repr(container)}"
   249 |             self.fail(self._formatMessage(msg, standardMsg))
   250 | 
