   191 |     def _compute_strided_slice(
   192 |         self, intervals: list[tuple[int, int]], rank: int, world_size: int, split_factor: int
   193 |     ) -> list[tuple[int, int]]:
   194 |         local_intervals = []
   195 | 
   196 |         for interval_start, interval_end in intervals:
   197 |             # For each interval, we break it into split_factor consecutive groups.
   198 |             group_width = math.ceil((interval_end - interval_start) / split_factor)
   199 | 
   200 |             for group_idx in range(split_factor):
   201 |                 # Compute this group's boundaries in source coordinates.
   202 |                 group_start = interval_start + group_idx * group_width
   203 |                 group_end = min(group_start + group_width, interval_end)
   204 |                 group_len = group_end - group_start
   205 | 
   206 |                 if group_len > 0:
   207 |                     # Inside each group, we do a normal contiguous shard across world_size ranks.
   208 |                     local_shard_size, local_shard_offset = Shard.local_shard_size_and_offset(
   209 |                         group_len, world_size, rank
   210 |                     )
   211 |                     if local_shard_size > 0:
   212 |                         # Convert group-local offset back to global source coordinates.
   213 |                         shard_start = group_start + local_shard_offset
   214 |                         local_intervals.append((shard_start, shard_start + local_shard_size))
   215 | 
   216 |         return local_intervals
   217 | 
   218 |     def _compute_contiguous_slice(
   219 |         self, intervals: list[tuple[int, int]], rank: int, world_size: int
   220 |     ) -> list[tuple[int, int]]:
   221 |         # We apply contiguous sharding to a list of intervals. Two cases:
   222 |         # 1. The intervals is a single interval -> we return the local interval for this rank.
   223 |         # 2. The intervals are disjoint (i.e: 2D TP + FSDP, same tensor dim (fused/interleaved TP = [StridedShard(d, sf=tp_size), Shard(d)])
   224 |         # -> find overlapping local intervals across the disjoint intervals.
   225 | 
   226 |         # Compute rank's local length and start offset when the total length is partitioned across world_size ranks.
   227 |         flat_total_len = sum(end - start for start, end in intervals)
   228 |         local_flat_len, local_flat_start = Shard.local_shard_size_and_offset(flat_total_len, world_size, rank)
   229 |         local_flat_end = local_flat_start + local_flat_len
   230 | 
   231 |         if local_flat_len == 0:
   232 |             return []
   233 | 
   234 |         # Single-interval case.
   235 |         if len(intervals) == 1:
   236 |             source_start, _ = intervals[0]
   237 |             return [(source_start + local_flat_start, source_start + local_flat_end)]
   238 | 
   239 |         # Disjoint intervals case.
   240 |         # 1) Build flat mapping from source intervals.
   241 |         # Example: intervals=[(0,3), (10,15)] -> flat segments: (0,3,0) and (3,8,10)
   242 |         # meaning flat [0,3) maps to source [0,3), and flat [3,8) maps to source [10,15).
   243 |         flat_segments = []  # (interval_flat_start, interval_flat_end, source_start)
   244 |         idx = 0
   245 |         for source_start, source_end in intervals:
   246 |             interval_len = source_end - source_start
   247 |             if interval_len > 0:
   248 |                 flat_segments.append((idx, idx + interval_len, source_start))
   249 |                 idx += interval_len
   250 | 
   251 |         # 2) Intersect this rank's flat span with each flat segment, then map overlap
   252 |         # back to source coordinates.
   253 |         # Example: local flat span [2,6) with segments above gives:
   254 |         #   overlap with [0,3) => [2,3) -> source (2,3)
   255 |         #   overlap with [3,8) => [3,6) -> source (10,13)
   256 |         # result: local_intervals = [(2,3), (10,13)]
   257 |         local_intervals = []
   258 |         for interval_flat_start, interval_flat_end, source_start in flat_segments:
   259 |             overlap_flat_start = max(interval_flat_start, local_flat_start)
   260 |             overlap_flat_end = min(interval_flat_end, local_flat_end)
   261 |             if overlap_flat_start < overlap_flat_end:
   262 |                 source_overlap_start = source_start + (overlap_flat_start - interval_flat_start)
   263 |                 source_overlap_end = source_start + (overlap_flat_end - interval_flat_start)
   264 |                 local_intervals.append((source_overlap_start, source_overlap_end))
   265 | 
   266 |         return local_intervals
   267 | 
   268 |     def _slice_and_cat(
   269 |         self,
   270 |         source: torch.Tensor,
   271 |         intervals: list[list[tuple[int, int]]],
   272 |         device: torch.device | str | int | None,
   273 |         dtype: torch.dtype | None,
   274 |     ) -> torch.Tensor:
   275 |         multi_interval_dims = [dim_idx for dim_idx, dim_intervals in enumerate(intervals) if len(dim_intervals) > 1]
   276 |         if len(multi_interval_dims) > 1:
   277 |             # NOTE(3outeille): not sure yet which scenario will have StridedShard
   278 |             # placements on both row and column. Thus, delay implementing this for now.
   279 |             raise ValueError("Current shard-on-read only supports disjoint ranges on a single checkpoint dimension.")
   280 |         concat_dim = multi_interval_dims[0] if multi_interval_dims else None
   281 | 
   282 |         base_slices = []
   283 |         for dim_idx, dim_intervals in enumerate(intervals):
   284 |             if dim_idx == concat_dim:
   285 |                 # Disconnected intervals on this dim — placeholder; filled per interval below.
   286 |                 base_slices.append(slice(None))
   287 |             else:
   288 |                 # Single contiguous slice on this dim.
   289 |                 start, end = dim_intervals[0]
   290 |                 base_slices.append(slice(start, end))
   291 | 
   292 |         # Fast path: every dim is one contiguous interval, read in a single slice.
   293 |         if concat_dim is None:
   294 |             return source[tuple(base_slices)].to(device=device, dtype=dtype)
   295 | 
   296 |         # Multi-interval dim: keep base slices fixed and vary concat_dim only.
   297 |         base_slices_tuple = tuple(base_slices)
   298 |         interval_tensors = []
   299 |         for interval_start, interval_end in intervals[concat_dim]:
   300 |             interval_slices = (
   301 |                 *base_slices_tuple[:concat_dim],
   302 |                 slice(interval_start, interval_end),
   303 |                 *base_slices_tuple[concat_dim + 1 :],
   304 |             )
   305 |             interval_tensors.append(source[interval_slices])
   306 | 
   307 |         return torch.cat(interval_tensors, dim=concat_dim).to(device=device, dtype=dtype)
   308 | 
   309 |     def _get_sub_mesh(self, mesh_dim: int):
   310 |         if self.device_mesh.ndim == 1:
   311 |             return self.device_mesh
   312 |         return self.device_mesh[self.device_mesh.mesh_dim_names[mesh_dim]]
   313 | 
   314 |     def _normalize_param_dim(self, dim: int) -> int:
   315 |         # if dim is negative, it should be normalized to the last axis
   316 |         return dim if dim >= 0 else self.param_ndim + dim
