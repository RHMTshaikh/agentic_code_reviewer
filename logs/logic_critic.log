   434 |     def load_custom_generate(
   435 |         self,
   436 |         pretrained_model_name_or_path: str | os.PathLike | None = None,
   437 |         trust_remote_code: bool | None = None,
   438 |         **kwargs,
   439 |     ) -> Callable:
   440 |         """
   441 |         Loads and returns a custom generate function, given a model repo.
   442 | 
   443 |         Args:
   444 |             pretrained_model_name_or_path (`str` or `os.PathLike`):
   445 |                  Can be either:
   446 |                     - A string, the *model id* of a pretrained model hosted inside a model repo on huggingface.co.
   447 |                     - A path to a *directory* containing model weights saved using
   448 |                       [`~PreTrainedModel.save_pretrained`], e.g., `./my_model_directory/`.
   449 |             trust_remote_code (`bool`, *optional*):
