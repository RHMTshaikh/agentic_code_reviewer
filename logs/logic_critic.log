   209 |     def create_and_check_mamba2_chunked_prefill(self, config, input_ids, *args, device="cpu"):
   210 |         """
   211 |         Adapted from `test_linear_attention_multi_token_cached_forward_matches_single_token`
   212 |         to check whether multi-token cached input is properly handled.
   213 | 
   214 |         Can either be run on GPU (fast path) or CPU (slow path), see `test_mamba2_chunked_prefill_*`
   215 |         """
   216 |         model = Mamba2Model(config=config)
   217 |         model.to(device)
   218 |         model.eval()
   219 | 
   220 |         input_ids = input_ids[:1].to(device)
   221 |         prefill_len = input_ids.shape[1] // 2 + 1
   222 |         prompt = input_ids[:, :prefill_len]
   223 |         next_token = input_ids[:, prefill_len : prefill_len + 1]
   224 |         distractors = input_ids[:, prefill_len + 1 :]
   225 |         multi_input = torch.cat([next_token, distractors], dim=1)
   226 | 
   227 |         cache_single = DynamicCache(config=config)
   228 |         with torch.no_grad():
   229 |             model(input_ids=prompt, cache_params=cache_single, use_cache=True)
   230 |             single_out = model(input_ids=next_token, cache_params=cache_single, use_cache=True)
   231 |         ref_first = single_out.last_hidden_state[:, 0, :]
   232 | 
   233 |         cache_multi = DynamicCache(config=config)
   234 |         with torch.no_grad():
   235 |             model(input_ids=prompt, cache_params=cache_multi, use_cache=True)
   236 |             multi_out = model(input_ids=multi_input, cache_params=cache_multi, use_cache=True)
   237 |         under_test_first = multi_out.last_hidden_state[:, 0, :]
   238 | 
   239 |         self.parent.assertTrue(
   240 |             torch.allclose(ref_first, under_test_first, atol=1e-4, rtol=1e-4),
   241 |             msg=f"Max diff: {(ref_first - under_test_first).abs().max().item():.6f}",
   242 |         )
