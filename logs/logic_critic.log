  2682 |         first_element = required_input[0]
  2683 |         if isinstance(first_element, (list, tuple)):
  2684 |             # first_element might be an empty list/tuple in some edge cases so we grab the first non empty element.
  2685 |             for item in required_input:
  2686 |                 if len(item) != 0:
  2687 |                     first_element = item[0]
