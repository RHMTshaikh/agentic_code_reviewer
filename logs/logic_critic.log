  4260 |         checkpoint_files, sharded_metadata = _get_resolved_checkpoint_files(
  4261 |             pretrained_model_name_or_path=pretrained_model_name_or_path,
  4262 |             variant=variant,
  4263 |             gguf_file=gguf_file,
  4264 |             use_safetensors=use_safetensors,
  4265 |             download_kwargs=download_kwargs_with_commit,
  4266 |             user_agent=user_agent,
  4267 |             is_remote_code=cls.is_remote_code(),
  4268 |             transformers_explicit_filename=getattr(config, "transformers_weights", None),
  4269 |             tqdm_class=tqdm_class,
  4270 |         )
  4271 | 
  4272 |         is_quantized = hf_quantizer is not None
  4273 | 
  4274 |         # Find the correct dtype based on current state
