  2073 |             if kwargs_has_attention_mask is not None and not kwargs_has_attention_mask:
  2074 |                 logger.warning_once(
  2075 |                     "The attention mask is not set and cannot be inferred from input because pad token is same as "
  2076 |                     "eos token. As a consequence, you may observe unexpected behavior. Please pass your input's "
  2077 |                     "`attention_mask` to obtain reliable results."
  2078 |                 )
