   897 |     @classmethod
   898 |     def _encode_special_floats(cls, obj: Any) -> Any:
   899 |         """
   900 |         Iterates over the passed object and encode specific floats that cannot be JSON-serialized. Python's JSON
   901 |         engine saves floats like `Infinity` (+/-) or `NaN` which are not compatible with other JSON engines.
   902 | 
   903 |         It serializes floats like `Infinity` as an object: `{'__float__': Infinity}`.
   904 |         """
   905 |         if isinstance(obj, float):
   906 |             if math.isnan(obj):
   907 |                 return {_FLOAT_TAG_KEY: "NaN"}
   908 |             if obj == float("inf"):
   909 |                 return {_FLOAT_TAG_KEY: "Infinity"}
   910 |             if obj == float("-inf"):
   911 |                 return {_FLOAT_TAG_KEY: "-Infinity"}
   912 |             return obj
   913 | 
   914 |         if isinstance(obj, dict):
   915 |             return {k: cls._encode_special_floats(v) for k, v in obj.items()}
   916 | 
   917 |         if isinstance(obj, (list, tuple)):
   918 |             return [cls._encode_special_floats(v) for v in obj]
   919 | 
   920 |         return obj
   921 | 
   922 |     @classmethod
   923 |     def _decode_special_floats(cls, obj: Any) -> Any:
   924 |         """
   925 |         Iterates over the passed object and decode specific floats that cannot be JSON-serialized. Python's JSON
   926 |         engine saves floats like `Infinity` (+/-) or `NaN` which are not compatible with other JSON engines.
   927 | 
   928 |         This method deserializes objects like `{'__float__': Infinity}` to their float values like `Infinity`.
   929 |         """
   930 |         if isinstance(obj, dict):
   931 |             if set(obj.keys()) == {_FLOAT_TAG_KEY} and isinstance(obj[_FLOAT_TAG_KEY], str):
   932 |                 tag = obj[_FLOAT_TAG_KEY]
   933 |                 if tag in _FLOAT_TAG_VALUES:
   934 |                     return _FLOAT_TAG_VALUES[tag]
   935 |                 return obj
   936 | 
   937 |             return {k: cls._decode_special_floats(v) for k, v in obj.items()}
   938 | 
   939 |         if isinstance(obj, list):
   940 |             return [cls._decode_special_floats(v) for v in obj]
   941 | 
   942 |         return obj
   943 | 
   944 |     def __eq__(self, other):
   945 |         return isinstance(other, PreTrainedConfig) and (self.__dict__ == other.__dict__)
   946 | 
   947 |     def __repr__(self):
   948 |         return f"{self.__class__.__name__} {self.to_json_string()}"
   949 | 
   950 |     def __iter__(self):
   951 |         yield from self.__dict__
   952 | 
   953 |     def to_diff_dict(self) -> dict[str, Any]:
   954 |         """
   955 |         Removes all attributes from the configuration that correspond to the default config attributes for
   956 |         better readability, while always retaining the `config` attribute from the class. Serializes to a
   957 |         Python dictionary.
   958 | 
   959 |         Returns:
   960 |             dict[str, Any]: Dictionary of all the attributes that make up this configuration instance.
   961 |         """
   962 |         config_dict = self.to_dict()
   963 | 
   964 |         # Get the default config dict (from a fresh PreTrainedConfig instance)
   965 |         default_config_dict = PreTrainedConfig().to_dict()
   966 | 
   967 |         # get class specific config dict
   968 |         class_config_dict = self.__class__().to_dict() if not self.has_no_defaults_at_init else {}
   969 | 
   970 |         serializable_config_dict = {}
   971 | 
   972 |         # Only serialize values that differ from the default config,
   973 |         # except always keep the 'config' attribute.
   974 |         for key, value in config_dict.items():
   975 |             if (
   976 |                 isinstance(getattr(self, key, None), PreTrainedConfig)
   977 |                 and key in class_config_dict
   978 |                 and isinstance(class_config_dict[key], dict)
   979 |             ):
   980 |                 # For nested configs we need to clean the diff recursively
   981 |                 diff = recursive_diff_dict(value, default_config_dict, config_obj=getattr(self, key, None))
   982 |                 if "model_type" in value:
   983 |                     # Needs to be set even if it's not in the diff
   984 |                     diff["model_type"] = value["model_type"]
   985 | 
   986 |                 serializable_config_dict[key] = diff
   987 |             elif (
   988 |                 key not in default_config_dict
   989 |                 or key == "transformers_version"
   990 |                 or key == "vocab_file"
   991 |                 or value != default_config_dict[key]
   992 |                 or (key in default_config_dict and value != class_config_dict.get(key, value))
   993 |             ):
   994 |                 serializable_config_dict[key] = value
   995 | 
   996 |         self._remove_keys_not_serialized(serializable_config_dict)
   997 | 
   998 |         # Key removed only in diff dict
   999 |         if "_name_or_path" in serializable_config_dict:
  1000 |             del serializable_config_dict["_name_or_path"]
  1001 | 
  1002 |         if hasattr(self, "quantization_config"):
  1003 |             serializable_config_dict["quantization_config"] = (
  1004 |                 self.quantization_config.to_dict()
  1005 |                 if not isinstance(self.quantization_config, dict) and self.quantization_config is not None
  1006 |                 else self.quantization_config
  1007 |             )
  1008 |         self.dict_dtype_to_str(serializable_config_dict)
  1009 | 
  1010 |         return serializable_config_dict
  1011 | 
  1012 |     def to_dict(self) -> dict[str, Any]:
  1013 |         """
  1014 |         Serializes this instance to a Python dictionary.
  1015 | 
  1016 |         Returns:
  1017 |             `dict[str, Any]`: Dictionary of all the attributes that make up this configuration instance.
  1018 |         """
  1019 |         output = copy.deepcopy(self.__dict__)
  1020 |         if hasattr(self.__class__, "model_type"):
  1021 |             output["model_type"] = self.__class__.model_type
  1022 | 
  1023 |         # Transformers version when serializing the model
  1024 |         output["transformers_version"] = __version__
  1025 | 
  1026 |         # Pop "kwargs" since they are unpacked and set in the post init
  1027 |         output.pop("kwargs", None)
  1028 | 
  1029 |         if "distributed_config" in output and hasattr(output["distributed_config"], "to_dict"):
  1030 |             output["distributed_config"] = output["distributed_config"].to_dict()
  1031 | 
  1032 |         def to_list(value):
  1033 |             if isinstance(value, tuple):
  1034 |                 value = [to_list(item) for item in value]
  1035 |             return value
  1036 | 
  1037 |         for key, value in output.items():
  1038 |             # Deal with nested configs like CLIP
  1039 |             if isinstance(value, PreTrainedConfig):
  1040 |                 value = value.to_dict()
  1041 |                 del value["transformers_version"]
  1042 | 
  1043 |             # Some models have defaults as tuples because dataclass
  1044 |             # doesn't allow mutables. Let's convert back to `list``
  1045 |             elif isinstance(value, tuple):
  1046 |                 value = to_list(value)
  1047 | 
  1048 |             output[key] = value
  1049 | 
  1050 |         self._remove_keys_not_serialized(output)
  1051 | 
  1052 |         if hasattr(self, "quantization_config"):
  1053 |             output["quantization_config"] = (
  1054 |                 self.quantization_config.to_dict()
  1055 |                 if not isinstance(self.quantization_config, dict) and self.quantization_config is not None
  1056 |                 else self.quantization_config
  1057 |             )
  1058 |         self.dict_dtype_to_str(output)
  1059 | 
  1060 |         return output
  1061 | 
  1062 |     def to_json_string(self, use_diff: bool = True) -> str:
  1063 |         """
  1064 |         Serializes this instance to a JSON string.
  1065 | 
  1066 |         Args:
  1067 |             use_diff (`bool`, *optional*, defaults to `True`):
  1068 |                 If set to `True`, only the difference between the config instance and the default `PreTrainedConfig()`
  1069 |                 is serialized to JSON string.
  1070 | 
  1071 |         Returns:
  1072 |             `str`: String containing all the attributes that make up this configuration instance in JSON format.
  1073 |         """
  1074 |         if use_diff is True:
  1075 |             config_dict = self.to_diff_dict()
  1076 |         else:
  1077 |             config_dict = self.to_dict()
  1078 | 
  1079 |         # Handle +/-Infinity and NaNs
  1080 |         config_dict = self._encode_special_floats(config_dict)
  1081 | 
  1082 |         return json.dumps(config_dict, indent=2, sort_keys=True) + "\n"
  1083 | 
  1084 |     def to_json_file(self, json_file_path: str | os.PathLike, use_diff: bool = True):
  1085 |         """
  1086 |         Save this instance to a JSON file.
  1087 | 
  1088 |         Args:
  1089 |             json_file_path (`str` or `os.PathLike`):
  1090 |                 Path to the JSON file in which this configuration instance's parameters will be saved.
  1091 |             use_diff (`bool`, *optional*, defaults to `True`):
  1092 |                 If set to `True`, only the difference between the config instance and the default `PreTrainedConfig()`
  1093 |                 is serialized to JSON file.
  1094 |         """
  1095 |         with open(json_file_path, "w", encoding="utf-8") as writer:
  1096 |             writer.write(self.to_json_string(use_diff=use_diff))
  1097 | 
  1098 |     def update(self, config_dict: dict[str, Any]):
  1099 |         """
  1100 |         Updates attributes of this class with attributes from `config_dict`.
  1101 | 
  1102 |         Args:
  1103 |             config_dict (`dict[str, Any]`): Dictionary of attributes that should be updated for this class.
  1104 |         """
  1105 |         for key, value in config_dict.items():
  1106 |             setattr(self, key, value)
  1107 | 
  1108 |     def update_from_string(self, update_str: str):
  1109 |         """
  1110 |         Updates attributes of this class with attributes from `update_str`.
  1111 | 
  1112 |         The expected format is ints, floats and strings as is, and for booleans use `true` or `false`. For example:
  1113 |         "n_embd=10,resid_pdrop=0.2,scale_attn_weights=false,summary_type=cls_index"
  1114 | 
  1115 |         The keys to change have to already exist in the config object.
  1116 | 
  1117 |         Args:
  1118 |             update_str (`str`): String with attributes that should be updated for this class.
  1119 | 
  1120 |         """
  1121 | 
  1122 |         d = dict(x.split("=") for x in update_str.split(","))
  1123 |         for k, v in d.items():
  1124 |             if not hasattr(self, k):
  1125 |                 raise ValueError(f"key {k} isn't in the original config dict")
  1126 | 
  1127 |             old_v = getattr(self, k)
  1128 |             if isinstance(old_v, bool):
  1129 |                 if v.lower() in ["true", "1", "y", "yes"]:
  1130 |                     v = True
  1131 |                 elif v.lower() in ["false", "0", "n", "no"]:
  1132 |                     v = False
  1133 |                 else:
  1134 |                     raise ValueError(f"can't derive true or false from {v} (key {k})")
  1135 |             elif isinstance(old_v, int):
  1136 |                 v = int(v)
  1137 |             elif isinstance(old_v, float):
  1138 |                 v = float(v)
  1139 |             elif not isinstance(old_v, str):
  1140 |                 raise TypeError(
  1141 |                     f"You can only update int, float, bool or string values in the config, got {v} for key {k}"
  1142 |                 )
  1143 | 
  1144 |             setattr(self, k, v)
  1145 | 
  1146 |     def dict_dtype_to_str(self, d: dict[str, Any]) -> None:
  1147 |         """
  1148 |         Checks whether the passed dictionary and its nested dicts have a *dtype* key and if it's not None,
  1149 |         converts torch.dtype to a string of just the type. For example, `torch.float32` get converted into *"float32"*
  1150 |         string, which can then be stored in the json format.
  1151 |         """
  1152 |         if d.get("dtype") is not None:
  1153 |             if isinstance(d["dtype"], dict):
  1154 |                 d["dtype"] = {k: str(v).split(".")[-1] for k, v in d["dtype"].items()}
  1155 |             # models like Emu3 can have "dtype" as token in config's vocabulary map,
  1156 |             # so we also exclude int type here to avoid error in this special case.
  1157 |             elif not isinstance(d["dtype"], (str, int)):
  1158 |                 d["dtype"] = str(d["dtype"]).split(".")[1]
  1159 |         for value in d.values():
  1160 |             if isinstance(value, dict):
  1161 |                 self.dict_dtype_to_str(value)
  1162 | 
  1163 |     def _remove_keys_not_serialized(self, d: dict[str, Any]) -> None:
  1164 |         """
  1165 |         Checks and removes if there are any keys in the dict that should not be serialized when saving the config.
  1166 |         Runs recursive check on the dict, to remove from all sub configs.
  1167 |         """
  1168 | 
  1169 |         for key_to_remove in [
  1170 |             "_is_quantized",
  1171 |             "_auto_class",
