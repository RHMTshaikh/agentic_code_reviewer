  3038 |     def _get_resized_lm_head(
  3039 |         self,
  3040 |         old_lm_head: nn.Linear,
  3041 |         new_num_tokens: int | None = None,
  3042 |         transposed: bool = False,
  3043 |         mean_resizing: bool = True,
  3044 |     ) -> nn.Linear:
  3045 |         """
  3046 |         Build a resized Linear Module from a provided old Linear Module. Increasing the size will add newly initialized
  3047 |         vectors at the end. Reducing the size will remove vectors from the end
  3048 | 
  3049 |         Args:
  3050 |             old_lm_head (`torch.nn.Linear`):
  3051 |                 Old lm head liner layer to be resized.
  3052 |             new_num_tokens (`int`, *optional*):
  3053 |                 New number of tokens in the linear matrix.
  3054 | 
  3055 |                 Increasing the size will add newly initialized vectors at the end. Reducing the size will remove
  3056 |                 vectors from the end. If not provided or `None`, just returns a pointer to the input tokens
  3057 |                 `torch.nn.Linear` module of the model without doing anything. transposed (`bool`, *optional*, defaults
  3058 |                 to `False`): Whether `old_lm_head` is transposed or not. If True `old_lm_head.size()` is `lm_head_dim,
  3059 |                 vocab_size` else `vocab_size, lm_head_dim`.
  3060 |             mean_resizing (`bool`):
  3061 |                 Whether to initialize the added embeddings from a multivariate normal distribution that has old embeddings' mean and
  3062 |                 covariance or to initialize them with a normal distribution that has a mean of zero and std equals `config.initializer_range`.
  3063 | 
  3064 |                 Setting `mean_resizing` to `True` is useful when increasing the size of the embeddings of causal language models,
  3065 |                 where the generated tokens' probabilities will not be affected by the added embeddings because initializing the new embeddings with the
  3066 |                 old embeddings' mean will reduce the kl-divergence between the next token probability before and after adding the new embeddings.
  3067 |                 Refer to this article for more information: https://nlp.stanford.edu/~johnhew/vocab-expansion.html
  3068 | 
  3069 |         Return:
  3070 |             `torch.nn.Linear`: Pointer to the resized Linear Module or the old Linear Module if `new_num_tokens` is
  3071 |             `None`
  3072 |         """
  3073 | 
  3074 |         if new_num_tokens is None:
  3075 |             return old_lm_head
  3076 | 
  3077 |         is_quantized = hasattr(self, "hf_quantizer") and self.hf_quantizer is not None
  3078 |         if is_deepspeed_zero3_enabled() and not is_quantized:
  3079 |             import deepspeed
  3080 | 
  3081 |             with deepspeed.zero.GatheredParameters(old_lm_head.weight, modifier_rank=None):
  3082 |                 old_num_tokens, old_lm_head_dim = (
  3083 |                     old_lm_head.weight.size() if not transposed else old_lm_head.weight.t().size()
  3084 |                 )
  3085 |         else:
  3086 |             old_num_tokens, old_lm_head_dim = (
  3087 |                 old_lm_head.weight.size() if not transposed else old_lm_head.weight.t().size()
  3088 |             )
  3089 | 
  3090 |         if old_num_tokens == new_num_tokens and not is_deepspeed_zero3_enabled():
  3091 |             old_lm_head.out_features = new_num_tokens  # maybe weights are tied which doesn't update attr
  3092 |             return old_lm_head
  3093 | 
  3094 |         if not isinstance(old_lm_head, nn.Linear):
  3095 |             raise TypeError(
  3096 |                 f"Old language model head is of type {type(old_lm_head)}, which is not an instance of {nn.Linear}. You"
  3097 |                 " should either use a different resize function or make sure that `old_lm_head` are an instance of"
  3098 |                 f" {nn.Linear}."
  3099 |             )
  3100 | 
  3101 |         # Build new lm head
  3102 |         new_lm_head_shape = (old_lm_head_dim, new_num_tokens) if not transposed else (new_num_tokens, old_lm_head_dim)
  3103 |         has_new_lm_head_bias = old_lm_head.bias is not None
  3104 | 
  3105 |         # When using DeepSpeed ZeRO-3, we shouldn't create new embeddings with DeepSpeed init
  3106 |         # because the shape of the new embedding layer is used across various modeling files
  3107 |         # as well as to update config vocab size. Shape will be 0 when using DeepSpeed init leading
  3108 |         # to errors when training.
  3109 |         new_lm_head = nn.Linear(
  3110 |             *new_lm_head_shape,
  3111 |             bias=has_new_lm_head_bias,
  3112 |             device=old_lm_head.weight.device,
  3113 |             dtype=old_lm_head.weight.dtype,
  3114 |         )
  3115 | 
  3116 |         if new_num_tokens > old_num_tokens and not mean_resizing:
  3117 |             # initialize new embeddings (in particular added tokens) with a mean of 0 and std equals `config.initializer_range`.
  3118 |             self._init_weights(new_lm_head)
  3119 | 
  3120 |         elif new_num_tokens > old_num_tokens and mean_resizing:
  3121 |             # initialize new lm_head weights (in particular added tokens). The new lm_head weights
  3122 |             # will be initialized from a multivariate normal distribution that has old embeddings' mean and covariance.
  3123 |             # as described in this article: https://nlp.stanford.edu/~johnhew/vocab-expansion.html
  3124 |             logger.warning_once(
  3125 |                 "The new lm_head weights will be initialized from a multivariate normal distribution that has old embeddings' mean and covariance. "
  3126 |                 "As described in this article: https://nlp.stanford.edu/~johnhew/vocab-expansion.html. "
  3127 |                 "To disable this, use `mean_resizing=False`"
  3128 |             )
  3129 | 
  3130 |             added_num_tokens = new_num_tokens - old_num_tokens
  3131 |             if is_deepspeed_zero3_enabled() and not is_quantized:
  3132 |                 import deepspeed
  3133 | 
  3134 |                 params = [old_lm_head.weight]
  3135 |                 if has_new_lm_head_bias:
  3136 |                     params += [old_lm_head.bias]
  3137 |                 with deepspeed.zero.GatheredParameters(params, modifier_rank=None):
  3138 |                     self._init_added_lm_head_weights_with_mean(
  3139 |                         old_lm_head, new_lm_head, old_lm_head_dim, old_num_tokens, added_num_tokens, transposed
  3140 |                     )
  3141 |                     if has_new_lm_head_bias:
  3142 |                         self._init_added_lm_head_bias_with_mean(old_lm_head, new_lm_head, added_num_tokens)
  3143 | 
  3144 |             else:
  3145 |                 self._init_added_lm_head_weights_with_mean(
  3146 |                     old_lm_head, new_lm_head, old_lm_head_dim, old_num_tokens, added_num_tokens, transposed
  3147 |                 )
  3148 |                 if has_new_lm_head_bias:
  3149 |                     self._init_added_lm_head_bias_with_mean(old_lm_head, new_lm_head, added_num_tokens)
  3150 | 
  3151 |         num_tokens_to_copy = min(old_num_tokens, new_num_tokens)
  3152 | 
  3153 |         if is_deepspeed_zero3_enabled() and not is_quantized:
  3154 |             import deepspeed
  3155 | 
  3156 |             params = [old_lm_head.weight, old_lm_head.bias, new_lm_head.weight, new_lm_head.bias]
  3157 |             with deepspeed.zero.GatheredParameters(params, modifier_rank=0):
  3158 |                 self._copy_lm_head_original_to_resized(
  3159 |                     new_lm_head, old_lm_head, num_tokens_to_copy, transposed, has_new_lm_head_bias
  3160 |                 )
  3161 |         else:
  3162 |             self._copy_lm_head_original_to_resized(
  3163 |                 new_lm_head, old_lm_head, num_tokens_to_copy, transposed, has_new_lm_head_bias
  3164 |             )
  3165 | 
  3166 |         setattr(new_lm_head, "_is_hf_initialized", True)
  3167 |         return new_lm_head
  3168 | 
  3169 |     def _init_added_embeddings_weights_with_mean(
  3170 |         self, old_embeddings, new_embeddings, old_num_tokens, added_num_tokens
  3171 |     ):
  3172 |         old_embeddings_weight = old_embeddings.weight.data.to(torch.float32)
  3173 |         mean_embeddings = torch.mean(old_embeddings_weight, axis=0)
  3174 |         old_centered_embeddings = old_embeddings_weight - mean_embeddings
  3175 |         covariance = old_centered_embeddings.T @ old_centered_embeddings / old_num_tokens
  3176 | 
  3177 |         # Check if the covariance is positive definite.
  3178 |         epsilon = 1e-9
  3179 |         is_covariance_psd = constraints.positive_definite.check(epsilon * covariance).all()
  3180 |         if is_covariance_psd:
  3181 |             # If covariances is positive definite, a distribution can be created. and we can sample new weights from it.
  3182 |             distribution = torch.distributions.multivariate_normal.MultivariateNormal(
  3183 |                 mean_embeddings, covariance_matrix=epsilon * covariance
  3184 |             )
  3185 |             new_embeddings.weight.data[-1 * added_num_tokens :, :] = distribution.sample(
  3186 |                 sample_shape=(added_num_tokens,)
  3187 |             ).to(old_embeddings.weight.dtype)
  3188 |         else:
  3189 |             # Otherwise, just initialize with the mean. because distribution will not be created.
  3190 |             new_embeddings.weight.data[-1 * added_num_tokens :, :] = (
  3191 |                 mean_embeddings[None, :].repeat(added_num_tokens, 1).to(old_embeddings.weight.dtype)
  3192 |             )
  3193 | 
  3194 |     def _init_added_lm_head_weights_with_mean(
  3195 |         self,
  3196 |         old_lm_head,
  3197 |         new_lm_head,
  3198 |         old_lm_head_dim,
  3199 |         old_num_tokens,
  3200 |         added_num_tokens,
  3201 |         transposed: bool = False,
  3202 |     ):
  3203 |         if transposed:
  3204 |             # Transpose to the desired shape for the function.
  3205 |             new_lm_head.weight.data = new_lm_head.weight.data.T
  3206 |             old_lm_head.weight.data = old_lm_head.weight.data.T
  3207 | 
  3208 |         # The same initialization logic as Embeddings.
  3209 |         self._init_added_embeddings_weights_with_mean(old_lm_head, new_lm_head, old_num_tokens, added_num_tokens)
  3210 | 
  3211 |         if transposed:
  3212 |             # Transpose again to the correct shape.
  3213 |             new_lm_head.weight.data = new_lm_head.weight.data.T
  3214 |             old_lm_head.weight.data = old_lm_head.weight.data.T
  3215 | 
  3216 |     def _init_added_lm_head_bias_with_mean(self, old_lm_head, new_lm_head, added_num_tokens):
  3217 |         bias_mean = torch.mean(old_lm_head.bias.data, axis=0, dtype=torch.float32)
  3218 |         bias_std = torch.std(old_lm_head.bias.data, axis=0).to(torch.float32)
  3219 |         new_lm_head.bias.data[-1 * added_num_tokens :].normal_(mean=bias_mean, std=1e-9 * bias_std)
  3220 | 
  3221 |     def _copy_lm_head_original_to_resized(
  3222 |         self, new_lm_head, old_lm_head, num_tokens_to_copy, transposed, has_new_lm_head_bias
  3223 |     ):
  3224 |         # Copy old lm head weights to new lm head
  3225 |         if not transposed:
  3226 |             new_lm_head.weight.data[:num_tokens_to_copy, :] = old_lm_head.weight.data[:num_tokens_to_copy, :]
  3227 |         else:
  3228 |             new_lm_head.weight.data[:, :num_tokens_to_copy] = old_lm_head.weight.data[:, :num_tokens_to_copy]
  3229 | 
  3230 |         # Copy bias weights to new lm head
  3231 |         if has_new_lm_head_bias:
  3232 |             new_lm_head.bias.data[:num_tokens_to_copy] = old_lm_head.bias.data[:num_tokens_to_copy]
  3233 | 
