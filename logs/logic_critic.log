   188 |             # This is the complete result when using `text_config_dict`.
   189 |             _text_config_dict = MetaClip2TextConfig(**text_config_dict).to_dict()
   190 | 
   191 |             # Give a warning if the values exist in both `_text_config_dict` and `text_config` but being different.
   192 |             for key, value in _text_config_dict.items():
   193 |                 if key in text_config and value != text_config[key] and key != "transformers_version":
   194 |                     # If specified in `text_config_dict`
   195 |                     if key in text_config_dict:
   196 |                         message = (
   197 |                             f"`{key}` is found in both `text_config_dict` and `text_config` but with different values. "
   198 |                             f'The value `text_config_dict["{key}"]` will be used instead.'
   199 |                         )
   200 |                     # If inferred from default argument values (just to be super careful)
   201 |                     else:
   202 |                         message = (
   203 |                             f"`text_config_dict` is provided which will be used to initialize `CLIPTextConfig`. The "
   204 |                             f'value `text_config["{key}"]` will be overridden.'
   205 |                         )
   206 |                     logger.info(message)
   207 | 
   208 |             # Update all values in `text_config` with the ones in `_text_config_dict`.
   209 |             text_config.update(_text_config_dict)
   210 | 
   211 |         if vision_config_dict is not None:
   212 |             # This is the complete result when using `vision_config_dict`.
   213 |             _vision_config_dict = MetaClip2VisionConfig(**vision_config_dict).to_dict()
   214 |             # convert keys to string instead of integer
   215 |             if "id2label" in _vision_config_dict:
   216 |                 _vision_config_dict["id2label"] = {
   217 |                     str(key): value for key, value in _vision_config_dict["id2label"].items()
   218 |                 }
   219 | 
   220 |             # Give a warning if the values exist in both `_vision_config_dict` and `vision_config` but being different.
   221 |             for key, value in _vision_config_dict.items():
