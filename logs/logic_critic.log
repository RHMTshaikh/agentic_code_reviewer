  3651 |     def get_memory_footprint(self, return_buffers=True):
  3652 |         r"""
  3653 |         Get the memory footprint of a model. This will return the memory footprint of the current model in bytes.
  3654 |         Useful to benchmark the memory footprint of the current model and design some tests. Solution inspired from the
  3655 |         PyTorch discussions: https://discuss.pytorch.org/t/gpu-memory-that-model-uses/56822/2
  3656 | 
  3657 |         Arguments:
  3658 |             return_buffers (`bool`, *optional*, defaults to `True`):
  3659 |                 Whether to return the size of the buffer tensors in the computation of the memory footprint. Buffers
  3660 |                 are tensors that do not require gradients and not registered as parameters. E.g. mean and std in batch
  3661 |                 norm layers. Please see: https://discuss.pytorch.org/t/what-pytorch-means-by-buffers/120266/2
  3662 |         """
  3663 |         mem = sum(param.nelement() * param.element_size() for param in self.parameters())
  3664 |         if return_buffers:
  3665 |             mem_bufs = sum(buf.nelement() * buf.element_size() for buf in self.buffers())
  3666 |             mem = mem + mem_bufs
  3667 |         return mem
  3668 | 
  3669 |     @wraps(torch.nn.Module.cuda)
  3670 |     def cuda(self, *args, **kwargs):
  3671 |         if getattr(self, "quantization_method", None) == QuantizationMethod.HQQ:
  3672 |             from hqq.core.quantize import HQQLinear
  3673 | 
  3674 |             # Since HQQLinear stores some tensors in the 'meta' attribute,
  3675 |             # it's necessary to manually call the `cuda` method on HQQLinear layers.
  3676 |             super().cuda(*args, **kwargs)
  3677 |             for module in self.modules():
  3678 |                 if isinstance(module, HQQLinear):
  3679 |                     if len(args) > 0:
  3680 |                         device = args[0]
  3681 |                     else:
  3682 |                         device = kwargs.get("device", "cuda")
  3683 |                     module.cuda(device)
  3684 |             return self
  3685 | 
  3686 |         # Checks if the model has been loaded in 4-bit or 8-bit with BNB
  3687 |         if getattr(self, "quantization_method", None) == QuantizationMethod.BITS_AND_BYTES:
  3688 |             if getattr(self, "is_loaded_in_8bit", False):
  3689 |                 raise ValueError(
  3690 |                     "Calling `cuda()` is not supported for `8-bit` quantized models. "
  3691 |                     " Please use the model as it is, since the model has already been set to the correct devices."
  3692 |                 )
  3693 |         return super().cuda(*args, **kwargs)
  3694 | 
  3695 |     @wraps(torch.nn.Module.to)
  3696 |     def to(self, *args, **kwargs):
  3697 |         # For BNB/GPTQ models, we prevent users from casting the model to another dtype to restrict unwanted behaviours.
  3698 |         # the correct API should be to load the model with the desired dtype directly through `from_pretrained`.
  3699 |         dtype_present_in_args = "dtype" in kwargs
  3700 | 
  3701 |         if not dtype_present_in_args:
  3702 |             for arg in args:
  3703 |                 if isinstance(arg, torch.dtype):
  3704 |                     dtype_present_in_args = True
  3705 |                     break
  3706 | 
  3707 |         if getattr(self, "quantization_method", None) == QuantizationMethod.HQQ:
  3708 |             from hqq.core.quantize import HQQLinear
  3709 | 
  3710 |             # Since HQQLinear stores some tensors in the 'meta' attribute, we must
  3711 |             # explicitly move the parameters to the target device for each HQQLinear layer after `to`.
  3712 |             super().to(*args, **kwargs)
  3713 |             for module in self.modules():
  3714 |                 if isinstance(module, HQQLinear):
  3715 |                     if "device" in kwargs:
  3716 |                         device = kwargs["device"]
  3717 |                     else:
  3718 |                         device = args[0]
  3719 |                     if "dtype" in kwargs:
  3720 |                         dtype = kwargs["dtype"]
  3721 |                     elif dtype_present_in_args:
  3722 |                         dtype = arg
  3723 |                     else:
  3724 |                         dtype = None
  3725 |                     # Due to the current messy implementation of HQQLinear, updating `compute_dtype`
  3726 |                     # followed by calling the `cuda` method achieves the intended behavior of `to`,
  3727 |                     # even when the target device is CPU.
  3728 |                     if dtype is not None:
  3729 |                         module.compute_dtype = dtype
  3730 |                     module.cuda(device)
  3731 |             return self
  3732 | 
  3733 |         if dtype_present_in_args and getattr(self, "quantization_method", None) == QuantizationMethod.QUARK:
  3734 |             raise ValueError("Casting a Quark quantized model to a new `dtype` is not supported.")
  3735 | 
  3736 |         # Checks if the model has been loaded in 4-bit or 8-bit with BNB
  3737 |         if getattr(self, "quantization_method", None) == QuantizationMethod.BITS_AND_BYTES:
  3738 |             if dtype_present_in_args:
  3739 |                 raise ValueError(
  3740 |                     "You cannot cast a bitsandbytes model in a new `dtype`. Make sure to load the model using `from_pretrained` using the"
  3741 |                     " desired `dtype` by passing the correct `dtype` argument."
  3742 |                 )
  3743 | 
  3744 |             if getattr(self, "is_loaded_in_8bit", False) and not is_bitsandbytes_available("0.48"):
  3745 |                 raise ValueError(
  3746 |                     "You need to install `pip install bitsandbytes>=0.48.0` if you want to move a 8-bit model across devices using to()."
  3747 |                 )
  3748 |         elif getattr(self, "quantization_method", None) == QuantizationMethod.GPTQ:
  3749 |             if dtype_present_in_args:
  3750 |                 raise ValueError(
  3751 |                     "You cannot cast a GPTQ model in a new `dtype`. Make sure to load the model using `from_pretrained` using the desired"
  3752 |                     " `dtype` by passing the correct `dtype` argument."
  3753 |                 )
  3754 |         return super().to(*args, **kwargs)
  3755 | 
  3756 |     def half(self, *args):
  3757 |         # Checks if the model is quantized
  3758 |         if getattr(self, "is_quantized", False):
  3759 |             raise ValueError(
  3760 |                 "`.half()` is not supported for quantized model. Please use the model as it is, since the"
  3761 |                 " model has already been casted to the correct `dtype`."
  3762 |             )
  3763 |         else:
  3764 |             return super().half(*args)
  3765 | 
  3766 |     def float(self, *args):
  3767 |         # Checks if the model is quantized
  3768 |         if getattr(self, "is_quantized", False):
  3769 |             raise ValueError(
  3770 |                 "`.float()` is not supported for quantized model. Please use the model as it is, since the"
  3771 |                 " model has already been casted to the correct `dtype`."
  3772 |             )
  3773 |         else:
  3774 |             return super().float(*args)
  3775 | 
  3776 |     @classmethod
  3777 |     def get_init_context(
  3778 |         cls, dtype: torch.dtype, is_quantized: bool, _is_ds_init_called: bool, allow_all_kernels: bool | None
  3779 |     ):
  3780 |         # Need to instantiate with correct dtype
  3781 |         init_contexts = [local_torch_dtype(dtype, cls.__name__), init.no_tie_weights(), apply_patches()]
  3782 |         # Needed as we cannot forward the `allow_all_kernels` arg in the model's __init__
  3783 |         if allow_all_kernels:
  3784 |             init_contexts.append(allow_all_hub_kernels())
  3785 |         if is_deepspeed_zero3_enabled():
  3786 |             import deepspeed
  3787 | 
  3788 |             # We cannot initialize the model on meta device with deepspeed when not quantized
  3789 |             if not is_quantized and not _is_ds_init_called:
  3790 |                 logger.info("Detected DeepSpeed ZeRO-3: activating zero.init() for this model")
  3791 |                 init_contexts.extend(
  3792 |                     [
  3793 |                         init.no_init_weights(),
  3794 |                         deepspeed.zero.Init(config_dict_or_path=deepspeed_config()),
  3795 |                         set_zero3_state(),
  3796 |                     ]
  3797 |                 )
  3798 |             elif is_quantized:
  3799 |                 init_contexts.extend([torch.device("meta"), set_quantized_state()])
  3800 |         else:
  3801 |             # meta_device_safe_creation_ops patches torch.linspace to default to CPU
  3802 |             # so that custom models calling .item() during __init__ (e.g. drop-path
  3803 |             # schedules) don't crash on meta tensors.
  3804 |             init_contexts.extend([torch.device("meta"), init.meta_device_safe_creation_ops()])
  3805 | 
  3806 |         return init_contexts
  3807 | 
  3808 |     def _get_dtype_plan(self, dtype: torch.dtype) -> dict:
  3809 |         """Create the dtype_plan describing modules/parameters that should use the `keep_in_fp32` flag."""
  3810 |         dtype_plan = {}
  3811 | 
  3812 |         # The _keep_in_fp32_modules flag is only used to avoid bf16 -> fp16 casting precision issues. It was introduced
  3813 |         # in case of force loading a model that should stay in bf16 in fp16
  3814 |         # See https://github.com/huggingface/transformers/issues/20287 for details.
  3815 |         if self._keep_in_fp32_modules is not None and dtype == torch.float16:
  3816 |             dtype_plan.update(dict.fromkeys(self._keep_in_fp32_modules, torch.float32))
  3817 | 
  3818 |         # The _keep_in_fp32_modules_strict was introduced to always force upcast to fp32, for both fp16 and bf16
  3819 |         if self._keep_in_fp32_modules_strict is not None and dtype in (torch.float16, torch.bfloat16):
  3820 |             dtype_plan.update(dict.fromkeys(self._keep_in_fp32_modules_strict, torch.float32))
  3821 | 
  3822 |         return dtype_plan
  3823 | 
  3824 |     def set_use_kernels(self, use_kernels, kernel_config: KernelConfig | None = None, mode: "Mode | None" = None):
  3825 |         """
  3826 |         Set whether or not to use the `kernels` library to kernelize some layers of the model.
  3827 |         Args:
  3828 |             use_kernels (`bool`):
  3829 |                 Whether or not to use the `kernels` library to kernelize some layers of the model.
  3830 |             kernel_config (`KernelConfig`, *optional*):
  3831 |                 The kernel configuration to use to kernelize the model. If `None`, the default kernel mapping will be used.
  3832 |             mode (`Mode`, *optional*):
  3833 |                 The mode that should be applied during `kernelize`. Optional, defaults to either training or inference mode
  3834 |                 based on the internal `training` flag.
  3835 |         """
  3836 |         if use_kernels:
  3837 |             if not is_kernels_available():
  3838 |                 raise ValueError(
  3839 |                     "Kernels are not available. "
  3840 |                     f"Please install a compatible version ({KERNELS_MIN_VERSION} <= version < {KERNELS_MAX_VERSION}), "
  3841 |                     f"e.g. `pip install kernels=={KERNELS_MIN_VERSION}`"
  3842 |                 )
  3843 |             from .integrations.hub_kernels import register_kernel_mapping_transformers
  3844 | 
  3845 |             register_kernel_mapping_transformers()
  3846 | 
  3847 |             if kernel_config is not None:
  3848 |                 if not isinstance(kernel_config, KernelConfig):
  3849 |                     raise ValueError(
  3850 |                         f"Expeced `kernel_config` to be of type `KernelConfig` but got {type(kernel_config)}"
  3851 |                     )
  3852 | 
  3853 |                 # Since kernel_config is a correct value, set it as an attribute of the model so it can be used.
  3854 |                 self.kernel_config = kernel_config
  3855 | 
  3856 |                 # This will make sure the mapping is valid, and the layers are registered in the model
  3857 |                 kernel_config.sanitize_kernel_mapping(self)
  3858 | 
  3859 |                 # This will create a compatible mapping for the model with the kernels library
  3860 |                 kernel_config.create_compatible_mapping(self)
  3861 | 
  3862 |             kernelize(self, mode=mode)
  3863 |         else:
  3864 |             self._use_kernels = False
  3865 | 
  3866 |     @classmethod
  3867 |     def from_pretrained(
  3868 |         cls: type[SpecificPreTrainedModelType],
  3869 |         pretrained_model_name_or_path: str | os.PathLike | None,
  3870 |         *model_args,
  3871 |         config: PreTrainedConfig | str | os.PathLike | None = None,
  3872 |         cache_dir: str | os.PathLike | None = None,
  3873 |         ignore_mismatched_sizes: bool = False,
  3874 |         force_download: bool = False,
  3875 |         local_files_only: bool = False,
  3876 |         token: str | bool | None = None,
  3877 |         revision: str = "main",
  3878 |         use_safetensors: bool | None = None,
  3879 |         weights_only: bool = True,
  3880 |         fusion_config: dict[str, bool | dict[str, Any]] | None = None,
  3881 |         disable_mmap: bool | None = None,
  3882 |         **kwargs,
  3883 |     ) -> SpecificPreTrainedModelType:
  3884 |         r"""
  3885 |         Instantiate a pretrained pytorch model from a pre-trained model configuration.
  3886 | 
  3887 |         The model is set in evaluation mode by default using `model.eval()` (Dropout modules are deactivated). To train
  3888 |         the model, you should first set it back in training mode with `model.train()`.
  3889 | 
  3890 |         The warning *Weights from XXX not initialized from pretrained model* means that the weights of XXX do not come
  3891 |         pretrained with the rest of the model. It is up to you to train those weights with a downstream fine-tuning
  3892 |         task.
  3893 | 
  3894 |         The warning *Weights from XXX not used in YYY* means that the layer XXX is not used by YYY, therefore those
  3895 |         weights are discarded.
  3896 | 
  3897 |         Parameters:
  3898 |             pretrained_model_name_or_path (`str` or `os.PathLike`, *optional*):
  3899 |                 Can be either:
  3900 | 
  3901 |                     - A string, the *model id* of a pretrained model hosted inside a model repo on huggingface.co.
  3902 |                     - A path to a *directory* containing model weights saved using
  3903 |                       [`~PreTrainedModel.save_pretrained`], e.g., `./my_model_directory/`.
  3904 |                     - `None` if you are both providing the configuration and state dictionary (resp. with keyword
  3905 |                       arguments `config` and `state_dict`).
  3906 |             model_args (sequence of positional arguments, *optional*):
  3907 |                 All remaining positional arguments will be passed to the underlying model's `__init__` method.
  3908 |             config (`Union[PreTrainedConfig, str, os.PathLike]`, *optional*):
  3909 |                 Can be either:
  3910 | 
  3911 |                     - an instance of a class derived from [`PreTrainedConfig`],
  3912 |                     - a string or path valid as input to [`~PreTrainedConfig.from_pretrained`].
  3913 | 
  3914 |                 Configuration for the model to use instead of an automatically loaded configuration. Configuration can
  3915 |                 be automatically loaded when:
  3916 | 
  3917 |                     - The model is a model provided by the library (loaded with the *model id* string of a pretrained
  3918 |                       model).
  3919 |                     - The model was saved using [`~PreTrainedModel.save_pretrained`] and is reloaded by supplying the
  3920 |                       save directory.
  3921 |                     - The model is loaded by supplying a local directory as `pretrained_model_name_or_path` and a
  3922 |                       configuration JSON file named *config.json* is found in the directory.
  3923 |             state_dict (`dict[str, torch.Tensor]`, *optional*):
  3924 |                 A state dictionary to use instead of a state dictionary loaded from saved weights file.
  3925 | 
  3926 |                 This option can be used if you want to create a model from a pretrained configuration but load your own
  3927 |                 weights. In this case though, you should check if using [`~PreTrainedModel.save_pretrained`] and
  3928 |                 [`~PreTrainedModel.from_pretrained`] is not a simpler option.
  3929 |             cache_dir (`Union[str, os.PathLike]`, *optional*):
  3930 |                 Path to a directory in which a downloaded pretrained model configuration should be cached if the
  3931 |                 standard cache should not be used.
  3932 |             ignore_mismatched_sizes (`bool`, *optional*, defaults to `False`):
  3933 |                 Whether or not to raise an error if some of the weights from the checkpoint do not have the same size
  3934 |                 as the weights of the model (if for instance, you are instantiating a model with 10 labels from a
  3935 |                 checkpoint with 3 labels).
  3936 |             force_download (`bool`, *optional*, defaults to `False`):
  3937 |                 Whether or not to force the (re-)download of the model weights and configuration files, overriding the
  3938 |                 cached versions if they exist.
  3939 |             proxies (`dict[str, str]`, *optional*):
  3940 |                 A dictionary of proxy servers to use by protocol or endpoint, e.g., `{'http': 'foo.bar:3128',
  3941 |                 'http://hostname': 'foo.bar:4012'}`. The proxies are used on each request.
  3942 |             output_loading_info(`bool`, *optional*, defaults to `False`):
  3943 |                 Whether or not to also return a dictionary containing missing keys, unexpected keys and error messages.
  3944 |             local_files_only(`bool`, *optional*, defaults to `False`):
  3945 |                 Whether or not to only look at local files (i.e., do not try to download the model).
  3946 |             token (`str` or `bool`, *optional*):
  3947 |                 The token to use as HTTP bearer authorization for remote files. If `True`, or not specified, will use
  3948 |                 the token generated when running `hf auth login` (stored in `~/.huggingface`).
  3949 |             revision (`str`, *optional*, defaults to `"main"`):
  3950 |                 The specific model version to use. It can be a branch name, a tag name, or a commit id, since we use a
  3951 |                 git-based system for storing models and other artifacts on huggingface.co, so `revision` can be any
  3952 |                 identifier allowed by git.
  3953 | 
  3954 |                 <Tip>
  3955 | 
  3956 |                 To test a pull request you made on the Hub, you can pass `revision="refs/pr/<pr_number>"`.
  3957 | 
  3958 |                 </Tip>
  3959 |             attn_implementation (`str`, *optional*):
  3960 |                 The attention implementation to use in the model (if relevant). Can be any of
  3961 |                     - `"eager"` (manual implementation of the attention)
  3962 |                     - `"sdpa"` (using [`F.scaled_dot_product_attention`](https://pytorch.org/docs/master/generated/torch.nn.functional.scaled_dot_product_attention.html))
  3963 |                     - `"flash_attention_2"` (using [Dao-AILab/flash-attention](https://github.com/Dao-AILab/flash-attention))
  3964 |                     - `"flash_attention_3"` (using [Dao-AILab/flash-attention/hopper](https://github.com/Dao-AILab/flash-attention/tree/main/hopper))
  3965 |                     - `"flash_attention_4"` (using [Dao-AILab/flash-attention/flash_attn/cute](https://github.com/Dao-AILab/flash-attention/tree/main/flash_attn/cute)).
  3966 |                 By default, if available, SDPA will be used. The default is otherwise the manual `"eager"` implementation.
  3967 | 
  3968 |                 Accept HF kernel references in the form:
  3969 |                   <namespace>/<repo_name>[@<revision>][:<kernel_name>]
  3970 | 
  3971 |                 - <namespace> and <repo_name> are any non-"/" and non-":" sequences.
  3972 |                 - "@<revision>" is optional (branch, tag, or commit-ish), e.g. "@main", "@v1.2.0", "@abc123".
  3973 |                 - ":<kernel_name>" is optional and selects a function inside the kernel repo.
  3974 |                 - Both options can appear together and in this order only: @revision first, then :kernel_name.
  3975 |                 - We intentionally allow a leading "<wrapper>|" prefix (e.g., "flash|...") because the code
  3976 |                   strips it before loading; '|' is not excluded in the character classes here.
  3977 | 
  3978 |                 Examples that match:
  3979 |                   "org/model"
  3980 |                   "org/model@main"
  3981 |                   "org/model:custom_kernel"
  3982 |                   "org/model@v1.2.3:custom_kernel"
  3983 |             experts_implementation (`str`, *optional*):
  3984 |                 The experts implementation to use in the model (if relevant). Can be any of:
  3985 | 
  3986 |                 - `"eager"` (sequential implementation of the experts matrix multiplications).
  3987 |                 - `"batched_mm"` (using [`torch.bmm`](https://pytorch.org/docs/stable/generated/torch.bmm.html)).
  3988 |                 - `"grouped_mm"` (using [`torch.nn.functional.grouped_mm`](https://docs.pytorch.org/docs/main/generated/torch.nn.functional.grouped_mm.html)).
  3989 | 
  3990 |                 By default, if the model supports it, `"grouped_mm"` will be used. The default is otherwise the manual `"eager"` implementation.
  3991 | 
  3992 |             > Parameters for big model inference
  3993 | 
  3994 |             dtype (`str` or `torch.dtype`, *optional*, defaults to `"auto"`):
  3995 |                 Override the default `torch_dtype` and load the model under a specific `dtype`. The different options
  3996 |                 are:
  3997 | 
  3998 |                 1. `torch.float16` or `torch.bfloat16` or `torch.float`: load in a specified
  3999 |                   `dtype`, ignoring the model's `config.dtype` if one exists. If not specified
  4000 |                   - the model will get loaded in `torch.float` (fp32).
  4001 | 
  4002 |                 2. `"auto"` - A `dtype` or `torch_dtype` entry in the `config.json` file of the model will be
  4003 |                   attempted to be used. If this entry isn't found then next check the `dtype` of the first weight in
  4004 |                   the checkpoint that's of a floating point type and use that as `dtype`. This will load the model
  4005 |                   using the `dtype` it was saved in at the end of the training. It can't be used as an indicator of how
  4006 |                   the model was trained. Since it could be trained in one of half precision dtypes, but saved in fp32.
  4007 | 
  4008 |                 3. A string that is a valid `torch.dtype`. E.g. "float32" loads the model in `torch.float32`, "float16" loads in `torch.float16` etc.
  4009 | 
  4010 |                 <Tip>
  4011 | 
  4012 |                 For some models the `dtype` they were trained in is unknown - you may try to check the model's paper or
  4013 |                 reach out to the authors and ask them to add this information to the model's card and to insert the
  4014 |                 `dtype` or `torch_dtype` entry in `config.json` on the hub.
  4015 | 
  4016 |                 </Tip>
  4017 | 
  4018 |             device_map (`str` or `dict[str, Union[int, str, torch.device]]` or `int` or `torch.device`, *optional*):
  4019 |                 A map that specifies where each submodule should go. It doesn't need to be refined to each
  4020 |                 parameter/buffer name, once a given module name is inside, every submodule of it will be sent to the
  4021 |                 same device. If we only pass the device (*e.g.*, `"cpu"`, `"cuda:1"`, `"mps"`, or a GPU ordinal rank
  4022 |                 like `1`) on which the model will be allocated, the device map will map the entire model to this
  4023 |                 device. Passing `device_map = 0` means put the whole model on GPU 0.
  4024 | 
  4025 |                 To have Accelerate compute the most optimized `device_map` automatically, set `device_map="auto"`. For
  4026 |                 more information about each option see [designing a device
  4027 |                 map](https://hf.co/docs/accelerate/main/en/usage_guides/big_modeling#designing-a-device-map).
  4028 |             max_memory (`Dict`, *optional*):
  4029 |                 A dictionary device identifier to maximum memory if using `device_map`. Will default to the maximum memory available for each
  4030 |                 GPU and the available CPU RAM if unset.
  4031 |             tp_plan (`Optional[Union[dict, str]]`, *optional*):
  4032 |                 A torch tensor parallel plan, see [here](https://pytorch.org/tutorials/intermediate/TP_tutorial.html). Use `tp_plan="auto"` to
  4033 |                 use the predefined plan based on the model. If it's a dict, then it should match between module names and desired layout.
  4034 |                 Note that if you use it, you should launch your script accordingly with `torchrun [args] script.py`. This will be much
  4035 |                 faster than using a `device_map`, but has limitations.
  4036 |             tp_size (`str`, *optional*):
  4037 |                 A torch tensor parallel degree. If not provided would default to world size.
  4038 |             device_mesh (`torch.distributed.DeviceMesh`, *optional*):
  4039 |                 A torch device mesh. If not provided would default to world size. Used only for tensor parallel for now.
  4040 |                 If provided, it has to contain dimension named `"tp"` in case it's > 1 dimensional, this dimension will be used for tensor parallelism
  4041 |             offload_folder (`str` or `os.PathLike`, *optional*):
  4042 |                 If the `device_map` contains any value `"disk"`, the folder where we will offload weights.
  4043 |             offload_buffers (`bool`, *optional*):
  4044 |                 Whether or not to offload the buffers with the model parameters.
  4045 |             quantization_config (`Union[QuantizationConfigMixin,Dict]`, *optional*):
  4046 |                 A dictionary of configuration parameters or a QuantizationConfigMixin object for quantization (e.g
  4047 |                 bitsandbytes, gptq).
  4048 |             subfolder (`str`, *optional*, defaults to `""`):
  4049 |                 In case the relevant files are located inside a subfolder of the model repo on huggingface.co, you can
  4050 |                 specify the folder name here.
  4051 |             variant (`str`, *optional*):
  4052 |                 If specified load weights from `variant` filename, *e.g.* pytorch_model.<variant>.bin.
  4053 |             use_safetensors (`bool`, *optional*, defaults to `None`):
  4054 |                 Whether or not to use `safetensors` checkpoints. Defaults to `None`. If not specified and `safetensors`
  4055 |                 is not installed, it will be set to `False`.
  4056 |             weights_only (`bool`, *optional*, defaults to `True`):
  4057 |                 Indicates whether unpickler should be restricted to loading only tensors, primitive types,
  4058 |                 dictionaries and any types added via torch.serialization.add_safe_globals().
  4059 |                 When set to False, we can load wrapper tensor subclass weights.
  4060 |             disable_mmap (`bool`, *optional*):
  4061 |                 Whether to disable memory mapping when loading safetensors checkpoints. When `None` (default),
  4062 |                 it is auto-detected to `True` when the checkpoint lives on an `hf-mount` FUSE filesystem
  4063 |                 (used by HF Spaces/Endpoints), where mmap + parallel page-faults can deadlock. When `True`,
  4064 |                 files are read fully into memory and parsed with `safetensors.torch.load`. When `False`, the
  4065 |                 default memory-mapped loader is always used.
  4066 |             fusion_config (`dict[str, bool | dict[str, Any]]`, *optional*):
  4067 |                 Optional fusion configuration applied before model instantiation. Each key enables a fusion family and
  4068 |                 its value can either be `True` to enable that fusion with default options or a dictionary of
  4069 |                 family-specific options. For example, `{"patch_embeddings": True}` enables patch embedding fusion.
  4070 |                 This should only be used as an inference optimization, as it can slightly change outputs. If omitted,
  4071 |                 `from_pretrained()` falls back to `config.fusion_config` when available. Refer to the fusion mapping
  4072 |                 guide in `docs/source/en/fusion_mapping.md` for more details.
  4073 |             key_mapping (`dict[str, str], *optional*):
  4074 |                 A potential mapping of the weight names if using a model on the Hub which is compatible to a Transformers
  4075 |                 architecture, but was not converted accordingly.
  4076 |             kwargs (remaining dictionary of keyword arguments, *optional*):
  4077 |                 Can be used to update the configuration object (after it being loaded) and initiate the model (e.g.,
  4078 |                 `output_attentions=True`). Behaves differently depending on whether a `config` is provided or
  4079 |                 automatically loaded:
  4080 | 
  4081 |                     - If a configuration is provided with `config`, `**kwargs` will be directly passed to the
  4082 |                       underlying model's `__init__` method (we assume all relevant updates to the configuration have
  4083 |                       already been done)
  4084 |                     - If a configuration is not provided, `kwargs` will be first passed to the configuration class
  4085 |                       initialization function ([`~PreTrainedConfig.from_pretrained`]). Each key of `kwargs` that
  4086 |                       corresponds to a configuration attribute will be used to override said attribute with the
  4087 |                       supplied `kwargs` value. Remaining keys that do not correspond to any configuration attribute
  4088 |                       will be passed to the underlying model's `__init__` function.
  4089 | 
  4090 |         <Tip>
  4091 | 
  4092 |         Activate the special ["offline-mode"](https://huggingface.co/transformers/installation.html#offline-mode) to
  4093 |         use this method in a firewalled environment.
  4094 | 
  4095 |         </Tip>
  4096 | 
  4097 |         Examples:
  4098 | 
  4099 |         ```python
  4100 |         >>> from transformers import BertConfig, BertModel
  4101 | 
  4102 |         >>> # Download model and configuration from huggingface.co and cache.
  4103 |         >>> model = BertModel.from_pretrained("google-bert/bert-base-uncased")
  4104 |         >>> # Model was saved using *save_pretrained('./test/saved_model/')* (for example purposes, not runnable).
  4105 |         >>> model = BertModel.from_pretrained("./test/saved_model/")
  4106 |         >>> # Update configuration during loading.
  4107 |         >>> model = BertModel.from_pretrained("google-bert/bert-base-uncased", output_attentions=True)
  4108 |         >>> assert model.config.output_attentions == True
  4109 |         ```
  4110 |         """
  4111 |         state_dict = kwargs.pop("state_dict", None)
  4112 |         proxies = kwargs.pop("proxies", None)
  4113 |         tqdm_class = kwargs.pop("tqdm_class", None)
  4114 |         output_loading_info = kwargs.pop("output_loading_info", False)
  4115 |         from_pipeline = kwargs.pop("_from_pipeline", None)
  4116 |         from_auto_class = kwargs.pop("_from_auto", False)
  4117 |         dtype = kwargs.pop("dtype", None)
