  1294 |                     if new_key in config_to_return.attribute_map:
  1295 |                         new_key = config_to_return.attribute_map[new_key]
  1296 | 
  1297 |                     value = getattr(config_to_return, key)
  1298 |                     delattr(config_to_return, key)
  1299 |                     setattr(config_to_return, new_key, value)
