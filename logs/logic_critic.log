  1453 |                 self._keys_to_ignore_on_load_unexpected.update(ignore_unexpected)
  1454 |             if ignore_missing := getattr(module, "_keys_to_ignore_on_load_missing", None):
  1455 |                 self._keys_to_ignore_on_load_missing.update(ignore_missing)
  1456 |             # This one is matched exactly, not by regex, so we need to add the prefix
  1457 |             if ignore_save := getattr(module, "_keys_to_ignore_on_save", None):
  1458 |                 self._keys_to_ignore_on_save.update({f"{name}.{k}" for k in ignore_save})
  1459 | 
  1460 |         # Maybe initialize the weights and tie the keys
  1461 |         self.init_weights()
  1462 |         self._backward_compatibility_gradient_checkpointing()
  1463 | 
  1464 |     @property
  1465 |     def tp_plan(self) -> dict[str, str]:
  1466 |         """
  1467 |         The full tp plan for the model's modules
  1468 |         """
  1469 |         if hasattr(self.config, "distributed_config") and self.config.distributed_config.enable_expert_parallel:
  1470 |             return self._ep_plan
  1471 |         return self._tp_plan
  1472 | 
  1473 |     @property
  1474 |     def fsdp_plan(self) -> dict[str, str]:
  1475 |         return self._fsdp_plan
  1476 | 
  1477 |     @property
  1478 |     def pp_plan(self) -> dict[str, tuple[str, str]]:
  1479 |         return self._pp_plan
  1480 | 
  1481 |     @tp_plan.setter
  1482 |     def tp_plan(self, plan: dict[str, str] | None):
  1483 |         if plan is None:
  1484 |             self._tp_plan = {}
  1485 |             return
  1486 |         if not isinstance(plan, dict):
  1487 |             raise ValueError("Can only set a dictionary as `tp_plan`")
  1488 | 
  1489 |         # Ensure the styles are all valid
  1490 |         for layer_pattern, parallel_style in plan.items():
  1491 |             if parallel_style not in ALL_PARALLEL_STYLES:
  1492 |                 raise ValueError(
  1493 |                     f"Unsupported tensor parallel style '{parallel_style}' for layer '{layer_pattern}'. "
  1494 |                     f"Supported styles are {list(ALL_PARALLEL_STYLES.keys())}"
  1495 |                 )
  1496 | 
  1497 |         # Validate that the layer patterns match existing model structure. We check this by getting all parameter
  1498 |         # names and seeing if any match the patterns
  1499 |         model_param_names = [name for name, _ in self.named_parameters()]
  1500 |         for layer_pattern in plan.keys():
  1501 |             # Convert pattern to regex (replace * with .*)
  1502 |             regex_pattern = layer_pattern.replace("*", r"\d+")
  1503 |             pattern_matched = False
  1504 |             for param_name in model_param_names:
  1505 |                 if re.match(regex_pattern, param_name):
  1506 |                     pattern_matched = True
  1507 |                     break
  1508 |             if not pattern_matched:
  1509 |                 warnings.warn(
  1510 |                     f"Layer pattern '{layer_pattern}' does not match any parameters in the model. This rule may not "
  1511 |                     "be applied during tensor parallelization, or may lead to dimension mismatches"
  1512 |                 )
  1513 | 
  1514 |         # Set the plan
  1515 |         self._tp_plan = plan
  1516 | 
  1517 |     @pp_plan.setter
  1518 |     def pp_plan(self, plan: dict[str, tuple[str, str]] | None):
  1519 |         if plan is None:
  1520 |             self._pp_plan = {}
  1521 |             return
  1522 |         if not isinstance(plan, dict):
  1523 |             raise ValueError("Can only set a dictionary as `pp_plan`")
  1524 | 
  1525 |         self._pp_plan = plan
  1526 | 
  1527 |     def dequantize(self, dtype=None):
  1528 |         """
  1529 |         Potentially dequantize the model in case it has been quantized by a quantization method that support
  1530 |         dequantization.
  1531 |         """
  1532 |         hf_quantizer = getattr(self, "hf_quantizer", None)
  1533 | 
  1534 |         if hf_quantizer is None:
  1535 |             raise ValueError("You need to first quantize your model in order to dequantize it")
  1536 | 
  1537 |         return hf_quantizer.dequantize(self, dtype=dtype)
  1538 | 
  1539 |     def _backward_compatibility_gradient_checkpointing(self):
  1540 |         if self.supports_gradient_checkpointing and getattr(self.config, "gradient_checkpointing", False):
  1541 |             self.gradient_checkpointing_enable()
  1542 |             # Remove the attribute now that is has been consumed, so it's no saved in the config.
  1543 |             delattr(self.config, "gradient_checkpointing")
  1544 | 
  1545 |     def add_model_tags(self, tags: list[str] | str) -> None:
  1546 |         r"""
  1547 |         Add custom tags into the model that gets pushed to the Hugging Face Hub. Will
  1548 |         not overwrite existing tags in the model.
  1549 | 
  1550 |         Args:
  1551 |             tags (`Union[list[str], str]`):
  1552 |                 The desired tags to inject in the model
  1553 | 
  1554 |         Examples:
  1555 | 
  1556 |         ```python
  1557 |         from transformers import AutoModel
  1558 | 
  1559 |         model = AutoModel.from_pretrained("google-bert/bert-base-cased")
  1560 | 
  1561 |         model.add_model_tags(["custom", "custom-bert"])
  1562 | 
  1563 |         # Push the model to your namespace with the name "my-custom-bert".
  1564 |         model.push_to_hub("my-custom-bert")
  1565 |         ```
  1566 |         """
  1567 |         if isinstance(tags, str):
  1568 |             tags = [tags]
  1569 | 
  1570 |         if self.model_tags is None:
  1571 |             self.model_tags = []
  1572 | 
  1573 |         for tag in tags:
  1574 |             if tag not in self.model_tags:
  1575 |                 self.model_tags.append(tag)
  1576 | 
  1577 |     @classmethod
  1578 |     def _from_config(cls, config, **kwargs):
  1579 |         """
  1580 |         All context managers that the model should be initialized under go here.
  1581 | 
  1582 |         Args:
  1583 |             dtype (`torch.dtype`, *optional*):
  1584 |                 Override the default `dtype` and load the model under this dtype.
  1585 |         """
  1586 |         # For BC on the old `torch_dtype`
  1587 |         dtype = kwargs.pop("dtype", config.dtype)
  1588 |         if (torch_dtype := kwargs.pop("torch_dtype", None)) is not None:
  1589 |             logger.warning_once("`torch_dtype` is deprecated! Use `dtype` instead!")
  1590 |             # if both kwargs are provided, use `dtype`
  1591 |             dtype = dtype if dtype != config.dtype else torch_dtype
  1592 |         if isinstance(dtype, str):
  1593 |             dtype = getattr(torch, dtype)
  1594 | 
  1595 |         # Keep the resolved `dtype` on the config so it matches the actual weights, the same way
  1596 |         # `from_pretrained` does. Also set it on all subconfigs to avoid dtype mismatch. When "auto"
  1597 |         # dtype with nested models, we can't dispatch different dtype per backbone module
  1598 |         config.dtype = dtype
  1599 |         for sub_config_key in config.sub_configs:
  1600 |             if (sub_config := getattr(config, sub_config_key)) is not None:
  1601 |                 sub_config.dtype = dtype
  1602 | 
  1603 |         # If passing `attn_implementation` as kwargs, respect it (it will be applied recursively on subconfigs)
  1604 |         if "attn_implementation" in kwargs:
  1605 |             config._attn_implementation = kwargs.pop("attn_implementation")
  1606 | 
  1607 |         # If passing `experts_implementation` as kwargs, respect it (it will be applied recursively on subconfigs)
  1608 |         if "experts_implementation" in kwargs:
  1609 |             config._experts_implementation = kwargs.pop("experts_implementation")
  1610 | 
  1611 |         # Needed if the attn_implementation is an outside `kernels-community` kernel
  1612 |         allow_all_kernels = kwargs.get("allow_all_kernels", False)
  1613 | 
  1614 |         init_contexts = [apply_patches()]
  1615 |         if dtype is not None:
  1616 |             init_contexts.append(local_torch_dtype(dtype, cls.__name__))
  1617 |         if allow_all_kernels:
  1618 |             init_contexts.append(allow_all_hub_kernels())
  1619 | 
  1620 |         needs_zero3_init = is_deepspeed_zero3_enabled() and not _is_quantized and not _is_ds_init_called
  1621 |         if needs_zero3_init:
  1622 |             logger.info("Detected DeepSpeed ZeRO-3: activating zero.init() for this model")
  1623 |             # this immediately partitions the model across all gpus, to avoid the overhead in time
  1624 |             # and memory copying it on CPU or each GPU first
  1625 |             import deepspeed
  1626 | 
  1627 |             init_contexts.extend(
  1628 |                 [
  1629 |                     init.no_init_weights(),
  1630 |                     deepspeed.zero.Init(config_dict_or_path=deepspeed_config()),
  1631 |                     set_zero3_state(),
  1632 |                 ]
  1633 |             )
  1634 | 
  1635 |         # Instantiate the model
  1636 |         with ContextManagers(init_contexts):
  1637 |             model = cls(config, **kwargs)
  1638 |             patch_output_recorders(model)
  1639 | 
  1640 |         # Under ZeRO-3, parameters were partitioned into empty tensors during construction,
  1641 |         # so weight init was suppressed. Re-initialize using the ZeRO-3 variant which gathers
  1642 |         # each module's parameters before init to avoid OOM on large models.
  1643 |         if needs_zero3_init:
  1644 |             from .integrations.deepspeed import initialize_weights_zero3
  1645 | 
  1646 |             initialize_weights_zero3(model)
  1647 |             model.tie_weights()
  1648 | 
  1649 |         return model
  1650 | 
  1651 |     @property
  1652 |     def base_model(self) -> nn.Module:
  1653 |         """
  1654 |         `torch.nn.Module`: The main body of the model.
  1655 |         """
  1656 |         return getattr(self, self.base_model_prefix, self)
  1657 | 
  1658 |     @classmethod
  1659 |     def can_generate(cls) -> bool:
  1660 |         """
  1661 |         Returns whether this model can generate sequences with `.generate()`, from the `GenerationMixin`
  1662 |         or one with a similar interface.
  1663 | 
  1664 |         Under the hood, on classes where this function returns True, some generation-specific changes are triggered:
  1665 |         for instance, the model instance will have a populated `generation_config` attribute.
  1666 | 
  1667 |         Returns:
  1668 |             `bool`: Whether this model can generate sequences with `.generate()`.
  1669 |         """
  1670 |         # Directly inherits `GenerationMixin` (or a class ending in the same substring) -> can generate
  1671 |         if "GenerationMixin" in str(cls.__bases__):
  1672 |             return True
  1673 |         # The class inherits from a class that can generate (recursive check) -> can generate
  1674 |         for base in cls.__bases__:
  1675 |             if not hasattr(base, "can_generate"):
  1676 |                 continue
  1677 |             if "PreTrainedModel" not in str(base) and base.can_generate():
  1678 |                 return True
  1679 |         # Detects whether `prepare_inputs_for_generation` has been overwritten in the model. Prior to v4.45, this
  1680 |         # was how we detected whether a model could generate.
  1681 |         if hasattr(cls, "prepare_inputs_for_generation"):  # implicit: doesn't inherit `GenerationMixin`
  1682 |             logger.warning(
  1683 |                 f"{cls.__name__} has generative capabilities, as `prepare_inputs_for_generation` is explicitly "
  1684 |                 "defined. However, it doesn't directly inherit from `GenerationMixin`. From 👉v4.50👈 onwards, "
  1685 |                 "`PreTrainedModel` will NOT inherit from `GenerationMixin`, and this model will lose the ability "
  1686 |                 "to call `generate` and other related functions."
  1687 |                 "\n  - If you're using `trust_remote_code=True`, you can get rid of this warning by loading the "
  1688 |                 "model with an auto class. See https://huggingface.co/docs/transformers/en/model_doc/auto#auto-classes"
  1689 |                 "\n  - If you are the owner of the model architecture code, please modify your model class such that "
  1690 |                 "it inherits from `GenerationMixin` (after `PreTrainedModel`, otherwise you'll get an exception)."
  1691 |                 "\n  - If you are not the owner of the model architecture class, please contact the model code owner "
  1692 |                 "to update it."
  1693 |             )
  1694 |         # Otherwise, can't generate
  1695 |         return False
  1696 | 
  1697 |     def _flash_attn_import_error(
  1698 |         self,
  1699 |         flash_attn_version: int,
  1700 |         general_availability_check: Callable,
  1701 |         pkg_availability_check: Callable,
  1702 |         supported_devices: tuple[tuple[Callable, str], ...],
  1703 |         custom_supported_devices: tuple[tuple[Callable, str], ...] = (),
  1704 |         cuda_min_major_version: int | None = None,
  1705 |     ):
  1706 |         """
  1707 |         Checks whether the specified Flash Attention version is supported and if not, searches for the specific reason
  1708 |         on why it failed - package import and/or device incompatibility issues.
  1709 | 
  1710 |         Args:
  1711 |             flash_attn_version (`int`):
  1712 |                 The requested version of Flash Attention.
  1713 |             general_availability_check (`Callable`):
  1714 |                 Checks whether our `is_available` function detects the specific FA version. Failing reasons
  1715 |                 are then checked for one-by-one.
  1716 |             pkg_availability_check (`Callable`):
  1717 |                 Checks whether the package could theoretically be detected in the environment by the init structures.
  1718 |                 This is not a sure-fire check as device compatibility with FA is just as important.
  1719 |             supported_devices (`tuple[tuple[Callable, str]]`):
  1720 |                 Essentially a list (for mutable kwargs reasons a tuple) of the supported devices in the format of
  1721 |                 `(device_availability_check, device_name)`, i.e. a pair of the associated device's name and whether
  1722 |                 it is available in the environment.
  1723 |             custom_supported_devices (`tuple[tuple[Callable, str]]`, *optional*, defaults to `()`):
  1724 |                 Essentially a list (for mutable kwargs reasons a tuple) of the custom supported devices in the format of
  1725 |                 `(device_availability_check, info_message)`. These custom devices have custom logic outside the torch
  1726 |                 ecosystem either via kernels or other packages and hence have early checks for availability.
  1727 |             cuda_min_major_version (`int`, *optional*):
  1728 |                 The minimum major cuda version supported for this version of Flash Attention. This is mostly
  1729 |                 affecting more recent versions which are more specialized to the features of new hardware.
  1730 |         """
  1731 |         # Certain devices have custom workarounds e.g. with their own package distribution (NPU) or via kernels (XPU)
  1732 |         for device_availability_check, info_message in custom_supported_devices:
  1733 |             if device_availability_check():
  1734 |                 logger.info(info_message)
  1735 |                 return
  1736 | 
  1737 |         if not general_availability_check():
  1738 |             preface = f"FlashAttention{flash_attn_version} has been toggled on, but it cannot be used due to the following error:"
  1739 | 
  1740 |             # Can the package be seen in the import structure
  1741 |             if not pkg_availability_check():
  1742 |                 raise ImportError(
  1743 |                     f"{preface} the package for FlashAttention{flash_attn_version} doesn't seem to be installed."
  1744 |                 )
  1745 |             # Minimum version (FA2 only)
  1746 |             elif flash_attn_version == 2 and not is_flash_attn_greater_or_equal("2.3.3"):
  1747 |                 raise ImportError(f"{preface} FlashAttention{flash_attn_version} requires at least version `2.3.3`.")
  1748 |             else:
  1749 |                 # Supported devices availability
  1750 |                 device_availability_checks, device_names = zip(*supported_devices)
  1751 |                 if not any(device_availability_check() for device_availability_check in device_availability_checks):
  1752 |                     raise ImportError(
  1753 |                         f"{preface} FlashAttention{flash_attn_version} is not available on CPU. Please make sure you are on any of the supported devices: {device_names}."
  1754 |                     )
  1755 |                 # Cuda major versions (more recent FA versions are specialized to newer cuda devices)
  1756 |                 elif cuda_min_major_version is not None and is_torch_cuda_available():
  1757 |                     major, _ = torch.cuda.get_device_capability()
  1758 |                     if major < cuda_min_major_version:
  1759 |                         raise ImportError(
  1760 |                             f"{preface} FlashAttention{flash_attn_version} requires compute capability >= {cuda_min_major_version}, but found {torch.cuda.get_device_capability()} with compute capability {major}.x"
  1761 |                         )
  1762 | 
  1763 |     def _flash_attn_can_dispatch(self, flash_attn_version: int, is_init_check: bool = False) -> bool:
  1764 |         """
  1765 |         Check the availability of Flash Attention for a given model.
  1766 | 
  1767 |         Args:
  1768 |             flash_attn_version (`int`):
  1769 |                 The requested version of Flash Attention.
  1770 |             is_init_check (`bool`, *optional*):
  1771 |                 Whether this check is performed early, i.e. at __init__ time, or later when the model and its weights are
  1772 |                 fully instantiated. This is needed as we also check the devices of the weights, which are only available
  1773 |                 later after __init__. This allows to raise proper exceptions early before instantiating the full models
  1774 |                 if we know that the model does not support the requested attention.
  1775 |         """
  1776 |         if not self._supports_flash_attn:
  1777 |             raise ValueError(
  1778 |                 f"{self.__class__.__name__} does not support Flash Attention {flash_attn_version} yet. Please request to add support where"
  1779 |                 f" the model is hosted, on its model hub page: https://huggingface.co/{self.config._name_or_path}/discussions/new"
  1780 |                 " or in the Transformers GitHub repo: https://github.com/huggingface/transformers/issues/new"
  1781 |             )
  1782 | 
  1783 |         if flash_attn_version not in [2, 3, 4]:
  1784 |             raise ValueError(f"Requested Flash Attention {flash_attn_version} which is not supported.")
  1785 | 
  1786 |         # Check if we can even use the FA version based on the env of the user
  1787 |         self._flash_attn_import_error(**FLASH_ATTENTION_COMPATIBILITY_MATRIX[flash_attn_version])
  1788 | 
  1789 |         # Check for attention dropout, which is incompatible with newer FA versions
  1790 |         # (many should not really care about dropout as it is not super effective, hence warning for now)
  1791 |         if flash_attn_version > 2:
  1792 |             if hasattr(self.config, "attention_dropout") and self.config.attention_dropout > 0:
  1793 |                 logger.warning_once(
  1794 |                     f"You are attempting to use Flash Attention {flash_attn_version} with dropout. "
  1795 |                     "This might lead to unexpected behaviour as this is not supported on recent versions of Flash Attention."
  1796 |                 )
  1797 | 
  1798 |         # People often move dtypes after init so we only warn in those cases
  1799 |         dtype = self.config.dtype
  1800 |         if dtype is None:
  1801 |             logger.warning_once(
  1802 |                 f"You are attempting to use Flash Attention {flash_attn_version} without specifying a dtype. This might lead to unexpected behaviour"
  1803 |             )
  1804 |         elif dtype is not None and dtype not in [torch.float16, torch.bfloat16]:
  1805 |             logger.warning_once(
  1806 |                 f"Flash Attention {flash_attn_version} only supports torch.float16 and torch.bfloat16 dtypes, but"
  1807 |                 f" the current dype in {self.__class__.__name__} is {dtype}. You should run training or inference using Automatic Mixed-Precision via the `with torch.autocast(device_type='torch_device'):` decorator,"
  1808 |                 f' or load the model with the `dtype` argument. Example: `model = AutoModel.from_pretrained("meta-llama/Llama-3.2-1B", attn_implementation="flash_attention_{flash_attn_version}", dtype=torch.float16)`'
  1809 |             )
  1810 | 
  1811 |         # With the early check, the parameters are not yet initialized correctly
  1812 |         if not is_init_check:
  1813 |             param_devices = list({param.device for param in self.parameters()})
  1814 |             if len(param_devices) == 1 and param_devices[0].type == "cpu":
  1815 |                 found_device = False
  1816 |                 for device_availability_check, device_name in FLASH_ATTENTION_COMPATIBILITY_MATRIX[flash_attn_version][
  1817 |                     "supported_devices"
  1818 |                 ]:
  1819 |                     if device_availability_check():
  1820 |                         found_device = True
  1821 |                         logger.warning_once(
  1822 |                             f"You are attempting to use Flash Attention {flash_attn_version} with a model not initialized on GPU. Please make sure to have "
  1823 |                             "access to a GPU and either initialise the model on a GPU by passing a device_map or initialising the model on CPU and then "
  1824 |                             f"moving it to GPU, e.g. with `model.to('{device_name}')`."
  1825 |                         )
  1826 |                         break
  1827 | 
  1828 |                 if not found_device:
  1829 |                     raise ValueError(
  1830 |                         f"You are attempting to use Flash Attention {flash_attn_version} with a model not initialized on GPU and with no GPU available. "
  1831 |                         "This is not supported yet. Please make sure to have access to a GPU and either initialise the model on a GPU by passing a device_map "
  1832 |                         "or initialising the model on CPU and then moving it to GPU."
  1833 |                     )
  1834 | 
  1835 |         # If no error raise by this point, we can return `True`
  1836 |         return True
  1837 | 
  1838 |     def _sdpa_can_dispatch(self, is_init_check: bool = False) -> bool:
  1839 |         """
  1840 |         Check the availability of SDPA for a given model.
  1841 | 
  1842 |         Args:
  1843 |             is_init_check (`bool`, *optional*):
  1844 |                 Whether this check is performed early, i.e. at __init__ time, or later when the model and its weights are
  1845 |                 fully instantiated. This is needed as we also check the devices of the weights, which are only available
  1846 |                 later after __init__. This allows to raise proper exceptions early before instantiating the full models
  1847 |                 if we know that the model does not support the requested attention.
  1848 |         """
  1849 |         if not self._supports_sdpa:
  1850 |             raise ValueError(
  1851 |                 f"{self.__class__.__name__} does not support an attention implementation through torch.nn.functional.scaled_dot_product_attention yet."
  1852 |                 " Please request the support for this architecture: https://github.com/huggingface/transformers/issues/28005. If you believe"
  1853 |                 ' this error is a bug, please open an issue in Transformers GitHub repository and load your model with the argument `attn_implementation="eager"` meanwhile. Example: `model = AutoModel.from_pretrained("openai/whisper-tiny", attn_implementation="eager")`'
  1854 |             )
  1855 | 
  1856 |         if (
  1857 |             torch.version.hip is not None
  1858 |             and torch.cuda.device_count() > 1
  1859 |             and version.parse(torch.__version__) < version.parse("2.4.1")
  1860 |         ):
  1861 |             logger.warning_once(
  1862 |                 "Using the `SDPA` attention implementation on multi-gpu setup with ROCM may lead to performance issues due to the FA backend. Disabling it to use alternative backends."
  1863 |             )
  1864 |             torch.backends.cuda.enable_flash_sdp(False)
  1865 | 
  1866 |         return True
  1867 | 
  1868 |     def _grouped_mm_can_dispatch(self) -> bool:
  1869 |         """
  1870 |         Check the availability of Grouped MM for a given model.
  1871 |         """
  1872 | 
  1873 |         if not self._can_set_experts_implementation():
  1874 |             raise ValueError(f"{self.__class__.__name__} does not support setting experts implementation.")
  1875 | 
  1876 |         # If no error raised by this point, we can return `True`
  1877 |         return True
  1878 | 
  1879 |     def _flex_attn_can_dispatch(self, is_init_check: bool = False) -> bool:
  1880 |         """
  1881 |         Check the availability of Flex Attention for a given model.
  1882 | 
  1883 |         Args:
  1884 |             is_init_check (`bool`, *optional*):
  1885 |                 Whether this check is performed early, i.e. at __init__ time, or later when the model and its weights are
  1886 |                 fully instantiated. This is needed as we also check the devices of the weights, which are only available
  1887 |                 later after __init__. This allows to raise proper exceptions early before instantiating the full models
  1888 |                 if we know that the model does not support the requested attention.
  1889 |         """
  1890 |         if not self._supports_flex_attn:
  1891 |             raise ValueError(
  1892 |                 f"{self.__class__.__name__} does not support an attention implementation through torch's flex_attention."
  1893 |                 " Please request the support for this architecture: https://github.com/huggingface/transformers/issues/34809."
  1894 |                 " If you believe this error is a bug, please open an issue in Transformers GitHub repository"
  1895 |                 ' and load your model with the argument `attn_implementation="eager"` meanwhile.'
  1896 |                 ' Example: `model = AutoModel.from_pretrained("openai/whisper-tiny", attn_implementation="eager")`'
  1897 |             )
  1898 |         if not is_torch_flex_attn_available():
  1899 |             raise ImportError(
  1900 |                 "PyTorch Flex Attention requirements in Transformers are not met. Please install torch>=2.5.0."
  1901 |             )
  1902 | 
  1903 |         # If no error raise by this point, we can return `True`
  1904 |         return True
  1905 | 
  1906 |     def _check_and_adjust_attn_implementation(
  1907 |         self, attn_implementation: str | None, is_init_check: bool = False, allow_all_kernels: bool = False
  1908 |     ) -> str:
  1909 |         """
  1910 |         Check that the `attn_implementation` exists and is supported by the models, and try to get the kernel from hub if
  1911 |         it matches hf kernels pattern.
  1912 | 
  1913 |         Args:
  1914 |             attn_implementation (`str` or `None`):
  1915 |                 The attention implementation to check for existence/validity.
  1916 |             is_init_check (`bool`, *optional*):
  1917 |                 Whether this check is performed early, i.e. at __init__ time, or later when the model and its weights are
  1918 |                 fully instantiated. This is needed as we also check the devices of the weights, which are only available
  1919 |                 later after __init__. This allows to raise proper exceptions early before instantiating the full models
  1920 |                 if we know that the model does not support the requested attention.
  1921 |             allow_all_kernels (`bool`, optional):
  1922 |                 Whether to load kernels from unverified hub repos, if `attn_implementation` is a custom kernel outside
  1923 |                 of the `kernels-community` hub repository.
  1924 | 
  1925 |         Returns:
  1926 |             `str`: The final attention implementation to use, including potential fallbacks from sdpa to eager, or from
  1927 |             None to sdpa (to potentially eager).
  1928 |         """
  1929 |         is_paged, base_implementation = split_attention_implementation(attn_implementation)
  1930 | 
  1931 |         # A kernel the model explicitly lists in `_compatible_flash_implementations` is vouched for by
  1932 |         # the model author, so authorize loading it even when it lives outside the `kernels-community` org.
  1933 |         if base_implementation in (getattr(self, "_compatible_flash_implementations", None) or []):
  1934 |             allow_all_kernels = True
  1935 | 
  1936 |         # Auto-correct model's default flash implementation if specified
  1937 |         if attn_implementation is not None:
  1938 |             compatible_flash_implementations = getattr(self, "_compatible_flash_implementations", None)
  1939 |             if (
  1940 |                 is_flash_attention_requested(requested_attention_implementation=base_implementation)
  1941 |                 and compatible_flash_implementations is not None
  1942 |                 and base_implementation not in compatible_flash_implementations
  1943 |             ):
  1944 |                 default_flash_implementation = (
  1945 |                     f"paged|{compatible_flash_implementations[0]}" if is_paged else compatible_flash_implementations[0]
  1946 |                 )
  1947 | 
  1948 |                 logger.warning_once(
  1949 |                     f"This model is compatible with the following flash attention implementations: `{compatible_flash_implementations}`. "
  1950 |                     f"Automatically falling back to `{default_flash_implementation}` instead of `{attn_implementation}`."
  1951 |                 )
  1952 |                 attn_implementation = default_flash_implementation
  1953 | 
  1954 |         is_paged, base_implementation = split_attention_implementation(attn_implementation)
  1955 | 
  1956 |         applicable_attn_implementation = attn_implementation
  1957 | 
  1958 |         requested_original_flash_attn = False
  1959 |         if is_flash_attention_requested(requested_attention_implementation=base_implementation):
  1960 |             # If FA not installed, do not fail but use kernels instead if possible
  1961 |             for fa_version in FLASH_ATTENTION_COMPATIBILITY_MATRIX.keys():
  1962 |                 # Check whether we have an original FA requested but not available in the env
  1963 |                 if (
  1964 |                     base_implementation == f"flash_attention_{fa_version}"
  1965 |                     and not FLASH_ATTENTION_COMPATIBILITY_MATRIX[fa_version]["general_availability_check"]()
  1966 |                 ):
  1967 |                     requested_original_flash_attn = True
  1968 |                     break
  1969 | 
  1970 |         if (
  1971 |             self._supports_flash_attn
  1972 |             and requested_original_flash_attn
  1973 |             and is_kernels_available()
  1974 |             and not is_torch_npu_available()
  1975 |         ):
  1976 |             applicable_attn_implementation = FLASH_ATTN_KERNEL_FALLBACK[base_implementation]
  1977 | 
  1978 |             if is_torch_xpu_available() and base_implementation == "flash_attention_2":
  1979 |                 # On XPU, kernels library is the native implementation
  1980 |                 # Disabling this flag to avoid giving wrong fallbacks on errors and warnings
  1981 |                 requested_original_flash_attn = False
  1982 | 
  1983 |             if is_paged:
  1984 |                 applicable_attn_implementation = f"paged|{applicable_attn_implementation}"
  1985 | 
  1986 |         if is_kernel(applicable_attn_implementation):
  1987 |             try:
  1988 |                 # preload flash attention here to allow compile with fullgraph
  1989 |                 if is_paged:
  1990 |                     lazy_import_paged_flash_attention(
  1991 |                         applicable_attn_implementation, allow_all_kernels=allow_all_kernels
  1992 |                     )
  1993 |                 else:
  1994 |                     lazy_import_flash_attention(applicable_attn_implementation, allow_all_kernels=allow_all_kernels)
  1995 | 
  1996 |                 # log that we used kernel fallback if successful
  1997 |                 if requested_original_flash_attn:
  1998 |                     logger.warning_once(
  1999 |                         f"You do not have `flash_attn` installed, using `{applicable_attn_implementation}` "
  2000 |                         "from the `kernels` library instead!"
  2001 |                     )
  2002 |             except Exception as e:
  2003 |                 # raise the proper exception for requested flash attention
  2004 |                 if requested_original_flash_attn:
  2005 |                     fa_version = int(base_implementation[-1])  # "flash_attention_(2|3|...)"
  2006 |                     self._flash_attn_can_dispatch(flash_attn_version=fa_version, is_init_check=is_init_check)
  2007 | 
  2008 |                 # error properly out if a kernel was specifically requested
  2009 |                 raise e
  2010 |         else:
  2011 |             applicable_attn_implementation = self.get_correct_attn_implementation(
  2012 |                 applicable_attn_implementation, is_init_check
  2013 |             )
  2014 | 
  2015 |             # preload flash attention here to allow compile with fullgraph
  2016 |             if is_flash_attention_requested(requested_attention_implementation=applicable_attn_implementation):
  2017 |                 lazy_import_flash_attention(applicable_attn_implementation)
  2018 | 
  2019 |         return applicable_attn_implementation
  2020 | 
  2021 |     def _check_and_adjust_experts_implementation(self, experts_implementation: str | None) -> str:
  2022 |         """
  2023 |         Check that the `experts_implementation` exists and is supported by the models.
  2024 | 
  2025 |         Args:
  2026 |             experts_implementation (`str` or `None`):
  2027 |                 The experts implementation to check for existence/validity.
  2028 |         Returns:
  2029 |             `str`: The final experts implementation to use.
  2030 |         """
  2031 |         applicable_experts_implementation = self.get_correct_experts_implementation(experts_implementation)
  2032 |         return applicable_experts_implementation
  2033 | 
  2034 |     def get_correct_attn_implementation(self, requested_attention: str | None, is_init_check: bool = False) -> str:
  2035 |         applicable_attention = "sdpa" if requested_attention is None else requested_attention
  2036 |         if applicable_attention not in ["eager"] + ALL_ATTENTION_FUNCTIONS.valid_keys():
  2037 |             message = (
  2038 |                 f'Specified `attn_implementation="{applicable_attention}"` is not supported. The only possible arguments are '
  2039 |                 '`attn_implementation="eager"`, `"paged|eager"`'
  2040 |             )
  2041 |             # check `supports_flash_attn_2` for BC with custom code. TODO: remove after a few releases
  2042 |             if self._supports_flash_attn or getattr(self, "_supports_flash_attn_2", False):
  2043 |                 message += ", "
  2044 |                 for fa_version in FLASH_ATTENTION_COMPATIBILITY_MATRIX.keys():
  2045 |                     message += f'`"attn_implementation=flash_attention_{fa_version}"`, `"attn_implementation=paged|flash_attention_{fa_version}"`, '
  2046 |                 message = message[:-2]  # remove trailing comma
  2047 |             if self._supports_sdpa:
  2048 |                 message += ', `"attn_implementation=sdpa"`, `"attn_implementation=paged|sdpa"`'
  2049 |             if self._supports_flex_attn:
  2050 |                 message += ', `"attn_implementation=flex_attention"`'
  2051 |             raise ValueError(message + ".")
  2052 | 
  2053 |         # Perform relevant checks
  2054 |         if is_flash_attention_requested(requested_attention_implementation=applicable_attention) and (
  2055 |             fa_matched := re.search(r"^flash_attention_(\d)$", applicable_attention)
  2056 |         ):
  2057 |             fa_version = int(fa_matched.group(1))  # last digit
  2058 |             self._flash_attn_can_dispatch(flash_attn_version=fa_version, is_init_check=is_init_check)
  2059 |         elif "flex_attention" in applicable_attention:
  2060 |             self._flex_attn_can_dispatch(is_init_check)
  2061 |         elif "sdpa" in applicable_attention:
  2062 |             # Sdpa is the default, so we try it and fallback to eager otherwise when not possible
  2063 |             try:
  2064 |                 self._sdpa_can_dispatch(is_init_check)
  2065 |             except (ValueError, ImportError) as e:
  2066 |                 if requested_attention is not None and "sdpa" in requested_attention:
  2067 |                     raise e
  2068 |                 applicable_attention = "eager"
  2069 | 
  2070 |         return applicable_attention
  2071 | 
  2072 |     def get_correct_experts_implementation(self, requested_experts: str | None) -> str:
  2073 |         applicable_experts = "grouped_mm" if requested_experts is None else requested_experts
  2074 |         base_experts_fns = ["eager"] + list(set(ALL_EXPERTS_FUNCTIONS.keys()) | set(ALL_FP8_EXPERTS_FUNCTIONS.keys()))
  2075 |         valid_experts_str_list = [f'`experts_implementation="{fn}"`' for fn in base_experts_fns]
  2076 |         valid_experts_str_list[-1] = "and " + valid_experts_str_list[-1]
  2077 |         valid_experts_str = ", ".join(valid_experts_str_list)
  2078 |         if applicable_experts not in base_experts_fns:
  2079 |             message = (
  2080 |                 f'Specified `experts_implementation="{applicable_experts}"` is not supported. The only possible arguments are '
  2081 |                 f"{valid_experts_str}."
  2082 |             )
  2083 |             raise ValueError(message)
  2084 | 
  2085 |         # Perform relevant checks
  2086 |         if applicable_experts == "grouped_mm":
  2087 |             try:
  2088 |                 self._grouped_mm_can_dispatch()
  2089 |             except (ValueError, ImportError) as e:
  2090 |                 if requested_experts == "grouped_mm":
  2091 |                     raise e
  2092 |                 applicable_experts = "eager"
  2093 | 
  2094 |         return applicable_experts
  2095 | 
  2096 |     @classmethod
  2097 |     def _can_set_attn_implementation(cls) -> bool:
  2098 |         """Detect whether the class supports setting its attention implementation dynamically. It is an ugly check based on
  2099 |         opening the file, but avoids maintaining yet another property flag.
  2100 |         """
  2101 |         class_module = sys.modules.get(cls.__module__)
  2102 |         # Missing module entry (e.g. cleared by a test) or custom model in a jupyter notebook / repl -> do not allow to set it
  2103 |         if class_module is None or not hasattr(class_module, "__file__"):
  2104 |             return False
  2105 |         class_file = class_module.__file__
  2106 |         with open(class_file, "r", encoding="utf-8") as f:
  2107 |             code = f.read()
  2108 |         # heuristic -> if we find those patterns, the model uses the correct interface
  2109 |         if re.search(r"class \w+Attention\(nn.Module\)", code):
  2110 |             return "eager_attention_forward" in code and "ALL_ATTENTION_FUNCTIONS.get_interface(" in code
  2111 |         else:
  2112 |             # If no attention layer, assume `True`. Most probably a multimodal model or inherits from existing models
  2113 |             return True
  2114 | 
  2115 |     @classmethod
  2116 |     def _can_set_experts_implementation(cls) -> bool:
  2117 |         """Detect whether the class supports setting its experts implementation dynamically. It is an ugly check based on
  2118 |         opening the file, but avoids maintaining yet another property flag.
  2119 |         """
  2120 |         class_module = sys.modules.get(cls.__module__)
  2121 |         # Missing module entry (e.g. cleared by a test) or custom model in a jupyter notebook / repl -> do not allow to set it
  2122 |         if class_module is None or not hasattr(class_module, "__file__"):
  2123 |             return False
  2124 |         class_file = class_module.__file__
  2125 |         with open(class_file, "r", encoding="utf-8") as f:
  2126 |             code = f.read()
  2127 |         # heuristic -> if we the use_experts_implementation decorator is used, then we can set it
  2128 |         return "@use_experts_implementation" in code
  2129 | 
  2130 |     def set_attn_implementation(self, attn_implementation: str | dict, allow_all_kernels: bool = False):
  2131 |         """
  2132 |         Set the requested `attn_implementation` for this model.
  2133 | 
  2134 |         Args:
  2135 |             attn_implementation (`str` or `dict`):
  2136 |                 The attention implementation to set for this model. It can be either a `str`, in which case it will be
  2137 |                 dispatched to all submodels if relevant, or a `dict` where keys are the sub_configs name, in which case each
  2138 |                 submodel will dispatch the corresponding value.
  2139 |             allow_all_kernels (`bool`, optional):
  2140 |                 Whether to load kernels from unverified hub repos, if `attn_implementation` is a custom kernel outside
  2141 |                 of the `kernels-community` hub repository.
  2142 |         """
  2143 |         requested_implementation = (
  2144 |             attn_implementation
  2145 |             if not isinstance(attn_implementation, dict)
  2146 |             else attn_implementation.get("", self.config._attn_implementation)
  2147 |         )
  2148 | 
  2149 |         if requested_implementation != self.config._attn_implementation:
  2150 |             # In this case, raise
  2151 |             if not self._can_set_attn_implementation():
  2152 |                 logger.warning(
  2153 |                     f"{self.__class__.__name__} does not support setting its attention implementation dynamically, because it "
  2154 |                     "does not follow the functional approach based on AttentionInterface "
  2155 |                     "(see https://huggingface.co/docs/transformers/en/attention_interface)"
  2156 |                 )
  2157 |             else:
  2158 |                 requested_implementation = self._check_and_adjust_attn_implementation(
  2159 |                     requested_implementation, is_init_check=False, allow_all_kernels=allow_all_kernels
  2160 |                 )
  2161 |                 # Apply the change (on the internal attr, to avoid setting it recursively)
  2162 |                 self.config._attn_implementation_internal = requested_implementation
  2163 | 
  2164 |         # Apply it to all submodels as well
  2165 |         for submodule in self.modules():
  2166 |             # We found a submodel (which is not self) with a different config (otherwise, it may be the same "actual model",
  2167 |             # e.g. ForCausalLM has a Model inside, but no need to check it again)
  2168 |             if (
  2169 |                 submodule is not self
  2170 |                 and isinstance(submodule, PreTrainedModel)
  2171 |                 and submodule.config.__class__ != self.config.__class__
  2172 |                 # If it was already changed, no need to do it again
  2173 |                 and not hasattr(submodule.config, "_attn_was_changed")
  2174 |             ):
  2175 |                 # In this case, warn and skip
  2176 |                 if not submodule._can_set_attn_implementation():
  2177 |                     logger.warning(
  2178 |                         f"{submodule.__class__.__name__} does not support setting its attention implementation dynamically, because it "
  2179 |                         "does not follow the functional approach based on AttentionInterface "
  2180 |                         "(see https://huggingface.co/docs/transformers/en/attention_interface)"
  2181 |                     )
  2182 |                 # Set the attn on the submodule
  2183 |                 else:
  2184 |                     sub_implementation = requested_implementation
  2185 |                     if isinstance(attn_implementation, dict):
  2186 |                         for subconfig_key in self.config.sub_configs:
  2187 |                             # We need to check for exact object match here, with `is`
  2188 |                             if getattr(self.config, subconfig_key) is submodule.config:
  2189 |                                 sub_implementation = attn_implementation.get(
  2190 |                                     subconfig_key, submodule.config._attn_implementation
  2191 |                                 )
  2192 |                                 break
  2193 |                     # Check the module can use correctly, otherwise we raise an error if requested attention can't be set for submodule
  2194 |                     sub_implementation = submodule.get_correct_attn_implementation(sub_implementation)
  2195 |                     submodule.config._attn_implementation_internal = sub_implementation
  2196 | 
  2197 |                 # Still add it as "changed" even if it was skipped, as we would otherwise try to set it in the dark afterwards
  2198 |                 # We need to set it on the config itself, to differentiate 2 subconfigs of the same __class__ potentially
  2199 |                 submodule.config._attn_was_changed = True
  2200 | 
  2201 |         # We need this as some old and badly designed models use subconfigs without declaring the corresponding modules as PreTrainedModel
  2202 |         for subconfig_key in self.config.sub_configs:
  2203 |             if (subconfig := getattr(self.config, subconfig_key)) is not None:
  2204 |                 sub_implementation = (
  2205 |                     requested_implementation
  2206 |                     if not isinstance(attn_implementation, dict)
  2207 |                     else attn_implementation.get(subconfig_key, subconfig._attn_implementation)
  2208 |                 )
  2209 |                 # This means we did not perform any check above for this particular subconfig -> set it in the dark if it is registered
  2210 |                 if (
  2211 |                     not hasattr(subconfig, "_attn_was_changed")
  2212 |                     # If it's already the same, then no need to enter here and raise warnings
  2213 |                     and sub_implementation != subconfig._attn_implementation
  2214 |                 ):
  2215 |                     if sub_implementation not in ["eager"] + ALL_ATTENTION_FUNCTIONS.valid_keys():
  2216 |                         raise ValueError(
  2217 |                             f'Specified `attn_implementation="{sub_implementation}"` is not supported for {subconfig_key}. '
  2218 |                             'The only possible arguments are "eager" (manual attention implementation)'
  2219 |                             f"or one of the following: {list(ALL_ATTENTION_FUNCTIONS.valid_keys())}"
  2220 |                         )
  2221 |                     subconfig._attn_implementation_internal = sub_implementation
  2222 |                     logger.warning(
  2223 |                         f"We set the attention implementation for the sub-config `{subconfig_key}` to `{sub_implementation}` "
  2224 |                         "without finding the associated sub-model. For this reason we could not check if the model supports it. "
  2225 |                         "You may encounter undefined behavior."
  2226 |                     )
  2227 |                 # Unset the attribute in this case, to avoid issues in the future
  2228 |                 else:
  2229 |                     if hasattr(subconfig, "_attn_was_changed"):
  2230 |                         del subconfig._attn_was_changed
  2231 | 
