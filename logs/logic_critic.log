  4794 |     def _initialize_missing_keys(self, is_quantized: bool) -> None:
  4795 |         """
  4796 |         Initialize the missing keys (keys that are part of the model parameters, but were NOT found in the loaded state dicts), according to
  4797 |         `_initialize_weights`. Indeed, since the corresponding weights are missing from the state dict, they will not be replaced and need to
  4798 |         be initialized correctly (i.e. weight initialization distribution).
  4799 | 
  4800 |         Also marks non-missing params/buffers with `_is_hf_initialized` and propagates this flag to modules,
  4801 |         so that `_initialize_weights` can skip fully-initialized modules entirely.
  4802 |         """
  4803 |         if is_fsdp_enabled() and not is_local_dist_rank_0():
  4804 |             # Handle FSDP edge case when using cpu ram efficient loading to ensure it is marked as initialized
  4805 |             # since it will get its weights broadcasted from rank0
  4806 |             # We actually need to do that only because we want to re-initialize non-persistent buffers with correct values.
  4807 |             # Everything else in the state_dict will be gathered from rank0, so we don't need re-initialization.
  4808 |             # We could simply early return after buffer inits if we had a way to init only the non-persistent buffers
  4809 |             for key in self.state_dict():
  4810 |                 try:
  4811 |                     param_or_buffer = self.get_parameter_or_buffer(key)
  4812 |                     param_or_buffer._is_hf_initialized = True
  4813 |                 except AttributeError:
  4814 |                     pass  # may happen when handling pre-quantized weights
  4815 |             self._is_hf_initialized = True
  4816 | 
  4817 |         # This will only initialize submodules that are not marked as initialized by the line above.
  4818 |         if is_deepspeed_zero3_enabled() and not is_quantized:
  4819 |             import deepspeed
  4820 | 
  4821 |             # keep_vars=True as we need the original tensors, so that the "_is_hf_initialized" is present on them
  4822 |             not_initialized_parameters = list(
  4823 |                 {v for v in self.state_dict(keep_vars=True).values() if not getattr(v, "_is_hf_initialized", False)}
  4824 |             )
  4825 |             with deepspeed.zero.GatheredParameters(not_initialized_parameters, modifier_rank=0):
  4826 |                 self.initialize_weights()
  4827 |         else:
  4828 |             self.initialize_weights()
  4829 | 

