   644 |                 input_ids=prompt_token_ids[:, input_pos : input_pos + 1],
   645 |                 cache_position=torch.tensor([input_pos], dtype=torch.long, device=device),
   646 |             )
   647 |             response_tokens.append(prompt_token_ids[0][input_pos].item())
