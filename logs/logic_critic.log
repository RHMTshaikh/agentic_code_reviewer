  1373 |     @property
  1374 |     def all_special_tokens(self) -> list[str]:
  1375 |         """
  1376 |         `list[str]`: A list of all unique special tokens (named + extra) as strings.
  1377 | 
  1378 |         Includes both named special tokens (bos_token, eos_token, etc.) and extra special tokens.
  1379 |         Converts tokens of `tokenizers.AddedToken` type to string.
  1380 |         """
  1381 |         seen = set()
  1382 |         all_toks = []
  1383 | 
  1384 |         # Add named special tokens
  1385 |         for attr in self.SPECIAL_TOKENS_ATTRIBUTES:
  1386 |             value = self._special_tokens_map.get(attr)
  1387 |             if value is not None:
  1388 |                 token_str = str(value)
  1389 |                 if token_str not in seen:
  1390 |                     all_toks.append(token_str)
  1391 |                     seen.add(token_str)
  1392 | 
  1393 |         # Add extra special tokens
  1394 |         for token in self._extra_special_tokens:
  1395 |             token_str = str(token)
  1396 |             if token_str not in seen:
  1397 |                 all_toks.append(token_str)
  1398 |                 seen.add(token_str)
  1399 | 
  1400 |         return all_toks
