    25 |         self, 
    26 |         valuation: PortfolioValuation, 
    27 |         confidence_level: float = 0.95, 
    28 |         lookback_days: int = 252
    29 |     ) -> Decimal:
    30 |         """
    31 |         Calculates Portfolio Value at Risk (VaR) using Historical Simulation.
    32 |         Answers: "What is the maximum amount we expect to lose in a single day with 95% confidence?"
    33 |         
    34 |         Args:
    35 |             valuation: Current evaluated state of the portfolio.
    36 |             confidence_level: Statistical confidence (e.g., 0.95 or 0.99).
    37 |             lookback_days: Number of historical trading days to simulate against (default 1 trading year).
    38 |         """
    39 |         if not valuation.positions:
    40 |             return Decimal("0.00")
    41 | 
    42 |         # 1. Fetch historical closing prices for all held assets
    43 |         historical_returns: dict[str, list[float]] = {}
    44 |         
    45 |         for pos in valuation.positions:
    46 |             bars = await self.market_client.get_historical_bars(pos.symbol, lookback_periods=lookback_days + 1)
    47 |             if len(bars) < lookback_days:
    48 |                 raise StaleMarketDataError(f"Insufficient historical data for {pos.symbol} to calculate VaR.")
    49 |             
    50 |             # Calculate daily logarithmic returns: ln(P_t / P_t-1)
    51 |             closes = [float(b.close_price) for b in bars]
    52 |             returns = [math.log(closes[i] / closes[i+1]) for i in range(len(closes)-1)]
    53 |             historical_returns[pos.symbol] = returns
    54 | 
    55 |         # 2. Simulate historical portfolio daily PnL
    56 |         # Convert to numpy arrays for fast matrix multiplication
    57 |         simulated_pnl = np.zeros(lookback_days)
    58 |         
    59 |         for pos in valuation.positions:
    60 |             symbol_returns = np.array(historical_returns[pos.symbol])
    61 |             position_value = float(pos.market_value)
    62 |             
    63 |             # Simulated daily dollar impact = Position Value * Daily Return
    64 |             simulated_pnl += (symbol_returns * position_value)
    65 | 
    66 |         # 3. Determine the percentile loss
    67 |         # If confidence is 95%, we want the 5th percentile worst return
    68 |         target_percentile = (1.0 - confidence_level) * 100
    69 |         simulated_var_value = np.percentile(simulated_pnl, target_percentile)
    70 | 
    71 |         # VaR is typically expressed as a positive number representing the loss
    72 |         computed_var = Decimal(str(simulated_var_value)).quantize(Decimal("0.01"))
    73 |         
    74 |         # If the 5th percentile is somehow positive (extreme bull market), VaR is 0.
