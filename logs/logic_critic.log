   291 |         attention_mask: torch.Tensor | None = None,
   292 |         past_key_values: Cache | None = None,
   293 |         **kwargs,
   294 |     ) -> tuple[torch.Tensor, torch.Tensor | None]:
   295 |         batch_size, seq_length = hidden_states.shape[:-1]
   296 |         query_shape = (batch_size, seq_length, -1, self.qk_head_dim)
   297 |         key_shape = (batch_size, seq_length, -1, self.qk_nope_head_dim + self.v_head_dim)
   298 | 
   299 |         if self.q_lora_rank is None:
