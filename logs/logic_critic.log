  2747 |         if preserved_attention_mask is not None:
  2748 |             sample = preserved_attention_mask[0]
  2749 |             if is_torch_tensor(sample):
  2750 |                 import torch
  2751 | 
  2752 |                 batch_outputs["attention_mask"] = torch.stack(preserved_attention_mask)
  2753 |             elif isinstance(sample, np.ndarray):
