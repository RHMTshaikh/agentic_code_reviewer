    89 |     async def calculate_vwap(self, symbol: str, lookback_periods: int = 30) -> Decimal:
    90 |         """
    91 |         Calculates the Volume-Weighted Average Price (VWAP):
    92 |             VWAP = sum(Typical_Price * Volume) / sum(Volume)
    93 |             Typical_Price = (High + Low + Close) / 3
    94 |         """
    95 |         clean_symbol = symbol.strip().upper()
    96 | 
    97 |         # Check cached analytical result
    98 |         cached_vwap = await self._cache.get_vwap(clean_symbol)
    99 |         if cached_vwap is not None:
   100 |             return cached_vwap
   101 | 
   102 |         bars = await self._client.get_historical_bars(clean_symbol, lookback_periods=lookback_periods)
   103 |         if not bars:
   104 |             raise StaleMarketDataError(f"Insufficient historical bars to compute VWAP for {clean_symbol}")
   105 | 
   106 |         total_volume = Decimal("0")
   107 |         total_dollar_volume = Decimal("0")
   108 | 
   109 |         for bar in bars:
   110 |             typical_price = (bar.high_price + bar.low_price + bar.close_price) / Decimal("3")
   111 |             dollar_volume = typical_price * bar.volume
   112 | 
   113 |             total_volume += bar.volume
   114 |             total_dollar_volume += dollar_volume
   115 | 
   116 |         if total_volume == Decimal("0"):
   117 |             raise StaleMarketDataError(f"Zero aggregate volume encountered during VWAP computation for {clean_symbol}")
   118 | 
   119 |         computed_vwap = (total_dollar_volume / total_volume).quantize(Decimal("0.0001"))
   120 | 
   121 |         # Cache calculated VWAP for subsequent calls
   122 |         await self._cache.set_vwap(clean_symbol, computed_vwap, ttl_seconds=300)
