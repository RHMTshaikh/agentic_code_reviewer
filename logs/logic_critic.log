   183 |                 "italic",
   184 |             )
   185 |             for k in update_key_name(self.unexpected_keys):
   186 |                 status = _style("UNEXPECTED", "orange")
   187 |                 rows.append([k, status, "", ""])
   188 | 
   189 |         if self.missing_keys:
