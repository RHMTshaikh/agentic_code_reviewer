  3216 |     def _init_added_lm_head_bias_with_mean(self, old_lm_head, new_lm_head, added_num_tokens):
  3217 |         bias_mean = torch.mean(old_lm_head.bias.data, axis=0, dtype=torch.float32)
  3218 |         bias_std = torch.std(old_lm_head.bias.data, axis=0).to(torch.float32)
