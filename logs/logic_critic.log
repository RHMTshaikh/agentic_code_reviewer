  3970 | def _process_returns_section(func_documentation, sig, config_class, indent_level):
  3971 |     """
  3972 |     Process the returns section of the docstring.
  3973 | 
  3974 |     Args:
  3975 |         func_documentation (`str`): Existing function documentation (manually specified in the docstring)
  3976 |         sig (`inspect.Signature`): Function signature
  3977 |         config_class (`str`): Config class for the model
  3978 |         indent_level (`int`): Indentation level
  3979 |     """
  3980 |     return_docstring = ""
  3981 | 
  3982 |     # Extract returns section from existing docstring if available
  3983 |     if func_documentation is not None and (match_start := _re_return.search(func_documentation)) is not None:
  3984 |         match_end = _re_example.search(func_documentation)
  3985 |         if match_end:
  3986 |             return_docstring = func_documentation[match_start.start() : match_end.start()]
  3987 |             func_documentation = func_documentation[match_end.start() :]
  3988 |         else:
  3989 |             return_docstring = func_documentation[match_start.start() :]
  3990 |             func_documentation = ""
  3991 |         return_docstring = set_min_indent(return_docstring, indent_level + 4)
  3992 |     # Otherwise, generate return docstring from return annotation if available
  3993 |     elif sig.return_annotation is not None and sig.return_annotation != inspect._empty:
  3994 |         add_intro, return_annotation = contains_type(sig.return_annotation, ModelOutput)
  3995 |         return_docstring = _prepare_return_docstring(return_annotation, config_class, add_intro=add_intro)
  3996 |         # PT_RETURN_INTRODUCTION already starts with \n, so only add blank line if it doesn't start with one
  3997 |         if not return_docstring.startswith("\n"):
  3998 |             return_docstring = "\n" + return_docstring
  3999 |         return_docstring = set_min_indent(return_docstring, indent_level + 4)
  4000 | 
  4001 |     return return_docstring, func_documentation
