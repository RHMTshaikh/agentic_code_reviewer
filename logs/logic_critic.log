   357 |         if (
   358 |             inputs_tensor.shape[1] != input_ids_length
   359 |             and model_input_name == "inputs_embeds"
   360 |             and not self.config.is_encoder_decoder
   361 |         ):
   362 |             max_cache_length += inputs_tensor.shape[1]
