   388 |             (2, 1, 1, 2, 4, 6, True),
   389 |             # Case 9: Edge case - requesting 0 blocks always succeeds
   390 |             # needed_blocks = 0, free_blocks = 0 -> 0 <= 0 = True
   391 |             (0, 0, 1, 1, 4, 0, True),
   392 |             # Case 10: Edge case - exactly enough blocks
   393 |             # needed_blocks = 2 * 1 + min(3 - 0, 2) * 1 = 2 + 2 = 4, free_blocks = 4 -> 4 <= 4 = True
   394 |             (2, 0, 1, 1, 3, 4, True),
   395 |         ]
   396 |     )
   397 |     def test_continuous_batching_will_allocation_be_successful(
   398 |         self,
   399 |         num_requested_blocks: int,
