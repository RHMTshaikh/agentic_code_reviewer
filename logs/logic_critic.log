  4520 |         - For model classes, the decorator derives parameter descriptions from the `__init__` method's signature
  4521 |           and docstring.
  4522 |         - Return value documentation is automatically generated for methods that return ModelOutput subclasses.
  4523 |     """
  4524 | 
  4525 |     def auto_docstring_decorator(obj):
  4526 |         if len(obj.__qualname__.split(".")) > 1:
  4527 |             return auto_method_docstring(
  4528 |                 obj, custom_args=custom_args, custom_intro=custom_intro, checkpoint=checkpoint
  4529 |             )
  4530 |         else:
