   315 |         ordered: list[RequestState] = []
   316 |         while offloaded or fresh:
   317 |             if offloaded:
   318 |                 ordered.append(offloaded.popleft())
   319 |             if fresh:
   320 |                 ordered.append(fresh.popleft())
   321 |         return ordered
