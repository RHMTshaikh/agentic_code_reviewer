   246 |     def test_dtensor_shard_aware_mixtral_conversion_uses_only_local_experts(self):
   247 |         """Integration test: FSDP-sharded expert loading + WeightConverter.
   248 | 
   249 |         The problem: Mixtral has 8 experts. The checkpoint stores them separately::
   250 | 
   251 |             experts.0.w1.weight  (2x2)
   252 |             experts.0.w3.weight  (2x2)
   253 |             experts.1.w1.weight  (2x2)
   254 |             experts.1.w3.weight  (2x2)
   255 | 
   256 |         The model stores them packed into one tensor::
   257 | 
   258 |             experts.gate_up_proj.weight  (2, 4, 2)
   259 |                                           ^  ^  ^
   260 |                                           |  |  +-- features
   261 |                                           |  +-- w1 (2) + w3 (2) concatenated
   262 |                                           +-- num_experts
   263 | 
   264 |         With FSDP2, params become DTensors and FSDP can shard the same
   265 |         dimension as TP or EP (e.g. expert axis 0). On a 2D (fsdp, tp) mesh
   266 |         the loader must compose both placements either: [Shard(d), Shard(d)] for contiguous double-shard,
   267 |         or [_StridedShard(d), Shard(d)] for fused weights.DtensorShardOperation handles this; the legacy TP path did not.
   268 | 
   269 |         What the test checks::
   270 | 
   271 |             checkpoint files              shard_tensor              rank 0 gets
   272 |             ----------------              ------------              -----------
   273 |             experts.0.w1  [[0,1],[2,3]]   idx=0 -> kept            [[0,1],[2,3]]
   274 |             experts.1.w1  [[10,11],...]   idx=1 -> None (not owned)
   275 |             experts.0.w3  [[4,5],[6,7]]   idx=0 -> kept            [[4,5],[6,7]]
   276 |             experts.1.w3  [[14,15],...]   idx=1 -> None (not owned)
   277 | 
   278 |         WeightConverter then combines only the kept tensors::
   279 | 
   280 |             MergeModulelist(dim=0): stack owned experts  -> shape (1, 2, 2) each
   281 |             Concatenate(dim=1):     cat w1 + w3 along dim 1
   282 | 
   283 |             gate_up_proj = [[[0,1],[2,3],[4,5],[6,7]]]   shape (1, 4, 2)
   284 |                               ~~~~~~~~~~  ~~~~~~~~~~
   285 |                                   w1          w3
   286 | 
   287 |         The key point: DtensorShardOperation.shard_tensor(tensor_idx=1) returns
   288 |         None for rank 0, so the converter never even processes expert 1's data.
   289 |         This saves memory during loading.
   290 |         """
   291 |         shard_op = _make_dtensor_shard_op(
   292 |             FakeMesh(shape=(2,), rank=0),
   293 |             [Shard(0)],
   294 |             param_shape=(2, 4, 2),
   295 |             local_shape=(1, 4, 2),
   296 |         )
   297 |         converter = WeightConverter(
   298 |             ["experts.*.w1.weight", "experts.*.w3.weight"],
   299 |             "experts.gate_up_proj.weight",
   300 |             operations=[MergeModulelist(dim=0), Concatenate(dim=1)],
   301 |         )
   302 | 
   303 |         for idx, tensor in enumerate(
   304 |             [
   305 |                 torch.tensor([[0.0, 1.0], [2.0, 3.0]]),
   306 |                 torch.tensor([[10.0, 11.0], [12.0, 13.0]]),
   307 |             ]
   308 |         ):
   309 |             converter.add_tensor(
   310 |                 "model.layers.0.experts.gate_up_proj.weight",
   311 |                 f"model.layers.0.experts.{idx}.w1.weight",
   312 |                 "experts.*.w1.weight",
   313 |                 spawn_materialize(None, tensor, device="cpu", dtype=None, sharding_op=shard_op, tensor_idx=idx),
   314 |             )
   315 | 
   316 |         for idx, tensor in enumerate(
   317 |             [
   318 |                 torch.tensor([[4.0, 5.0], [6.0, 7.0]]),
   319 |                 torch.tensor([[14.0, 15.0], [16.0, 17.0]]),
   320 |             ]
   321 |         ):
   322 |             converter.add_tensor(
   323 |                 "model.layers.0.experts.gate_up_proj.weight",
   324 |                 f"model.layers.0.experts.{idx}.w3.weight",
   325 |                 "experts.*.w3.weight",
   326 |                 spawn_materialize(None, tensor, device="cpu", dtype=None, sharding_op=shard_op, tensor_idx=idx),
   327 |             )
   328 | 
   329 |         converted = converter.convert("model.layers.0.experts.gate_up_proj.weight")
   330 | 
   331 |         self.assertEqual(list(converted), ["model.layers.0.experts.gate_up_proj.weight"])
   332 |         torch.testing.assert_close(
