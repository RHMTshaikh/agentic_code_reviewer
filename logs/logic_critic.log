  1158 |         tokenizer = GPT2Tokenizer.from_pretrained("openai-community/gpt2")
  1159 |         model = GPT2Model.from_pretrained("openai-community/gpt2")
  1160 | 
  1161 |         special_tokens_dict = {"cls_token": "<CLS>"}
  1162 | 
  1163 |         num_added_toks = tokenizer.add_special_tokens(special_tokens_dict)
  1164 |         print("We have added", num_added_toks, "tokens")
  1165 |         # Notice: resize_token_embeddings expect to receive the full size of the new vocabulary, i.e., the length of the tokenizer.
  1166 |         model.resize_token_embeddings(len(tokenizer))
  1167 | 
  1168 |         assert tokenizer.cls_token == "<CLS>"
  1169 |         ```"""
  1170 |         if not special_tokens_dict:
  1171 |             return 0
  1172 | 
  1173 |         # V5: Allowed keys are SPECIAL_TOKENS_ATTRIBUTES + "extra_special_tokens"
  1174 |         # Backward compatibility: convert "additional_special_tokens" to "extra_special_tokens"
  1175 |         special_tokens_dict = dict(special_tokens_dict)
  1176 |         if "additional_special_tokens" in special_tokens_dict:
  1177 |             special_tokens_dict.setdefault(
  1178 |                 "extra_special_tokens", special_tokens_dict.pop("additional_special_tokens")
  1179 |             )
  1180 | 
  1181 |         allowed_keys = set(self.SPECIAL_TOKENS_ATTRIBUTES) | {"extra_special_tokens"}
  1182 |         tokens_to_add = []
  1183 |         for key, value in special_tokens_dict.items():
