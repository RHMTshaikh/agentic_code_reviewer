  3542 |         else:
  3543 |             weights_name = ADAPTER_SAFE_WEIGHTS_NAME
  3544 | 
  3545 |         filename_pattern = weights_name.replace(".bin", "{suffix}.bin").replace(".safetensors", "{suffix}.safetensors")
  3546 |         state_dict_split = split_torch_state_dict_into_shards(
  3547 |             state_dict, filename_pattern=filename_pattern, max_shard_size=max_shard_size
  3548 |         )
  3549 |         # Save index if sharded
  3550 |         index = None
  3551 |         if state_dict_split.is_sharded:
  3552 |             index = {
  3553 |                 "metadata": {"total_parameters": self.num_parameters(), **state_dict_split.metadata},
  3554 |                 "weight_map": state_dict_split.tensor_to_filename,
  3555 |             }
  3556 | 
  3557 |         # Clean the folder from a previous save
  3558 |         for filename in os.listdir(save_directory):
  3559 |             full_filename = os.path.join(save_directory, filename)
  3560 |             # If we have a shard file that is not going to be replaced, we delete it, but only from the main process
  3561 |             # in distributed settings to avoid race conditions.
  3562 |             weights_no_suffix = weights_name.replace(".bin", "").replace(".safetensors", "")
  3563 | 
  3564 |             # make sure that file to be deleted matches format of sharded file, e.g. pytorch_model-00001-of-00005
  3565 |             filename_no_suffix = filename.replace(".bin", "").replace(".safetensors", "")
  3566 |             reg = re.compile(r"(.*?)-\d{5}-of-\d{5}")
  3567 | 
  3568 |             if (
  3569 |                 filename.startswith(weights_no_suffix)
  3570 |                 and os.path.isfile(full_filename)
  3571 |                 and filename not in state_dict_split.filename_to_tensors
  3572 |                 and is_main_process
  3573 |                 and reg.fullmatch(filename_no_suffix) is not None
  3574 |             ):
  3575 |                 os.remove(full_filename)
