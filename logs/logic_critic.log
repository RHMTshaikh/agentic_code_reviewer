  2139 |     def _save_pretrained(
  2140 |         self,
  2141 |         save_directory: str | os.PathLike,
  2142 |         file_names: tuple[str, ...],
  2143 |         legacy_format: bool | None = None,
  2144 |         filename_prefix: str | None = None,
  2145 |     ) -> tuple[str, ...]:
  2146 |         """
  2147 |         Save a tokenizer using the slow-tokenizer/legacy format: vocabulary + added tokens.
  2148 | 
  2149 |         Fast tokenizers can also be saved in a unique JSON file containing {config + vocab + added-tokens} using the
  2150 |         specific [`~tokenization_utils_tokenizers.PreTrainedTokenizerFast._save_pretrained`]
  2151 |         """
  2152 |         if legacy_format is False:
  2153 |             raise ValueError(
  2154 |                 "Only fast tokenizers (instances of PreTrainedTokenizerFast) can be saved in non legacy format."
  2155 |             )
  2156 | 
  2157 |         save_directory = str(save_directory)
  2158 | 
  2159 |         added_tokens_file = os.path.join(
  2160 |             save_directory, (filename_prefix + "-" if filename_prefix else "") + ADDED_TOKENS_FILE
  2161 |         )
  2162 |         # the new get_added_vocab() also returns special tokens and tokens that have an index < vocab_size
  2163 |         added_vocab = {tok: index for tok, index in self.added_tokens_encoder.items() if index >= self.vocab_size}
  2164 |         if added_vocab:
  2165 |             with open(added_tokens_file, "w", encoding="utf-8") as f:
  2166 |                 out_str = json.dumps(added_vocab, indent=2, sort_keys=True, ensure_ascii=False) + "\n"
  2167 |                 f.write(out_str)
  2168 |                 logger.info(f"added tokens file saved in {added_tokens_file}")
  2169 | 
  2170 |         vocab_files = self.save_vocabulary(save_directory, filename_prefix=filename_prefix)
  2171 | 
  2172 |         return file_names + vocab_files + (added_tokens_file,)
