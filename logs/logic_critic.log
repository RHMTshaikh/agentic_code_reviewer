  2720 | 
  2721 |         batch_size = len(required_input)
  2722 |         assert all(len(v) == batch_size for v in encoded_inputs.values()), (
  2723 |             "Some items in the output dictionary have a different batch size than others."
  2724 |         )
  2725 | 
  2726 |         if padding_strategy == PaddingStrategy.LONGEST:
  2727 |             max_length = max(len(inputs) for inputs in required_input)
  2728 |             padding_strategy = PaddingStrategy.MAX_LENGTH
