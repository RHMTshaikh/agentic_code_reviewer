  55 |         side = random.choice([True, False])
  56 |         sides.append(side)
  57 |         masks.append(get_affected_points_mask(forward_map.shape, line, side))
  58 | 
  59 |     if draw_folds:
  60 |         for i, line in enumerate(lines):
  61 |             p1 = (int(line.point1[0]/scale), int(line.point1[1]/scale))
  62 |             p2 = (int(line.point2[0]/scale), int(line.point2[1]/scale))
  63 |             cv.line(image_copy, p1, p2, (0, 255, 0, 255), 3)
  64 |             text_pos = (
  65 |                 int((p1[0] + p2[0]) // 2),
  66 |                 int((p1[1] + p2[1]) // 2)
  67 |             )
  68 |             cv.putText(image_copy, f'{i+1}', text_pos, cv.FONT_HERSHEY_SIMPLEX, 0.7, (255, 0, 0, 255), 2)
  69 | 
  70 |     t = time.time()
  71 |     for i in range(num_folds):
  72 |         line = lines[i]
  73 |         angle = np.radians(np.random.uniform(*angle_range)) * np.random.choice([-1, 1])
  74 |         mask = masks[i]
  75 |         side = sides[i]
  76 |         
  77 |         while True:
  78 |             test_map = apply_fold(forward_map, line, angle, mask)
  79 |             if not map_overlaps(test_map):
  80 |                 forward_map = test_map
