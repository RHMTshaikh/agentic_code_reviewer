   231 |     def test_dtensor_shard_aware_mixtral_conversion_uses_only_local_experts(self):
   232 |         """Integration test: FSDP-sharded expert loading + WeightConverter.
   233 | 
   234 |         The problem: Mixtral has 8 experts. The checkpoint stores them separately::
   235 | 
   236 |             experts.0.w1.weight  (2x2)
   237 |             experts.0.w3.weight  (2x2)
   238 |             experts.1.w1.weight  (2x2)
   239 |             experts.1.w3.weight  (2x2)
   240 | 
   241 |         The model stores them packed into one tensor::
   242 | 
   243 |             experts.gate_up_proj.weight  (2, 4, 2)
   244 |                                           ^  ^  ^
   245 |                                           |  |  +-- features
   246 |                                           |  +-- w1 (2) + w3 (2) concatenated
   247 |                                           +-- num_experts
   248 | 
   249 |         The conversion (without FSDP) is: load all expert w1/w3 tensors,
   250 |         MergeModulelist(dim=0) stacks experts, Concatenate(dim=1) joins w1+w3.
   251 | 
   252 |         With FSDP, Shard(0) splits the expert dim across ranks. Rank 0 owns
   253 |         expert 0, rank 1 owns expert 1. So rank 0 should skip loading expert 1
   254 |         entirely -- not load it then discard it.
   255 | 
   256 |         What the test checks::
   257 | 
   258 |             checkpoint files              shard_tensor              rank 0 gets
   259 |             ----------------              ------------              -----------
   260 |             experts.0.w1  [[0,1],[2,3]]   idx=0 -> kept            [[0,1],[2,3]]
   261 |             experts.1.w1  [[10,11],...]   idx=1 -> None (not owned)
   262 |             experts.0.w3  [[4,5],[6,7]]   idx=0 -> kept            [[4,5],[6,7]]
   263 |             experts.1.w3  [[14,15],...]   idx=1 -> None (not owned)
   264 | 
   265 |         WeightConverter then combines only the kept tensors::
   266 | 
   267 |             MergeModulelist(dim=0): stack owned experts  -> shape (1, 2, 2) each
   268 |             Concatenate(dim=1):     cat w1 + w3 along dim 1
   269 | 
   270 |             gate_up_proj = [[[0,1],[2,3],[4,5],[6,7]]]   shape (1, 4, 2)
   271 |                               ~~~~~~~~~~  ~~~~~~~~~~
   272 |                                   w1          w3
   273 | 
   274 |         The key point: DtensorShardOperation.shard_tensor(tensor_idx=1) returns
   275 |         None for rank 0, so the converter never even processes expert 1's data.
   276 |         This saves memory during loading.
   277 |         """
   278 |         shard_op = _make_dtensor_shard_op(
   279 |             FakeMesh(shape=(2,), rank=0),
   280 |             [Shard(0)],
   281 |             param_shape=(2, 4, 2),
   282 |             local_shape=(1, 4, 2),
   283 |         )
   284 |         converter = WeightConverter(
   285 |             ["experts.*.w1.weight", "experts.*.w3.weight"],
   286 |             "experts.gate_up_proj.weight",
   287 |             operations=[MergeModulelist(dim=0), Concatenate(dim=1)],
   288 |         )
   289 | 
   290 |         for idx, tensor in enumerate(
   291 |             [
   292 |                 torch.tensor([[0.0, 1.0], [2.0, 3.0]]),
   293 |                 torch.tensor([[10.0, 11.0], [12.0, 13.0]]),
   294 |             ]
   295 |         ):
   296 |             converter.add_tensor(
   297 |                 "model.layers.0.experts.gate_up_proj.weight",
   298 |                 f"model.layers.0.experts.{idx}.w1.weight",
   299 |                 "experts.*.w1.weight",
   300 |                 spawn_materialize(None, tensor, device="cpu", dtype=None, sharding_op=shard_op, tensor_idx=idx),
   301 |             )
   302 | 
   303 |         for idx, tensor in enumerate(
   304 |             [
   305 |                 torch.tensor([[4.0, 5.0], [6.0, 7.0]]),
   306 |                 torch.tensor([[14.0, 15.0], [16.0, 17.0]]),
   307 |             ]
   308 |         ):
   309 |             converter.add_tensor(
   310 |                 "model.layers.0.experts.gate_up_proj.weight",
   311 |                 f"model.layers.0.experts.{idx}.w3.weight",
   312 |                 "experts.*.w3.weight",
   313 |                 spawn_materialize(None, tensor, device="cpu", dtype=None, sharding_op=shard_op, tensor_idx=idx),
   314 |             )
   315 | 
   316 |         converted = converter.convert("model.layers.0.experts.gate_up_proj.weight")
   317 | 
   318 |         self.assertEqual(list(converted), ["model.layers.0.experts.gate_up_proj.weight"])
   319 |         torch.testing.assert_close(
