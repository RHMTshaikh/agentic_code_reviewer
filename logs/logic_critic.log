  2445 |     @torch.no_grad()
  2446 |     def _init_weights(self, module):
  2447 |         """
  2448 |         Initialize the weights. This is quite general on purpose, in the spirit of what we usually do. For more complex
  2449 |         initialization scheme, it should be overridden by the derived `PreTrainedModel` class. In case a model adds an explicit
  2450 |         `nn.Parameter`, this method should also be overridden in order to initialize it correctly.
  2451 |         """
  2452 |         if hasattr(self.config, "initializer_range"):
  2453 |             std = self.config.initializer_range or 0.02
  2454 |         elif hasattr(self.config, "init_std"):
  2455 |             std = self.config.init_std
  2456 |         elif hasattr(self.config, "initializer_factor"):
  2457 |             std = self.config.initializer_factor
  2458 |         else:
  2459 |             # 0.02 is the standard default value across the library
  2460 |             std = getattr(self.config.get_text_config(), "initializer_range", 0.02)
  2461 | 
  2462 |         if isinstance(module, (nn.Linear, nn.Conv1d, nn.Conv2d, nn.Conv3d, nn.ConvTranspose1d, nn.ConvTranspose2d)):
  2463 |             if getattr(module, "weight", None) is not None:
  2464 |                 init.normal_(module.weight, mean=0.0, std=std)
  2465 |             if module.bias is not None:
  2466 |                 init.zeros_(module.bias)
  2467 |         elif isinstance(module, nn.LSTM):
  2468 |             for name, param in module.named_parameters():
  2469 |                 if "weight" in name:
  2470 |                     init.xavier_uniform_(param)
  2471 |                 elif "bias" in name:
  2472 |                     init.constant_(param, 0.0)
  2473 |         elif isinstance(module, nn.Embedding):
  2474 |             init.normal_(module.weight, mean=0.0, std=std)
  2475 |             # Here we need the check explicitly, as we slice the weight in the `zeros_` call, so it looses the flag
  2476 |             if module.padding_idx is not None and not getattr(module.weight, "_is_hf_initialized", False):
  2477 |                 init.zeros_(module.weight[module.padding_idx])
  2478 |         elif isinstance(module, nn.MultiheadAttention):
  2479 |             # This uses torch's original init
  2480 |             module._reset_parameters()
  2481 |         # We cannot use `isinstance` on the RMSNorms or LayerNorms, as they usually are custom modules which change names
  2482 |         # between modelings (because they are prefixed with the model name)
  2483 |         elif (
  2484 |             isinstance(module, (nn.GroupNorm, nn.BatchNorm1d, nn.BatchNorm2d, nn.BatchNorm3d))
  2485 |             or "LayerNorm" in module.__class__.__name__
  2486 |             or "RMSNorm" in module.__class__.__name__
  2487 |         ):
  2488 |             # Norms can exist without weights (in which case they are None from torch primitives)
  2489 |             if getattr(module, "weight", None) is not None:
  2490 |                 init.ones_(module.weight)
  2491 |             if getattr(module, "bias", None) is not None:
  2492 |                 init.zeros_(module.bias)
  2493 |             # And the potential buffers for the BatchNorms
  2494 |             if getattr(module, "running_mean", None) is not None:
  2495 |                 init.zeros_(module.running_mean)
  2496 |                 init.ones_(module.running_var)
  2497 |                 init.zeros_(module.num_batches_tracked)
  2498 |         # This matches all the usual RotaryEmbeddings modules
  2499 |         elif "RotaryEmbedding" in module.__class__.__name__ and hasattr(module, "original_inv_freq"):
  2500 |             rope_fn = (
  2501 |                 ROPE_INIT_FUNCTIONS[module.rope_type]
  2502 |                 if module.rope_type != "default"
  2503 |                 else module.compute_default_rope_parameters
  2504 |             )
  2505 |             buffer_value, _ = rope_fn(module.config)
  2506 |             init.copy_(module.inv_freq, buffer_value)
  2507 |             init.copy_(module.original_inv_freq, buffer_value)
  2508 | 
  2509 |     def _initialize_weights(self, module, is_remote_code: bool = False):
  2510 |         """
  2511 |         Initialize the weights if they are not already initialized.
  2512 |         """
  2513 |         if getattr(module, "_is_hf_initialized", False):
  2514 |             return
  2515 | 
  2516 |         # This check is for remote code that does NOT use either `torch.init` or `transformers.initialization` in `_init_weights`
  2517 |         # which allow to check the flag directly on param. As they don't and write the params in-place, params would be reinitialized
  2518 |         # otherwise
  2519 |         if (
  2520 |             is_remote_code
  2521 |             and all(getattr(param, "_is_hf_initialized", False) for param in module.parameters(recurse=False))
  2522 |             and all(
  2523 |                 getattr(buffer, "_is_hf_initialized", False)
  2524 |                 for buffer in module.buffers(recurse=False)
  2525 |                 if buffer is not None
  2526 |             )
  2527 |         ):
  2528 |             module._is_hf_initialized = True
  2529 |             return
  2530 | 
  2531 |         self._init_weights(module)
  2532 |         module._is_hf_initialized = True
  2533 | 
  2534 |     @torch.no_grad()
  2535 |     @init.guard_torch_init_functions()
  2536 |     def initialize_weights(self):
  2537 |         """
  2538 |         This is equivalent to calling `self.apply(self._initialize_weights)`, but correctly handles composite models.
  2539 |         This function dynamically dispatches the correct `init_weights` function to the modules as we advance in the
  2540 |         module graph along the recursion. It can handle an arbitrary number of sub-models. Without it, every composite
  2541 |         model would have to recurse a second time on all sub-models explicitly in the outer-most `_init_weights`, which
  2542 |         is extremely error prone and inefficient.
  2543 |         """
  2544 |         if not hasattr(torch.nn.Module, "smart_apply"):
  2545 |             # This function is equivalent to `torch.nn.Module.apply`, except that it dynamically adjust the function
  2546 |             # to apply as we go down the graph
  2547 |             def smart_apply(module: nn.Module, fn: Callable[[nn.Module, bool], None], is_remote_code: bool):
  2548 |                 for child in module.children():
  2549 |                     # We found a sub-model: recursively dispatch its own init function now!
  2550 |                     if isinstance(child, PreTrainedModel):
  2551 |                         smart_apply(child, child._initialize_weights, is_remote_code)
  2552 |                     else:
  2553 |                         smart_apply(child, fn, is_remote_code)
  2554 |                 fn(module, is_remote_code)
  2555 |                 return module
  2556 | 
  2557 |             setattr(torch.nn.Module, "smart_apply", smart_apply)
  2558 | 
  2559 |         # Let the magic happen with this simple call
  2560 |         smart_apply_fn = getattr(self, "smart_apply")
  2561 |         # `getattr(self, ...)` returns a bound method, so `self` is already provided as the receiver.
  2562 |         smart_apply_fn(self._initialize_weights, self.is_remote_code())
  2563 | 
  2564 |     def get_expanded_tied_weights_keys(self, all_submodels: bool = False) -> dict:
  2565 |         r"""
  2566 |         Return the expanded tied weight keys (in case they contain modules or regex patterns) for only the current
  2567 |         model, or recursively for all submodels if `all_submodels=True` (i.e. it will re-check the config values for all
  2568 |         submodels).
  2569 | 
  2570 |         For almost all models, we only require to tie the embeddings, so the model has an internal property
  2571 |         `_tied_weights_keys = {"lm_head.weight": "model.embed_tokens.weight"}`. In this case, the mapping is already
  2572 |         "expanded", i.e. it already contains full parameters, and this function will simply return a copy of the property.
  2573 |         For more complex patterns, e.g. for `DFineForObjectDetection`, we have the following attribute
  2574 |         ```
  2575 |         _tied_weights_keys = {
  2576 |             r"bbox_embed.(?![0])\d+": "bbox_embed.0",
  2577 |             r"class_embed.(?![0])\d+": "class_embed.0",
  2578 |             "model.decoder.class_embed": "class_embed",
  2579 |             "model.decoder.bbox_embed": "bbox_embed",
  2580 |         }
  2581 |         ```
  2582 |         In this case, the function looks up all the model's parameters and buffers, and matches all the params,
  2583 |         returning the following:
  2584 |         ```
  2585 |         {
  2586 |             'bbox_embed.1.layers.0.bias': 'bbox_embed.0.layers.0.bias',
  2587 |             'bbox_embed.1.layers.0.weight': 'bbox_embed.0.layers.0.weight',
  2588 |             'bbox_embed.1.layers.1.bias': 'bbox_embed.0.layers.1.bias',
  2589 |             'bbox_embed.1.layers.1.weight': 'bbox_embed.0.layers.1.weight',
  2590 |             'bbox_embed.1.layers.2.bias': 'bbox_embed.0.layers.2.bias',
  2591 |             'bbox_embed.1.layers.2.weight': 'bbox_embed.0.layers.2.weight',
  2592 |             'bbox_embed.2.layers.0.bias': 'bbox_embed.0.layers.0.bias',
  2593 |             'bbox_embed.2.layers.0.weight': 'bbox_embed.0.layers.0.weight',
  2594 |             ...
  2595 |             'class_embed.1.bias': 'class_embed.0.bias',
  2596 |             'class_embed.1.weight': 'class_embed.0.weight',
  2597 |             'class_embed.2.bias': 'class_embed.0.bias',
  2598 |             'class_embed.2.weight': 'class_embed.0.weight',
  2599 |             ...
  2600 |             'model.decoder.class_embed.0.bias': 'class_embed.0.bias',
  2601 |             'model.decoder.class_embed.0.weight': 'class_embed.0.weight',
  2602 |             'model.decoder.class_embed.1.bias': 'class_embed.0.bias',
  2603 |             'model.decoder.class_embed.1.weight': 'class_embed.0.weight',
  2604 |             ...
  2605 |             'model.decoder.bbox_embed.0.layers.0.bias': 'bbox_embed.0.layers.0.bias',
  2606 |             'model.decoder.bbox_embed.0.layers.0.weight': 'bbox_embed.0.layers.0.weight',
  2607 |             'model.decoder.bbox_embed.0.layers.1.bias': 'bbox_embed.0.layers.1.bias',
  2608 |             'model.decoder.bbox_embed.0.layers.1.weight': 'bbox_embed.0.layers.1.weight',
  2609 |             ...
  2610 |         }
  2611 |         ```
  2612 |         i.e. all the parameters matching the regex and modules patterns in `_tied_weights_keys`
  2613 |         """
  2614 |         if all_submodels:
  2615 |             expanded_tied_weights = {}
  2616 |             for prefix, submodule in self.named_modules(remove_duplicate=False):
  2617 |                 if isinstance(submodule, PreTrainedModel):
  2618 |                     # Will dynamically check the config if it has changed
  2619 |                     submodel_tied_weights = submodule.get_expanded_tied_weights_keys(all_submodels=False)
  2620 |                     if prefix != "":
  2621 |                         submodel_tied_weights = {
  2622 |                             f"{prefix}.{k}": f"{prefix}.{v}" for k, v in submodel_tied_weights.items()
  2623 |                         }
  2624 |                     expanded_tied_weights.update(submodel_tied_weights)
  2625 |             return expanded_tied_weights
  2626 | 
  2627 |         tied_mapping = self._tied_weights_keys
  2628 |         # If the config does not specify any tying, return empty dict
  2629 |         # NOTE: not all modules have `tie_word_embeddings` attr, for example vision-only
  2630 |         # modules do not have any word embeddings!
  2631 |         tie_word_embeddings = getattr(self.config, "tie_word_embeddings", False)
  2632 |         if not tie_word_embeddings:
  2633 |             return {}
  2634 |         # If None, return empty dict
  2635 |         elif tied_mapping is None:
  2636 |             return {}
  2637 |         # Short-cut for the most common cases: if the tied weights mapping only contains already expanded params,
  2638 |         # return it directly (the regex matches names containing only letters, numbers, dots, and underscores to make
  2639 |         # sure it does not contain a regex pattern, and finishing by "bias" or "weight" to make sure it's not a module)
  2640 |         common_case_regex = re.compile(r"^[A-Za-z0-9_\.]+(weight)|(bias)$")
  2641 |         if all(common_case_regex.match(k) for k in tied_mapping.keys() | tied_mapping.values()):
