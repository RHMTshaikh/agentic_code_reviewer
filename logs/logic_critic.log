  1289 |     def __getattr__(self, key):
  1290 |         # Handle _id/_ids suffix (eg. bos_token_id -> bos_token)
  1291 |         key_without_id = key.removesuffix("_ids").removesuffix("_id") if key.endswith(("_id", "_ids")) else key
  1292 | 
  1293 |         # Named special tokens (bos_token, eos_token, etc.)
  1294 |         if key_without_id in self.SPECIAL_TOKENS_ATTRIBUTES:
  1295 |             # Use __dict__.get to avoid recursive __getattr__ when _special_tokens_map
  1296 |             # is not yet initialized (e.g. during fast tokenizer __init__)
  1297 |             token_value = self.__dict__.get("_special_tokens_map", {}).get(key_without_id)
  1298 |             if token_value is None:
  1299 |                 if self.verbose:
  1300 |                     logger.error(f"Using {key}, but it is not set yet.")
  1301 |                 return None
  1302 |             return self.convert_tokens_to_ids(str(token_value)) if key != key_without_id else str(token_value)
  1303 | 
  1304 |         # Extra special tokens
  1305 |         if key_without_id == "extra_special_tokens":
  1306 |             tokens = [str(tok) for tok in self.__dict__.get("_extra_special_tokens", [])]
  1307 |             return self.convert_tokens_to_ids(tokens) if key != key_without_id else tokens
  1308 | 
  1309 |         if key not in self.__dict__:
  1310 |             # Also check the class hierarchy (handles class-level defaults, e.g. in
  1311 |             # dynamically loaded remote code where __getattr__ may be called before
  1312 |             # the instance attribute is set)
  1313 |             for cls in type(self).__mro__:
  1314 |                 if key in vars(cls):
  1315 |                     return vars(cls)[key]
  1316 |             raise AttributeError(f"{self.__class__.__name__} has no attribute {key}")
