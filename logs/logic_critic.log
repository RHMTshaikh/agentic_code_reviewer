  2288 |     def enable_input_require_grads(self):
  2289 |         """
  2290 |         Enables the gradients for the input embeddings. This is useful for fine-tuning adapter weights while keeping
  2291 |         the model weights fixed.
  2292 |         """
  2293 | 
  2294 |         def make_inputs_require_grads(module, input, output):
  2295 |             output.requires_grad_(True)
  2296 | 
  2297 |         hooks = []
  2298 |         seen_modules = set()
  2299 |         found_embeddings = False
  2300 | 
  2301 |         for module in self.modules():
  2302 |             if not (isinstance(module, PreTrainedModel) and hasattr(module, "get_input_embeddings")):
  2303 |                 continue
  2304 | 
  2305 |             try:
  2306 |                 input_embeddings = module.get_input_embeddings()
  2307 |             except NotImplementedError:
  2308 |                 continue
  2309 | 
  2310 |             if input_embeddings is None or not hasattr(input_embeddings, "register_forward_hook"):
  2311 |                 continue
  2312 | 
  2313 |             embedding_id = id(input_embeddings)
  2314 |             if embedding_id in seen_modules:
  2315 |                 continue
  2316 | 
  2317 |             seen_modules.add(embedding_id)
  2318 |             hooks.append(input_embeddings.register_forward_hook(make_inputs_require_grads))
  2319 |             found_embeddings = True
  2320 | 
  2321 |         self._require_grads_hooks = hooks
  2322 |         if hooks:
  2323 |             # for BC
  2324 |             self._require_grads_hook = hooks[0]
  2325 |         if not found_embeddings:
  2326 |             logger.warning_once(
  2327 |                 f"{self.__class__.__name__} does not expose input embeddings. Gradients cannot flow back to the token "
  2328 |                 "embeddings when using adapters or gradient checkpointing. Override `get_input_embeddings` to fully "
  2329 |                 "support those features, or set `_input_embed_layer` to the attribute name that holds the embeddings."
  2330 |             )
  2331 | 
  2332 |     def disable_input_require_grads(self):
  2333 |         """
  2334 |         Removes the `_require_grads_hook`.
  2335 |         """
  2336 |         hooks = getattr(self, "_require_grads_hooks", None)
  2337 |         if not hooks:
  2338 |             return
  2339 | 
  2340 |         for hook in hooks:
  2341 |             hook.remove()
  2342 | 
  2343 |         self._require_grads_hooks = []
  2344 |         if hasattr(self, "_require_grads_hook"):
  2345 |             del self._require_grads_hook
  2346 | 
  2347 |     def get_encoder(self, modality: str | None = None):
  2348 |         """
  2349 |         Best-effort lookup of the *encoder* module. If provided with `modality` argument,
  2350 |         it looks for a modality-specific encoder in multimodal models (e.g. "image_encoder")
  2351 |         By default the function returns model's text encoder if any, and otherwise returns `self`.
  2352 | 
  2353 |         Possible `modality` values are "image", "video" and "audio".
  2354 |         """
  2355 |         # NOTE: new models need to use existing names for layers if possible, so this list doesn't grow infinitely
  2356 |         if modality in ["image", "video"]:
  2357 |             possible_module_names = ["vision_tower", "visual", "vision_model", "vision_encoder", "image_tower"]
  2358 |         elif modality == "audio":
  2359 |             possible_module_names = ["audio_tower", "audio_encoder", "speech_encoder"]
  2360 |         elif modality is None:
  2361 |             possible_module_names = ["text_encoder", "encoder"]
  2362 |         else:
  2363 |             raise ValueError(f'Unnrecognized modality, has to be "image", "video" or "audio" but found {modality}')
  2364 | 
  2365 |         for name in possible_module_names:
  2366 |             if hasattr(self, name):
  2367 |                 return getattr(self, name)
  2368 | 
  2369 |         if self.base_model is not self and hasattr(self.base_model, "get_encoder"):
  2370 |             base_encoder = self.base_model.get_encoder(modality=modality)
  2371 |             # Base model will always have attr `get_encoder` if inherited from `PreTrainedModel`
  2372 |             # But it doesn't mean that the model has an encoder module, and we need to return `self`
  2373 |             if base_encoder != self.base_model:
  2374 |                 return base_encoder
  2375 | 
  2376 |         # If this is a base transformer model (no encoder/model attributes), return self
  2377 |         return self
  2378 | 
  2379 |     def set_encoder(self, encoder, modality: str | None = None):
  2380 |         """
  2381 |         Symmetric setter. Mirrors the lookup logic used in `get_encoder`.
  2382 |         """
  2383 | 
  2384 |         # NOTE: new models need to use existing names for layers if possible, so this list doesn't grow infinitely
  2385 |         if modality in ["image", "video"]:
  2386 |             possible_module_names = ["vision_tower", "visual", "vision_model", "vision_encoder", "image_tower"]
  2387 |         elif modality == "audio":
  2388 |             possible_module_names = ["audio_tower", "audio_encoder"]
  2389 |         elif modality is None:
  2390 |             possible_module_names = ["text_encoder", "encoder"]
  2391 |         else:
  2392 |             raise ValueError(f'Unnrecognized modality, has to be "image", "video" or "audio" but found {modality}')
  2393 | 
  2394 |         for name in possible_module_names:
  2395 |             if hasattr(self, name):
  2396 |                 setattr(self, name, encoder)
  2397 |                 return
  2398 | 
  2399 |         if self.base_model is not self:
  2400 |             if hasattr(self.base_model, "set_encoder"):
  2401 |                 self.base_model.set_encoder(encoder, modality=modality)
  2402 |             else:
  2403 |                 self.model = encoder
  2404 | 
  2405 |     def get_decoder(self):
  2406 |         """
  2407 |         Best-effort lookup of the *decoder* module.
  2408 | 
  2409 |         Order of attempts (covers ~85 % of current usages):
  2410 | 
  2411 |         1. `self.decoder/self.language_model/self.text_model`
  2412 |         2. `self.base_model`                  (many wrappers store the decoder here)
  2413 |         3. `self.base_model.get_decoder()`    (nested wrappers)
  2414 |         4. fallback: raise for the few exotic models that need a bespoke rule
  2415 |         """
  2416 |         possible_module_names = ["language_model", "text_model", "decoder", "text_decoder"]
  2417 |         for name in possible_module_names:
  2418 |             if hasattr(self, name):
  2419 |                 return getattr(self, name)
  2420 | 
  2421 |         if self.base_model is not self and hasattr(self.base_model, "get_decoder"):
  2422 |             return self.base_model.get_decoder()
  2423 | 
  2424 |         # If this is a base transformer model (no decoder/model attributes), return self
  2425 |         # This handles cases like MistralModel which is itself the decoder
  2426 |         return self
  2427 | 
  2428 |     def set_decoder(self, decoder):
  2429 |         """
  2430 |         Symmetric setter. Mirrors the lookup logic used in `get_decoder`.
  2431 |         """
  2432 | 
  2433 |         possible_module_names = ["language_model", "text_model", "decoder"]
  2434 |         for name in possible_module_names:
  2435 |             if hasattr(self, name):
  2436 |                 setattr(self, name, decoder)
  2437 |                 return
  2438 | 
  2439 |         if self.base_model is not self:
  2440 |             if hasattr(self.base_model, "set_decoder"):
  2441 |                 self.base_model.set_decoder(decoder)
  2442 |             else:
  2443 |                 self.model = decoder
  2444 | 
  2445 |     @torch.no_grad()
  2446 |     def _init_weights(self, module):
  2447 |         """
  2448 |         Initialize the weights. This is quite general on purpose, in the spirit of what we usually do. For more complex
  2449 |         initialization scheme, it should be overridden by the derived `PreTrainedModel` class. In case a model adds an explicit
  2450 |         `nn.Parameter`, this method should also be overridden in order to initialize it correctly.
  2451 |         """
  2452 |         if hasattr(self.config, "initializer_range"):
  2453 |             std = self.config.initializer_range or 0.02
  2454 |         elif hasattr(self.config, "init_std"):
  2455 |             std = self.config.init_std
  2456 |         elif hasattr(self.config, "initializer_factor"):
  2457 |             std = self.config.initializer_factor
  2458 |         else:
  2459 |             # 0.02 is the standard default value across the library
  2460 |             std = getattr(self.config.get_text_config(), "initializer_range", 0.02)
  2461 | 
  2462 |         if isinstance(module, (nn.Linear, nn.Conv1d, nn.Conv2d, nn.Conv3d, nn.ConvTranspose1d, nn.ConvTranspose2d)):
  2463 |             if getattr(module, "weight", None) is not None:
  2464 |                 init.normal_(module.weight, mean=0.0, std=std)
  2465 |             if module.bias is not None:
  2466 |                 init.zeros_(module.bias)
  2467 |         elif isinstance(module, nn.LSTM):
  2468 |             for name, param in module.named_parameters():
  2469 |                 if "weight" in name:
  2470 |                     init.xavier_uniform_(param)
  2471 |                 elif "bias" in name:
  2472 |                     init.constant_(param, 0.0)
  2473 |         elif isinstance(module, nn.Embedding):
  2474 |             init.normal_(module.weight, mean=0.0, std=std)
  2475 |             # Here we need the check explicitly, as we slice the weight in the `zeros_` call, so it looses the flag
  2476 |             if module.padding_idx is not None and not getattr(module.weight, "_is_hf_initialized", False):
  2477 |                 init.zeros_(module.weight[module.padding_idx])
  2478 |         elif isinstance(module, nn.MultiheadAttention):
  2479 |             # This uses torch's original init
  2480 |             module._reset_parameters()
  2481 |         # We cannot use `isinstance` on the RMSNorms or LayerNorms, as they usually are custom modules which change names
  2482 |         # between modelings (because they are prefixed with the model name)
  2483 |         elif (
  2484 |             isinstance(module, (nn.GroupNorm, nn.BatchNorm1d, nn.BatchNorm2d, nn.BatchNorm3d))
  2485 |             or "LayerNorm" in module.__class__.__name__
  2486 |             or "RMSNorm" in module.__class__.__name__
  2487 |         ):
  2488 |             # Norms can exist without weights (in which case they are None from torch primitives)
  2489 |             if getattr(module, "weight", None) is not None:
  2490 |                 init.ones_(module.weight)
  2491 |             if getattr(module, "bias", None) is not None:
  2492 |                 init.zeros_(module.bias)
  2493 |             # And the potential buffers for the BatchNorms
  2494 |             if getattr(module, "running_mean", None) is not None:
  2495 |                 init.zeros_(module.running_mean)
  2496 |                 init.ones_(module.running_var)
  2497 |                 init.zeros_(module.num_batches_tracked)
  2498 |         # This matches all the usual RotaryEmbeddings modules
  2499 |         elif "RotaryEmbedding" in module.__class__.__name__ and hasattr(module, "original_inv_freq"):
  2500 |             rope_fn = (
  2501 |                 ROPE_INIT_FUNCTIONS[module.rope_type]
  2502 |                 if module.rope_type != "default"
  2503 |                 else module.compute_default_rope_parameters
  2504 |             )
  2505 |             buffer_value, _ = rope_fn(module.config)
  2506 |             init.copy_(module.inv_freq, buffer_value)
  2507 |             init.copy_(module.original_inv_freq, buffer_value)
  2508 | 
  2509 |     def _initialize_weights(self, module, is_remote_code: bool = False):
  2510 |         """
  2511 |         Initialize the weights if they are not already initialized.
  2512 |         """
  2513 |         if getattr(module, "_is_hf_initialized", False):
  2514 |             return
  2515 | 
  2516 |         # This check is for remote code that does NOT use either `torch.init` or `transformers.initialization` in `_init_weights`
  2517 |         # which allow to check the flag directly on param. As they don't and write the params in-place, params would be reinitialized
  2518 |         # otherwise
  2519 |         if (
  2520 |             is_remote_code
  2521 |             and all(getattr(param, "_is_hf_initialized", False) for param in module.parameters(recurse=False))
  2522 |             and all(
  2523 |                 getattr(buffer, "_is_hf_initialized", False)
  2524 |                 for buffer in module.buffers(recurse=False)
  2525 |                 if buffer is not None
  2526 |             )
  2527 |         ):
  2528 |             module._is_hf_initialized = True
  2529 |             return
  2530 | 
  2531 |         self._init_weights(module)
  2532 |         module._is_hf_initialized = True
  2533 | 
  2534 |     @torch.no_grad()
  2535 |     @init.guard_torch_init_functions()
  2536 |     def initialize_weights(self):
  2537 |         """
  2538 |         This is equivalent to calling `self.apply(self._initialize_weights)`, but correctly handles composite models.
  2539 |         This function dynamically dispatches the correct `init_weights` function to the modules as we advance in the
  2540 |         module graph along the recursion. It can handle an arbitrary number of sub-models. Without it, every composite
  2541 |         model would have to recurse a second time on all sub-models explicitly in the outer-most `_init_weights`, which
  2542 |         is extremely error prone and inefficient.
  2543 |         """
  2544 |         if not hasattr(torch.nn.Module, "smart_apply"):
  2545 |             # This function is equivalent to `torch.nn.Module.apply`, except that it dynamically adjust the function
  2546 |             # to apply as we go down the graph
  2547 |             def smart_apply(module: nn.Module, fn: Callable[[nn.Module, bool], None], is_remote_code: bool):
  2548 |                 for child in module.children():
  2549 |                     # We found a sub-model: recursively dispatch its own init function now!
  2550 |                     if isinstance(child, PreTrainedModel):
  2551 |                         smart_apply(child, child._initialize_weights, is_remote_code)
  2552 |                     else:
  2553 |                         smart_apply(child, fn, is_remote_code)
  2554 |                 fn(module, is_remote_code)
  2555 |                 return module
  2556 | 
  2557 |             setattr(torch.nn.Module, "smart_apply", smart_apply)
  2558 | 
  2559 |         # Let the magic happen with this simple call
  2560 |         smart_apply_fn = getattr(self, "smart_apply")
  2561 |         # `getattr(self, ...)` returns a bound method, so `self` is already provided as the receiver.
  2562 |         smart_apply_fn(self._initialize_weights, self.is_remote_code())
  2563 | 
  2564 |     def get_expanded_tied_weights_keys(self, all_submodels: bool = False) -> dict:
  2565 |         r"""
  2566 |         Return the expanded tied weight keys (in case they contain modules or regex patterns) for only the current
  2567 |         model, or recursively for all submodels if `all_submodels=True` (i.e. it will re-check the config values for all
  2568 |         submodels).
  2569 | 
  2570 |         For almost all models, we only require to tie the embeddings, so the model has an internal property
  2571 |         `_tied_weights_keys = {"lm_head.weight": "model.embed_tokens.weight"}`. In this case, the mapping is already
  2572 |         "expanded", i.e. it already contains full parameters, and this function will simply return a copy of the property.
  2573 |         For more complex patterns, e.g. for `DFineForObjectDetection`, we have the following attribute
  2574 |         ```
  2575 |         _tied_weights_keys = {
  2576 |             r"bbox_embed.(?![0])\d+": "bbox_embed.0",
  2577 |             r"class_embed.(?![0])\d+": "class_embed.0",
  2578 |             "model.decoder.class_embed": "class_embed",
  2579 |             "model.decoder.bbox_embed": "bbox_embed",
  2580 |         }
  2581 |         ```
  2582 |         In this case, the function looks up all the model's parameters and buffers, and matches all the params,
  2583 |         returning the following:
  2584 |         ```
  2585 |         {
  2586 |             'bbox_embed.1.layers.0.bias': 'bbox_embed.0.layers.0.bias',
  2587 |             'bbox_embed.1.layers.0.weight': 'bbox_embed.0.layers.0.weight',
  2588 |             'bbox_embed.1.layers.1.bias': 'bbox_embed.0.layers.1.bias',
  2589 |             'bbox_embed.1.layers.1.weight': 'bbox_embed.0.layers.1.weight',
  2590 |             'bbox_embed.1.layers.2.bias': 'bbox_embed.0.layers.2.bias',
  2591 |             'bbox_embed.1.layers.2.weight': 'bbox_embed.0.layers.2.weight',
  2592 |             'bbox_embed.2.layers.0.bias': 'bbox_embed.0.layers.0.bias',
  2593 |             'bbox_embed.2.layers.0.weight': 'bbox_embed.0.layers.0.weight',
  2594 |             ...
  2595 |             'class_embed.1.bias': 'class_embed.0.bias',
  2596 |             'class_embed.1.weight': 'class_embed.0.weight',
  2597 |             'class_embed.2.bias': 'class_embed.0.bias',
  2598 |             'class_embed.2.weight': 'class_embed.0.weight',
  2599 |             ...
  2600 |             'model.decoder.class_embed.0.bias': 'class_embed.0.bias',
  2601 |             'model.decoder.class_embed.0.weight': 'class_embed.0.weight',
  2602 |             'model.decoder.class_embed.1.bias': 'class_embed.0.bias',
  2603 |             'model.decoder.class_embed.1.weight': 'class_embed.0.weight',
  2604 |             ...
  2605 |             'model.decoder.bbox_embed.0.layers.0.bias': 'bbox_embed.0.layers.0.bias',
  2606 |             'model.decoder.bbox_embed.0.layers.0.weight': 'bbox_embed.0.layers.0.weight',
  2607 |             'model.decoder.bbox_embed.0.layers.1.bias': 'bbox_embed.0.layers.1.bias',
  2608 |             'model.decoder.bbox_embed.0.layers.1.weight': 'bbox_embed.0.layers.1.weight',
  2609 |             ...
  2610 |         }
  2611 |         ```
  2612 |         i.e. all the parameters matching the regex and modules patterns in `_tied_weights_keys`
  2613 |         """
  2614 |         if all_submodels:
  2615 |             expanded_tied_weights = {}
  2616 |             for prefix, submodule in self.named_modules(remove_duplicate=False):
  2617 |                 if isinstance(submodule, PreTrainedModel):
  2618 |                     # Will dynamically check the config if it has changed
  2619 |                     submodel_tied_weights = submodule.get_expanded_tied_weights_keys(all_submodels=False)
  2620 |                     if prefix != "":
  2621 |                         submodel_tied_weights = {
  2622 |                             f"{prefix}.{k}": f"{prefix}.{v}" for k, v in submodel_tied_weights.items()
  2623 |                         }
  2624 |                     expanded_tied_weights.update(submodel_tied_weights)
  2625 |             return expanded_tied_weights
  2626 | 
  2627 |         tied_mapping = self._tied_weights_keys
  2628 |         # If the config does not specify any tying, return empty dict
  2629 |         # NOTE: not all modules have `tie_word_embeddings` attr, for example vision-only
  2630 |         # modules do not have any word embeddings!
  2631 |         tie_word_embeddings = getattr(self.config, "tie_word_embeddings", False)
  2632 |         if not tie_word_embeddings:
  2633 |             return {}
  2634 |         # If None, return empty dict
  2635 |         elif tied_mapping is None:
  2636 |             return {}
  2637 |         # Short-cut for the most common cases: if the tied weights mapping only contains already expanded params,
  2638 |         # return it directly (the regex matches names containing only letters, numbers, dots, and underscores to make
  2639 |         # sure it does not contain a regex pattern, and finishing by "bias" or "weight" to make sure it's not a module)
  2640 |         common_case_regex = re.compile(r"^[A-Za-z0-9_\.]+(weight)|(bias)$")
  2641 |         if all(common_case_regex.match(k) for k in tied_mapping.keys() | tied_mapping.values()):
  2642 |             return tied_mapping.copy()
  2643 | 
  2644 |         # We need to expand the regex patterns or the modules into proper parameters
  2645 |         expanded_tied_weights = {}
  2646 |         all_param_names = {k for k, _ in self.named_parameters(remove_duplicate=False)} | {
  2647 |             k for k, _ in self.named_buffers(remove_duplicate=False)
  2648 |         }
  2649 |         for target_name, source_name in tied_mapping.items():
  2650 |             target_name = "^" + target_name
  2651 |             source_name = "^" + source_name
  2652 | 
  2653 |             source_params = sorted(filter(lambda x: re.search(source_name, x), all_param_names))
  2654 |             target_params = sorted(filter(lambda x: re.search(target_name, x), all_param_names))
  2655 |             if (
  2656 |                 not len(source_params) > 0
  2657 |                 or not len(target_params) > 0
  2658 |                 or len(target_params) % len(source_params) != 0
  2659 |             ):
  2660 |                 raise ValueError(
  2661 |                     f"There is an issue with your definition of `tie_weights_keys` for {source_name}:{target_name}. "
  2662 |                     f"We found {source_params} to tie into {target_params}"
  2663 |                 )
  2664 |             # we cycle source as it should be dispatch in many target if regex
  2665 |             for target_n, source_n in zip(target_params, cycle(source_params)):
  2666 |                 # If the source is already registered as a target, use the original corresponding source. This should never
  2667 |                 # happen in general, but some models such as `d_fine` have complicated regex patterns, so it end up being
  2668 |                 # the case for simplicity of the regexes. Fix it silently here
  2669 |                 if source_n in expanded_tied_weights.keys():
  2670 |                     # Use original source instead of having keys both as source and targets
  2671 |                     expanded_tied_weights[target_n] = expanded_tied_weights[source_n]
  2672 |                 # Usual case, everything is already correct
  2673 |                 else:
  2674 |                     expanded_tied_weights[target_n] = source_n
  2675 | 
  2676 |         return expanded_tied_weights
  2677 | 
  2678 |     def tie_weights(self, missing_keys: set[str] | None = None, recompute_mapping: bool = True):
  2679 |         """
  2680 |         Tie the model weights. If `recompute_mapping=False` (default when called internally), it will rely on the
  2681 |         `model.all_tied_weights_keys` attribute, containing the `{target: source}` mapping for the tied params.
  2682 |         If `recompute_mapping=True`, it will re-check all internal submodels and their config to determine the params
  2683 |         that need to be tied. This is the default when `model.tie_weights()` is called on its own, outside of
  2684 |         `__init__`, and `from_pretrained`, in case the config values were changed somewhere.
  2685 | 
  2686 |         Note that during `from_pretrained`, tying is *symmetric*: if the mapping says "tie target -> source" but
  2687 |         `source` is missing in the checkpoint while `target` exists, we *swap* source and target so we can still
  2688 |         tie everything to the parameter that actually exists.
  2689 |         """
  2690 |         # In this case, the keys stored in `all_tied_weights_keys` are already correct
  2691 |         if not recompute_mapping:
  2692 |             tied_keys = self.all_tied_weights_keys
  2693 |         else:
  2694 |             tied_keys = self.get_expanded_tied_weights_keys(all_submodels=True)
  2695 | 
  2696 |         tied_keys = list(tied_keys.items())
  2697 |         for i, (target_param_name, source_param_name) in enumerate(tied_keys):
  2698 |             # This is `from_pretrained` -> let's check symmetrically in case the source key is not present
  2699 |             if missing_keys is not None:
  2700 |                 remove_from_missing = True
  2701 |                 source_is_there = source_param_name not in missing_keys
  2702 |                 target_is_there = target_param_name not in missing_keys
  2703 |                 # Both are already present -> it means the config is wrong and do not reflect the actual
  2704 |                 # checkpoint -> let's raise a warning and NOT tie them
  2705 |                 if source_is_there and target_is_there:
  2706 |                     source_param = self.get_parameter(source_param_name)
  2707 |                     target_param = self.get_parameter(target_param_name)
  2708 | 
  2709 |                     # Skip check if both are disk offloaded. Tied tensors always
  2710 |                     # share the same offload device as per `infer_auto_device_map`
  2711 |                     if source_param.device.type == "meta" and target_param.device.type == "meta":
  2712 |                         continue
  2713 | 
  2714 |                     # If both are present, check if the weights are exactly similar, and only tie in this case
  2715 |                     # This check is important, as torch `.bin` checkpoints always contain both keys, referencing the same storage
  2716 |                     if not torch.equal(source_param, target_param):
  2717 |                         logger.warning(
  2718 |                             f"The tied weights mapping and config for this model specifies to tie {source_param_name} to "
  2719 |                             f"{target_param_name}, but both are present in the checkpoints with different values, so we will NOT "
  2720 |                             "tie them. You should update the config with `tie_word_embeddings=False` to silence this warning."
  2721 |                         )
  2722 |                         # Remove from internal attribute to correctly reflect actual tied weights
  2723 |                         self.all_tied_weights_keys.pop(target_param_name)
  2724 |                         # Skip to next iteration
  2725 |                         continue
  2726 |                 # We're missing the source but we have the target -> we swap them, tying the parameter that exists
  2727 |                 elif not source_is_there and target_is_there:
  2728 |                     target_param_name, source_param_name = source_param_name, target_param_name
  2729 |                 # Both are missing -> check other keys in case more than 2 keys are tied to the same weight
  2730 |                 elif not source_is_there and not target_is_there:
  2731 |                     for target_backup, source_backup in tied_keys[i + 1 :]:
  2732 |                         # In case of more than 2 keys tied to the same weight, they are guaranteed to all have
  2733 |                         # the same source thanks to `get_expanded_tied_weights_keys` so this check is enough
  2734 |                         if source_backup == source_param_name:
  2735 |                             target_backup_is_there = target_backup not in missing_keys
  2736 |                             # If the target is present, we found the correct weight to tie into (we know the source is missing)
  2737 |                             # Note here that we do not tie the missing source right now as well, as it will be done anyway when
  2738 |                             # the pair (target_backup, source_backup) becomes the main pair (target_param_name, source_param_name)
  2739 |                             if target_backup_is_there:
  2740 |                                 source_param_name = target_backup
  2741 |                                 break
  2742 |                     # If we did not break from the loop, it was impossible to find a source key -> let's raise
  2743 |                     else:
  2744 |                         # TODO Cyril: here ideally we want to raise instead of warning, but will break our CI as we have
  2745 |                         # tests loading model from empty dicts to perform init checks - since we don't raise, add a flag
  2746 |                         # to NOT remove from missing keys as it's actually still missing
  2747 |                         remove_from_missing = False
  2748 |                         logger.warning(
  2749 |                             f"This checkpoint seem corrupted. The tied weights mapping for this model specifies to tie "
  2750 |                             f"{source_param_name} to {target_param_name}, but both are absent from the checkpoint, "
  2751 |                             "and we could not find another related tied weight for those keys"
  2752 |                         )
  2753 | 
  2754 |             # Perform the actual tying
  2755 |             source_param = self.get_parameter_or_buffer(source_param_name)
  2756 |             if "." in target_param_name:
  2757 |                 parent_name, name = target_param_name.rsplit(".", 1)
  2758 |                 parent = self.get_submodule(parent_name)
  2759 |             else:
  2760 |                 name = target_param_name
  2761 |                 parent = self
  2762 |             # Tie the weights
  2763 |             setattr(parent, name, source_param)
  2764 |             self._adjust_bias(parent, source_param)
  2765 |             # Remove from missing if necessary
  2766 |             if missing_keys is not None and remove_from_missing:
  2767 |                 missing_keys.discard(target_param_name)
  2768 | 
