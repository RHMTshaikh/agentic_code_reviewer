   669 | def process_target_pattern(pattern: str) -> tuple[str, str | None]:
   670 |     """
   671 |     Process a target pattern for reverse mapping (when targets become sources).
   672 | 
   673 |     This handles several edge cases in checkpoint conversion mappings:
   674 |     - Removes `^` prefix and `$` suffix (start/end of string anchors)
   675 |     - Removes negative lookahead/lookbehind assertions
   676 |     - Detects capturing groups and replaces them with `\\1` backreference
   677 | 
   678 |     Args:
   679 |         pattern: The target pattern to process for reverse mapping.
   680 | 
   681 |     Returns:
   682 |         A tuple of (processed_pattern, captured_group) where captured_group is
   683 |         the original capturing group found (e.g., "(encoder|decoder)") or None.
   684 |     """
   685 |     # Some mapping contains `^` to notify start of string when matching -> remove it during reverse mapping
   686 |     pattern = pattern.removeprefix("^")
   687 |     # Some mapping contains `$` to notify end of string when matching -> remove it during reverse mapping
   688 |     pattern = pattern.removesuffix("$")
   689 |     # Remove negative lookahead/behind if any. This is ugly but needed for reverse mapping of
   690 |     # Qwen2.5, Sam3, Ernie4.5 VL MoE! It needs to be non greedy in case there are several
   691 |     pattern = re.sub(r"\(\?.+?\)?\)", "", pattern)
   692 |     # Remove the backslash for literal dots
   693 |     pattern = pattern.replace(r"\.", ".")
   694 |     # Allow capturing groups in patterns, i.e. to add/remove a prefix to all keys (e.g. timm_wrapper, sam3)
   695 |     capturing_group_match = re.search(r"\(.+?\)", pattern)
   696 |     captured_group = None
   697 |     if capturing_group_match:
   698 |         captured_group = capturing_group_match.group(0)
   699 |         pattern = pattern.replace(captured_group, r"\1", 1)
   700 |     return pattern, captured_group
   701 | 

