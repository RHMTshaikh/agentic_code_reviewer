  3603 |         if index is None:
  3604 |             path_to_weights = os.path.join(save_directory, weights_name)
  3605 |             logger.info(f"Model weights saved in {path_to_weights}")
  3606 |         else:
  3607 |             save_index_file = SAFE_WEIGHTS_INDEX_NAME
  3608 |             save_index_file = os.path.join(save_directory, _add_variant(save_index_file, variant))
  3609 |             # Save the index as well
  3610 |             with open(save_index_file, "w", encoding="utf-8") as f:
  3611 |                 content = json.dumps(index, indent=2, sort_keys=True) + "\n"
