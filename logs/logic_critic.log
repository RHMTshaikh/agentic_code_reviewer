  1283 |                     if key == prefix_to_keep + "_layers":
  1284 |                         new_key = "num_hidden_layers"
  1285 |                     # [encoder/decoder]_attention_heads -> num_attention_heads
  1286 |                     elif key == prefix_to_keep + "_attention_heads":
  1287 |                         new_key = "num_attention_heads"
