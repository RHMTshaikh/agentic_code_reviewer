   445 |             (32, [0, 1, 2], 0, 16),
   446 |             (32, [0, 1, 2], 0, 64),
   447 |             (32, [0, 1, 2], 16, 16),
   448 |             (32, [0, 1, 2], 31, 2),
   449 |             # Non-contiguous blocks
   450 |             (32, [0, 3, 6], 0, 64),
   451 |             (32, [2, 5, 8], 60, 10),
