  2696 |                 raise ValueError(
  2697 |                     f"type of {first_element} unknown: {type(first_element)}. "
  2698 |                     "Should be one of a python, numpy, or pytorch object."
  2699 |                 )
  2700 | 
  2701 |             for key, value in encoded_inputs.items():
